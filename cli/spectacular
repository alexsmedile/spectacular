_discovery_list() {
  local kind="$1" collection="$2"; shift 2
  local filter=all f id status updated summary result count=0
  while (( $# > 0 )); do
    case "$1" in --status) require_value "--status" "${2:-}"; filter="$2"; shift 2 ;; *) die "$kind list: unknown option '$1'" ;; esac
  done
  printf '%-10s  %-10s  %-12s  %-10s  %s\n' "ID" "STATUS" "RESULT" "UPDATED" "SUMMARY"
  printf '%-10s  %-10s  %-10s  %s\n' "--" "------" "-------" "----"
  while IFS= read -r f; do
    id=$(fm_get "$f" id); status=$(fm_get "$f" status); updated=$(fm_get "$f" updated); result=$(fm_get "$f" result); summary=$(fm_get "$f" summary)
    [[ "$filter" == all || "$filter" == "$status" ]] || continue
    [[ -n "$summary" ]] || summary="(legacy record — inspect $id)"
    printf '%-10s  %-10s  %-12s  %-10s  %s\n' "$id" "$status" "${result:-unknown}" "$updated" "$summary"
    count=$((count + 1))
  done < <(_iter_md "$collection")
  (( count > 0 )) || info "(no $collection match)"
}

_discovery_show() {
  local kind="$1" collection="$2" ref="$3"; shift 3
  local full=false json=false f id approval label
  while (( $# > 0 )); do case "$1" in --full) full=true; shift ;; --json) json=true; shift ;; *) die "$kind: unknown option '$1'" ;; esac; done
  f=$(_discovery_find "$collection" "$kind" "$ref") || die "$kind: '$ref' not found"
  $full && { cat "$f"; return 0; }
  id=$(fm_get "$f" id); approval=$(fm_get "$f" execution_requires_approval)
  case "$kind" in research) label="Research" ;; spike) label="Spike" ;; *) label="$kind" ;; esac
  if $json; then
    printf '{"schema":"spectacular.%s.v1","id":"%s","status":"%s","result":"%s","summary":"%s","blocked_by":"%s","execution_requires_approval":"%s","goal":"%s","outcome":"%s","evidence":"%s"}\n' \
      "$kind" "$(_json_escape "$id")" "$(_json_escape "$(fm_get "$f" status)")" "$(_json_escape "$(fm_get "$f" result)")" "$(_json_escape "$(fm_get "$f" summary)")" "$(_json_escape "$(fm_get "$f" blocked_by)")" "$(_json_escape "$approval")" "$(_json_escape "$(_section_body "$f" Goal)")" "$(_json_escape "$(_discovery_outcome "$f")")" "$(_json_escape "$(_discovery_evidence "$f")")"
    return 0
  fi
  printf '%s: %s\nStatus: %s · Result: %s%s\nBlocked by: %s\n\nGoal\n%s\n\nOutcome\n%s\n\nEvidence\n%s\n\nFull evidence: spectacular %s %s --full\n' \
    "$label" "$id" "$(fm_get "$f" status)" "$(fm_get "$f" result)" "${approval:+ · Execution requires approval: $approval}" "$(fm_get "$f" blocked_by)" "$(_section_body "$f" Goal)" "$(_discovery_outcome "$f")" "$(_discovery_evidence "$f")" "$kind" "$ref"
}

# Discovery resolution appends its durable outcome/evidence markers. These are
# collection-owned fields, deliberately separate from the generic section helper.
_discovery_outcome() {
  local value
  value=$(awk '/^\*\*Completed [^:]+:\*\*/ { sub(/^\*\*Completed [^:]+:\*\*[[:space:]]*/, ""); last=$0 } END { print last }' "$1")
  [[ -n "$value" ]] && { printf '%s\n' "$value"; return 0; }
  _section_body "$1" Outcome
}

_discovery_evidence() {
  local value
  value=$(awk '/^\*\*Evidence:\*\*/ { sub(/^\*\*Evidence:\*\*[[:space:]]*/, ""); last=$0 } END { print last }' "$1")
  [[ -n "$value" ]] && { printf '%s\n' "$value"; return 0; }
  _section_body "$1" Evidence
}

_discovery_resolve() {
  local kind="$1" collection="$2"; shift 2
  local ref="" outcome="" evidence="" result=""
  while (( $# > 0 )); do
    case "$1" in
      --outcome) require_value "--outcome" "${2:-}"; outcome="$2"; shift 2 ;;
      --evidence) require_value "--evidence" "${2:-}"; evidence="$2"; shift 2 ;;
      --result) require_value "--result" "${2:-}"; result="$2"; shift 2 ;;
      -*) die "$kind resolve: unknown flag '$1'" ;;
      *) [[ -z "$ref" ]] || die "$kind resolve: only one reference allowed"; ref="$1"; shift ;;
    esac
  done
  [[ -n "$ref" && -n "$outcome" && -n "$evidence" && -n "$result" ]] || die "Usage: spectacular $kind resolve <id|alias> --result supported|refuted|inconclusive --outcome <text> --evidence <source>"
  case "$result" in supported|refuted|inconclusive) ;; *) die "$kind resolve: --result must be supported|refuted|inconclusive" ;; esac
  local path id
  path=$(_discovery_find "$collection" "$kind" "$ref") || die "$kind resolve: '$ref' not found"
  id=$(fm_get "$path" id)
  fm_set "$path" status completed
  fm_set "$path" result "$result"
  fm_set "$path" completed_at "$TODAY"
  fm_set "$path" updated "$TODAY"
  printf '\n**Completed %s (%s):** %s\n' "$TODAY" "$result" "$outcome" >> "$path"
  printf '**Evidence:** %s\n' "$evidence" >> "$path"
  if [[ "$result" == inconclusive ]]; then
    info "  ⚠  $id completed inconclusively — uncertainty remains in fog; create/link a narrower successor"
  else
    info "  ✓  $id completed ($result) — tested uncertainty cleared"
  fi
}

_spec_find() {
  local ref="$1" canonical f path compact dir id slug
  path="$SPEC_SPECS_DIR/$ref.md"
  [[ -f "$path" ]] && { echo "$path"; return 0; }
  for f in "$SPEC_SPECS_DIR"/*.md "$SPEC_ARCHIVE_DIR/specs"/*.md; do
    [[ -f "$f" ]] || continue
    [[ "$(basename "$f")" == index.md ]] && continue
    id=$(fm_get "$f" id)
    slug=$(_record_slug "$f")
    [[ "$ref" == "$id" || "$ref" == "$slug" ]] && { echo "$f"; return 0; }
  done
  compact=$(printf '%s' "$ref" | tr -d ' _-' | tr '[:lower:]' '[:upper:]')
  if [[ "$compact" =~ ^(S|SPC|SPEC)([0-9]+)$ ]] || [[ "$compact" =~ ^[0-9]+$ ]]; then
    canonical=$(_canonical_resolve "$ref" spec)
    for dir in "$SPEC_SPECS_DIR" "$SPEC_WORKSPACE_DIR/spec" "$SPEC_ARCHIVE_DIR/specs"; do
      for f in "$dir"/"$canonical"-*.md "$dir"/"$canonical".md; do
        [[ -f "$f" ]] && { echo "$f"; return 0; }
      done
    done
  fi
  return 1
}

cmd_spec_record() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    new) cmd_spec_new "$@" ;;
    list) cmd_spec_list "$@" ;;
    approve|confirm) cmd_spec_approve "$sub" "$@" ;;
    act) cmd_spec_act "$@" ;;
    implement) cmd_spec_implement "$@" ;;
    deprecate) cmd_spec_deprecate "$@" ;;
    archive) cmd_spec_archive "$@" ;;
  ""|--help|-h)
      cat <<EOF
Usage: spectacular spec <new|list|approve|act|implement|deprecate|archive> [options]
       spectacular spec <id> [--json]

  new <slug> --summary <text> [--afk] [--supersedes <SPC>] [--target-version <v>]
  list [--status draft|unconfirmed|approved|implemented|superseded|deprecated|all]
  approve <id|alias> [--evidence <text>] [--approved-by <actor>]
  act <id|alias> [--request-slug <slug>] [--priority high|medium|low]
  implement <id|alias> --verified-against <commit|build>
  deprecate <id|alias> --reason <why>
  archive <id|alias> --reason <why> [--apply --yes]

  <id> [--json]  Compact named-spec overview (state, intent, linked request, next action)

Only a spec whose commit is merged into the configured shared base can create
an implementation request. `approve`/`confirm` remain compatibility commands.
EOF
      ;;
    *) cmd_spec_show "$sub" "$@" ;;
  esac
}

cmd_spec_new() {
  local slug="" summary="" target_version="tbd" afk=false supersedes=""
  while (( $# > 0 )); do
    case "$1" in
      --summary) require_value "--summary" "${2:-}"; summary="$2"; shift 2 ;;
      --target-version) require_value "--target-version" "${2:-}"; target_version="$2"; shift 2 ;;
      --afk) afk=true; shift ;;
      --supersedes) require_value "--supersedes" "${2:-}"; supersedes=$(_canonical_resolve "$2" spec); shift 2 ;;
      -*) die "spec new: unknown flag '$1'" ;;
      *) [[ -z "$slug" ]] || die "spec new: only one slug allowed"; slug="$1"; shift ;;
    esac
  done
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "spec new: slug must be kebab-case"
  [[ -n "$summary" ]] || die "spec new: --summary is required"
  _require_unique_collection_slug specs "$slug" "spec new"
  local id path status=draft old_path="" old_status="" old_archived_from=""
  $afk && status=unconfirmed
  if [[ -n "$supersedes" ]]; then
    old_path=$(_spec_find "$supersedes") || die "spec new: superseded spec '$supersedes' not found"
    old_status=$(fm_get "$old_path" status); old_archived_from=$(fm_get "$old_path" archived_from)
    [[ "$old_status" == implemented || ( "$old_status" == archived && ( "$old_archived_from" == implemented || "$old_archived_from" == superseded ) ) ]] || \
      die "spec new: $supersedes must be an implemented live/archive predecessor"
  fi
  mkdir -p "$SPEC_SPECS_DIR"
  id=$(_uuidv7)
  path="$SPEC_SPECS_DIR/$slug.md"
  [[ ! -e "$path" ]] || die "spec new: target exists: $path"
  cat > "$path" <<EOF
---
id: $id
slug: $slug
kind: spec
scope: project
status: $status
target_version: "$target_version"
supersedes: "${supersedes}"
updated: $TODAY
summary: "$summary"
related: []
references: []
---

# $summary

## Intent

_(What outcome should exist?)_

## Requirements

- _(fill in)_

## Evidence and decisions

- _(link DEC/QUE/RES/SPK records)_

## Confirmation

$status — not eligible for implementation until explicitly approved.
EOF
  created "$path"
  info "  → $id is $status"
}

cmd_spec_list() {
  local filter=all f id status target updated summary count=0
  while (( $# > 0 )); do
    case "$1" in --status) require_value "--status" "${2:-}"; filter="$2"; shift 2 ;; *) die "spec list: unknown option '$1'" ;; esac
  done
  printf '%-10s  %-12s  %-20s  %-10s  %s\n' "ID" "STATUS" "TARGET" "UPDATED" "SUMMARY"
  printf '%-10s  %-12s  %-20s  %-10s  %s\n' "--" "------" "------" "-------" "-------"
  while IFS= read -r f; do
    [[ "$(basename "$f")" == index.md ]] && continue
    id=$(fm_get "$f" id); _is_uuidv7 "$id" || [[ "$id" == SPC-* ]] || continue
    status=$(fm_get "$f" status); [[ "$filter" == all || "$filter" == "$status" ]] || continue
    target=$(fm_get "$f" target_version); updated=$(fm_get "$f" updated); summary=$(fm_get "$f" summary)
    printf '%-10s  %-12s  %-20s  %-10s  %s\n' "$id" "$status" "$target" "$updated" "$summary"
    count=$((count + 1))
  done < <(_iter_md specs)
  (( count > 0 )) || info "(no specifications match)"
}

# Read-only named specification view. Mirrors `request <slug>`: frontmatter
# first, one Intent line, linked live request, and a safe next action.
cmd_spec_show() {
  local ref="$1"; shift
  local json=false
  while (( $# > 0 )); do
    case "$1" in --json) json=true; shift ;; *) die "spec: unknown option '$1' (use: spec <id> [--json])" ;; esac
  done
  local path id status summary target intent linked="" f command reason kind
  path=$(_spec_find "$ref") || die "spec: '$ref' not found"
  id=$(fm_get "$path" id); status=$(fm_get "$path" status); summary=$(fm_get "$path" summary)
  target=$(fm_get "$path" target_version)
  intent=$(awk '/^## Intent[[:space:]]*$/{inside=1;next} inside && /^## /{exit} inside && NF && !/^_\(/{print;exit}' "$path")
  while IFS= read -r f; do
    [[ "$(fm_get "$f" contract)" == "$id" || "$(fm_get "$f" source_spec)" == "$id" ]] || continue
    linked=$(basename "$(dirname "$f")"); break
  done < <(_request_iter_all)
  case "$status" in
    draft|unconfirmed)
      if _contract_is_merged "$path"; then
        kind=act_spec; command="/spectacular act $id"; reason="merged contract can authorize one request"
      else
        kind=review_spec; command="/spectacular review spec $id"; reason="contract is not yet merged into $(_contract_shared_base)"
      fi ;;
    approved)
      kind=act_spec; command="/spectacular act $id"; reason="approved specification can authorize one request" ;;
    implemented|superseded|deprecated)
      kind=archive_spec; command="spectacular spec archive $id --reason <why>"; reason="historical specification is ready for archive review" ;;
    archived)
      kind=none; command=""; reason="specification is archived history" ;;
    *)
      kind=inspect_spec; command="/spectacular review spec $id"; reason="unknown lifecycle state needs review" ;;
  esac
  if $json; then
    printf '{"schema":"spectacular.spec.v1","id":"%s","status":"%s","summary":"%s","target_version":"%s","intent":"%s","linked_request":"%s","next_action":{"kind":"%s","command":"%s","reason":"%s"}}\n' \
      "$(_json_escape "$id")" "$(_json_escape "$status")" "$(_json_escape "$summary")" "$(_json_escape "$target")" \
      "$(_json_escape "$intent")" "$(_json_escape "$linked")" "$(_json_escape "$kind")" \
      "$(_json_escape "$command")" "$(_json_escape "$reason")"
  else
    printf "┌─ %s · %s\n" "$id" "$status"
    [[ -n "$summary" ]] && printf "│ summary    %s\n" "$summary"
    [[ -n "$intent" ]] && printf "│ intent     %s\n" "$intent"
    [[ -n "$target" ]] && printf "│ target     %s\n" "$target"
    [[ -n "$linked" ]] && printf "│ request    %s\n" "$linked"
    [[ -n "$command" ]] && printf "│ next       %s\n" "$command"
    printf "└─\n"
  fi
}

cmd_spec_approve() {
  local invoked_as="$1"; shift
  local ref="" evidence="" target="" approved_by="user"
  while (( $# > 0 )); do
    case "$1" in
      --evidence) require_value "--evidence" "${2:-}"; evidence="$2"; shift 2 ;;
      --target-version) require_value "--target-version" "${2:-}"; target="$2"; shift 2 ;;
      --approved-by) require_value "--approved-by" "${2:-}"; approved_by="$2"; shift 2 ;;
      -*) die "spec approve: unknown flag '$1'" ;;
      *) [[ -z "$ref" ]] || die "spec approve: only one reference allowed"; ref="$1"; shift ;;
    esac
  done
  [[ -n "$ref" ]] || die "Usage: spectacular spec approve <id|alias> [--evidence <text>] [--approved-by <actor>]"
  local path id status
  path=$(_spec_find "$ref") || die "spec approve: '$ref' not found"
  id=$(fm_get "$path" id); status=$(fm_get "$path" status)
  [[ "$status" == unconfirmed || "$status" == draft ]] || die "spec approve: $id is '$status', expected draft or unconfirmed"
  cmd_snapshot "$path"
  fm_set "$path" status approved
  [[ -n "$(fm_get "$path" version)" ]] || fm_set "$path" version "1.0"
  fm_set "$path" approved_at "$TODAY"
  fm_set "$path" approved_by "$approved_by"
  [[ -n "$target" ]] && fm_set "$path" target_version "$target"
  fm_touch "$path"
  printf '\n**Approved %s by %s**%s\n' "$TODAY" "$approved_by" "${evidence:+ — $evidence}" >> "$path"
  [[ "$invoked_as" == confirm ]] && warn "'spec confirm' is a compatibility alias; use 'spec approve'"
  info "  ✓  $id: $status → approved"
}

cmd_spec_act() {
  local ref="" request_slug="" priority=medium
  while (( $# > 0 )); do
    case "$1" in
      --request-slug) require_value "--request-slug" "${2:-}"; request_slug="$2"; shift 2 ;;
      --priority) require_value "--priority" "${2:-}"; priority="$2"; shift 2 ;;
      -*) die "spec act: unknown flag '$1'" ;;
      *) [[ -z "$ref" ]] || die "spec act: only one reference allowed"; ref="$1"; shift ;;
    esac
  done
  [[ -n "$ref" ]] || die "Usage: spectacular spec act <id|alias> [--request-slug <slug>]"
  local path id status
  path=$(_spec_find "$ref") || die "spec act: '$ref' not found"
  id=$(fm_get "$path" id); status=$(fm_get "$path" status)
  if [[ "$status" != approved ]] && ! _contract_is_merged "$path"; then
    die "spec act: $id is '$status' and its contract commit is not merged into $(_contract_shared_base)"
  fi
  warn "'spectacular spec act' is now an agentic flow; terminal execution does not create or activate a request"
  local -a forwarded=()
  [[ -n "$request_slug" ]] && forwarded+=(--request-slug "$request_slug")
  [[ "$priority" != medium ]] && forwarded+=(--priority "$priority")
  skill_verb_message "act $id" \
    "Authorize implementation — find or create exactly one request, run HITL and blocker gates, record activation provenance, compile --brief, initialize native planning, and begin production work." \
    "${forwarded[@]+${forwarded[@]}}"
}

_request_docs_impact_closed() {
  local plan="$1" impact reason evidence
  impact=$(fm_get "$plan" docs_impact)
  reason=$(fm_get "$plan" docs_impact_reason)
  evidence=$(fm_get "$plan" docs_impact_evidence)
  case "$impact" in
    none) [[ -n "$reason" ]] ;;
    required) [[ -n "$evidence" ]] ;;
    *) return 1 ;;
  esac
}

_request_docs_impact_is_heavy() {
  local plan="$1" priority source
  priority=$(fm_get "$plan" priority); source=$(fm_get "$plan" contract); [[ -n "$source" ]] || source=$(fm_get "$plan" source_spec)
  [[ "$priority" == high || -n "$source" ]]
}

cmd_docs_impact() {
  local slug="${1:-}" mode="" reason="" evidence=""
  [[ -n "$slug" ]] || die "Usage: spectacular docs-impact <request> --none --reason <why> | --required --evidence <update|handoff>"
  shift || true
  while (( $# > 0 )); do
    case "$1" in
      --none) mode=none; shift ;;
      --required) mode=required; shift ;;
      --reason) require_value "$1" "${2:-}"; reason="$2"; shift 2 ;;
      --evidence) require_value "$1" "${2:-}"; evidence="$2"; shift 2 ;;
      *) die "docs-impact: unknown option '$1'" ;;
    esac
  done
  local plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md"
  [[ -f "$plan" ]] || die "docs-impact: request '$slug' not found"
  case "$mode" in
    none) [[ -n "$reason" ]] || die "docs-impact: --none requires --reason" ;;
    required) [[ -n "$evidence" ]] || die "docs-impact: --required requires --evidence" ;;
    *) die "docs-impact: choose exactly one of --none or --required" ;;
  esac
  fm_set "$plan" docs_impact "$mode"
  if [[ "$mode" == none ]]; then fm_set "$plan" docs_impact_reason "$reason"; fm_unset "$plan" docs_impact_evidence
  else fm_set "$plan" docs_impact_evidence "$evidence"; fm_unset "$plan" docs_impact_reason; fi
  fm_touch "$plan"
  info "  ✓ $slug docs impact: $mode"
}

cmd_spec_implement() {
  local ref="" verified_against=""
  while (( $# > 0 )); do
    case "$1" in
      --verified-against) require_value "$1" "${2:-}"; verified_against="$2"; shift 2 ;;
      -*) die "spec implement: unknown flag '$1'" ;;
      *) [[ -z "$ref" ]] || die "spec implement: only one reference allowed"; ref="$1"; shift ;;
    esac
  done
  [[ -n "$ref" && -n "$verified_against" ]] || die "Usage: spectacular spec implement <id|alias> --verified-against <commit|build>"
  local path id status plan linked=0 supersedes old_path old_status old_archived_from
  path=$(_spec_find "$ref") || die "spec implement: '$ref' not found"
  id=$(fm_get "$path" id); status=$(fm_get "$path" status)
  if [[ "$status" != approved ]] && ! _contract_is_merged "$path"; then
    die "spec implement: $id is '$status' and its contract commit is not merged into $(_contract_shared_base)"
  fi
  for plan in "$SPEC_REQUESTS_DIR"/*/PLAN.md "$SPEC_ARCHIVE_DIR"/*/PLAN.md; do
    [[ -f "$plan" ]] || continue
    [[ "$(fm_get "$plan" contract)" == "$id" || "$(fm_get "$plan" source_spec)" == "$id" ]] || continue
    linked=$((linked + 1))
    case "$(fm_get "$plan" status)" in verified|archived) ;; *) die "spec implement: linked request $(basename "$(dirname "$plan")") is not verified/archived" ;; esac
    _request_docs_impact_closed "$plan" || die "spec implement: linked request $(basename "$(dirname "$plan")") has unresolved docs impact"
  done
  (( linked > 0 )) || die "spec implement: $id has no linked implementation request"
  supersedes=$(fm_get "$path" supersedes)
  if [[ -n "$supersedes" ]]; then
    old_path=$(_spec_find "$supersedes") || die "spec implement: superseded spec $supersedes not found"
    old_status=$(fm_get "$old_path" status); old_archived_from=$(fm_get "$old_path" archived_from)
    [[ "$old_status" == implemented || ( "$old_status" == archived && ( "$old_archived_from" == implemented || "$old_archived_from" == superseded ) ) ]] || \
      die "spec implement: $supersedes must be implemented (live or archived) before replacement"
  fi
  cmd_snapshot "$path" >/dev/null
  [[ -n "$old_path" && "$old_status" == implemented ]] && cmd_snapshot "$old_path" >/dev/null
  fm_set "$path" status implemented
  fm_set "$path" implemented_at "$TODAY"
  fm_set "$path" verified_against "$verified_against"
  fm_touch "$path"
  if [[ -n "$old_path" && "$old_status" == implemented ]]; then
    fm_set "$old_path" status superseded
    fm_set "$old_path" superseded_by "$id"
    fm_touch "$old_path"
    info "  ↔ $supersedes: implemented → superseded"
  elif [[ -n "$old_path" ]]; then
    info "  ↔ $supersedes: archived implemented predecessor linked (left immutable)"
  fi
  info "  ✓ $id: approved → implemented (verified against $verified_against)"
}

cmd_spec_deprecate() {
  local ref="" reason=""
  while (( $# > 0 )); do case "$1" in --reason) require_value "$1" "${2:-}"; reason="$2"; shift 2 ;; -*) die "spec deprecate: unknown flag '$1'" ;; *) [[ -z "$ref" ]] || die "spec deprecate: only one reference allowed"; ref="$1"; shift ;; esac; done
  [[ -n "$ref" && -n "$reason" ]] || die "Usage: spectacular spec deprecate <id|alias> --reason <why>"
  local path id status
  path=$(_spec_find "$ref") || die "spec deprecate: '$ref' not found"; id=$(fm_get "$path" id); status=$(fm_get "$path" status)
  [[ "$status" == implemented ]] || die "spec deprecate: $id is '$status', expected implemented"
  cmd_snapshot "$path" >/dev/null; fm_set "$path" status deprecated; fm_set "$path" deprecated_at "$TODAY"; fm_set "$path" deprecation_reason "$reason"; fm_touch "$path"
  info "  ✓ $id: implemented → deprecated"
}

cmd_spec_archive() {
  local ref="" reason="" apply=false yes=false
  while (( $# > 0 )); do case "$1" in --reason) require_value "$1" "${2:-}"; reason="$2"; shift 2 ;; --apply) apply=true; shift ;; --yes) yes=true; shift ;; -*) die "spec archive: unknown flag '$1'" ;; *) [[ -z "$ref" ]] || die "spec archive: only one reference allowed"; ref="$1"; shift ;; esac; done
  [[ -n "$ref" && -n "$reason" ]] || die "Usage: spectacular spec archive <id|alias> --reason <why> [--apply --yes]"
  local path id status destination
  path=$(_spec_find "$ref") || die "spec archive: '$ref' not found"; id=$(fm_get "$path" id); status=$(fm_get "$path" status)
  case "$status" in
    draft|unconfirmed|approved|implemented|superseded|deprecated) ;;
    archived) die "spec archive: $id is already archived" ;;
    *) die "spec archive: $id is '$status'; expected draft, unconfirmed, approved, implemented, superseded, or deprecated" ;;
  esac
  [[ "$status" != implemented || -n "$(fm_get "$path" verified_against)" ]] || die "spec archive: implemented $id lacks verified_against evidence"
  destination="$SPEC_ARCHIVE_DIR/specs/$(basename "$path")"
  info "Archive plan: $path → $destination (reason: $reason)"
  $apply || { info "Dry-run only. Apply with --apply --yes"; return 0; }
  $yes || die "spec archive: --apply requires --yes"
  cmd_snapshot "$path" >/dev/null; fm_set "$path" archived_from "$status"; fm_set "$path" status archived; fm_set "$path" archived_at "$TODAY"; fm_set "$path" archive_reason "$reason"; fm_touch "$path"
  mkdir -p "$SPEC_ARCHIVE_DIR/specs"; mv "$path" "$destination"
  info "  ✓ archived $id; explicit historical lookup: $destination"
}

# ── cmd_decisions_migrate: spectacular decisions migrate ─────────────────────
# v1.17.0: split flat DECISIONS.md into index mode.
cmd_decisions_migrate() {
  local dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular decisions migrate [--dry-run]

Split a flat .spectacular/DECISIONS.md into index mode:
  - Extracts each "## YYYY-MM-DD — Title" block into decisions/D<N>.md
  - Rewrites DECISIONS.md as a one-liner index (one line per decision)

Safe: per-entry files are written before DECISIONS.md is rewritten.
Idempotent: exits 0 if decisions/ already exists.

  --dry-run   Preview would-write paths and index; write nothing.
EOF
        exit 0 ;;
      *) die "Unknown flag for decisions migrate: $1" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "decisions migrate: not inside a Spectacular workspace"

  local decisions="$SPEC_WORKSPACE_DIR/DECISIONS.md"
  local decisions_dir="$SPEC_DECISIONS_DIR"

  # Idempotent: already migrated
  if [[ -d "$decisions_dir" ]]; then
    info "  ✓  already in index mode ($decisions_dir exists) — nothing to do"
    return 0
  fi

  [[ -f "$decisions" ]] || die "decisions migrate: $decisions not found — nothing to migrate"

  # Parse flat DECISIONS.md: split on "## YYYY-MM-DD —" heading lines.
  # Accumulate blocks, write D<N>.md per block.
  # Skip the YAML frontmatter (first --- ... --- block) then parse entries.
  local block_title="" block_lines=""
  local -a titles=() blocks=()

  # Strip frontmatter first (awk: skip from line 1 "---" to the closing "---")
  local body
  if head -1 "$decisions" | grep -q '^---$'; then
    body=$(awk 'NR==1{next} /^---$/ && NR>1 {found=1; next} found{print}' "$decisions")
  else
    body=$(cat "$decisions")
  fi

  local line
  while IFS= read -r line; do
    # Detect a new decision block heading: ## YYYY-MM-DD — ... or ## YYYY-MM-DD
    if [[ "$line" =~ ^##[[:space:]]+[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
      # Save previous block if any
      if [[ -n "$block_title" ]]; then
        titles+=("$block_title")
        blocks+=("$block_lines")
      fi
      # Extract title: everything after "## YYYY-MM-DD — " (or just the date)
      local heading="${line#\#\# }"
      if [[ "$heading" =~ [[:space:]]—[[:space:]] ]]; then
        block_title="${heading#*— }"
      else
        block_title="$heading"
      fi
      block_lines=""
      continue
    fi

    # Skip the top-level "# Decisions" heading
    [[ "$line" =~ ^#[[:space:]] && -z "$block_title" ]] && continue

    # Accumulate body lines for the current block
    if [[ -n "$block_title" ]]; then
      block_lines+="${line}"$'\n'
    fi
  done <<< "$body"

  # Flush final block
  if [[ -n "$block_title" ]]; then
    titles+=("$block_title")
    blocks+=("$block_lines")
  fi

  local total=${#titles[@]}
  if [[ $total -eq 0 ]]; then
    die "decisions migrate: no '## YYYY-MM-DD' blocks found in $decisions — nothing to migrate"
  fi

  if $dry_run; then
    echo "── dry-run: would create $decisions_dir/ with $total entries ──"
    local i
    for ((i=0; i<total; i++)); do
      local dnum="D$((i+1))"
      local dslug; dslug=$(_slug_from_text "${titles[$i]}")
      echo "  would write: ${decisions_dir}/${dnum}-${dslug}.md  (${titles[$i]})"
    done
    echo ""
    echo "── dry-run: would write ${decisions_dir}/index.md as index and remove $decisions ──"
    for ((i=0; i<total; i++)); do
      local dnum="D$((i+1))"
      echo "- **${dnum}** — ${titles[$i]}"
    done
    return 0
  fi

  # Write per-entry files (all before touching index — no data loss on partial run)
  mkdir -p "$decisions_dir"
  local i
  for ((i=0; i<total; i++)); do
    local dnum="D$((i+1))"
    local dslug; dslug=$(_slug_from_text "${titles[$i]}")
    local entry_path="${decisions_dir}/${dnum}-${dslug}.md"
    local body="${blocks[$i]}"
    # Strip leading/trailing blank lines from body
    body=$(printf '%s' "$body" | sed -e '/./,$!d' -e 's/[[:space:]]*$//')
    printf '# %s — %s\n\n%s\n' "$dnum" "${titles[$i]}" "$body" > "$entry_path"
    created "$entry_path"
  done

  # Now write index
  local target_index="${decisions_dir}/index.md"
  {
    cat <<FM
---
type: decisions
doc: decisions
mode: index
updated: $TODAY
---

FM
    echo "# Decisions"
    echo ""
    for ((i=0; i<total; i++)); do
      local dnum="D$((i+1))"
      echo "- **${dnum}** — ${titles[$i]}"
    done
  } > "${target_index}.tmp.$$" && mv "${target_index}.tmp.$$" "$target_index"

  fm_touch "$target_index"
  rm -f "$decisions"
  info "  ✓  migrated $total decisions to index mode"
  info "  ↳  full entries in: $decisions_dir/"
  info "  ↳  index: $target_index"
  info "  ↳  removed flat file: $decisions"
}

# ── cmd_session: spectacular session start|end ──────────────────────────────
cmd_session() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    start) cmd_session_start "$@" ;;
    end)   cmd_session_end "$@" ;;
    ""|--help|-h)
      cat <<EOF
Usage: spectacular session <subcommand> [options]

Subcommands:
  start [--tag a,b]    Open a new session entry in .spectacular/sessions/
  end                  Close the currently-open session; recompute linked counts

At most one session can be open at a time.
EOF
      [[ -z "$sub" ]] && exit 1 || exit 0 ;;
    *) die "session: unknown subcommand '$sub'. Use: start | end" ;;
  esac
}

cmd_session_start() {
  local tags_csv="" dry_run=false notes=""
  while (( $# > 0 )); do
    case "$1" in
      --tag|--tags) require_value "--tag" "${2:-}"; tags_csv="$2"; shift 2 ;;
      --notes)      require_value "--notes" "${2:-}"; notes="$2"; shift 2 ;;
      --dry-run)    dry_run=true; shift ;;
      *) die "Unknown flag for session start: $1" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "session start: not inside a Spectacular workspace"

  local existing
  existing=$(_active_session_slug)
  if [[ -n "$existing" ]]; then
    die "session start: a session is already open ($existing). Run 'spectacular session end' first."
  fi

  local first_tag base_slug slug entry_dir entry_path
  first_tag=$(echo "$tags_csv" | cut -d',' -f1 | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
  base_slug="${TODAY}-${first_tag:-work}"
  # Sanitize the tag part
  base_slug=$(echo "$base_slug" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/-+/-/g; s/-$//')
  entry_dir="$SPEC_SESSIONS_DIR"
  mkdir -p "$entry_dir"
  slug=$(_resolve_slug_collision "$entry_dir" "$base_slug" "md")
  entry_path="$entry_dir/$slug.md"

  local tags_yaml="[]"
  [[ -n "$tags_csv" ]] && tags_yaml="[$(echo "$tags_csv" | sed 's/,/, /g')]"

  local start_ts summary
  start_ts=$(date +%Y-%m-%dT%H:%M:%S)
  summary="${notes:-Session $slug}"

  local template rendered
  template=$(_resolve_template "sessions/entry.md") || die_recover \
    "session start: template not found" \
    "Create .spectacular/sessions/<YYYY-MM-DD-slug>.md with frontmatter:" \
    "  type: session / status: open / started: $TODAY" \
    "then 'spectacular session end' will close it as usual."
  rendered=$(_render_template "$template" \
    START_DATE "$start_ts" \
    TAGS "$tags_yaml" \
    SUMMARY "$summary" \
    SLUG "$slug" \
    NOTES "${notes:-_(session in progress)_}")

  if $dry_run; then
    echo "── would write $entry_path ──"
    echo "$rendered"
    return 0
  fi

  echo "$rendered" > "$entry_path"
  created "$entry_path"
  _regen_sessions_index
  info "  ✓  SESSIONS.md regenerated"
  info "  → session open: $slug"
  if [[ -d "$SPEC_QUESTIONS_DIR" ]]; then
    info ""
    cmd_wayfind status --blockers-only
  fi
}

_session_git_commit_review() {
  command -v git >/dev/null 2>&1 || {
    info "  Git commit review unavailable: git is not installed."
    return 0
  }
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    info "  Git commit review unavailable: not inside a Git repository."
    return 0
  }

  local branch line x y path request_paths="" other_paths=""
  local staged=0 unstaged=0 untracked=0
  branch=$(git branch --show-current 2>/dev/null)
  [[ -n "$branch" ]] || branch="(detached HEAD)"

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    x=${line:0:1}; y=${line:1:1}; path=${line:3}
    if [[ "$x$y" == "??" ]]; then
      untracked=$((untracked + 1))
    else
      [[ "$x" != " " ]] && staged=$((staged + 1))
      [[ "$y" != " " ]] && unstaged=$((unstaged + 1))
    fi
    case "$path" in
      .spectacular/requests/*) request_paths="${request_paths}${request_paths:+\n}    $path" ;;
      *) other_paths="${other_paths}${other_paths:+\n}    $path" ;;
    esac
  done < <(git status --porcelain --untracked-files=all)

  info ""
  info "── Git commit review (read-only) ──"
  info "  Branch: $branch"
  if [[ $staged -eq 0 && $unstaged -eq 0 && $untracked -eq 0 ]]; then
    info "  Working tree: clean; no commit proposal."
    return 0
  fi

  info "  Staged files: $staged"
  info "  Unstaged files: $unstaged"
  info "  Untracked files: $untracked"
  info "  Changed files:"
  git status --short --untracked-files=all | sed 's/^/    /'
  if [[ -n "$request_paths" ]]; then
    info "  Request-owned paths (direct folder match only):"
    printf '%b\n' "$request_paths"
  fi
  if [[ -n "$other_paths" ]]; then
    info "  Other paths (no ownership inferred):"
    printf '%b\n' "$other_paths"
  fi
  if [[ $staged -gt 0 ]]; then
    info "  Staged diffstat:"
    git diff --cached --stat | sed 's/^/    /'
  fi
  if [[ $unstaged -gt 0 ]]; then
    info "  Unstaged diffstat:"
    git diff --stat | sed 's/^/    /'
  fi
  if [[ $untracked -gt 0 ]]; then
    info "  Untracked files have no diffstat until staged."
  fi

  info "Suggested, human must verify:"
  info "  Spectacular cannot determine whether these changes are one commit or several."
  info "  Review: git diff --cached && git diff && git status --short"
  info "  Select hunks if needed: git add -p"
  info "  Commit after review: git commit -m \"<human-verified conventional message>\""
  info "  Spectacular did not stage, commit, amend, push, merge, reset, or stash."
}

cmd_session_end() {
  local dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      *) die "Unknown flag for session end: $1" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "session end: not inside a Spectacular workspace"

  local slug entry_path
  slug=$(_active_session_slug)
  [[ -z "$slug" ]] && die "session end: no open session found"
  entry_path="$SPEC_SESSIONS_DIR/$slug.md"

  # Count linked decisions: scan flat DECISIONS.md for matching session reference
  # (v1.5.0 — flat decisions; folder shape lands in v1.6.x)
  local decisions_count=0
  if [[ -f "$SPEC_WORKSPACE_DIR/DECISIONS.md" ]]; then
    decisions_count=$(grep -c "\[\[sessions/$slug\]\]" "$SPEC_WORKSPACE_DIR/DECISIONS.md" || true)
  fi

  # Count linked memories: scan memories/*.md frontmatter for session: $slug
  local memories_count=0
  local mfile msession
  if [[ -d "$SPEC_MEMORIES_DIR" ]]; then
    for mfile in "$SPEC_MEMORIES_DIR"/*.md; do
      [[ -f "$mfile" ]] || continue
      msession=$(fm_get "$mfile" "session")
      [[ "$msession" == "$slug" ]] && memories_count=$((memories_count + 1))
    done
  fi

  local end_ts
  end_ts=$(date +%Y-%m-%dT%H:%M:%S)

  if $dry_run; then
    echo "── would close $entry_path ──"
    echo "   status: open → closed"
    echo "   end_date: $end_ts"
    echo "   decisions_count: $decisions_count"
    echo "   memories_count: $memories_count"
    _session_git_commit_review
    return 0
  fi

  # Review before writing the closed-session record so this command's own
  # metadata updates never appear as user changes or a commit suggestion.
  _session_git_commit_review

  fm_set "$entry_path" "status" "closed"
  fm_set "$entry_path" "end_date" "$end_ts"
  fm_set "$entry_path" "decisions_count" "$decisions_count"
  fm_set "$entry_path" "memories_count" "$memories_count"

  # Append "Linked decisions" + "Linked memories" lists to the body.
  # grep pipelines are wrapped with `|| true` so empty matches don't trip pipefail.
  {
    echo ""
    echo "## Linked decisions"
    echo ""
    if [[ $decisions_count -gt 0 ]]; then
      # Scan DECISIONS.md for ADR blocks (## headers) containing the session
      # reference anywhere in their body, emit each matched title as a bullet.
      awk -v slug="$slug" '
        /^## / {
          if (matched && title != "") print "- " title
          title = $0
          sub(/^## /, "", title)
          matched = 0
          next
        }
        index($0, "[[sessions/" slug "]]") { matched = 1 }
        END { if (matched && title != "") print "- " title }
      ' "$SPEC_WORKSPACE_DIR/DECISIONS.md"
    else
      echo "_(none)_"
    fi
    echo ""
    echo "## Linked memories"
    echo ""
    if [[ $memories_count -gt 0 ]]; then
      for mfile in "$SPEC_MEMORIES_DIR"/*.md; do
        [[ -f "$mfile" ]] || continue
        msession=$(fm_get "$mfile" "session")
        [[ "$msession" == "$slug" ]] || continue
        echo "- [[memories/$(basename "$mfile" .md)]]"
      done
    else
      echo "_(none)_"
    fi
  } >> "$entry_path"

  _regen_sessions_index
  info "  ✓  session closed: $slug (${decisions_count} decisions, ${memories_count} memories)"
  local pending_docs=0 plan
  for plan in "$SPEC_REQUESTS_DIR"/*/PLAN.md; do
    [[ -f "$plan" ]] || continue
    case "$(fm_get "$plan" status)" in active|review) ;; *) continue ;; esac
    _request_docs_impact_closed "$plan" || pending_docs=$((pending_docs + 1))
  done
  (( pending_docs == 0 )) || info "  ⚠ docs-impact assessment pending for $pending_docs active/review request(s)"
}

# Return 0 if file is a registered canonical doc (eligible for snapshot).
# Per ARCHITECTURE.md § Versioning + versioning.md.
is_canonical_doc() {
  local file="$1"
  local base
  base=$(basename "$file")
  local dir
  dir=$(dirname "$file")
  dir="${dir#./}"

  # Legacy and OKF root docs
  if [[ "$dir" == "$SPEC_WORKSPACE_DIR" ]]; then
    case "$base" in
      PRD.md|ARCHITECTURE.md|PRINCIPLES.md|STACK.md|AGENTS.md|DESIGN.md|POLICY.md|config.yaml|PERSONAS.md|SPEC.md|ROADMAP.md|DECISIONS.md|MEMORY.md|SESSIONS.md)
        return 0
        ;;
      *) return 1 ;;
    esac
  elif [[ "$dir" == "$SPEC_SPECS_DIR" ]] || [[ "$dir" == "$SPEC_ROADMAPS_DIR" ]] || [[ "$dir" == "$SPEC_DECISIONS_DIR" ]] || [[ "$dir" == "$SPEC_MEMORIES_DIR" ]] || [[ "$dir" == "$SPEC_SESSIONS_DIR" ]]; then
    return 0
  elif [[ "$dir" == "$SPEC_SPECS_DIR/"* ]]; then
    # Legacy capability subfolders (e.g. specs/auth/SPEC.md)
    if [[ "$base" == "SPEC.md" ]]; then
      return 0
    fi
  elif [[ "$dir" == "$SPEC_WORKSPACE_DIR/roadmap" ]] || [[ "$dir" == "$SPEC_WORKSPACE_DIR/memory" ]] || [[ "$dir" == "$SPEC_WORKSPACE_DIR/session" ]]; then
    # Legacy folders
    return 0
  fi
  return 1
}

# Diagnoses path errors for touch / snapshot commands.
# Returns type classification on stdout line 1, and suggested path on line 2.
# Usage: diagnose_path_error <verb> <provided_path>
diagnose_path_error() {
  local verb="$1"
  local file="$2"
  local clean_file="${file%/}"

  # 1. Prefix missing check
  if [[ -f "$SPEC_WORKSPACE_DIR/$clean_file" ]]; then
    local suggested="$SPEC_WORKSPACE_DIR/$clean_file"
    if [[ "$verb" == "snapshot" ]] && ! is_canonical_doc "$suggested"; then
      if [[ "$suggested" == "$SPEC_REQUESTS_DIR"/*/PLAN.md ]]; then
        echo "not-eligible-request"
        echo "$suggested"
      else
        echo "not-eligible-other"
        echo "$suggested"
      fi
    else
      echo "prefix-missing"
      echo "$suggested"
    fi
    return 0
  fi

  # 2. Slug check (e.g., requests/slug, slug)
  local slug=""
  local p1='^requests/([^/]+)/PLAN$'
  local p2='^requests/([^/]+)/PLAN\.md$'
  local p3='^requests/([^/]+)$'
  local p4='^([^/]+)/PLAN$'
  local p5='^([^/]+)/PLAN\.md$'
  local p6='^([^/]+)$'

  if [[ "$clean_file" =~ $p1 ]] || [[ "$clean_file" =~ $p2 ]] || [[ "$clean_file" =~ $p3 ]]; then
    slug="${BASH_REMATCH[1]}"
  elif [[ "$clean_file" =~ $p4 ]] || [[ "$clean_file" =~ $p5 ]]; then
    slug="${BASH_REMATCH[1]}"
  elif [[ "$clean_file" =~ $p6 ]]; then
    if [[ -d "$SPEC_REQUESTS_DIR/$clean_file" ]] || [[ -d "requests/$clean_file" ]]; then
      slug="$clean_file"
    fi
  fi

  if [[ -n "$slug" ]]; then
    local plan_candidate=""
    if [[ -f "$SPEC_REQUESTS_DIR/$slug/PLAN.md" ]]; then
      plan_candidate="$SPEC_REQUESTS_DIR/$slug/PLAN.md"
    elif [[ -f "requests/$slug/PLAN.md" ]]; then
      plan_candidate="requests/$slug/PLAN.md"
    fi

    if [[ -n "$plan_candidate" ]]; then
      if [[ "$verb" == "snapshot" ]]; then
        echo "not-eligible-request"
        echo "$plan_candidate"
      else
        echo "slug-to-plan"
        echo "$plan_candidate"
      fi
      return 0
    fi
  fi

  return 1
}

# ── config.yaml parsers ───────────────────────────────────────────────────────
# Read workspace_schema: top-level key from .spectacular/config.yaml.
# Stdout: declared schema (e.g. "0.6"); defaults to "0.4" if field absent
# (that's the schema before the first registered migration).
config_workspace_schema() {
  local cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  [[ -f "$cfg" ]] || { echo "0.4"; return 0; }
  local schema
  schema=$(awk -F: '
    /^workspace_schema:/ {
      val=$2
      gsub(/^[[:space:]]*"?/, "", val)
      gsub(/"?[[:space:]]*$/, "", val)
      print val
      exit
    }
  ' "$cfg")
  echo "${schema:-0.4}"
}

# ── snapshots: config block (b16) ─────────────────────────────────────────────
# Reads a key from the `snapshots:` block of .spectacular/config.yaml:
#
#   snapshots:
#     folder: _snapshots   # store dir name        (default _snapshots)
#     keep: 3              # recent-tier count      (default 3)
#     period: month        # periodic tier bucket   (default month; month|week|off)
#     gitignore: false     # gitignore the store?   (default false)
#
# All fields default when the block or the field is absent. Best-effort parse:
# an indented `  <key>: <value>` line under a top-level `snapshots:` key.
config_snapshots_field() {
  local key="$1"
  local cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  [[ -f "$cfg" ]] || return 0
  awk -v key="$key" '
    /^[^[:space:]#]/ { inblock = ($0 ~ /^snapshots:/) ? 1 : 0 }
    inblock && $0 ~ "^[[:space:]]+" key ":" {
      val = $0
      sub("^[[:space:]]+" key ":[[:space:]]*", "", val)
      sub(/[[:space:]]*#.*$/, "", val)          # strip trailing comment
      gsub(/^["'"'"']|["'"'"'][[:space:]]*$/, "", val)
      gsub(/[[:space:]]+$/, "", val)
      print val; exit
    }
  ' "$cfg"
}

config_snapshots_folder() {
  local v; v="$(config_snapshots_field folder)"; echo "${v:-_snapshots}"
}
config_snapshots_keep() {
  local v; v="$(config_snapshots_field keep)"
  [[ "$v" =~ ^[0-9]+$ ]] && echo "$v" || echo 3
}
config_snapshots_period() {
  local v; v="$(config_snapshots_field period)"
  case "$v" in month|week|off) echo "$v" ;; *) echo month ;; esac
}
config_snapshots_gitignore() {
  local v; v="$(config_snapshots_field gitignore)"
  [[ "$v" == "true" ]] && echo true || echo false
}

# ── feedback-loop (v1.6.0+) ──────────────────────────────────────────────────
# `spectacular feedback-loop <subverb> ...` — prototyping-mode human-feedback
# acquisition. NOT a benchmark/eval harness. See references/feedback-loop.md.
#
# Subverbs:
#   new <target>           Scaffold a new feedback entry (status: open)
#   list [--status <s>]    List entries (default: all)
#   resolve <slug>         Close an entry with a decision
#   archive <slug>         Move entry to .spectacular/archive/feedback/<year>/
#
# Hidden aliases (top-level dispatch routes them here): iterate, experiment,
# test, probe, try. Not documented in --help.
cmd_feedback_loop() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    new)     cmd_feedback_loop_new "$@" ;;
    list)    cmd_feedback_loop_list "$@" ;;
    resolve) cmd_feedback_loop_resolve "$@" ;;
    archive) cmd_feedback_loop_archive "$@" ;;
    ""|--help|-h)
      cat <<'EOF'
Usage: spectacular feedback <subcommand> [options]

Subcommands:
  new <target>              Scaffold a feedback entry (status: open). Optional:
                              --request <slug>   Scope to a request
                              --scope <s>        skill|substrate|convention|doc-type|request
                              --proposal <text>  One-line proposal summary
  list [--status <s>]       List feedback entries (open|resolved|parked|all)
  resolve <slug>            Close entry. Options:
                              --next-action <a>  ship-as-is|new-request:<slug>|park|memory:<entry>
                              --promote-hint     Print the `spectacular remember` command to promote
  archive <slug>            Move entry to .spectacular/archive/feedback/<year>/

Feedback files live at:
  .spectacular/feedback/<YYYY-MM-DD>-<slug>.md          (system-level)
  .spectacular/requests/<slug>/feedback/<...>.md        (request-scoped, when --request used)

This is a prototyping-mode feedback loop — not a benchmark or verification pass.
See references/feedback-loop.md for the full mode spec.
EOF
      [[ -z "$sub" ]] && exit 1 || exit 0 ;;
    *) die "feedback-loop: unknown subcommand '$sub'. Use: new | list | resolve | archive" ;;
  esac
}

# Resolve the feedback directory for a given (optional) request slug
_feedback_dir() {
  local request="${1:-}"
  if [[ -n "$request" ]]; then
    echo "$SPEC_REQUESTS_DIR/$request/feedbacks"
  else
    echo "$SPEC_WORKSPACE_DIR/feedbacks"
  fi
}

# Walk all feedback locations and emit one path per line
_feedback_iter_all() {
  local f root
  for root in "$SPEC_FEEDBACKS_DIR" "$SPEC_WORKSPACE_DIR/feedback"; do
    [[ -d "$root" ]] || continue
    for f in "$root"/*.md; do
      [[ -f "$f" ]] && echo "$f"
    done
  done
  if [[ -d "$SPEC_REQUESTS_DIR" ]]; then
    local d
    for d in "$SPEC_REQUESTS_DIR"/*/feedbacks; do
      [[ -d "$d" ]] || continue
      for f in "$d"/*.md; do
        [[ -f "$f" ]] && echo "$f"
      done
    done
    for d in "$SPEC_REQUESTS_DIR"/*/feedback; do
      [[ -d "$d" ]] || continue
      for f in "$d"/*.md; do [[ -f "$f" ]] && echo "$f"; done
    done
  fi
}

# Find a feedback entry by slug across all locations. Echoes path or empty.
_feedback_find() {
  local slug="$1" f
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if [[ "$(basename "$f" .md)" == "$slug" ]]; then
      echo "$f"
      return 0
    fi
  done < <(_feedback_iter_all)
  return 1
}

cmd_feedback_loop_new() {
  local target="" request="" scope="skill" proposal="" dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --request)  require_value "--request" "${2:-}"; request="$2"; shift 2 ;;
      --scope)    require_value "--scope" "${2:-}"; scope="$2"; shift 2 ;;
      --proposal) require_value "--proposal" "${2:-}"; proposal="$2"; shift 2 ;;
      --dry-run)  dry_run=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular feedback-loop new <target> [options]

Options:
  --request <slug>     Scope to a request (file lands under requests/<slug>/feedback/)
  --scope <s>          skill|substrate|convention|doc-type|request  (default: skill)
  --proposal <text>    One-line proposal summary (frontmatter)
  --dry-run            Print the rendered entry, don't write
EOF
        exit 0 ;;
      -*) die "Unknown flag for feedback-loop new: $1" ;;
      *)
        if [[ -z "$target" ]]; then target="$1"
        else target="$target $1"
        fi
        shift ;;
    esac
  done

  [[ -z "$target" ]] && die "feedback-loop new: <target> argument required"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "feedback-loop new: not inside a Spectacular workspace"

  if [[ -n "$request" ]]; then
    [[ -d "$SPEC_REQUESTS_DIR/$request" ]] || die "feedback-loop new: request '$request' not found"
  fi

  local valid_scopes="skill substrate convention doc-type request"
  in_list "$scope" "$valid_scopes" || die "feedback-loop new: invalid scope '$scope'. Use: $valid_scopes"

  local entry_dir base_slug slug entry_path
  entry_dir=$(_feedback_dir "$request")
  mkdir -p "$entry_dir"

  local target_slug
  target_slug=$(_slug_from_text "$target")
  [[ -z "$target_slug" ]] && die "feedback-loop new: could not derive slug from target"
  base_slug="${TODAY}-${target_slug}"
  slug=$(_resolve_slug_collision "$entry_dir" "$base_slug" "md")
  entry_path="$entry_dir/$slug.md"

  local request_yaml="null"
  [[ -n "$request" ]] && request_yaml="$request"

  local proposal_text="${proposal:-<one-line summary of the proposal shown to the user>}"

  local template rendered
  template=$(_resolve_template "feedback/entry.md") || die_recover \
    "feedback-loop new: feedback entry template not found" \
    "Create the entry under .spectacular/feedback/ by hand using an existing" \
    "entry as a shape reference, then re-run subsequent feedback-loop steps."
  rendered=$(_render_template "$template" \
    TARGET "$target" \
    SCOPE "$scope" \
    DATE "$TODAY" \
    PROPOSAL_SUMMARY "$proposal_text" \
    REQUEST "$request_yaml" \
    HUNCH "_(starting hypothesis — fill during loop)_" \
    PROPOSAL "_(scenario, variants, artifacts shown to user — fill during loop)_" \
    QUESTION "_(exact question put to user — fill during loop)_" \
    RESPONSE "_(verbatim or tight paraphrase — fill during loop)_" \
    INSIGHT "_(durable lesson — fill during loop)_" \
    DECISION "_(next_action explained — fill during loop)_")

  if $dry_run; then
    echo "── would write $entry_path ──"
    echo "$rendered"
    return 0
  fi

  echo "$rendered" > "$entry_path"
  created "$entry_path"
  info "  → status: open"
  [[ -n "$request" ]] && info "  → scoped to request: $request"
  info "  ↳ run the 5-step loop in /spectacular, then 'spectacular feedback-loop resolve $slug'"
}

cmd_feedback_loop_list() {
  local status_filter="all"
  while (( $# > 0 )); do
    case "$1" in
      --status) require_value "--status" "${2:-}"; status_filter="$2"; shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: spectacular feedback-loop list [--status open|resolved|parked|all]

Lists all feedback entries across .spectacular/feedback/ and
.spectacular/requests/*/feedback/.
EOF
        exit 0 ;;
      *) die "Unknown flag for feedback-loop list: $1" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "feedback-loop list: not inside a Spectacular workspace"

  # Slug carries the date prefix; we drop the DATE column to avoid duplication.
  # Slugs over 32 chars truncate to 29 + "..." to keep columns aligned.
  local count=0 f status target request
  printf "%-32s  %-9s  %-10s  %s\n" "SLUG" "STATUS" "SCOPE" "TARGET"
  printf "%-32s  %-9s  %-10s  %s\n" "----" "------" "-----" "------"

  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    status=$(fm_get "$f" "status")
    [[ -z "$status" ]] && status="?"
    if [[ "$status_filter" != "all" && "$status" != "$status_filter" ]]; then
      continue
    fi
    target=$(fm_get "$f" "target")
    local scope_val
    scope_val=$(fm_get "$f" "scope")
    local slug slug_display
    slug=$(basename "$f" .md)
    if (( ${#slug} > 32 )); then
      slug_display="${slug:0:29}..."
    else
      slug_display="$slug"
    fi
    request=$(fm_get "$f" "request")
    local loc_marker=""
    [[ "$request" != "null" && -n "$request" ]] && loc_marker=" [req:$request]"
    printf "%-32s  %-9s  %-10s  %s%s\n" "$slug_display" "$status" "${scope_val:-?}" "${target:-?}" "$loc_marker"
    count=$((count + 1))
  done < <(_feedback_iter_all)

  if [[ $count -eq 0 ]]; then
    if [[ "$status_filter" == "all" ]]; then
      info "(no feedback entries yet — start one with 'spectacular feedback-loop new <target>')"
    else
      info "(no feedback entries with status: $status_filter)"
    fi
  fi
}

cmd_feedback_loop_resolve() {
  local slug="" next_action="" promote_hint=false
  while (( $# > 0 )); do
    case "$1" in
      --next-action) require_value "--next-action" "${2:-}"; next_action="$2"; shift 2 ;;
      --promote-hint) promote_hint=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular feedback-loop resolve <slug> [options]

Options:
  --next-action <a>    ship-as-is | new-request:<slug> | park | memory:<entry>
  --promote-hint       Print the `spectacular remember` command to promote this
                       resolution to memory. Does NOT auto-write — promotion is
                       a judgment call that requires user-confirmed text. Run
                       the printed command manually after confirming.
EOF
        exit 0 ;;
      -*) die "Unknown flag for feedback-loop resolve: $1" ;;
      *)
        [[ -n "$slug" ]] && die "feedback-loop resolve: only one <slug> argument allowed"
        slug="$1"; shift ;;
    esac
  done

  [[ -z "$slug" ]] && die "feedback-loop resolve: <slug> argument required"
  [[ -z "$next_action" ]] && die "feedback-loop resolve: --next-action required (ship-as-is | new-request:<slug> | park | memory:<entry>)
Resolving without an explicit decision leaves next_action: tbd — that's a smell.
Use 'feedback-loop list' to inspect, or set --next-action park to defer."
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "feedback-loop resolve: not inside a Spectacular workspace"

  local entry_path
  entry_path=$(_feedback_find "$slug") || die "feedback-loop resolve: feedback entry '$slug' not found"

  local current_status
  current_status=$(fm_get "$entry_path" "status")
  [[ "$current_status" == "resolved" ]] && info "  ℹ already resolved — updating frontmatter anyway"

  fm_set "$entry_path" "status" "resolved"
  fm_set "$entry_path" "resolved" "$TODAY"
  fm_set "$entry_path" "next_action" "$next_action"

  created "$entry_path"
  info "  → status: resolved"
  info "  → next_action: $next_action"

  if $promote_hint; then
    info "  ↳ memory promotion: distill the preference and run:"
    info "      spectacular remember \"<preference>\" --tag feedback,$(fm_get "$entry_path" "scope")"
    info "      then: fm_set $entry_path promoted_to memory/<slug>.md"
    # We deliberately do NOT auto-write memory here — promotion requires explicit
    # user-confirmed text per the contract in PRINCIPLES.md § 9.
  fi
}

cmd_feedback_loop_archive() {
  local slug=""
  while (( $# > 0 )); do
    case "$1" in
      --help|-h)
        cat <<EOF
Usage: spectacular feedback-loop archive <slug>

Move a feedback entry to .spectacular/archive/feedback/<year>/<slug>.md.
Use when an entry is no longer actively relevant. Resolved entries do NOT
auto-archive — this is a manual curation verb.
EOF
        exit 0 ;;
      -*) die "Unknown flag for feedback-loop archive: $1" ;;
      *)
        [[ -n "$slug" ]] && die "feedback-loop archive: only one <slug> argument allowed"
        slug="$1"; shift ;;
    esac
  done

  [[ -z "$slug" ]] && die "feedback-loop archive: <slug> argument required"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "feedback-loop archive: not inside a Spectacular workspace"

  local src
  src=$(_feedback_find "$slug") || die "feedback-loop archive: feedback entry '$slug' not found"

  local year archive_dir target
  year=$(date +%Y)
  archive_dir="$SPEC_ARCHIVE_DIR/feedbacks/$year"
  mkdir -p "$archive_dir"
  target="$archive_dir/$(basename "$src")"

  if [[ -e "$target" ]]; then
    die "feedback-loop archive: target already exists: $target"
  fi

  mv "$src" "$target"
  created "$target"
  info "  → archived from $src"
}

# ── idea (v1.7.0+) ───────────────────────────────────────────────────────────
# `spectacular idea new|list|promote <slug>`
# Thinking-scratchpad soft-folder DB. See references/idea-rules.md for spec.
cmd_idea() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    new)     cmd_idea_new "$@" ;;
    list)    cmd_idea_list "$@" ;;
    promote) cmd_idea_promote "$@" ;;
    ""|--help|-h)
      cat <<EOF
Usage: spectacular idea <subcommand> [options]

Subcommands:
  new <slug>                  Scaffold an idea entry at .spectacular/ideas/IDEA-NNN-<slug>.md
                                (status: parked). Optional:
                                  --hypothesis <text>   One-line hypothesis
                                  --origin <text>       Where it came from
                                  --priority <level>    low|medium|high (default: medium)
  list [--status <s>]         List idea entries (parked|exploring|promoted|all)
  promote <slug>              Hand the idea to an explicit destination and move source
                                to archive/ideas/. Options:
                                  --to <destination>    request|roadmap|shared
                                                        (default: request; compatibility)
                                  --request-slug <s>    Override request slug
                                                        (default: idea's slug)
                                  --placement <p>       roadmap only: icebox
                                  --ref <reference>     shared only: existing stable reference

Idea files live at:
  .spectacular/ideas/IDEA-NNN-<slug>.md

Ideas are a thinking scratchpad — nothing in ideas/ is acted on automatically.
Promotion is explicit and one-way. Shared promotion never creates a remote record.
See references/idea-rules.md.
EOF
      [[ -z "$sub" ]] && exit 1 || exit 0 ;;
    *) cmd_idea_show "$sub" "$@" ;;
  esac
}

# Walk all *.md in a .spectacular/ subdir. Emits one path per line.
# Shared by ideas, decisions, memory, sessions (single-folder collections).
# feedback is NOT one of these — it spans two locations (see _feedback_iter_all).
_iter_md() {
  local name="$1" legacy=""
  case "$name" in
    audit|audits) legacy="audit"; name="audits" ;;
    memory|memories) legacy="memory"; name="memories" ;;
    decision|decisions) legacy="decision"; name="decisions" ;;
    idea|ideas) legacy="idea"; name="ideas" ;;
    question|questions) legacy="question"; name="questions" ;;
    spike|spikes) legacy="spike"; name="spikes" ;;
    spec|specs) legacy="spec"; name="specs" ;;
    session|sessions) legacy="session"; name="sessions" ;;
    fix|fixes) legacy="fix"; name="fixes" ;;
    debug|debugs) legacy="debug"; name="debugs" ;;
  esac
  local dir f
  for dir in "$SPEC_WORKSPACE_DIR/$name" ${legacy:+"$SPEC_WORKSPACE_DIR/$legacy"}; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      [[ "$(basename "$f")" == "index.md" ]] && continue
      echo "$f"
    done
  done
}

# Find an idea by slug. Echoes path or empty.
_idea_find() {
  local slug="$1" f path compact canonical
  path="$SPEC_IDEAS_DIR/$slug.md"
  [[ -f "$path" ]] && { echo "$path"; return 0; }
  if _resolve_uuid_or_slug "$slug" idea >/dev/null 2>&1; then
    canonical=$(_resolve_uuid_or_slug "$slug" idea)
    for f in "$SPEC_IDEAS_DIR"/*.md; do
      [[ -f "$f" && "$(fm_get "$f" id)" == "$canonical" ]] && { echo "$f"; return 0; }
    done
  fi
  compact=$(printf '%s' "$slug" | tr -d ' _-' | tr '[:lower:]' '[:upper:]')
  if [[ "$compact" =~ ^(I|IDE|IDEA)([0-9]+)$ ]] || [[ "$compact" =~ ^[0-9]+$ ]]; then
    canonical=$(_canonical_resolve "$slug" idea)
    for f in "$SPEC_IDEAS_DIR"/"$canonical"-*.md "$SPEC_IDEAS_DIR"/"$canonical".md; do
      [[ -f "$f" ]] && { echo "$f"; return 0; }
    done
  fi
  for f in "$SPEC_IDEAS_DIR"/IDEA-[0-9]*-"$slug".md; do
    [[ -f "$f" ]] && { echo "$f"; return 0; }
  done
  return 1
}

cmd_idea_new() {
  local slug="" hypothesis="" origin="" priority="medium" dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --hypothesis) require_value "--hypothesis" "${2:-}"; hypothesis="$2"; shift 2 ;;
      --origin)     require_value "--origin"     "${2:-}"; origin="$2"; shift 2 ;;
      --priority)   require_value "--priority"   "${2:-}"; priority="$2"; shift 2 ;;
      --dry-run)    dry_run=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular idea new <slug> [options]

Options:
  --hypothesis <text>  One-line hypothesis (body of idea)
  --origin <text>      Free text — where the idea came from
  --priority <level>   low|medium|high (default: medium)
  --dry-run            Print the rendered entry, don't write
EOF
        exit 0 ;;
      -*) die "Unknown flag for idea new: $1" ;;
      *)
        [[ -n "$slug" ]] && die "idea new: only one <slug> argument allowed"
        slug="$1"; shift ;;
    esac
  done

  [[ -z "$slug" ]] && die "idea new: <slug> argument required"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "idea new: not inside a Spectacular workspace"

  # Validate slug shape (same as cmd_new)
  if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]; then
    die "idea new: invalid slug '$slug'. Must be kebab-case, lowercase alnum + hyphens, max 64 chars."
  fi

  case "$priority" in
    low|medium|high) ;;
    *) die "idea new: invalid --priority '$priority'. Must be: low | medium | high" ;;
  esac

  local entries_dir="$SPEC_IDEAS_DIR"
  mkdir -p "$entries_dir"
  _require_unique_collection_slug ideas "$slug" "idea new"

  local id entry_path
  id=$(_uuidv7)
  entry_path="$entries_dir/$slug.md"
  [[ -e "$entry_path" ]] && die "idea new: '$slug' already exists at $entry_path"

  # Also refuse if already in archive (don't shadow promoted ideas)
  local archived_match
  for archived_match in "$SPEC_ARCHIVE_DIR"/ideas/IDEA-[0-9]*-"$slug".md "$SPEC_ARCHIVE_DIR"/ideas/"$slug".md; do
    [[ -f "$archived_match" ]] && die "idea new: '$slug' exists in archive ($archived_match). Pick a different slug."
  done

  local owner=""
  if [[ -f "$SPEC_WORKSPACE_DIR/config.yaml" ]]; then
    owner=$(awk '/^  owner:/ { sub(/^  owner:[[:space:]]*/, ""); print; exit }' "$SPEC_CONFIG_FILE")
  fi
  [[ -z "$owner" ]] && owner="$(whoami 2>/dev/null || echo unknown)"

  local origin_text="${origin:-(captured)}"
  local hyp_text="${hypothesis:-_(fill in)_}"

  local template rendered
  template=$(_resolve_template "idea/base.md") || die_recover \
    "idea new: idea template not found" \
    "Create .spectacular/ideas/<slug>.md by hand with frontmatter:" \
    "  type: idea / status: exploring / owner: <you> / created: $TODAY" \
    "then add the idea body below the frontmatter."
  rendered=$(_render_template "$template" \
    ID "$id" \
    OWNER "$owner" \
    ORIGIN "$origin_text" \
    SUMMARY "$hyp_text" \
    DATE "$TODAY" \
    SLUG "$slug" \
    HYPOTHESIS "$hyp_text" \
    CONTEXT "_(fill in)_" \
    QUESTION "_(fill in)_")

  # Set priority via fm_set if not the default
  if $dry_run; then
    echo "── would write $entry_path ──"
    echo "$rendered"
    return 0
  fi

  echo "$rendered" > "$entry_path"
  if [[ "$priority" != "medium" ]]; then
    fm_set "$entry_path" "priority" "$priority"
  fi

  created "$entry_path"
  info "  → $id"
  info "  → status: parked"
  info "  ↳ shape it with: spectacular idea grill $slug"
  info "  ↳ when ready: spectacular idea promote $slug"
}

cmd_idea_show() {
  local ref="$1"; shift
  local full=false json=false f id
  while (( $# > 0 )); do case "$1" in --full) full=true; shift ;; --json) json=true; shift ;; *) die "idea: unknown option '$1'" ;; esac; done
  f=$(_idea_find "$ref") || die "idea: '$ref' not found"
  $full && { cat "$f"; return 0; }
  id=$(fm_get "$f" id)
  if $json; then
    printf '{"schema":"spectacular.idea.v1","id":"%s","status":"%s","priority":"%s","summary":"%s","origin":"%s","hypothesis":"%s","open_questions":"%s","promoted_to":"%s"}\n' \
      "$(_json_escape "$id")" "$(_json_escape "$(fm_get "$f" status)")" "$(_json_escape "$(fm_get "$f" priority)")" "$(_json_escape "$(fm_get "$f" summary)")" "$(_json_escape "$(fm_get "$f" origin)")" "$(_json_escape "$(_section_body "$f" Hypothesis)")" "$(_json_escape "$(_section_body "$f" "Open questions")")" "$(_json_escape "$(fm_get "$f" promoted_to)")"
    return 0
  fi
  printf 'Idea: %s\nStatus: %s · Priority: %s\nOrigin: %s\n\nHypothesis\n%s\n\nOpen questions\n%s\n\nFull evidence: spectacular idea %s --full\n' \
    "$id" "$(fm_get "$f" status)" "$(fm_get "$f" priority)" "$(fm_get "$f" origin)" "$(_section_body "$f" Hypothesis)" "$(_section_body "$f" "Open questions")" "$ref"
}

cmd_idea_list() {
  local status_filter="all"
  while (( $# > 0 )); do
    case "$1" in
      --status) require_value "--status" "${2:-}"; status_filter="$2"; shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: spectacular idea list [--status parked|exploring|promoted|all]

Lists all ideas in .spectacular/ideas/.
EOF
        exit 0 ;;
      *) die "Unknown flag for idea list: $1" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "idea list: not inside a Spectacular workspace"

  local count=0 f status updated priority slug slug_display
  printf "%-32s  %-10s  %-8s  %-10s  %s\n" "SLUG" "STATUS" "PRIORITY" "UPDATED" "ORIGIN"
  printf "%-32s  %-10s  %-8s  %-10s  %s\n" "----" "------" "--------" "-------" "------"

  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    status=$(fm_get "$f" "status")
    [[ -z "$status" ]] && status="?"
    if [[ "$status_filter" != "all" && "$status" != "$status_filter" ]]; then
      continue
    fi
    priority=$(fm_get "$f" "priority")
    updated=$(fm_get "$f" "updated")
    local origin
    origin=$(fm_get "$f" "origin")
    slug=$(basename "$f" .md)
    if (( ${#slug} > 32 )); then
      slug_display="${slug:0:29}..."
    else
      slug_display="$slug"
    fi
    printf "%-32s  %-10s  %-8s  %-10s  %s\n" "$slug_display" "$status" "${priority:-?}" "${updated:-?}" "${origin:-?}"
    count=$((count + 1))
  done < <(_iter_md ideas)

  if [[ $count -eq 0 ]]; then
    if [[ "$status_filter" == "all" ]]; then
      info "(no ideas yet — start one with 'spectacular idea new <slug>')"
    else
      info "(no ideas with status: $status_filter)"
    fi
  fi
}

cmd_idea_promote() {
  local slug="" request_slug="" destination="request" destination_set=false placement="" shared_ref=""
  while (( $# > 0 )); do
    case "$1" in
      --to)             require_value "--to"             "${2:-}"; destination="$2"; destination_set=true; shift 2 ;;
      --request-slug)   require_value "--request-slug"   "${2:-}"; request_slug="$2"; shift 2 ;;
      --placement)      require_value "--placement"      "${2:-}"; placement="$2"; shift 2 ;;
      --ref)            require_value "--ref"            "${2:-}"; shared_ref="$2"; shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: spectacular idea promote <slug> [options]

Options:
  --to <destination>   request | roadmap | shared (default: request; compatibility)
  --request-slug <s>    Override request slug (default: idea's slug)
  --placement <p>       roadmap only: icebox
  --ref <reference>     shared only: existing stable URL or provider reference

Destinations:
  request              scaffolds a request (the legacy default)
  roadmap              requires --placement icebox; snapshots then adds an Icebox item
  shared               requires --ref; records the existing destination without network access

Every destination archives the source locally. The undo command supports request promotion only.
EOF
        exit 0 ;;
      -*) die "Unknown flag for idea promote: $1" ;;
      *)
        [[ -n "$slug" ]] && die "idea promote: only one <slug> argument allowed"
        slug="$1"; shift ;;
    esac
  done

  [[ -z "$slug" ]] && die "idea promote: <slug> argument required"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "idea promote: not inside a Spectacular workspace"

  case "$destination" in
    request|roadmap|shared) ;;
    *) die "idea promote: invalid --to '$destination'. Must be: request | roadmap | shared" ;;
  esac
  if ! $destination_set; then
    warn "idea promote without --to is deprecated — use '--to request' (compatibility default)"
  fi
  case "$destination" in
    request)
      [[ -z "$placement" ]] || die "idea promote: --placement is valid only with --to roadmap"
      [[ -z "$shared_ref" ]] || die "idea promote: --ref is valid only with --to shared"
      ;;
    roadmap)
      [[ -z "$request_slug" ]] || die "idea promote: --request-slug is valid only with --to request"
      [[ -z "$shared_ref" ]] || die "idea promote: --ref is valid only with --to shared"
      [[ "$placement" == "icebox" ]] || die "idea promote: --to roadmap requires '--placement icebox'. Version/tier promotion is an explicit roadmap skill flow."
      ;;
    shared)
      [[ -z "$request_slug" ]] || die "idea promote: --request-slug is valid only with --to request"
      [[ -z "$placement" ]] || die "idea promote: --placement is valid only with --to roadmap"
      [[ -n "$shared_ref" ]] || die "idea promote: --to shared requires '--ref <stable-reference>'"
      ;;
  esac

  local idea_path idea_file idea_slug
  idea_path=$(_idea_find "$slug") || die "idea promote: idea '$slug' not found in .spectacular/ideas/"
  idea_file=$(basename "$idea_path")
  idea_slug=$(basename "$idea_path" .md | sed -E 's/^IDEA-[0-9]+-//')

  # Capture the idea's pre-promote status for the undo breadcrumb.
  local idea_prev_status
  idea_prev_status="$(fm_get "$idea_path" "status")"
  [[ -z "$idea_prev_status" ]] && idea_prev_status="exploring"

  local promoted_to="" archive_dir archived_path
  case "$destination" in
    request)
      [[ -z "$request_slug" ]] && request_slug="$idea_slug"
      if [[ -d "$SPEC_REQUESTS_DIR/$request_slug" ]] || [[ -d "$SPEC_ARCHIVE_DIR/$request_slug" ]]; then
        die "idea promote: request slug '$request_slug' already exists. Use --request-slug <other>."
      fi
      local idea_origin idea_priority summary new_plan
      idea_origin=$(fm_get "$idea_path" "origin")
      idea_priority=$(fm_get "$idea_path" "priority")
      [[ -z "$idea_priority" ]] && idea_priority="medium"
      summary="Promoted from ideas/$idea_file (origin: ${idea_origin:-captured})"
      local new_args=(--summary "$summary" --priority "$idea_priority")
      cmd_new "${new_args[@]}" "$request_slug" || die "idea promote: request scaffold failed"
      new_plan="$SPEC_REQUESTS_DIR/$request_slug/PLAN.md"
      cat >> "$new_plan" <<EOF

---

> **Promoted from idea** \`ideas/$idea_file\` (now at \`archive/ideas/$idea_file\`).
> Idea body content is preserved in the archive — review for hypotheses, context, and open questions that should fold into the slots above.
EOF
      promoted_to="requests/$request_slug/"
      ;;
    roadmap)
      local roadmap hypothesis
      roadmap="$SPEC_WORKSPACE_DIR/roadmaps/index.md"
      [[ -f "$roadmap" ]] || die "idea promote: --to roadmap requires .spectacular/roadmaps/index.md"
      hypothesis=$(awk '/^## Hypothesis/{found=1; next} found && /^## /{exit} found && NF{print; exit}' "$idea_path")
      [[ -n "$hypothesis" ]] || hypothesis="$idea_slug"
      cmd_snapshot ".spectacular/roadmaps/index.md" >/dev/null || die "idea promote: could not snapshot roadmap"
      if ! grep -q '^## Icebox' "$roadmap"; then
        printf '\n## Icebox\n' >> "$roadmap"
      fi
      printf '%s\n' "- $hypothesis _(from $idea_file)_" >> "$roadmap"
      fm_touch "$roadmap"
      promoted_to="roadmaps/index.md#icebox"
      ;;
    shared)
      promoted_to="shared:$shared_ref"
      ;;
  esac

  # Update idea frontmatter, then archive the local handoff record.
  fm_set "$idea_path" "status" "promoted"
  fm_set "$idea_path" "promoted_to" "$promoted_to"
  fm_set "$idea_path" "updated" "$TODAY"

  archive_dir="$SPEC_ARCHIVE_DIR/ideas"
  mkdir -p "$archive_dir"
  archived_path="$archive_dir/$idea_file"
  if [[ -e "$archived_path" ]]; then
    die "idea promote: archive target already exists: $archived_path (manual cleanup needed)"
  fi
  mv "$idea_path" "$archived_path"

  if [[ "$destination" == "request" ]]; then
    # Breadcrumb applies only to the request flow, whose scaffold undo understands.
    _breadcrumb_write "idea-promote" "$idea_slug" "request_slug=$request_slug" "idea_prev_status=$idea_prev_status" "idea_file=$idea_file"
    created "$SPEC_REQUESTS_DIR/$request_slug/"
  fi
  info "  → idea archived: $archived_path"
  info "  → destination: $promoted_to"
  case "$destination" in
    request) info "  ↳ next: cd into the request and flesh out PLAN slots" ;;
    roadmap) info "  ↳ next: use the roadmap Icebox-promotion ritual before choosing a version/tier" ;;
    shared)  info "  ↳ next: continue discussion at the referenced shared destination" ;;
  esac
}

# ── audit / fixes (v1.25.0+) ─────────────────────────────────────────────────
# Two soft-DB collections, one bug-lifecycle workflow:
#   audit/  A<N>.md  — investigation BEFORE a fix is planned (open→resolved/folded)
#   fixes/  F<N>.md  — verified-fix log, logged only once resolved (terminal entries)
# Both index-only (folder of files); auto-numbered like `decide`'s index mode.
# See references/audit-rules.md and references/fixes-rules.md.

# Next free N for a prefix (A|F) in a collection dir. Echoes the integer.
_next_entry_num() {
  local dir="$1" prefix="$2" f num next_n=1
  for f in "$dir/$prefix"*.md; do
    [[ -f "$f" ]] || continue
    num=$(basename "$f" .md); num="${num#$prefix}"
    num="${num%%-*}"
    [[ "$num" =~ ^[0-9]+$ ]] && (( num >= next_n )) && next_n=$(( num + 1 ))
  done
  echo "$next_n"
}

_validate_severity() {
  case "$1" in low|medium|high) ;; *) die "$2: invalid severity '$1'. Must be: low | medium | high" ;; esac
}

cmd_audit() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    new)     cmd_audit_new "$@" ;;
    list)    cmd_audit_list "$@" ;;
    resolve) cmd_audit_resolve "$@" ;;
    ""|--help|-h)
      cat <<EOF
Usage: spectacular audit <subcommand> [options]

Subcommands:
  new "<title>"               Scaffold an investigation at .spectacular/audit/A<N>.md
                                (status: open). Options:
                                  --severity low|medium|high  (default: medium)
                                  --symptom <text>            Prefill the Symptom slot
                                  --dry-run
  list [--status <s>]         List audits (open|resolved|folded|all)
  resolve <A<N>> --disposition "<text>"   Close an audit (status: resolved).
                                  --into-fix                  Also scaffold a fix F<N>
                                                                (from_audit: A<N>)
                                  --verified-by <text>        (with --into-fix)

audit/ is the diagnostic scratchpad between "something's off" and "here's the plan".
See references/audit-rules.md.
EOF
      [[ -z "$sub" ]] && exit 1 || exit 0 ;;
    *) cmd_audit_show "$sub" "$@" ;;
  esac
}

cmd_audit_new() {
  local title="" severity="medium" problem="" intended="" dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --severity)          require_value "--severity" "${2:-}"; severity="$2"; shift 2 ;;
      --problem|--symptom) require_value "$1" "${2:-}"; problem="$2"; shift 2 ;;
      --intended)          require_value "--intended" "${2:-}"; intended="$2"; shift 2 ;;
      --dry-run)  dry_run=true; shift ;;
      --help|-h)  echo "Usage: spectacular audit new \"<title>\" [--severity low|medium|high] [--problem <text>] [--intended <text>] [--dry-run]"; exit 0 ;;
      -*) die "Unknown flag for audit new: $1" ;;
      *) [[ -n "$title" ]] && die "audit new: only one <title> argument (quote it)"; title="$1"; shift ;;
    esac
  done
  [[ -z "$title" ]] && die "audit new: <title> argument required (quote it)"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "audit new: not inside a Spectacular workspace"
  _validate_severity "$severity" "audit new"

  local dir="$SPEC_AUDITS_DIR"
  mkdir -p "$dir"
  local num="$(_next_entry_num "$dir" A)"
  local id="A${num}"
  local slug; slug=$(_slug_from_text "$title")
  local entry_path="$dir/${id}-${slug}.md"

  local template rendered
  template=$(_resolve_template "audit/entry.md") \
    || die "audit new: audit template not found (skills/spectacular/templates/audit/entry.md)"
  rendered=$(_render_template "$template" \
    ID "$id" TITLE "$title" SUMMARY "$title" SEVERITY "$severity" DATE "$TODAY" \
    PROBLEM "${problem:-_(fill in)_}" \
    INTENDED "${intended:-_(what SHOULD happen instead — the contract the bug violates)_}")

  if $dry_run; then echo "── would write $entry_path ──"; echo "$rendered"; return 0; fi
  echo "$rendered" > "$entry_path"
  created "$entry_path"
  info "  → status: open · severity: $severity"
  info "  ↳ close it with: spectacular audit resolve $id --disposition \"...\""
}

cmd_audit_list() {
  local status_filter="all"
  while (( $# > 0 )); do
    case "$1" in
      --status) require_value "--status" "${2:-}"; status_filter="$2"; shift 2 ;;
      --help|-h) echo "Usage: spectacular audit list [--status open|resolved|folded|all]"; exit 0 ;;
      *) die "Unknown flag for audit list: $1" ;;
    esac
  done
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "audit list: not inside a Spectacular workspace"

  local count=0 f status severity updated id disposition summary
  printf "%-6s  %-9s  %-8s  %-10s  %-18s  %s\n" "ID" "STATUS" "SEVERITY" "UPDATED" "DISPOSITION" "SUMMARY"
  printf "%-6s  %-9s  %-8s  %-10s  %s\n" "--" "------" "--------" "-------" "-----------"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    status=$(fm_get "$f" "status"); [[ -z "$status" ]] && status="?"
    [[ "$status_filter" != "all" && "$status" != "$status_filter" ]] && continue
    severity=$(fm_get "$f" "severity"); updated=$(fm_get "$f" "updated")
    disposition=$(fm_get "$f" "disposition")
    id=$(basename "$f" .md); id="${id%%-*}"
    summary=$(fm_get "$f" summary); [[ -n "$summary" ]] || summary="(legacy record — inspect $id)"
    printf "%-6s  %-9s  %-8s  %-10s  %-18s  %s\n" "$id" "$status" "${severity:-?}" "${updated:-?}" "${disposition:-—}" "$summary"
    count=$((count + 1))
  done < <(_iter_md audit)
  if [[ $count -eq 0 ]]; then
    [[ "$status_filter" == "all" ]] \
      && info "(no audits yet — start one with 'spectacular audit new \"<title>\"')" \
      || info "(no audits with status: $status_filter)"
  fi
}

_audit_find() {
  local ref="$1" f compact
  compact=$(printf '%s' "$ref" | tr '[:lower:]' '[:upper:]')
  for f in "$SPEC_AUDITS_DIR"/"$ref"*.md "$SPEC_AUDITS_DIR"/"$compact"*.md; do [[ -f "$f" ]] && { echo "$f"; return 0; }; done
  return 1
}

cmd_audit_show() {
  local ref="$1"; shift
  local full=false json=false f id
  while (( $# > 0 )); do case "$1" in --full) full=true; shift ;; --json) json=true; shift ;; *) die "audit: unknown option '$1'" ;; esac; done
  f=$(_audit_find "$ref") || die "audit: '$ref' not found"
  $full && { cat "$f"; return 0; }
  id=$(basename "$f" .md); id="${id%%-*}"
  if $json; then
    printf '{"schema":"spectacular.audit.v1","id":"%s","status":"%s","severity":"%s","summary":"%s","problem":"%s","root_cause":"%s","proposed_fix":"%s","disposition":"%s"}\n' \
      "$(_json_escape "$id")" "$(_json_escape "$(fm_get "$f" status)")" "$(_json_escape "$(fm_get "$f" severity)")" "$(_json_escape "$(fm_get "$f" summary)")" "$(_json_escape "$(_section_body "$f" Problem)")" "$(_json_escape "$(_section_body "$f" "Root cause")")" "$(_json_escape "$(_section_body "$f" "Proposed fix")")" "$(_json_escape "$(fm_get "$f" disposition)")"
    return 0
  fi
  printf 'Audit: %s\nStatus: %s · Severity: %s\nDisposition: %s\n\nProblem\n%s\n\nRoot cause\n%s\n\nProposed fix\n%s\n\nFull evidence: spectacular audit %s --full\n' \
    "$id" "$(fm_get "$f" status)" "$(fm_get "$f" severity)" "$(fm_get "$f" disposition)" "$(_section_body "$f" Problem)" "$(_section_body "$f" "Root cause")" "$(_section_body "$f" "Proposed fix")" "$ref"
}

cmd_audit_resolve() {
  local id="" disposition="" into_fix=false verified_by=""
  while (( $# > 0 )); do
    case "$1" in
      --disposition) require_value "--disposition" "${2:-}"; disposition="$2"; shift 2 ;;
      --into-fix)    into_fix=true; shift ;;
      --verified-by) require_value "--verified-by" "${2:-}"; verified_by="$2"; shift 2 ;;
      --help|-h) echo "Usage: spectacular audit resolve <A<N>> --disposition \"<text>\" [--into-fix [--verified-by <text>]]"; exit 0 ;;
      -*) die "Unknown flag for audit resolve: $1" ;;
      *) [[ -n "$id" ]] && die "audit resolve: only one <id> argument"; id="$1"; shift ;;
    esac
  done
  [[ -z "$id" ]] && die "audit resolve: <A<N>> argument required"
  [[ -z "$disposition" ]] && die "audit resolve: --disposition \"<text>\" required"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "audit resolve: not inside a Spectacular workspace"

  local dir="$SPEC_AUDITS_DIR"
  local entry_path="$dir/$id.md"
  if [[ ! -f "$entry_path" ]]; then
    local matches=()
    shopt -s nullglob
    for match in "$dir/${id}"*.md; do
      matches+=("$match")
    done
    shopt -u nullglob
    if (( ${#matches[@]} == 1 )); then
      entry_path="${matches[0]}"
    elif (( ${#matches[@]} > 1 )); then
      die "audit resolve: multiple matches found for '$id'"
    fi
  fi
  [[ -f "$entry_path" ]] || die "audit resolve: '$id' not found at $entry_path"

  # --into-fix graduates the audit into a verified-fix entry, copying every
  # matching slot forward (problem, intended, cause, proposed fix, criteria).
  local fix_id=""
  if $into_fix; then
    [[ -n "$verified_by" ]] || die "audit resolve: --into-fix requires concrete --verified-by evidence; otherwise keep it as an audit/request"
    local f_title f_from_audit f_severity f_problem f_intended f_cause f_fix f_criteria f_verified_by f_signature
    f_title=$(_h1_title "$entry_path"); [[ -z "$f_title" ]] && f_title="fix for $id"
    f_from_audit="$id"
    f_severity=$(fm_get "$entry_path" severity)
    f_verified_by="$verified_by"
    f_problem=$(_copy_section  "$entry_path" "Problem")
    f_intended=$(_copy_section "$entry_path" "Intended behavior")
    f_cause=$(_copy_section    "$entry_path" "Root cause")
    f_fix=$(_copy_section      "$entry_path" "Proposed fix")   # proposal → the fix, refine after
    f_criteria=$(_copy_section "$entry_path" "Success criteria")
    fix_id=$(_fix_scaffold) || die "audit resolve: could not scaffold fix entry"
    # --into-fix owns the disposition; don't duplicate the user's phrasing.
    disposition="became fix $fix_id"
  fi

  fm_set "$entry_path" "status" "resolved"
  fm_set "$entry_path" "updated" "$TODAY"
  fm_set "$entry_path" "disposition" "$disposition"

  created "$entry_path"
  info "  → status: resolved · disposition: $disposition"
  $into_fix && info "  ↳ created fix $fix_id (slots copied from $id) — confirm Fix + add Verified by / Signature"
  return 0
}

# Copy a section's body forward, treating a placeholder hint (_(...)_) as empty.
_copy_section() {
  local body; body=$(_section_body "$1" "$2")
  [[ "$body" =~ ^_\(.*\)_$ ]] && body=""
  echo "$body"
}

# Echo the body under a "## <heading>" up to the next "## " (or EOF), leading blanks trimmed.
_section_body() {
  awk -v h="## $2" '
    $0 == h { grab=1; next }
    grab && /^## / { exit }
    grab { if (!started && $0 ~ /./) started=1; if (started) print }
  ' "$1"
}

# Scaffold a fixes/F<N>.md from named slot vars.
# Reads these locals from the CALLER's scope (set them before calling):
#   f_title f_from_audit f_debug_job f_severity f_problem f_intended f_cause f_fix
#   f_criteria f_verified_by f_signature
# Default: writes the file, echoes the new id.
# If f_dry=true: writes nothing, echoes the rendered content (for --dry-run).
_fix_scaffold() {
  local dir="$SPEC_FIXES_DIR"
  local id="F$(_next_entry_num "$dir" F)"
  local verified_date="null"
  [[ -n "${f_verified_by:-}" ]] && verified_date="$TODAY"
  local template rendered
  template=$(_resolve_template "fixes/entry.md") || { echo ""; return 1; }
  rendered=$(_render_template "$template" \
    ID "$id" TITLE "${f_title:-untitled}" SUMMARY "${f_title:-untitled}" SEVERITY "${f_severity:-medium}" \
    OPENED "$TODAY" VERIFIED "$verified_date" FROM_AUDIT "${f_from_audit:-null}" \
    DEBUG_JOB "${f_debug_job:-null}" \
    SIGNATURE "${f_signature:-}" \
    PROBLEM     "${f_problem:-_(fill in)_}" \
    INTENDED    "${f_intended:-_(what SHOULD happen)_}" \
    CAUSE       "${f_cause:-_(fill in)_}" \
    FIX         "${f_fix:-_(fill in)_}" \
    CRITERIA    "${f_criteria:-_(the observable bar the fix must clear)_}" \
    VERIFIED_BY "${f_verified_by:-_(fill in — name the check)_}")
  if [[ "${f_dry:-false}" == true ]]; then echo "$rendered"; return 0; fi
  mkdir -p "$dir"
  local fslug; fslug=$(_slug_from_text "${f_title:-untitled}")
  local entry_path="$dir/${id}-${fslug}.md"
  echo "$rendered" > "$entry_path"
  _FIX_SCAFFOLD_PATH="$entry_path"
  echo "$id"
}

cmd_fix() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    new)  cmd_fix_new "$@" ;;
    list) cmd_fix_list "$@" ;;
    ""|--help|-h)
      cat <<EOF
Usage: spectacular fix <subcommand> [options]

Subcommands:
  new "<title>"               Log a VERIFIED fix at .spectacular/fixes/F<N>.md.
                                Options:
                                  --severity low|medium|high  (default: medium)
                                  --bug <text> --cause <text> --fix <text>
                                  --verified-by <text>   Required check that proves it
                                  --from-audit <A<N>>    Link to originating audit
                                  --debug-job <slug>     Back-link to debug/<slug> job
                                  --dry-run
  list [--since <Nd>]         List fix entries

fixes/ logs a bug fix ONLY once fully resolved and verified. See references/fixes-rules.md.
EOF
      [[ -z "$sub" ]] && exit 1 || exit 0 ;;
    *) cmd_fix_show "$sub" "$@" ;;
  esac
}

_fix_find() {
  local ref="$1" f compact
  compact=$(printf '%s' "$ref" | tr '[:lower:]' '[:upper:]')
  for f in "$SPEC_FIXES_DIR"/"$ref"*.md "$SPEC_FIXES_DIR"/"$compact"*.md; do [[ -f "$f" ]] && { echo "$f"; return 0; }; done
  return 1
}

cmd_fix_show() {
  local ref="$1"; shift
  local full=false json=false f id
  while (( $# > 0 )); do case "$1" in --full) full=true; shift ;; --json) json=true; shift ;; *) die "fix: unknown option '$1'" ;; esac; done
  f=$(_fix_find "$ref") || die "fix: '$ref' not found"
  $full && { cat "$f"; return 0; }
  id=$(basename "$f" .md); id="${id%%-*}"
  if $json; then
    printf '{"schema":"spectacular.fix.v1","id":"%s","verified":"%s","signature":"%s","severity":"%s","summary":"%s","root_cause":"%s","fix":"%s","verified_by":"%s"}\n' \
      "$(_json_escape "$id")" "$(_json_escape "$(fm_get "$f" verified)")" "$(_json_escape "$(fm_get "$f" signature)")" "$(_json_escape "$(fm_get "$f" severity)")" "$(_json_escape "$(fm_get "$f" summary)")" "$(_json_escape "$(_section_body "$f" "Root cause")")" "$(_json_escape "$(_section_body "$f" Fix)")" "$(_json_escape "$(_section_body "$f" "Verified by")")"
    return 0
  fi
  printf 'Fix: %s\nVerified: %s · Severity: %s\nSignature: %s\n\nRoot cause\n%s\n\nFix\n%s\n\nVerified by\n%s\n\nFull evidence: spectacular fix %s --full\n' \
    "$id" "$(fm_get "$f" verified)" "$(fm_get "$f" severity)" "$(fm_get "$f" signature)" "$(_section_body "$f" "Root cause")" "$(_section_body "$f" Fix)" "$(_section_body "$f" "Verified by")" "$ref"
}

cmd_fix_new() {
  # slot vars use the f_ prefix consumed by _fix_scaffold
  local f_title="" f_severity="medium" f_problem="" f_intended="" f_cause="" f_fix="" \
        f_criteria="" f_verified_by="" f_from_audit="" f_debug_job="" f_signature="" dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --severity)        require_value "--severity"    "${2:-}"; f_severity="$2"; shift 2 ;;
      --problem|--bug)   require_value "$1" "${2:-}"; f_problem="$2"; shift 2 ;;
      --intended)        require_value "--intended"    "${2:-}"; f_intended="$2"; shift 2 ;;
      --cause)           require_value "--cause"       "${2:-}"; f_cause="$2"; shift 2 ;;
      --fix)             require_value "--fix"         "${2:-}"; f_fix="$2"; shift 2 ;;
      --criteria)        require_value "--criteria"    "${2:-}"; f_criteria="$2"; shift 2 ;;
      --verified-by)     require_value "--verified-by" "${2:-}"; f_verified_by="$2"; shift 2 ;;
      --signature)       require_value "--signature"   "${2:-}"; f_signature="$2"; shift 2 ;;
      --from-audit)      require_value "--from-audit"  "${2:-}"; f_from_audit="$2"; shift 2 ;;
      --debug-job)       require_value "--debug-job"   "${2:-}"; f_debug_job="$2"; shift 2 ;;
      --dry-run)         dry_run=true; shift ;;
      --help|-h)
        echo "Usage: spectacular fix new \"<title>\" [--verified-by <text>] [--problem/--intended/--cause/--fix/--criteria <text>] [--signature <text>] [--from-audit A<N>] [--debug-job <slug>] [--severity low|medium|high] [--dry-run]"; exit 0 ;;
      -*) die "Unknown flag for fix new: $1" ;;
      *) [[ -n "$f_title" ]] && die "fix new: only one <title> argument (quote it)"; f_title="$1"; shift ;;
    esac
  done
  [[ -z "$f_title" ]] && die "fix new: <title> argument required (quote it)"
  [[ -n "$f_verified_by" ]] || die "fix new: --verified-by is required; incomplete work belongs in audits/ or a request"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "fix new: not inside a Spectacular workspace"
  _validate_severity "$f_severity" "fix new"
  if [[ -n "$f_from_audit" ]]; then
    local audit_found=false
    local match
    for match in "$SPEC_AUDITS_DIR/${f_from_audit}"*.md; do
      [[ -f "$match" ]] && audit_found=true && break
    done
    if ! $audit_found; then
      die "fix new: --from-audit '$f_from_audit' not found under .spectacular/audits/"
    fi
  fi
  if $dry_run; then
    local fslug; fslug=$(_slug_from_text "$f_title")
    echo "── would write .spectacular/fixes/F$(_next_entry_num "$SPEC_FIXES_DIR" F)-${fslug}.md ──"
    local f_dry=true; _fix_scaffold || die "fix new: could not render fixes template"
    return 0
  fi

  local id fslug entry_path
  id=$(_fix_scaffold) || die "fix new: could not render fixes template"
  fslug=$(_slug_from_text "${f_title:-untitled}")
  entry_path="$SPEC_FIXES_DIR/${id}-${fslug}.md"
  created "$entry_path"
  if [[ -n "$f_verified_by" ]]; then info "  → verified: $TODAY · by: $f_verified_by"; else info "  → verified: null (unverified)"; fi
  [[ -n "$f_from_audit" ]] && info "  ↳ linked to audit: $f_from_audit"
  return 0
}

cmd_fix_list() {
  local since="" since_epoch
  while (( $# > 0 )); do
    case "$1" in
      --since) require_value "--since" "${2:-}"; since="$2"; shift 2 ;;
      --help|-h) echo "Usage: spectacular fix list [--since <Nd>]"; exit 0 ;;
      *) die "Unknown flag for fix list: $1" ;;
    esac
  done
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "fix list: not inside a Spectacular workspace"
  since_epoch=$(_parse_since "$since")

  local count=0 f verified severity id from_audit signature summary verified_epoch
  printf "%-6s  %-12s  %-8s  %-10s  %-18s  %s\n" "ID" "VERIFIED" "SEVERITY" "FROM" "SIGNATURE" "SUMMARY"
  printf "%-6s  %-12s  %-8s  %-10s  %-18s  %s\n" "--" "--------" "--------" "----" "---------" "-------"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    verified=$(fm_get "$f" "verified"); [[ -z "$verified" || "$verified" == "null" ]] && verified="unverified"
    if (( since_epoch > 0 )); then
      verified_epoch=$(_date_to_epoch "$verified")
      (( verified_epoch < since_epoch )) && continue
    fi
    severity=$(fm_get "$f" "severity"); from_audit=$(fm_get "$f" "from_audit")
    signature=$(fm_get "$f" "signature")
    [[ -z "$from_audit" || "$from_audit" == "null" ]] && from_audit="—"
    id=$(basename "$f" .md); id="${id%%-*}"
    summary=$(fm_get "$f" summary); [[ -n "$summary" ]] || summary="(legacy record — inspect $id)"
    printf "%-6s  %-12s  %-8s  %-10s  %-18s  %s\n" "$id" "$verified" "${severity:-?}" "$from_audit" "${signature:-?}" "$summary"
    count=$((count + 1))
  done < <(_iter_md fixes)
  [[ $count -eq 0 ]] && info "(no fixes yet — log one with 'spectacular fix new \"<title>\" --verified-by \"...\"')"
  return 0
}

# Echo the "# <ID> — <title>" H1 title portion (after the em-dash), or the whole H1.
_h1_title() {
  awk '/^# / { sub(/^# /, ""); if (index($0, " — ")) sub(/^.* — /, ""); print; exit }' "$1"
}

# ── vision / imagine (v1.38.0+) ─────────────────────────────────────────────
# New Vision workspaces are pre-request direction records at visions/<slug>/.
# Legacy request-owned vision/ folders remain readable and diagnosable.

_vision_find() {
  local slug="$1"
  [[ -d "$SPEC_VISIONS_DIR/$slug" ]] && { echo "$SPEC_VISIONS_DIR/$slug"; return 0; }
  [[ -d "$SPEC_REQUESTS_DIR/$slug/vision" ]] && { echo "$SPEC_REQUESTS_DIR/$slug/vision"; return 0; }
  return 1
}

_vision_is_legacy() { [[ "$1" == "$SPEC_REQUESTS_DIR"/*/vision ]]; }

_vision_iter_fragments() {
  local vdir="$1" kind f
  if [[ -d "$vdir/fragments" ]]; then
    for f in "$vdir/fragments"/*.md; do [[ -f "$f" ]] && echo "$f"; done
    return 0
  fi
  for kind in stories ui arch; do
    [[ -d "$vdir/$kind" ]] || continue
    for f in "$vdir/$kind"/*.md; do [[ -f "$f" ]] && echo "$f"; done
  done
}

_vision_fragment_reaction() {
  local f="$1" reaction approved
  reaction=$(fm_get "$f" reaction)
  if [[ -z "$reaction" ]]; then
    approved=$(fm_get "$f" approved)
    case "$approved" in true) reaction=approved ;; false) reaction=rejected ;; *) reaction=pending ;; esac
  fi
  echo "$reaction"
}

_vision_manifest_lines() {
  local vdir="$1" f kind caption reaction rel any=false
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    any=true
    kind=$(fm_get "$f" kind); caption=$(fm_get "$f" caption)
    reaction=$(_vision_fragment_reaction "$f")
    rel="${f#"$vdir/"}"
    [[ -n "$kind" ]] || kind="?"
    [[ -n "$caption" ]] || caption="$(basename "$f" .md)"
    printf -- '- `[%s]` %s — **%s** (`%s`)\n' "$kind" "$caption" "$reaction" "$rel"
  done < <(_vision_iter_fragments "$vdir")
  $any || printf -- '_No fragments yet. Add only what makes a material uncertainty discussable._\n'
}

# Replace only the Manifest body. New spines keep the following Approval section;
# legacy spines have Manifest at EOF and continue to work.
_regen_vision_manifest() {
  local vdir="$1" spine="$1/VISION.md" tmp
  [[ -f "$spine" ]] || return 0
  tmp=$(mktemp)
  awk '/^## Manifest$/{exit} {print}' "$spine" > "$tmp"
  printf '## Manifest\n\n' >> "$tmp"
  _vision_manifest_lines "$vdir" >> "$tmp"
  awk 'seen && /^## /{print; copy=1; next} /^## Manifest$/{seen=1; next} copy{print}' "$spine" >> "$tmp"
  mv "$tmp" "$spine"
}

_vision_section_has_content() {
  local file="$1" heading="$2"
  awk -v h="## $heading" '
    $0 == h { in_section=1; next }
    in_section && /^## / { exit }
    in_section { print }
  ' "$file" | sed '/<!--/,/-->/d' | grep -q '[[:alnum:]]'
}

_vision_subsection_has_content() {
  local file="$1" heading="$2"
  awk -v h="### $heading" '
    $0 == h { in_section=1; next }
    in_section && /^##[#]? / { exit }
    in_section { print }
  ' "$file" | sed '/<!--/,/-->/d' | grep -q '[[:alnum:]]'
}

_vision_replace_approval() {
  local spine="$1" content="$2" tmp
  tmp=$(mktemp)
  awk -v content="$content" '
    /^## Approval$/ { print; print ""; print content; inside=1; next }
    inside && /^## / { inside=0 }
    !inside { print }
  ' "$spine" > "$tmp" && mv "$tmp" "$spine"
}

_vision_fragment_find() {
  local vdir="$1" ref="${2%.md}" f found=""
  while IFS= read -r f; do
    [[ "$(basename "$f" .md)" == "$ref" ]] || continue
    [[ -z "$found" ]] || die "vision fragment '$ref' is ambiguous"
    found="$f"
  done < <(_vision_iter_fragments "$vdir")
  [[ -n "$found" ]] || return 1
  echo "$found"
}

cmd_imagine() {
  local slug=""
  while (( $# > 0 )); do
    case "$1" in
      --help|-h)
        cat <<EOF
Usage: spectacular imagine <slug>

Scaffold a pre-request Vision workspace:

  .spectacular/visions/<slug>/
  ├── VISION.md      understanding, north star, direction, manifest, approval
  ├── fragments/     proportional strategy/story/flow/ui/arch/prototype artifacts
  └── evidence/      links or concise presentation artifacts (RES/SPK stay canonical)

The CLI scaffolds only. Run /spectacular imagine <slug> in an AI agent for the
Understand → Imagine → Probe → React → Confirm loop. Approved Vision derives a
draft SPC, never a PLAN or implementation authorization.
EOF
        exit 0 ;;
      -*) die "Unknown flag for imagine: $1" ;;
      *) [[ -z "$slug" ]] || die "imagine: only one <slug> argument allowed"; slug="$1"; shift ;;
    esac
  done
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "imagine: slug must be kebab-case"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "imagine: not inside a Spectacular workspace"
  local vdir="$SPEC_VISIONS_DIR/$slug" legacy="$SPEC_REQUESTS_DIR/$slug/vision"
  [[ ! -d "$vdir" ]] || die "imagine: Vision already exists at $vdir"
  [[ ! -d "$legacy" ]] || die "imagine: legacy request Vision already exists at $legacy; it remains readable via 'spectacular vision show $slug'"
  mkdir -p "$vdir/fragments" "$vdir/evidence"
  local template rendered spine="$vdir/VISION.md"
  template=$(_resolve_template "vision/spine.md") || die "imagine: template vision/spine.md not found"
  rendered=$(_render_template "$template" SLUG "$slug" DATE "$TODAY")
  echo "$rendered" > "$spine"
  created "$vdir/"
  info "  → status: draft · pre-request"
  info "  → spine: $spine"
  info "  ↳ next: /spectacular imagine $slug"
}

cmd_vision_list() {
  local count=0 dir slug spine status updated approved_at
  printf '%-28s  %-10s  %-10s  %-12s  %s\n' SLUG STATUS UPDATED APPROVED LOCATION
  printf '%-28s  %-10s  %-10s  %-12s  %s\n' ---- ------ ------- -------- --------
  if [[ -d "$SPEC_VISIONS_DIR" ]]; then
    for dir in "$SPEC_VISIONS_DIR"/*; do
      [[ -d "$dir" && -f "$dir/VISION.md" ]] || continue
      slug=$(basename "$dir"); spine="$dir/VISION.md"
      status=$(fm_get "$spine" status); updated=$(fm_get "$spine" updated); approved_at=$(fm_get "$spine" approved_at)
      printf '%-28s  %-10s  %-10s  %-12s  %s\n' "$slug" "${status:-?}" "${updated:-?}" "${approved_at:---}" "$dir"
      count=$((count + 1))
    done
  fi
  if [[ -d "$SPEC_REQUESTS_DIR" ]]; then
    for dir in "$SPEC_REQUESTS_DIR"/*/vision; do
      [[ -d "$dir" && -f "$dir/VISION.md" ]] || continue
      slug=$(basename "$(dirname "$dir")")
      printf '%-28s  %-10s  %-10s  %-12s  %s\n' "$slug" legacy "$(fm_get "$dir/VISION.md" updated)" -- "$dir"
      count=$((count + 1))
    done
  fi
  (( count > 0 )) || info "(no visions yet — start one with 'spectacular imagine <slug>')"
}

cmd_vision_show() {
  local slug="${1:-}"; [[ -n "$slug" ]] || die "Usage: spectacular vision show <slug>"
  local vdir spine count=0 approved=0 f reaction
  vdir=$(_vision_find "$slug") || die "vision show: '$slug' not found"
  spine="$vdir/VISION.md"; [[ -f "$spine" ]] || die "vision show: VISION.md missing at $vdir"
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue; count=$((count + 1)); reaction=$(_vision_fragment_reaction "$f")
    [[ "$reaction" == approved ]] && approved=$((approved + 1))
  done < <(_vision_iter_fragments "$vdir")
  echo "Vision: $slug"
  if _vision_is_legacy "$vdir"; then echo "Status: legacy"; else echo "Status: $(fm_get "$spine" status)"; fi
  echo "Fragments: $approved approved / $count total"
  echo "Path: $vdir"
  echo ""
  sed -n '1,220p' "$spine"
}

cmd_vision_add() {
  local kind="" name="" slug="" caption=""
  while (( $# > 0 )); do
    case "$1" in
      --slug) require_value "$1" "${2:-}"; slug="$2"; shift 2 ;;
      --slug=*) slug="${1#--slug=}"; shift ;;
      --caption) require_value "$1" "${2:-}"; caption="$2"; shift 2 ;;
      --caption=*) caption="${1#--caption=}"; shift ;;
      -*) die "vision add: unknown flag '$1'" ;;
      *) if [[ -z "$kind" ]]; then kind="$1"; elif [[ -z "$name" ]]; then name="$1"; else die "vision add: unexpected argument '$1'"; fi; shift ;;
    esac
  done
  in_list "$kind" "strategy story flow ui arch prototype" || die "vision add: kind must be strategy|story|flow|ui|arch|prototype"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "vision add: name must be kebab-case"
  [[ -n "$slug" ]] || die "vision add: --slug <vision-slug> required"
  local vdir spine frag template rendered kind_title
  vdir=$(_vision_find "$slug") || die "vision add: Vision '$slug' not found; run 'spectacular imagine $slug' first"
  _vision_is_legacy "$vdir" && die "vision add: legacy request Vision is read-compatible only; add manually at $vdir or start a new pre-request Vision"
  spine="$vdir/VISION.md"; [[ "$(fm_get "$spine" status)" == draft ]] || die "vision add: fragments may be added only while Vision is draft"
  frag="$vdir/fragments/$name.md"; [[ ! -e "$frag" ]] || die "vision add: fragment already exists: $frag"
  [[ -n "$caption" ]] || caption="$name"
  kind_title="$(printf '%s' "$kind" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
  template=$(_resolve_template "vision/fragment.md") || die "vision add: template vision/fragment.md not found"
  rendered=$(_render_template "$template" KIND "$kind" KIND_TITLE "$kind_title" NAME "$name" CAPTION "$caption" DATE "$TODAY")
  echo "$rendered" > "$frag"
  _regen_vision_manifest "$vdir"; fm_touch "$spine"
  created "$frag"
  info "  → kind: $kind · reaction: pending"
}

cmd_vision_react() {
  local slug="${1:-}" ref="${2:-}" reaction="" note=""; shift 2 2>/dev/null || true
  while (( $# > 0 )); do
    case "$1" in
      --approve) reaction=approved; shift ;;
      --revise) reaction=revise; shift ;;
      --reject) reaction=rejected; shift ;;
      --supersede) reaction=superseded; shift ;;
      --note) require_value "$1" "${2:-}"; note="$2"; shift 2 ;;
      *) die "vision react: unknown option '$1'" ;;
    esac
  done
  [[ -n "$slug" && -n "$ref" && -n "$reaction" ]] || die "Usage: spectacular vision react <slug> <fragment> --approve|--revise|--reject|--supersede [--note <text>]"
  local vdir spine frag
  vdir=$(_vision_find "$slug") || die "vision react: Vision '$slug' not found"
  _vision_is_legacy "$vdir" && die "vision react: legacy request Vision is read-compatible only"
  spine="$vdir/VISION.md"; [[ "$(fm_get "$spine" status)" == draft ]] || die "vision react: Vision must be draft"
  frag=$(_vision_fragment_find "$vdir" "$ref") || die "vision react: fragment '$ref' not found"
  fm_set "$frag" reaction "$reaction"; fm_set "$frag" reaction_note "$note"; fm_touch "$frag"
  _regen_vision_manifest "$vdir"; fm_touch "$spine"
  info "  ✓ $(basename "$frag" .md): $reaction"
}

_vision_assert_resolved() {
  local vdir="$1" f reaction approved=0 unresolved=""
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue; reaction=$(_vision_fragment_reaction "$f")
    [[ "$reaction" == approved ]] && approved=$((approved + 1))
    case "$reaction" in pending|revise) unresolved="${unresolved:+$unresolved, }$(basename "$f" .md)" ;; esac
  done < <(_vision_iter_fragments "$vdir")
  [[ -z "$unresolved" ]] || die "vision: unresolved fragment reactions: $unresolved"
  (( approved > 0 )) || die "vision: at least one approved fragment is required"
}

cmd_vision_propose() {
  local slug="${1:-}" vdir spine heading
  [[ -n "$slug" ]] || die "Usage: spectacular vision propose <slug>"
  vdir=$(_vision_find "$slug") || die "vision propose: Vision '$slug' not found"
  _vision_is_legacy "$vdir" && die "vision propose: legacy request Vision has no whole-Vision lifecycle"
  spine="$vdir/VISION.md"; [[ "$(fm_get "$spine" status)" == draft ]] || die "vision propose: expected draft"
  for heading in Intent "North star" Understanding "Experience signature" "Strategies considered" "Chosen direction" Boundaries; do
    _vision_section_has_content "$spine" "$heading" || die "vision propose: section '$heading' is empty"
  done
  for heading in "Current reality" "Users and needs" Constraints "Material uncertainties"; do
    _vision_subsection_has_content "$spine" "$heading" || die "vision propose: Understanding subsection '$heading' is empty"
  done
  _vision_assert_resolved "$vdir"
  fm_set "$spine" status proposed; fm_set "$spine" proposed_at "$TODAY"; fm_touch "$spine"
  _vision_replace_approval "$spine" "Proposed $TODAY — awaiting explicit human approval."
  info "  ✓ $slug: draft → proposed"
}

cmd_vision_approve() {
  local slug="${1:-}" approved_by="" note=""; shift || true
  while (( $# > 0 )); do
    case "$1" in
      --approved-by) require_value "$1" "${2:-}"; approved_by="$2"; shift 2 ;;
      --note) require_value "$1" "${2:-}"; note="$2"; shift 2 ;;
      *) die "vision approve: unknown option '$1'" ;;
    esac
  done
  [[ -n "$slug" && -n "$approved_by" ]] || die "Usage: spectacular vision approve <slug> --approved-by <human> [--note <text>]"
  local vdir spine
  vdir=$(_vision_find "$slug") || die "vision approve: Vision '$slug' not found"
  _vision_is_legacy "$vdir" && die "vision approve: legacy request Vision has no whole-Vision lifecycle"
  spine="$vdir/VISION.md"; [[ "$(fm_get "$spine" status)" == proposed ]] || die "vision approve: expected proposed"
  _vision_assert_resolved "$vdir"
  fm_set "$spine" status approved; fm_set "$spine" approved_by "$approved_by"; fm_set "$spine" approved_at "$TODAY"; fm_touch "$spine"
  _vision_replace_approval "$spine" "Approved $TODAY by $approved_by.${note:+ $note}"
  info "  ✓ $slug: proposed → approved"
  info "  ↳ next: /spectacular vision derive $slug"
}

cmd_vision_reject() {
  local slug="${1:-}" rejected_by="" reason=""; shift || true
  while (( $# > 0 )); do
    case "$1" in
      --rejected-by) require_value "$1" "${2:-}"; rejected_by="$2"; shift 2 ;;
      --reason) require_value "$1" "${2:-}"; reason="$2"; shift 2 ;;
      *) die "vision reject: unknown option '$1'" ;;
    esac
  done
  [[ -n "$slug" && -n "$rejected_by" && -n "$reason" ]] || die "Usage: spectacular vision reject <slug> --rejected-by <human> --reason <why>"
  local vdir spine status
  vdir=$(_vision_find "$slug") || die "vision reject: Vision '$slug' not found"
  _vision_is_legacy "$vdir" && die "vision reject: legacy request Vision has no whole-Vision lifecycle"
  spine="$vdir/VISION.md"; status=$(fm_get "$spine" status)
  [[ "$status" == draft || "$status" == proposed ]] || die "vision reject: expected draft or proposed"
  fm_set "$spine" status rejected; fm_set "$spine" rejected_by "$rejected_by"; fm_set "$spine" rejected_at "$TODAY"; fm_set "$spine" rejection_reason "$reason"; fm_touch "$spine"
  _vision_replace_approval "$spine" "Rejected $TODAY by $rejected_by — $reason"
  info "  ✓ $slug: $status → rejected"
}

cmd_vision_derive() {
  local slug="${1:-}" vdir spine
  [[ -n "$slug" ]] || die "Usage: spectacular vision derive <slug>"
  vdir=$(_vision_find "$slug") || die "vision derive: Vision '$slug' not found"
  _vision_is_legacy "$vdir" && die "vision derive: legacy request Vision already belongs to execution planning"
  spine="$vdir/VISION.md"; [[ "$(fm_get "$spine" status)" == approved ]] || die "vision derive: Vision must be approved"
  skill_verb_message "vision derive $slug" \
    "Derive a draft SPC from this approved Vision, approved fragments only, and linked evidence. Preserve Vision as provenance; do not create a request or authorize implementation."
}

cmd_vision() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list) cmd_vision_list "$@" ;;
    show) cmd_vision_show "$@" ;;
    add) cmd_vision_add "$@" ;;
    react) cmd_vision_react "$@" ;;
    propose) cmd_vision_propose "$@" ;;
    approve) cmd_vision_approve "$@" ;;
    reject) cmd_vision_reject "$@" ;;
    derive) cmd_vision_derive "$@" ;;
    --help|-h|"")
      cat <<EOF
Usage: spectacular vision <list|show|add|react|propose|approve|reject|derive>

  list
  show <slug>
  add <strategy|story|flow|ui|arch|prototype> <name> --slug <slug> [--caption <text>]
  react <slug> <fragment> --approve|--revise|--reject|--supersede [--note <text>]
  propose <slug>
  approve <slug> --approved-by <human> [--note <text>]
  reject <slug> --rejected-by <human> --reason <why>
  derive <slug>          Agentic: approved Vision → draft SPC

Start with: spectacular imagine <slug>
EOF
      [[ -n "$sub" ]] || exit 1 ;;
    *) die "vision: unknown subcommand '$sub'" ;;
  esac
}

# ── archive ──────────────────────────────────────────────────────────────────
# ── read verbs (v1.8.0+) ─────────────────────────────────────────────────────
# Read-only listing + detail + workspace verbs. Collapse multi-step agent
# workflows into single deterministic CLI calls.
#
# Grammar:
#   plural noun       = list (requests, decisions, memories, sessions)
#   singular + slug   = detail (request <slug>, decision <slug>, memory <slug>)
#   show <doctype>    = dump canonical doc
#   summary           = workspace overview
#   progress <slug>   = milestone tick rate for a request
#   paths             = JSON path map
#
# Universal flags: --status, --since, --limit (default 20), --all, --json
# Detail verbs add: --full (bypass skim mode)

# Parse a duration string like "7d", "24h", "2w" → epoch threshold.
# Returns 0 (epoch start) if input is empty or unparseable.
_parse_since() {
  local input="$1"
  [[ -z "$input" ]] && { echo 0; return 0; }
  local num unit seconds
  if [[ "$input" =~ ^([0-9]+)([dhw])$ ]]; then
    num="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]}"
    case "$unit" in
      h) seconds=$((num * 3600)) ;;
      d) seconds=$((num * 86400)) ;;
      w) seconds=$((num * 604800)) ;;
    esac
    echo $(( $(date +%s) - seconds ))
    return 0
  fi
  die "Invalid --since value: '$input'. Use Nh, Nd, or Nw (e.g. 24h, 7d, 2w)."
}

# Convert a YYYY-MM-DD date string to epoch. Returns 0 on parse failure.
_date_to_epoch() {
  local d="$1"
  [[ -z "$d" ]] && { echo 0; return 0; }
  date -j -f "%Y-%m-%d" "$d" "+%s" 2>/dev/null || echo 0
}

# Escape a string for JSON. Handles backslashes, quotes, newlines, tabs.
_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}

# Iterate over all request directories. Emits one path per request (PLAN.md).
_request_iter_all() {
  local d
  [[ -d "$SPEC_REQUESTS_DIR" ]] || return 0
  for d in "$SPEC_REQUESTS_DIR"/*/; do
    [[ -d "$d" ]] || continue
    [[ -f "$d/PLAN.md" ]] && echo "$d/PLAN.md"
  done
}

# ── cmd_requests (list) ──────────────────────────────────────────────────────
cmd_requests() {
  local status_filter="all" since="" limit=20 show_all=false json=false
  while (( $# > 0 )); do
    case "$1" in
      --status) require_value "--status" "${2:-}"; status_filter="$2"; shift 2 ;;
      --active) status_filter="active"; shift ;;
      --since)  require_value "--since" "${2:-}"; since="$2"; shift 2 ;;
      --limit)  require_value "--limit" "${2:-}"; limit="$2"; shift 2 ;;
      --all)    show_all=true; shift ;;
      --json)   json=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular requests [options]

List requests with their lifecycle state.

Options:
  --status <s>    planned | active | review | verified | all  (default: all)
  --active        Alias for --status active
  --since <dur>   Filter to requests updated within duration (e.g. 7d, 24h, 2w)
  --limit <n>     Cap output at n rows (default: 20)
  --all           No limit
  --json          JSON output (array of objects)

Examples:
  spectacular requests --active
  spectacular requests --status review --json
  spectacular requests --since 30d
EOF
        exit 0 ;;
      *) die "Unknown flag for requests: $1" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "requests: not inside a Spectacular workspace"
  [[ "$limit" =~ ^[0-9]+$ ]] || die "requests: --limit must be a positive integer"
  (( limit > 0 )) || die "requests: --limit must be > 0"

  local since_epoch
  since_epoch=$(_parse_since "$since")

  # Collect rows
  local rows=() count=0
  local f slug status priority updated target summary
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    slug=$(basename "$(dirname "$f")")
    status=$(fm_get "$f" "status")
    [[ -z "$status" ]] && status="?"
    if [[ "$status_filter" != "all" && "$status" != "$status_filter" ]]; then
      continue
    fi
    updated=$(fm_get "$f" "updated")
    if (( since_epoch > 0 )); then
      local upd_epoch
      upd_epoch=$(_date_to_epoch "$updated")
      (( upd_epoch < since_epoch )) && continue
    fi
    priority=$(fm_get "$f" "priority")
    target=$(fm_get "$f" "target_version")
    summary=$(fm_get "$f" "summary")
    rows+=("$slug|${status}|${priority:-?}|${target:-—}|${updated:-?}|${summary:-}")
    count=$((count + 1))
  done < <(_request_iter_all)

  # Apply limit unless --all
  local effective_limit=$count
  if ! $show_all && (( count > limit )); then
    effective_limit=$limit
  fi

  if $json; then
    printf '['
    local i=0
    for row in "${rows[@]:0:$effective_limit}"; do
      IFS='|' read -r slug status priority target updated summary <<< "$row"
      (( i > 0 )) && printf ','
      printf '{"slug":"%s","status":"%s","priority":"%s","target_version":"%s","updated":"%s","summary":"%s"}' \
        "$(_json_escape "$slug")" "$(_json_escape "$status")" "$(_json_escape "$priority")" \
        "$(_json_escape "$target")" "$(_json_escape "$updated")" "$(_json_escape "$summary")"
      i=$((i + 1))
    done
    printf ']\n'
    return 0
  fi

  if (( count == 0 )); then
    info "(no requests match)"
    return 0
  fi

  printf "%-28s  %-10s  %-8s  %-8s  %-10s  %s\n" "SLUG" "STATUS" "PRIORITY" "TARGET" "UPDATED" "SUMMARY"
  printf "%-28s  %-10s  %-8s  %-8s  %-10s  %s\n" "----" "------" "--------" "------" "-------" "-------"
  local row
  for row in "${rows[@]:0:$effective_limit}"; do
    IFS='|' read -r slug status priority target updated summary <<< "$row"
    local slug_disp="$slug" summary_disp="$summary"
    (( ${#slug_disp} > 28 )) && slug_disp="${slug_disp:0:25}..."
    (( ${#summary_disp} > 60 )) && summary_disp="${summary_disp:0:57}..."
    printf "%-28s  %-10s  %-8s  %-8s  %-10s  %s\n" \
      "$slug_disp" "$status" "$priority" "$target" "$updated" "$summary_disp"
  done

  if (( count > effective_limit )); then
    info "(showing $effective_limit of $count — use --all for full list)"
  fi
}

# ── cmd_next (v1.19.0+) ──────────────────────────────────────────────────────
# Read-only. Names the single highest-priority next action. Lifecycle-state
# ordering: an active request in flight beats starting a planned one; a review
# request waiting on verify beats both. Empty workspace → usher into `new`.
# Mutates nothing. ponytail: priority is a coarse high/medium/low rank; if a
# numeric priority is ever added, swap _prio_weight for it.
_prio_weight() {
  case "$1" in
    high) echo 0 ;; medium|"") echo 1 ;; low) echo 2 ;; *) echo 1 ;;
  esac
}

cmd_next() {
  case "${1:-}" in
    --help|-h)
      cat <<EOF
Usage: spectacular next

Print the single highest-priority next action for this workspace. Read-only —
mutates nothing. Order: active (keep going / advance) > review (verify) >
planned (advance the top-priority one) > empty (start your first request).
EOF
      exit 0 ;;
    "") : ;;
    *) die "next takes no arguments (got '$1')" ;;
  esac

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "next: not inside a Spectacular workspace"

  # Pick the best request per state: lowest priority-weight, tie-break newest.
  local best_active="" best_active_w=9 best_active_upd=""
  local best_review="" best_review_w=9 best_review_upd=""
  local best_planned="" best_planned_w=9 best_planned_upd=""
  local f slug status priority updated w
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    slug=$(basename "$(dirname "$f")")
    status=$(fm_get "$f" "status")
    priority=$(fm_get "$f" "priority")
    updated=$(fm_get "$f" "updated")
    w=$(_prio_weight "$priority")
    case "$status" in
      active)
        if (( w < best_active_w )) || { (( w == best_active_w )) && [[ "$updated" > "$best_active_upd" ]]; }; then
          best_active="$slug"; best_active_w=$w; best_active_upd="$updated"
        fi ;;
      review)
        if (( w < best_review_w )) || { (( w == best_review_w )) && [[ "$updated" > "$best_review_upd" ]]; }; then
          best_review="$slug"; best_review_w=$w; best_review_upd="$updated"
        fi ;;
      planned)
        if (( w < best_planned_w )) || { (( w == best_planned_w )) && [[ "$updated" > "$best_planned_upd" ]]; }; then
          best_planned="$slug"; best_planned_w=$w; best_planned_upd="$updated"
        fi ;;
    esac
  done < <(_request_iter_all)

  info "── Next ──"
  info ""
  if [[ -n "$best_active" ]]; then
    info "  ▸ Keep working  $best_active  (active)"
    info "    when done:    spectacular advance $best_active"
  elif [[ -n "$best_review" ]]; then
    info "  ▸ Verify        $best_review  (review)"
    info "    run:          /spectacular verify $best_review"
  elif [[ -n "$best_planned" ]]; then
    info "  ▸ Start         $best_planned  (planned, top priority)"
    info "    begin:        spectacular advance $best_planned"
  else
    info "  ▸ No requests yet — start your first one:"
    info "    spectacular new <description>"
  fi
}

# ── Wayfinding fog/frontier ──────────────────────────────────────────────────
_fm_list() {
  local file="$1" field="$2"
  awk -v fld="$field" '
    /^---$/ { fm++; if (fm > 1) exit; next }
    fm != 1 { next }
    found && /^[a-zA-Z_][a-zA-Z0-9_-]*:/ { exit }
    found && /^[[:space:]]*-[[:space:]]+/ {
      val=$0; sub(/^[[:space:]]*-[[:space:]]+/, "", val); sub(/[[:space:]]+#.*$/, "", val)
      gsub(/^"|"$/, "", val); if (val != "") print val
    }
    $0 ~ "^" fld ":" {
      found=1
      val=$0; sub("^" fld ":[[:space:]]*", "", val)
      if (val ~ /^\[.*\]$/) {
        gsub(/^\[|\]$/, "", val); gsub(/,[[:space:]]*/, "\n", val)
        if (val != "") print val
      }
    }
  ' "$file"
}

_wayfind_iter() {
  local collection f
  for collection in questions research spikes specs; do
    [[ -d "$SPEC_WORKSPACE_DIR/$collection" ]] || continue
    for f in "$SPEC_WORKSPACE_DIR/$collection"/*.md; do
      [[ -f "$f" ]] || continue
      [[ "$(basename "$f")" == index.md ]] && continue
      [[ -n "$(fm_get "$f" id)" ]] && echo "$f"
    done
  done
}

_wayfind_validate_or_die() {
  local tmp nodes edges f id dep cycle
  tmp=$(mktemp -d); nodes="$tmp/nodes"; edges="$tmp/edges"
  : > "$nodes"; : > "$edges"
  while IFS= read -r f; do
    id=$(fm_get "$f" id); [[ -n "$id" ]] || continue
    printf '%s\n' "$id" >> "$nodes"
    while IFS= read -r dep; do
      [[ -n "$dep" ]] || continue
      _wayfind_find_id "$dep" >/dev/null || { rm -rf "$tmp"; die "wayfind: dangling dependency $id → $dep; run 'spectacular doctor wayfinding'"; }
      printf '%s|%s\n' "$id" "$dep" >> "$edges"
    done < <(_fm_list "$f" blocked_by)
  done < <(_wayfind_iter)
  cycle=$(awk -F'|' '
    NR==FNR { node[$1]=1; next }
    { adj[$1]=adj[$1] " " $2 }
    function visit(n, p,i,m,x) {
      if (color[n] == 1) return 1
      if (color[n] == 2) return 0
      color[n]=1; m=split(adj[n],p," ")
      for (i=1;i<=m;i++) { x=p[i]; if (x != "" && node[x] && visit(x)) return 1 }
      color[n]=2; return 0
    }
    END { for (n in node) if (color[n] == 0 && visit(n)) { print n; exit } }
  ' "$nodes" "$edges")
  rm -rf "$tmp"
  [[ -z "$cycle" ]] || die "wayfind: dependency cycle includes $cycle; run 'spectacular doctor wayfinding'"
}

# Dependency-first, deterministic ordering. External satisfied nodes such as
# decisions participate as prerequisites but are not rendered as actionable
# discovery nodes. Cycles are rejected before this helper runs.
_wayfind_topological_iter() {
  local tmp remaining next emitted f id dep blocked progress
  tmp=$(mktemp -d); remaining="$tmp/remaining"; next="$tmp/next"; emitted=" "
  : > "$remaining"
  while IFS= read -r f; do
    id=$(fm_get "$f" id); [[ -n "$id" ]] && printf '%s|%s\n' "$id" "$f"
  done < <(_wayfind_iter) | sort > "$remaining"
  while [[ -s "$remaining" ]]; do
    : > "$next"; progress=false
    while IFS='|' read -r id f; do
      blocked=false
      while IFS= read -r dep; do
        [[ -n "$dep" ]] || continue
        if grep -q "^${dep}|" "$remaining" && [[ "$emitted" != *" $dep "* ]]; then blocked=true; break; fi
      done < <(_fm_list "$f" blocked_by)
      if $blocked; then
        printf '%s|%s\n' "$id" "$f" >> "$next"
      else
        echo "$f"; emitted+="$id "; progress=true
      fi
    done < "$remaining"
    $progress || { rm -rf "$tmp"; return 1; }
    mv "$next" "$remaining"
  done
  rm -rf "$tmp"
}

_wayfind_find_id() {
  local id="$1" prefix dir f n archive_dir=""
  if _is_uuidv7 "$id"; then
    for dir in decisions questions ideas research spikes specs; do
      for f in "$SPEC_WORKSPACE_DIR/$dir"/*.md "$SPEC_ARCHIVE_DIR/$dir"/*.md; do
        [[ -f "$f" && "$(fm_get "$f" id)" == "$id" ]] && { echo "$f"; return 0; }
      done
    done
    return 1
  fi
  prefix="${id%%-*}"
  case "$prefix" in
    DEC) dir=decisions ;;
    QUE) dir=questions; archive_dir="$SPEC_ARCHIVE_DIR/questions" ;;
    IDEA) dir=ideas ;;
    RES) dir=research ;;
    SPK) dir=spikes ;;
    SPC) dir=specs; archive_dir="$SPEC_ARCHIVE_DIR/specs" ;;
    *) return 1 ;;
  esac
  for f in "$SPEC_WORKSPACE_DIR/$dir/$id"-*.md "$SPEC_WORKSPACE_DIR/$dir/$id".md; do
    [[ -f "$f" ]] && { echo "$f"; return 0; }
  done
  if [[ -n "$archive_dir" ]]; then
    for f in "$archive_dir/$id"-*.md "$archive_dir/$id".md; do
      [[ -f "$f" ]] && { echo "$f"; return 0; }
    done
  fi
  if [[ "$prefix" == DEC ]]; then
    n=$((10#${id#DEC-}))
    for f in "$SPEC_DECISIONS_DIR"/D"$n"-*.md "$SPEC_DECISIONS_DIR"/D"$n".md; do
      [[ -f "$f" ]] && { echo "$f"; return 0; }
    done
  fi
  return 1
}

_wayfind_satisfied() {
  local file="$1" status type result archived_from
  status=$(fm_get "$file" status); type=$(fm_get "$file" type)
  [[ -z "$status" && "$file" == "$SPEC_DECISIONS_DIR"/* ]] && return 0
  if [[ "$status" == completed ]]; then
    result=$(fm_get "$file" result)
    [[ "$result" == supported || "$result" == refuted ]] && return 0
    return 1
  fi
  case "$status" in resolved|verified|approved|implemented|superseded|deprecated|promoted) return 0 ;; esac
  if [[ "$status" == archived ]]; then
    archived_from=$(fm_get "$file" archived_from)
    case "$archived_from" in resolved|completed|verified|approved|implemented|superseded|deprecated|promoted) return 0 ;; esac
  fi
  return 1
}

_wayfind_readiness() {
  local file="$1" status dep dep_file
  status=$(fm_get "$file" status)
  [[ "$status" == deferred ]] && { echo deferred; return 0; }
  [[ "$status" == completed && "$(fm_get "$file" result)" == inconclusive ]] && { echo fog; return 0; }
  _wayfind_satisfied "$file" && { echo resolved; return 0; }
  while IFS= read -r dep; do
    [[ -n "$dep" ]] || continue
    dep_file=$(_wayfind_find_id "$dep") || { echo fog; return 0; }
    _wayfind_satisfied "$dep_file" || { echo fog; return 0; }
  done < <(_fm_list "$file" blocked_by)
  echo frontier
}

_wayfind_label() {
  local file="$1" label
  label=$(fm_get "$file" summary)
  [[ -z "$label" ]] && label=$(awk '/^## (Question|Goal)/{getline; getline; print; exit}' "$file")
  [[ -z "$label" ]] && label=$(basename "$file" .md)
  echo "$label"
}

cmd_wayfind() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    status) cmd_wayfind_status "$@" ;;
    next) cmd_wayfind_next "$@" ;;
    order) cmd_wayfind_order "$@" ;;
    resolve) cmd_wayfind_resolve "$@" ;;
    defer) cmd_wayfind_hold deferred "$@" ;;
    resume) cmd_wayfind_hold open "$@" ;;
    route) cmd_wayfind_route "$@" ;;
    path) cmd_wayfind_path "$@" ;;
    ""|--help|-h)
      cat <<EOF
Usage: spectacular wayfind <status|next|order|resolve|defer|resume|route|path>

  status [--blockers-only]  Show durable fog and the actionable frontier
  next                      Pick one dependency-ready, high-uncertainty node
  order                     Print strict dependency-first topological order
  resolve <id> [options]    Resolve a question, research record, or spike
  defer <id> --reason <why> Put an open loop on ice without losing it
  resume <id>               Return a deferred loop to open
  path <id>                 Show the target and its immediate prerequisites
  route <phrase> ...        Route a Wayfinder metaphor through a safe CLI verb
EOF
      ;;
    *) die "wayfind: unknown subcommand '$sub'" ;;
  esac
}

cmd_wayfind_status() {
  local blockers_only=false
  [[ "${1:-}" == --blockers-only ]] && blockers_only=true && shift
  (( $# == 0 )) || die "wayfind status: unknown argument '$1'"
  _wayfind_validate_or_die
  local f id type state req label frontier=0 fog=0 deferred=0 resolved=0 blockers=0 blocker_rows=""
  if $blockers_only; then
    info "── Questions requiring your input ──"
  else
    printf '%-10s  %-12s  %-10s  %s\n' "ID" "READINESS" "TYPE" "SUMMARY"
    printf '%-10s  %-12s  %-10s  %s\n' "--" "---------" "----" "-------"
  fi
  while IFS= read -r f; do
    id=$(fm_get "$f" id); type=$(fm_get "$f" type); state=$(_wayfind_readiness "$f"); req=$(fm_get "$f" requires_user_input); label=$(_wayfind_label "$f")
    case "$state" in frontier) frontier=$((frontier+1)) ;; fog) fog=$((fog+1)) ;; deferred) deferred=$((deferred+1)) ;; resolved) resolved=$((resolved+1)) ;; esac
    if $blockers_only; then
      if [[ "$type" == question && "$req" == true && "$state" != resolved && "$state" != deferred ]]; then
        local downstream=0 dependent
        while IFS= read -r dependent; do
          while IFS= read -r dep; do [[ "$dep" == "$id" ]] && downstream=$((downstream + 1)); done < <(_fm_list "$dependent" blocked_by)
        done < <(_wayfind_iter)
        blocker_rows+="$(_prio_weight "$(fm_get "$f" priority)")"$'\t'"$downstream"$'\t'"$id"$'\t'"$state"$'\t'"$label"$'\n'
        blockers=$((blockers+1))
      fi
    else
      printf '%-10s  %-12s  %-10s  %s\n' "$id" "$state" "$type" "$label"
    fi
  done < <(_wayfind_topological_iter)
  if $blockers_only; then
    if (( blockers > 0 )); then
      while IFS=$'\t' read -r _priority downstream id state label; do
        info "  ▸ $id — $label [$state; blocks $downstream]"
      done < <(printf '%s' "$blocker_rows" | sort -t $'\t' -k1,1n -k2,2nr -k3,3)
    else
      info "  ✓ No immediate human blockers"
    fi
  else
    info ""
    info "Fog: $((frontier + fog)) unresolved · Frontier: $frontier actionable · Blocked: $fog · Deferred: $deferred · Resolved: $resolved"
  fi
}

_wayfind_risk_weight() {
  local type="$1" requires="$2"
  [[ "$type" == question && "$requires" == true ]] && { echo 0; return; }
  case "$type" in spike) echo 1 ;; research) echo 2 ;; question) echo 3 ;; specification) echo 4 ;; *) echo 5 ;; esac
}

_wayfind_target_weight() {
  local value="$1" core suffix major minor patch phase=1
  [[ "$value" =~ ^v?([0-9]+)\.([0-9]+)\.([0-9]+)(-(discovery|execution))?$ ]] || return 1
  major="${BASH_REMATCH[1]}"; minor="${BASH_REMATCH[2]}"; patch="${BASH_REMATCH[3]}"; suffix="${BASH_REMATCH[5]:-}"
  [[ "$suffix" == discovery ]] && phase=0
  [[ "$suffix" == execution ]] && phase=2
  echo $((10#$major * 10000000 + 10#$minor * 10000 + 10#$patch * 10 + phase))
}

cmd_wayfind_next() {
  (( $# == 0 )) || die "wayfind next takes no arguments"
  _wayfind_validate_or_die
  local f state type req w p best="" best_w=99 best_p=99 id label
  while IFS= read -r f; do
    state=$(_wayfind_readiness "$f"); [[ "$state" == frontier ]] || continue
    type=$(fm_get "$f" type); req=$(fm_get "$f" requires_user_input); w=$(_wayfind_risk_weight "$type" "$req")
    p=$(_prio_weight "$(fm_get "$f" priority)")
    if (( p < best_p )) || { (( p == best_p )) && (( w < best_w )); }; then best="$f"; best_p=$p; best_w=$w; fi
  done < <(_wayfind_topological_iter)
  if [[ -z "$best" ]]; then info "No actionable frontier node; inspect: spectacular wayfind status"; return 0; fi
  id=$(fm_get "$best" id); type=$(fm_get "$best" type); label=$(_wayfind_label "$best")
  info "── Wayfinding next ──"
  info "  ▸ $id [$type] — $label"
  [[ "$(fm_get "$best" requires_user_input)" == true ]] && info "  ⛔ requires user input"
  [[ "$type" == spike ]] && info "  ⛔ execution requires authorization"
  return 0
}

cmd_wayfind_order() {
  (( $# == 0 )) || die "wayfind order takes no arguments"
  _wayfind_validate_or_die
  local f id state
  while IFS= read -r f; do
    id=$(fm_get "$f" id); state=$(_wayfind_readiness "$f")
    printf '%s\t%s\n' "$id" "$state"
  done < <(_wayfind_topological_iter)
}

cmd_wayfind_resolve() {
  local ref="${1:-}"; [[ -n "$ref" ]] || die "wayfind resolve: ID required"
  shift || true
  local id prefix record
  id=$(_canonical_resolve "$ref")
  record=$(_wayfind_find_id "$id") || die "wayfind resolve: $id not found"
  prefix="${id%%-*}"
  _is_uuidv7 "$id" && prefix=$(fm_get "$record" kind)
  case "$prefix" in
    QUE|question) cmd_question_resolve "$id" "$@" ;;
    RES|research) _discovery_resolve research research "$id" "$@" ;;
    SPK|spike) _discovery_resolve spike spikes "$id" "$@" ;;
    *) die "wayfind resolve: $id is not resolvable here; use its lifecycle command" ;;
  esac
}

cmd_wayfind_path() {
  local ref="${1:-}"; shift || true
  [[ -n "$ref" && $# -eq 0 ]] || die "Usage: spectacular wayfind path <id>"
  _wayfind_validate_or_die
  local id path dep dep_file state
  id=$(_canonical_resolve "$ref"); path=$(_wayfind_find_id "$id") || die "wayfind path: $id not found"
  state=$(_wayfind_readiness "$path")
  info "── Find your way to $id [$state] ──"
  while IFS= read -r dep; do
    [[ -n "$dep" ]] || continue
    dep_file=$(_wayfind_find_id "$dep") || continue
    info "  ← $dep [$(_wayfind_readiness "$dep_file")]"
  done < <(_fm_list "$path" blocked_by)
  [[ -n "$( _fm_list "$path" blocked_by )" ]] || info "  ✓ no prerequisites"
}

cmd_wayfind_route() {
  local phrase="${1:-}"; [[ -n "$phrase" ]] || die "wayfind route: phrase required"
  shift || true
  local normalized
  normalized=$(printf '%s' "$phrase" | tr '[:upper:]' '[:lower:]' | tr -s ' ')
  case "$normalized" in
    "park this idea"|park) cmd_idea_new "$@" ;;
    "put it on ice"|icebox|ice) cmd_wayfind_hold deferred "$@" ;;
    "find your way to"|find) cmd_wayfind_path "$@" ;;
    "act on goal"|act) cmd_spec_act "$@" ;;
    *) die "wayfind route: unknown metaphor '$phrase'" ;;
  esac
}

cmd_wayfind_hold() {
  local target="$1"; shift
  local ref="" reason="" review_after="" id path
  while (( $# > 0 )); do
    case "$1" in --reason) require_value "--reason" "${2:-}"; reason="$2"; shift 2 ;; --review-after) require_value "--review-after" "${2:-}"; review_after="$2"; shift 2 ;; -*) die "wayfind: unknown flag '$1'" ;; *) [[ -z "$ref" ]] || die "wayfind: only one ID allowed"; ref="$1"; shift ;; esac
  done
  [[ -n "$ref" ]] || die "wayfind: ID required"
  id=$(_canonical_resolve "$ref")
  path=$(_wayfind_find_id "$id") || die "wayfind: $id not found"
  if [[ "$target" == deferred ]]; then
    [[ -n "$reason" ]] || die "wayfind defer: --reason is required"
    fm_set "$path" status deferred; fm_set "$path" deferred_reason "$reason"
    [[ -n "$review_after" ]] && fm_set "$path" review_after "$review_after"
  else
    fm_set "$path" status open; fm_unset "$path" deferred_reason; fm_unset "$path" review_after
  fi
  fm_touch "$path"
  info "  ✓  $id → $target"
}

# ── AFK Git hygiene ─────────────────────────────────────────────────────────
_afk_config_get() {
  local field="$1"
  [[ -f "$SPEC_CONFIG_FILE" ]] || return 0
  awk -v fld="$field" '
    /^afk_git:/ { on=1; next }
    on && /^[^[:space:]#]/ { exit }
    on && $0 ~ "^[[:space:]]+" fld ":" {
      sub("^[[:space:]]+" fld ":[[:space:]]*", ""); sub(/[[:space:]]+#.*$/, ""); gsub(/^"|"$/, ""); print; exit
    }
  ' "$SPEC_CONFIG_FILE"
}

_afk_enabled() { [[ "$(_afk_config_get enabled)" == true ]]; }
_afk_allow_pr() { [[ "$(_afk_config_get allow_pr_create)" == true ]]; }
_afk_prefix() { _afk_config_get branch_prefix; }
_afk_primary_list() { local v; v=$(_afk_config_get primary_branches); echo "${v:-main,master,develop}"; }

_forge_config_get() {
  local key="$1"
  [[ -f "$SPEC_CONFIG_FILE" ]] || return 0
  awk -v key="$key" '
    /^forge:[[:space:]]*$/ { inside=1; next }
    inside && /^[^[:space:]]/ { exit }
    inside && $0 ~ "^[[:space:]]+" key ":[[:space:]]*" {
      sub("^[[:space:]]+" key ":[[:space:]]*", ""); gsub(/^"|"$/, ""); print; exit
    }
  ' "$SPEC_CONFIG_FILE"
}

_contract_shared_base() { local base; base=$(_forge_config_get shared_base); echo "${base:-main}"; }

_contract_commit() {
  local spec="$1" commit
  commit=$(git log --diff-filter=A --format=%H -- "$spec" 2>/dev/null | tail -1)
  [[ -n "$commit" ]] || commit=$(git log -1 --format=%H -- "$spec" 2>/dev/null)
  [[ -n "$commit" ]] || return 1
  printf '%s\n' "$commit"
}

_contract_is_merged() {
  local spec="$1" base commit
  base=$(_contract_shared_base)
  git rev-parse --verify "$base^{commit}" >/dev/null 2>&1 || return 1
  commit=$(_contract_commit "$spec") || return 1
  git merge-base --is-ancestor "$commit" "$base" 2>/dev/null
}

_execution_contains_contract() {
  local spec="$1" commit
  commit=$(_contract_commit "$spec") || return 1
  git merge-base --is-ancestor "$commit" HEAD 2>/dev/null
}
_afk_is_primary() {
  local branch="$1" item list
  list=$(_afk_primary_list); local IFS=','
  for item in $list; do [[ "$branch" == "$item" ]] && return 0; done
  return 1
}
_afk_require_repo() { git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "afk: not inside a Git repository"; }
_afk_require_clean() { [[ -z "$(git status --porcelain 2>/dev/null)" ]] || die "afk: working tree is dirty; commit, stash, or park changes before branch mutation"; }

# ── Workspace coordination ──────────────────────────────────────────────────
# This intentionally has no persistent path-ownership registry. A branch is
# evidence about a request, not evidence that every dirty source file belongs
# to it. Unrecognised paths remain preservation candidates.
_workspace_require_repo() { git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "workspace: not inside a Git repository"; }
_workspace_current_branch() { git branch --show-current 2>/dev/null || true; }
_workspace_base() { _contract_shared_base; }
_workspace_remote_base_state() {
  local base="$1"
  if ! git remote get-url origin >/dev/null 2>&1; then echo "no-remote"; return; fi
  if ! git rev-parse --verify "origin/$base^{commit}" >/dev/null 2>&1; then echo "unknown (origin/$base not fetched)"; return; fi
  if [[ "$(git rev-parse "$base" 2>/dev/null || true)" == "$(git rev-parse "origin/$base")" ]]; then
    echo "fresh (local $base equals origin/$base)"
  else
    echo "stale (local $base differs from origin/$base)"
  fi
}
_workspace_provider_state() {
  # Git ancestry is primary. Provider data is optional evidence and must never
  # be inferred from the presence of a remote.
  local branch="$1" remote state
  remote=$(git remote get-url origin 2>/dev/null || true)
  [[ -n "$remote" ]] || { echo "unknown (no remote)"; return; }
  case "$remote" in *github.com*) ;; *) echo "unknown (no provider adapter)"; return ;; esac
  command -v gh >/dev/null 2>&1 || { echo "unknown (GitHub adapter unavailable)"; return; }
  state=$(gh pr list --head "$branch" --state all --json state --jq '.[0].state' 2>/dev/null || true)
  [[ -n "$state" ]] && echo "$state" || echo "none (adapter found no PR)"
}
_workspace_request_for_branch() {
  local branch="$1" plan
  for plan in "$SPEC_REQUESTS_DIR"/*/PLAN.md; do
    [[ -f "$plan" ]] || continue
    [[ "$(fm_get "$plan" branch)" == "$branch" ]] && { basename "$(dirname "$plan")"; return 0; }
  done
  return 1
}
_workspace_path_owner() {
  local path="$1" current="$2" request
  case "$path" in
    .spectacular/requests/*/*)
      request=$(printf '%s' "$path" | cut -d/ -f3)
      [[ -f "$SPEC_REQUESTS_DIR/$request/PLAN.md" ]] && {
        [[ "$request" == "$current" ]] && echo "$request|high|belongs-to-current-request" || echo "$request|high|belongs-to-known-work"
        return 0
      } ;;
    .spectacular/specs/*.md)
      request=$(basename "$path" .md)
      [[ -f "$SPEC_SPECS_DIR/$request.md" ]] && { echo "spec:$request|high|belongs-to-known-work"; return 0; } ;;
  esac
  # A caller can explicitly name the request; still only its durable request
  # folder receives automatic ownership. Arbitrary code paths stay unowned.
  if [[ -n "$current" && "$path" == ".spectacular/requests/$current/"* ]]; then
    echo "$current|high|belongs-to-current-request"
  else
    echo "unowned|none|needs-preservation-branch"
  fi
}
_workspace_changed_paths() {
  local record code path
  git status --porcelain=v1 -z 2>/dev/null | while IFS= read -r -d '' record; do
    code=${record:0:2}; path=${record:3}
    # Rename/copy records carry a second NUL path; report the destination, the
    # user-visible changed path that needs a disposition.
    if [[ "$code" == *R* || "$code" == *C* ]]; then IFS= read -r -d '' _old || true; fi
    case "$code" in
      \?\?) printf 'untracked\t%s\n' "$path" ;;
      *)
        [[ "${code:0:1}" != ' ' ]] && printf 'staged\t%s\n' "$path"
        [[ "${code:1:1}" != ' ' ]] && printf 'unstaged\t%s\n' "$path"
        ;;
    esac
  done
}
_workspace_report() {
  local request="${1:-}" branch upstream base ahead behind owner confidence disposition group path any=false remote_state provider_state
  _workspace_require_repo
  branch=$(_workspace_current_branch); base=$(_workspace_base)
  upstream=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null || true)
  if git rev-parse --verify "$base^{commit}" >/dev/null 2>&1; then
    read -r behind ahead <<EOF
$(git rev-list --left-right --count "$base...HEAD" 2>/dev/null || echo "unknown unknown")
EOF
  else behind=unknown; ahead=unknown; fi
  info "── Workspace coordination (read-only) ──"
  info "  branch:   ${branch:-(detached)}"
  info "  upstream: ${upstream:-unknown}"
  info "  base:     $base"
  info "  divergence from base: ahead ${ahead:-unknown}, behind ${behind:-unknown}"
  remote_state=$(_workspace_remote_base_state "$base")
  info "  remote base freshness: $remote_state"
  [[ -n "$request" ]] || request=$(_workspace_request_for_branch "$branch" 2>/dev/null || true)
  info "  associated request: ${request:-unknown}"
  provider_state=$(_workspace_provider_state "$branch")
  info "  provider PR/MR facts: $provider_state"
  info "  changed paths:"
  while IFS=$'\t' read -r group path; do
    any=true
    IFS='|' read -r owner confidence disposition <<EOF
$(_workspace_path_owner "$path" "$request")
EOF
    info "    - [$group] $path"
    info "      owner: $owner (confidence: $confidence) · disposition: $disposition"
  done < <(_workspace_changed_paths)
  if ! $any; then
    info "    - none"
    info "  blockers: none"
    info "  safe next action: inspect and implement on this clean branch"
  else
    info "  blockers: unowned paths require explicit intent or preservation"
    info "  safe next action: spectacular workspace preserve <slug> --paths <unowned-paths>"
    info "  mutation commands: none (read-only report)"
  fi
}
_workspace_report_json() {
  # A compact stable envelope for scripts. The human report remains the full
  # path-by-path explanation; JSON deliberately preserves unknown evidence.
  local request="${1:-}" branch base upstream ahead behind remote_state provider_state
  _workspace_require_repo; branch=$(_workspace_current_branch); base=$(_workspace_base)
  upstream=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null || true)
  if git rev-parse --verify "$base^{commit}" >/dev/null 2>&1; then read -r behind ahead <<EOF
$(git rev-list --left-right --count "$base...HEAD" 2>/dev/null || echo "unknown unknown")
EOF
  else behind=unknown; ahead=unknown; fi
  [[ -n "$request" ]] || request=$(_workspace_request_for_branch "$branch" 2>/dev/null || true)
  remote_state=$(_workspace_remote_base_state "$base"); provider_state=$(_workspace_provider_state "$branch")
  printf '{"schema":"spectacular.workspace-plan.v1","branch":"%s","upstream":"%s","base":"%s","divergence":{"ahead":"%s","behind":"%s"},"remote_base":"%s","request":"%s","provider":"%s","changed_paths":[' \
    "$(_json_escape "${branch:-detached}")" "$(_json_escape "${upstream:-unknown}")" "$(_json_escape "$base")" "$(_json_escape "$ahead")" "$(_json_escape "$behind")" "$(_json_escape "$remote_state")" "$(_json_escape "${request:-unknown}")" "$(_json_escape "$provider_state")"
  local first=true group path owner confidence disposition
  while IFS=$'\t' read -r group path; do
    $first && first=false || printf ','
    IFS='|' read -r owner confidence disposition <<EOF
$(_workspace_path_owner "$path" "$request")
EOF
    printf '{"group":"%s","path":"%s","owner":"%s","confidence":"%s","disposition":"%s"}' "$(_json_escape "$group")" "$(_json_escape "$path")" "$(_json_escape "$owner")" "$(_json_escape "$confidence")" "$(_json_escape "$disposition")"
