  touch "$specs_dir/.gitkeep"
  echo "  ✓ v0.5→v0.6: created .spectacular/specs/ with .gitkeep"
  bump_workspace_schema "0.6"
}

# v0.6 → v2.0: OKF restructing and pluralization
migration_apply_v06_to_v20() {
  local dry="$1"
  echo "  • Running v0.6→v2.0 migration (OKF Restructure)..."

  # Define paths
  local root_dir="$SPEC_WORKSPACE_DIR"

  # Step 1: Dry run preview
  if [[ "$dry" == "true" ]]; then
    echo "  [dry-run] Would pluralize folders:"
    echo "    - memory/ -> memories/"
    echo "    - roadmap/ -> roadmaps/"
    echo "    - feedback/ -> feedbacks/"
    echo "    - audit/ -> audits/"
    echo "    - debug/ -> debugs/"
    echo "    - requests/*/feedback -> feedbacks"
    echo "  [dry-run] Would relocate index files:"
    echo "    - DECISIONS.md -> decisions/index.md"
    echo "    - MEMORY.md -> memories/index.md"
    echo "    - SESSIONS.md -> sessions/index.md"
    echo "    - ROADMAP.md -> roadmaps/index.md"
    echo "    - SPEC.md -> specs/index.md"
    echo "  [dry-run] Would flatten specs/<capability>/SPEC.md to specs/<capability>.md"
    echo "  [dry-run] Would rename decisions/D<N>.md to D<N>-<slug>.md"
    echo "  [dry-run] Would prefix memories/*.md to M<N>-<slug>.md"
    echo "  [dry-run] Would rewrite markdown links in all workspace files"
    return 0
  fi

  # Step 2: Mechanical execution

  # 2a. Relocate/Pluralize Top-level Folders
  local src_dir dest_dir
  for pair in "memory:memories" "roadmap:roadmaps" "feedback:feedbacks" "audit:audits" "debug:debugs"; do
    src_dir="$root_dir/${pair%%:*}"
    dest_dir="$root_dir/${pair#*:}"
    if [[ -d "$src_dir" && ! -d "$dest_dir" ]]; then
      mv "$src_dir" "$dest_dir"
      echo "  ✓ Renamed $src_dir -> $dest_dir"
    fi
  done

  # 2b. Relocate requests-nested feedbacks
  local req feedbacks_src feedbacks_dest
  shopt -s nullglob
  for req in "$root_dir"/requests/*/ "$root_dir"/archive/*/; do
    [[ -d "$req" ]] || continue
    feedbacks_src="${req}feedback"
    feedbacks_dest="${req}feedbacks"
    if [[ -d "$feedbacks_src" && ! -d "$feedbacks_dest" ]]; then
      mv "$feedbacks_src" "$feedbacks_dest"
      echo "  ✓ Renamed $feedbacks_src -> $feedbacks_dest"
    fi
  done
  shopt -u nullglob

  # 2c. Relocate Index Files
  local idx_src idx_dest_dir idx_dest_file
  for pair in "DECISIONS.md:decisions/index.md" "MEMORY.md:memories/index.md" "SESSIONS.md:sessions/index.md" "ROADMAP.md:roadmaps/index.md" "SPEC.md:specs/index.md"; do
    idx_src="$root_dir/${pair%%:*}"
    idx_dest_file="$root_dir/${pair#*:}"
    idx_dest_dir="$(dirname "$idx_dest_file")"
    if [[ -f "$idx_src" ]]; then
      mkdir -p "$idx_dest_dir"
      mv "$idx_src" "$idx_dest_file"
      echo "  ✓ Moved $idx_src -> $idx_dest_file"
    fi
  done

  # 2d. Flatten nested specs/
  local specs_dir="$root_dir/specs"
  if [[ -d "$specs_dir" ]]; then
    local subdir spec_file cap_name new_spec
    shopt -s nullglob
    for subdir in "$specs_dir"/*/; do
      subdir="${subdir%/}"
      spec_file="$subdir/SPEC.md"
      cap_name="$(basename "$subdir")"
      if [[ -f "$spec_file" ]]; then
        new_spec="$specs_dir/${cap_name}.md"
        mv "$spec_file" "$new_spec"
        rmdir "$subdir" 2>/dev/null || rm -rf "$subdir"
        echo "  ✓ Flattened $spec_file -> $new_spec"
      fi
    done
    shopt -u nullglob
  fi

  # 2e. Rename decisions/D<N>.md to D<N>-<slug>.md
  # Also build a replacement map for link-rewriting
  local decs_dir="$root_dir/decisions"
  local -a dec_old_links=()
  local -a dec_new_links=()
  if [[ -d "$decs_dir" ]]; then
    local f bname num dslug new_name h1_title
    shopt -s nullglob
    for f in "$decs_dir"/D[0-9]*.md; do
      bname="$(basename "$f" .md)"
      # Skip only if name matches strictly formatted clean D<N>-<slug>
      if [[ "$bname" =~ ^D[0-9]+-[a-z0-9-]+$ ]]; then
        dec_old_links+=("decisions/${bname%%-*}")
        dec_new_links+=("decisions/${bname}")
        continue
      fi
      num="${bname#D}"
      num="${num%%-*}"
      h1_title=""
      if [[ -f "$f" ]]; then
        # Extract H1 title
        h1_title=$(grep -m1 '^#' "$f" || true)
        h1_title="${h1_title#\#}"
        # Strip a leading "D<N> — " / "D<N> - " label only (anchored), not every
        # hyphen — a hyphenated title must survive intact.
        h1_title="$(printf '%s' "$h1_title" | sed -E 's/^[[:space:]]*D[0-9]+[[:space:]]*[—-][[:space:]]*//; s/^[[:space:]]*//; s/[[:space:]]*$//')"
      fi
      dslug=$(_slug_from_text "${h1_title:-decision-${num}}")
      local dec_base
      dec_base=$(_resolve_slug_collision "$decs_dir" "D${num}-${dslug}" "md")
      new_name="${decs_dir}/${dec_base}.md"
      mv "$f" "$new_name"
      echo "  ✓ Renamed $f -> $new_name"
      dec_old_links+=("decisions/D${num}")
      dec_new_links+=("decisions/${dec_base}")
    done
    shopt -u nullglob
  fi

  # 2f. Rename memories/*.md to sequential M<N>-<slug>.md
  # Also build replacement map for memories
  local mems_dir="$root_dir/memories"
  local -a mem_old_links=()
  local -a mem_new_links=()
  if [[ -d "$mems_dir" ]]; then
    local mfiles=() f bname num mslug new_name m_title
    # Collect all memory files (excluding index.md)
    shopt -s nullglob
    for f in "$mems_dir"/*.md; do
      [[ "$(basename "$f")" == "index.md" ]] && continue
      mfiles+=("$f")
    done
    shopt -u nullglob

    # Sort files by updated date in frontmatter (or date in frontmatter)
    local sorted_mfiles=()
    local mfile mdate item
    for mfile in "${mfiles[@]}"; do
      mdate=$(fm_get "$mfile" "date" 2>/dev/null || true)
      [[ -z "$mdate" ]] && mdate=$(fm_get "$mfile" "updated" 2>/dev/null || true)
      [[ -z "$mdate" ]] && mdate="0000-00-00"
      sorted_mfiles+=("${mdate}|${mfile}")
    done
    IFS=$'\n' read -r -d '' -a sorted_mfiles < <(printf '%s\n' "${sorted_mfiles[@]}" | sort; printf '\0')

    # Stable numbering: a file already prefixed M<N>- KEEPS its N (re-runs must
    # not renumber, or existing links break). Unprefixed files get fresh numbers
    # continuing past the current max — never reusing a taken slot.
    local max_n=0 mn
    for item in "${sorted_mfiles[@]}"; do
      mn="$(basename "${item#*|}" .md)"
      if [[ "$mn" =~ ^M([0-9]+)- ]]; then
        (( BASH_REMATCH[1] > max_n )) && max_n="${BASH_REMATCH[1]}"
      fi
    done
    local next_n=$((max_n + 1))

    # Two-pass rename to prevent collision overwrites and normalize slugs.
    # The final names don't exist on disk yet during the tmp pass, so on-disk
    # collision detection (_resolve_slug_collision statting the dir) can't see a
    # pending duplicate. Track taken final bases in-memory instead, so two
    # malformed inputs that normalize to the same M<N>-<slug> (e.g. duplicate
    # M1-Foo.md + M1-foo.md) get de-duped (-2, -3, ...) rather than one silently
    # clobbering the other. The resolved base is baked into the tmp name so the
    # second pass just strips the "tmp-" prefix, keeping disk name and the
    # mem_new_links mapping in lockstep.
    # taken_bases: a newline-delimited membership string (macOS ships bash 3.2,
    # which has no associative arrays). Each claimed final base is one line;
    # membership is a fixed-string, whole-line grep.
    local taken_bases=$'\n'
    local -a tmp_mfiles=()
    for item in "${sorted_mfiles[@]}"; do
      mfile="${item#*|}"
      bname="$(basename "$mfile" .md)"
      local orig_slug="$bname" this_n
      if [[ "$bname" =~ ^M([0-9]+)- ]]; then
        this_n="${BASH_REMATCH[1]}"
        orig_slug="${bname#M[0-9]*-}"
      elif [[ "$bname" =~ ^M- ]]; then
        this_n="$next_n"
        next_n=$((next_n + 1))
        orig_slug="${bname#M-}"
      else
        this_n="$next_n"
        next_n=$((next_n + 1))
      fi
      orig_slug=$(_slug_from_text "$orig_slug")
      # Resolve final-base collisions against bases already claimed this run.
      local final_base="M${this_n}-${orig_slug}" n=2
      while printf '%s' "$taken_bases" | grep -qxF "$final_base"; do
        final_base="M${this_n}-${orig_slug}-${n}"
        n=$((n + 1))
      done
      if [[ "$final_base" != "M${this_n}-${orig_slug}" ]]; then
        echo "  ⚠  memory slug collision: 'M${this_n}-${orig_slug}' → '${final_base}'" >&2
      fi
      taken_bases+="${final_base}"$'\n'
      local tmp_name="${mems_dir}/tmp-${final_base}.md"
      mv "$mfile" "$tmp_name"
      tmp_mfiles+=("$tmp_name")
      mem_old_links+=("memory/${bname}")
      mem_new_links+=("memories/${final_base}")
    done

    # Move to final names
    for f in "${tmp_mfiles[@]}"; do
      local b; b=$(basename "$f")
      local final_name="${mems_dir}/${b#tmp-}"
      mv "$f" "$final_name"
      echo "  ✓ Renamed $b -> ${b#tmp-}"
    done
  fi

  # 2g. Rewrite markdown links across all files in .spectacular/
  local md_files=() f
  while IFS= read -r f; do
    [[ -f "$f" ]] && md_files+=("$f")
  done < <(find "$root_dir" -name "*.md")

  # Serialize mappings into environment variables for single Python call
  local dec_mapping_str="" mem_mapping_str="" i
  for ((i=0; i<${#dec_old_links[@]}; i++)); do
    dec_mapping_str+="${dec_old_links[$i]}->${dec_new_links[$i]},"
  done
  for ((i=0; i<${#mem_old_links[@]}; i++)); do
    mem_mapping_str+="${mem_old_links[$i]}->${mem_new_links[$i]},"
  done
  export DEC_MAPPINGS="$dec_mapping_str"
  export MEM_MAPPINGS="$mem_mapping_str"

  local md_file
  for md_file in "${md_files[@]}"; do
    local content temp_file
    temp_file="${md_file}.tmp.$$"
    content=$(cat "$md_file")

    echo "$content" > "$temp_file"
    # Link-only rewrite. Every regex below is deliberately anchored to link
    # syntax — the whole of a [[...]] wikilink or the (...) of a markdown link —
    # and the non-greedy [^\]|]*? / [^)]*? prefixes exist ONLY to admit relative
    # path segments (../../) and a |alias display, NOT to match bare prose. A
    # previous over-broad `${//}` substring replace corrupted live docs (matched
    # inside words like SPECIFICATION / debugging — migration bugs A/B). Do not
    # loosen the anchoring or drop the [[ / ( guards; that regression is why this
    # is Python-anchored and not a shell substring swap.
    python3 -c '
import sys, os, re
content = open(sys.argv[1]).read()

# Nested capability spec must run BEFORE the generic SPEC.md rename, or
# specs/<cap>/SPEC.md would become specs/<cap>/specs/index.md.
content = re.sub(r"specs/([A-Za-z0-9_-]+)/SPEC\.md", r"specs/\1.md", content)
content = re.sub(r"specs/([A-Za-z0-9_-]+)/SPEC(?=[\]) ]|$)", r"specs/\1", content)

# Root index relocations — only rewrite a link TARGET, i.e. a token that is
# the whole content of [[...]] or the whole (...) of a markdown link.
INDEX = {
    "DECISIONS": "decisions/index",
    "MEMORY":    "memories/index",
    "SESSIONS":  "sessions/index",
    "ROADMAP":   "roadmaps/index",
    "SPEC":      "specs/index",
}
for stem, target in INDEX.items():
    # Wikilinks: [[ROADMAP]] or [[../../ROADMAP.md]]
    def sub_wikilink(m):
        prefix, ext, display = m.group(1), m.group(2) or "", m.group(3) or ""
        return f"[[{prefix}{target}{ext}{display}]]"
    content = re.sub(r"\[\[([^\]|]*?)" + stem + r"(\.md)?(\|[^\]]*)?\]\]", sub_wikilink, content)

    # Standard Markdown Links: (ROADMAP) or (../../ROADMAP.md#section-1)
    def sub_mdlink(m):
        prefix, ext, anchor = m.group(1), m.group(2) or "", m.group(3) or ""
        return f"({prefix}{target}{ext}{anchor})"
    content = re.sub(r"\(([^)]*?)" + stem + r"(\.md)?(#\S+)?\)", sub_mdlink, content)

# Pluralize singular dir segments — only where they head a link path.
PLURAL = {"memory": "memories", "roadmap": "roadmaps", "feedback": "feedbacks",
          "audit": "audits", "debug": "debugs"}
for sing, plur in PLURAL.items():
    content = re.sub(r"(\[\[[^\]|]*?)" + sing + r"/", r"\1" + plur + r"/", content)
    content = re.sub(r"(\([^)]*?)" + sing + r"/", r"\1" + plur + r"/", content)

# Frontmatter link fields (related:/depends-on:/blocks:) carry relative-path
# targets as YAML list items ("  - ../../SPEC.md"). Two fixes: (1) rename the
# old root-index filename, (2) fix the ../ DEPTH — a moved file (root->subdir,
# or specs/<cap>/SPEC.md->specs/<cap>.md) changed level, so the old relative
# path no longer resolves. We resolve each target to a real file on disk (by
# basename, searching the workspace) and re-express it relative to this file.
import posixpath
this_file = sys.argv[2]                       # real destination path of the doc
root      = sys.argv[3].rstrip("/")           # .spectacular root
# Directory of this file, expressed relative to root (posix, "" == root).
this_reldir = os.path.relpath(os.path.dirname(this_file), root).replace(os.sep, "/")
if this_reldir == ".":
    this_reldir = ""
# The canonical docs a related: field points at (ARCHITECTURE, PRD, the renamed
# index files, flattened specs) are all addressed FROM ROOT. So: normalize each
# target to root-relative, then re-express relative to the file dir. This is
# depth-correct for every move (root->subdir AND specs/<cap>/SPEC.md->specs/<cap>.md)
# and has no basename ambiguity (unlike matching bare "index.md").
# Root-level canonical docs a related: field may point at (besides the renamed
# index files). Only THESE bare filenames get re-rooted — a bare "index.md" must
# not (it is a subdir index and would be re-expressed wrongly / non-idempotently).
ROOT_DOCS = {"PRD.md", "PRINCIPLES.md", "ARCHITECTURE.md", "STACK.md",
             "AGENTS.md", "POLICY.md", "PERSONAS.md", "CAPABILITIES.md",
             "VISION.md", "RISKS.md", "DESIGN.md"}
def fix_fm_target(m):
    prefix, path = m.group(1), m.group(2)
    base = path.rsplit("/", 1)[-1]            # basename with .md
    stem = base[:-3]
    if stem in INDEX:                          # old root-index name -> new location
        root_rel = INDEX[stem] + ".md"
    elif base in ROOT_DOCS:                     # "ARCHITECTURE.md" / "../../ARCHITECTURE.md"
        root_rel = base                        # a root-level canonical doc
    else:
        return m.group(0)                      # subpath or non-root file — leave it
    rel = posixpath.relpath(root_rel, this_reldir or ".")
    return prefix + rel
content = re.sub(r"^(\s*-\s*)((?:\.\./)*[A-Za-z0-9_-]+\.md)\s*$",
                 fix_fm_target, content, flags=re.M)

# Rewrite decisions links
dec_mappings = os.environ.get("DEC_MAPPINGS", "")
if dec_mappings:
    for pair in dec_mappings.split(","):
        if not pair: continue
        old, new = pair.split("->")
        old_stem, new_stem = old.split("/")[-1], new.split("/")[-1]
        content = re.sub(r"(\[\[[^\]|]*?decisions/)" + old_stem + r"(\.md)?(\|[^\]]*)?\]\]",
                         r"\1" + new_stem + r"\2\3]]", content)
        content = re.sub(r"(\([^)]*?decisions/)" + old_stem + r"(\.md)?(#\S+)?\)",
                         r"\1" + new_stem + r"\2\3)", content)

# Rewrite memories links
mem_mappings = os.environ.get("MEM_MAPPINGS", "")
if mem_mappings:
    for pair in mem_mappings.split(","):
        if not pair: continue
        old, new = pair.split("->")
        old_slug, new_slug = old.split("/")[-1], new.split("/")[-1]
        content = re.sub(r"(\[\[[^\]|]*?memories/)" + old_slug + r"(\.md)?(\|[^\]]*)?\]\]",
                         r"\1" + new_slug + r"\2\3]]", content)
        content = re.sub(r"(\([^)]*?memories/)" + old_slug + r"(\.md)?(#\S+)?\)",
                         r"\1" + new_slug + r"\2\3)", content)

open(sys.argv[1], "w").write(content)
' "$temp_file" "$md_file" "$root_dir"

    mv "$temp_file" "$md_file"
  done

  # Regenerate index files
  _regen_memory_index
  _regen_sessions_index

  bump_workspace_schema "2.0"
  echo "  ✓ Upgraded workspace to schema 2.0"
}

# Compare two schema versions (e.g. "0.4", "0.5"). Returns 0 if $1 < $2, else 1.
# Simple lexicographic comparison via sort -V.
schema_lt() {
  local a="$1" b="$2"
  [[ "$a" == "$b" ]] && return 1
  local first
  first=$(printf '%s\n%s\n' "$a" "$b" | sort -V | head -n1)
  [[ "$first" == "$a" ]]
}

# Classify the workspace's declared schema relative to this CLI. Keep this
# separate from schema_lt(): callers need all three states, not just "older".
workspace_schema_relation() {
  local declared="$1" supported="$2"
  if [[ "$declared" == "$supported" ]]; then
    echo "equal"
  elif schema_lt "$declared" "$supported"; then
    echo "older"
  else
    echo "newer"
  fi
}

# Return success when the invocation is diagnostics-only. The default is
# deliberately conservative: an unclassified command must prove it is
# read-only before it can operate on a newer workspace.
schema_write_gate_required() {
  local subcmd="${1:-}" verb="${2:-}" arg
  case "$subcmd" in
    status|requests|decisions|memories|sessions|links|traffic|decision|memory|show|summary|progress|paths|next|policy|collections)
      return 1
      ;;
    request)
      [[ "$verb" == "new" || "$verb" == "advance" || "$verb" == "archive" ]]
      return
      ;;
    spec)
      [[ "$verb" == "new" || "$verb" == "approve" || "$verb" == "confirm" || "$verb" == "implement" || "$verb" == "deprecate" || "$verb" == "archive" ]]
      return
      ;;
    doctor)
      for arg in "$@"; do [[ "$arg" == "--fix" ]] && return 0; done
      return 1
      ;;
    migrate)
      for arg in "$@"; do
        case "$arg" in --list|--help|-h|--dry-run) return 1 ;; esac
      done
      return 0
      ;;
    pack)
      [[ "$verb" == "install" || "$verb" == "remove" ]]
      return
      ;;
    feedback|feedback-loop)
      [[ "$verb" != "list" && "$verb" != "show" ]]
      return
      ;;
    idea)
      [[ "$verb" == "new" || "$verb" == "promote" ]]
      return
      ;;
    question)
      [[ "$verb" == "new" || "$verb" == "resolve" ]]
      return
      ;;
    research|spike)
      [[ "$verb" != "list" ]]
      return
      ;;
    audit)
      [[ "$verb" == "new" || "$verb" == "resolve" ]]
      return
      ;;
    fix)
      [[ "$verb" == "new" ]]
      return
      ;;
    vision)
      [[ "$verb" == "add" || "$verb" == "react" || "$verb" == "propose" || "$verb" == "approve" || "$verb" == "reject" ]]
      return
      ;;
    wayfind)
      case "$verb" in status|next|order|path) return 1 ;; esac
      return 0
      ;;
    roadmap)
      [[ "$verb" == "migrate" ]]
      return
      ;;
    afk)
      [[ "$verb" != "status" && "$verb" != "preflight" ]]
      return
      ;;
    github)
      [[ "$verb" != "reconcile" ]]
      return
      ;;
    id)
      [[ "$verb" == "migrate" ]]
      return
      ;;
  esac
  return 0
}

# Refuse a write before its first mutation when the workspace was created by a
# newer CLI. First-time init has no workspace to protect and therefore passes.
require_supported_workspace_schema_for_write() {
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || return 0
  local declared relation
  declared="$(config_workspace_schema)"
  relation="$(workspace_schema_relation "$declared" "$CURRENT_SCHEMA")"
  [[ "$relation" != "newer" ]] && return 0
  die "Refusing to modify workspace_schema ${declared}: this CLI supports ${CURRENT_SCHEMA}. Update Spectacular first; read-only diagnostics remain available."
}

# Migration must never write when private local material is already tracked.
# Deliberately print only repository pathnames; do not inspect file contents.
require_no_tracked_local_paths_for_migration() {
  local paths
  paths="$(git ls-files -- .spectacular.local 2>/dev/null || true)"
  [[ -z "$paths" ]] && return 0
  echo "Refusing migrate — tracked .spectacular.local path(s) require explicit security handling:" >&2
  while IFS= read -r path; do
    [[ -n "$path" ]] && echo "  - $path" >&2
  done <<< "$paths"
  echo "Stop before reading local contents. Classify exposure with the designated security authority." >&2
  return 1
}

cmd_migrate() {
  local dry_run=false
  local opt_to="" opt_from="" opt_list=false opt_skip_doctor=false
  while (( $# > 0 )); do
    case "$1" in
      --dry-run)      dry_run=true; shift ;;
      --list)         opt_list=true; shift ;;
      --to)           require_value "--to" "${2:-}"; opt_to="$2"; shift 2 ;;
      --from)         require_value "--from" "${2:-}"; opt_from="$2"; shift 2 ;;
      --skip-doctor)  opt_skip_doctor=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular migrate [--dry-run] [--to <ver>] [--from <ver>] [--list] [--skip-doctor]

Apply pending workspace-schema migrations to bring .spectacular/ to the latest
shape expected by this CLI (schema ${CURRENT_SCHEMA}).

Options:
  --dry-run       List planned migrations without writing
  --to <ver>      Migrate up to a specific schema version (default: latest)
  --from <ver>    Re-run starting from a specific schema (for repair)
  --list          List all known migrations from the registry; exit
  --skip-doctor   Bypass the doctor precondition (use with caution)
  -h, --help      Show this help

Migrations live as .md files in skills/spectacular/references/migrations/.
Each declares frontmatter (id, from, to, mechanical, reversible, apply-fn).
Mechanical migrations are applied by this CLI. Judgment migrations route
to '/spectacular migrate' in your AI agent.

A workspace with no workspace_schema: field is treated as "0.4".
Each migration is idempotent; running migrate on an up-to-date workspace
is a clean no-op.
EOF
        exit 0 ;;
      *) die "Unknown flag for migrate: $1" ;;
    esac
  done

  local reg_dir
  if ! reg_dir="$(migrations_dir)"; then
    die "Migration registry not found. Run \`spectacular init --update\` or check skill installation."
  fi

  # Build sorted list of migrations: "<from>|<to>|<id>|<mechanical>|<apply-fn>|<path>"
  local -a registry=()
  shopt -s nullglob
  for path in "$reg_dir"/v*.md; do
    local id from to mech applyfn
    id="$(migration_field "$path" "id")"
    from="$(migration_field "$path" "from")"
    to="$(migration_field "$path" "to")"
    mech="$(migration_field "$path" "mechanical")"
    applyfn="$(migration_field "$path" "apply-fn")"
    [[ -z "$id" || -z "$from" || -z "$to" ]] && continue
    registry+=("${from}|${to}|${id}|${mech}|${applyfn}|${path}")
  done
  shopt -u nullglob

  # Sort by `from` semver
  IFS=$'\n' read -r -d '' -a registry < <(printf '%s\n' "${registry[@]}" | sort -t'|' -V -k1,1; printf '\0')

  if $opt_list; then
    echo "Registered migrations (${#registry[@]} total):"
    echo ""
    local entry
    for entry in "${registry[@]}"; do
      IFS='|' read -r from to id mech _ path <<< "$entry"
      # description: prefer the first non-empty paragraph from the body's <H1>
      # if frontmatter description is a YAML literal block (|), parse the
      # indented continuation lines instead of the | marker
      local desc
      desc=$(awk '
        /^---$/ { fm = !fm; next }
        fm && /^description:[[:space:]]*\|/ { in_desc=1; next }
        fm && /^description:[[:space:]]*/ {
          val = $0
          sub(/^description:[[:space:]]*/, "", val)
          gsub(/^"|"$/, "", val)
          print val
          exit
        }
        fm && in_desc && /^  / {
          val = $0
          sub(/^[[:space:]]+/, "", val)
          print val
          exit
        }
      ' "$path")
      printf "  %-18s  %s → %s  (%s)  %s\n" "$id" "$from" "$to" "$mech" "$desc"
    done
    return 0
  fi

  if [[ ! -d "$SPEC_WORKSPACE_DIR" ]]; then
    die "Not inside a Spectacular workspace (no .spectacular/ here)."
  fi

  # Dry-run/list/help are diagnostics-only. Every apply-capable migration must
  # stop before doctor or registry work can lead to a write.
  if ! $dry_run; then
    require_no_tracked_local_paths_for_migration || return 1
  fi

  local current target start_schema
  current="${opt_from:-$(config_workspace_schema)}"
  target="${opt_to:-$CURRENT_SCHEMA}"
  start_schema="$current"   # captured before the apply loop mutates `current`

  if [[ "$current" == "$target" ]]; then
    echo "Workspace is up to date (schema ${current})."
    return 0
  fi

  # Doctor precondition (v0.7.4+): for migrate, only check links — workspace/specs
  # checks would fire on the very drift migrate is designed to repair (e.g. v0.4
  # shape has current/ which trips check_specs). Links remain valid signal: a
  # workspace with broken cross-doc references is unsafe to mutate further.
  # Dry-run skips entirely since no mutation will occur.
  if ! $dry_run; then
    require_doctor_clean_links "migrate" "skip-doctor" "$opt_skip_doctor"
  fi

  if schema_lt "$target" "$current"; then
    die "Downgrade not supported: --to ${target} is older than current schema ${current}. Bidirectional migrations are out of scope."
  fi

  if $dry_run; then
    echo "Dry-run: would migrate workspace_schema ${current} → ${target}"
  else
    echo "Migrating workspace_schema ${current} → ${target}"
  fi
  echo ""

  # On-disk schema before we mutate anything — used to gate the history-log
  # write so a forced `--from` re-run on an up-to-date workspace doesn't dup-log.
  local disk_schema_before
  disk_schema_before="$(config_workspace_schema)"

  # Apply chain — for each registry entry where from >= current AND to <= target.
  local entry from to id mech applyfn path
  for entry in "${registry[@]}"; do
    IFS='|' read -r from to id mech applyfn path <<< "$entry"
    # Skip migrations whose `from` is older than current (already applied)
    schema_lt "$from" "$current" && continue
    # Skip migrations whose `to` exceeds target
    schema_lt "$target" "$to" && continue

    if [[ "$mech" != "true" ]]; then
      echo "  ⚠ ${id}: this migration requires judgment (mechanical: false)"
      echo ""
      echo "    Run '/spectacular migrate' in your AI agent (Claude Code, Codex, etc.)"
      echo "    to walk this migration with snapshot-before-edit + per-step confirmation."
      echo ""
      echo "    See: skills/spectacular/references/migrate.md"
      return 1
    fi

    if [[ -z "$applyfn" ]]; then
      die "${id}: mechanical: true but apply-fn is empty in frontmatter"
    fi
    if ! declare -F "$applyfn" >/dev/null; then
      die "${id}: apply-fn '${applyfn}' is not defined in cli/spectacular"
    fi

    "$applyfn" "$dry_run" || return $?
    [[ "$dry_run" == "false" ]] && current="$to"
  done

  echo ""
  if $dry_run; then
    echo "Dry-run complete. Run without --dry-run to apply."
  else
    stamp_last_touched
    # Append-only migration history — provenance the current schema alone can't
    # give: when the upgrade ran, from→to, and which CLI version did it.
    # Guard on the ON-DISK schema captured before the apply loop: a forced re-run
    # (`--from` on an already-migrated workspace) re-applies idempotently but must
    # NOT append a duplicate log line. Only log a genuine advance.
    if schema_lt "$disk_schema_before" "$target"; then
      printf '%s  %s → %s  (spectacular %s)\n' \
        "$TODAY" "$start_schema" "$current" "$SPECTACULAR_VERSION" \
        >> "$SPEC_WORKSPACE_DIR/migrations.log"
    fi
    echo "Migration complete. workspace_schema is now ${current}."
  fi
}

# ── spectacular status — deterministic fleet view (status-fleet-view, b23) ────
# Renders the active-request fleet from PLAN/TASKS: frontmatter fields plus
# grep-safe body signals. Assumes the enforced schema (doctor guarantees the
# canonical unnumbered ## Goal heading + ### M milestones on active requests):
#   - Goal line          → the paragraph after `## Goal`
#   - progress x/total    → flush-left `- [ ]`/`- [x]` counts; `- [~]` deferred
#   - current milestone   → first `### M<N>` with an open top-level `- [ ]`
# Three surfaces: bare (fleet table), <slug> (card), --json (agent contract).

# Extract the Goal line: first non-blank content line under `## Goal`
# (accepts the legacy `## 1. Goal` too). Stdout: one line, empty if absent.
_status_goal_line() {
  local plan="$1"
  awk '
    /^## ([0-9]+\. )?Goal[[:space:]]*$/ { ingoal=1; next }
    ingoal && /^## / { exit }
    ingoal && /^<!--/ { next }
    ingoal && NF { print; exit }
  ' "$plan" 2>/dev/null
}

# Count top-level checkbox progress in a TASKS file. Sets globals:
#   _ST_DONE _ST_OPEN _ST_DEFERRED _ST_TOTAL  (total = done+open, deferred separate)
# Only flush-left `- [ ]` counted; indented `  - [ ]` sub-bullets ignored.
_status_progress() {
  local tasks="$1"
  _ST_DONE=0; _ST_OPEN=0; _ST_DEFERRED=0; _ST_TOTAL=0
  [[ -f "$tasks" ]] || return 0
  # grep -c exits 1 on zero matches and still prints "0"; the trailing `|| true`
  # keeps that non-zero status from being fatal under `set -e`. (A `|| echo 0`
  # here would double-print "0\n0" — do not use it.)
  _ST_DONE=$(grep -cE '^- \[x\]' "$tasks" 2>/dev/null || true)
  _ST_OPEN=$(grep -cE '^- \[ \]' "$tasks" 2>/dev/null || true)
  _ST_DEFERRED=$(grep -cE '^- \[~\]' "$tasks" 2>/dev/null || true)
  _ST_TOTAL=$(( _ST_DONE + _ST_OPEN ))
}

# Format the progress signal as a short string (e.g. "3/8" or "3/8 (+1 def)").
_status_progress_fmt() {
  local tasks="$1"
  _status_progress "$tasks"
  local out
  if (( _ST_TOTAL == 0 && _ST_DEFERRED == 0 )); then
    out="—"
  else
    out="${_ST_DONE}/${_ST_TOTAL}"
    (( _ST_DEFERRED > 0 )) && out="${out} (+${_ST_DEFERRED} def)"
  fi
  printf '%s' "$out"
}

# Current milestone: first `### M<N>` heading that has an open top-level `- [ ]`
# task beneath it (before the next `### ` heading). Stdout: e.g. "M2 — signals".
_status_current_milestone() {
  local tasks="$1"
  [[ -f "$tasks" ]] || return 0
  awk '
    /^### M[0-9]+/ {
      # flush the previous milestone: if it had an open task, we already printed
      cur=$0; sub(/^### /, "", cur); has_open=0; next
    }
    /^### / { cur=""; next }
    cur != "" && /^- \[ \]/ {
      print cur; exit
    }
  ' "$tasks" 2>/dev/null
}

# Days since a YYYY-MM-DD date; echoes a large sentinel if unparseable.
_status_age_days() {
  local d="$1" e
  e=$(_date_to_epoch "$d")
  (( e == 0 )) && { echo 999999; return 0; }
  echo $(( ( $(date +%s) - e ) / 86400 ))
}

# Sort key by lifecycle status: active first, then review, planned, then rest.
_status_sort_rank() {
  case "$1" in
    active) echo 0 ;; review) echo 1 ;; planned) echo 2 ;;
    verified) echo 3 ;; *) echo 4 ;;
  esac
}

# Open human-owned questions are the highest-priority status signal.  Keep this
# deliberately shallow: it reads only question frontmatter, not question bodies
# or the broader discovery graph.  Output: ID|summary.
_status_open_blockers() {
  local f id status required label
  [[ -d "$SPEC_QUESTIONS_DIR" ]] || return 0
  for f in "$SPEC_QUESTIONS_DIR"/*.md; do
    [[ -f "$f" ]] || continue
    required=$(fm_get "$f" requires_user_input)
    status=$(fm_get "$f" status)
    [[ "$required" == true ]] || continue
    case "$status" in resolved|deferred|archived) continue ;; esac
    id=$(fm_get "$f" id); [[ -n "$id" ]] || continue
    label=$(fm_get "$f" summary); [[ -n "$label" ]] || label=$(basename "$f" .md)
    printf '%s|%s\n' "$id" "$label"
  done
}

# Local request health signals. Output: kind|slug|detail. These are advisory;
# doctor remains the authoritative substrate validator.
_status_health_signals() {
  local f dir slug status updated hold age milestone
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    dir=$(dirname "$f"); slug=$(basename "$dir")
    status=$(fm_get "$f" status); updated=$(fm_get "$f" updated)
    hold=$(fm_get "$f" hold); [[ "$hold" == none ]] && hold=""
    if [[ -n "$hold" ]]; then printf 'held_request|%s|%s\n' "$slug" "$hold"; fi
    age=$(_status_age_days "$updated")
    if [[ "$status" == active ]] && (( age > 14 && age < 999999 )); then
      printf 'stale_active|%s|%sd since update\n' "$slug" "$age"
    fi
    if [[ "$status" == active ]]; then
      _status_progress "$dir/TASKS.md"
      if (( _ST_TOTAL > 0 && _ST_OPEN == 0 )); then
        printf 'ready_for_review|%s|all top-level tasks complete\n' "$slug"
      fi
    fi
  done < <(_request_iter_all)
}

# Pick the most urgent unheld request in one lifecycle state. Priority wins,
# then the most recently updated request. Stdout: slug or empty.
_status_pick_request() {
  local wanted="$1" f slug status priority updated hold weight
  local best="" best_weight=9 best_updated=""
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    status=$(fm_get "$f" status); [[ "$status" == "$wanted" ]] || continue
    hold=$(fm_get "$f" hold); [[ -n "$hold" && "$hold" != none ]] && continue
    priority=$(fm_get "$f" priority); weight=$(_prio_weight "$priority")
    updated=$(fm_get "$f" updated); slug=$(basename "$(dirname "$f")")
    if (( weight < best_weight )) || { (( weight == best_weight )) && [[ "$updated" > "$best_updated" ]]; }; then
      best="$slug"; best_weight="$weight"; best_updated="$updated"
    fi
  done < <(_request_iter_all)
  printf '%s' "$best"
}

# Output: kind|slug-or-id|command|reason. This is advisory only: lifecycle
# changes still run their normal policy and evidence gates.
_status_next_action() {
  local blocker id label slug
  blocker=$(_status_open_blockers | head -1 || true)
  if [[ -n "$blocker" ]]; then
    IFS='|' read -r id label <<< "$blocker"
    printf 'resolve_question|%s|spectacular question resolve %s|requires user input: %s\n' "$id" "$id" "$label"
    return 0
  fi
  slug=$(_status_pick_request review)
  if [[ -n "$slug" ]]; then
    printf 'verify_request|%s|/spectacular verify %s|request is in review\n' "$slug" "$slug"
    return 0
  fi
  slug=$(_status_pick_request active)
  if [[ -n "$slug" ]]; then
    printf 'resume_request|%s|spectacular request %s --brief|highest-priority active request\n' "$slug" "$slug"
    return 0
  fi
  slug=$(_status_pick_request planned)
  if [[ -n "$slug" ]]; then
    printf 'inspect_request|%s|spectacular request %s|highest-priority planned request\n' "$slug" "$slug"
    return 0
  fi
  printf 'create_request||spectacular request new|no live requests\n'
}

_status_action_footer() {
  local row kind slug detail action target command reason count=0
  while IFS='|' read -r kind slug detail; do
    [[ -z "$kind" ]] && continue
    (( count == 0 )) && { echo ""; info "── Health ──"; }
    info "  ⚠ $slug — $detail"
    count=$((count + 1))
  done < <(_status_health_signals)
  while IFS='|' read -r kind target command reason; do
    echo ""
    info "── Next action ──"
    info "  ▸ $command"
    info "    $reason"
  done < <(_status_next_action)
}

# `spectacular status` (bare) → aligned fleet table, sorted active→planned.
cmd_status_fleet() {
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "status: not inside a Spectacular workspace"

  # Collect rows: rank|slug|status|priority|build|updated|progress|milestone|goal
  local rows=() f slug status priority build updated goal progress milestone rank
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    slug=$(basename "$(dirname "$f")")
    status=$(fm_get "$f" "status"); [[ -z "$status" ]] && status="?"
    priority=$(fm_get "$f" "priority"); [[ -z "$priority" ]] && priority="—"
    build=$(fm_get "$f" "build"); [[ -z "$build" ]] && build="—"
    updated=$(fm_get "$f" "updated"); [[ -z "$updated" ]] && updated="?"
    goal=$(_status_goal_line "$f")
    progress=$(_status_progress_fmt "$(dirname "$f")/TASKS.md")
    milestone=$(_status_current_milestone "$(dirname "$f")/TASKS.md")
    # Rank on the raw lifecycle status; a hold is an orthogonal modifier that
    # doesn't change sort order (a held planned request still ranks as planned).
    rank=$(_status_sort_rank "$status")
    # Fold an active hold into the displayed status: planned(deferred).
    local hold; hold=$(fm_get "$f" "hold")
    [[ -n "$hold" && "$hold" != "none" ]] && status="${status}(${hold})"
    rows+=("${rank}|${slug}|${status}|${priority}|${build}|${updated}|${progress}|${milestone}|${goal}")
  done < <(_request_iter_all)

  if (( ${#rows[@]} == 0 )); then
    info "No requests yet. Start one with: spectacular new \"<description>\""
    return 0
  fi

  # Sort by rank (stable within rank by slug via the join).
  local sorted
  sorted=$(printf '%s\n' "${rows[@]}" | sort -t'|' -k1,1n -k2,2)

  printf "%-26s  %-18s  %-7s  %-6s  %-8s  %s\n" "SLUG" "STATUS" "PRI" "BUILD" "PROGRESS" "MILESTONE / GOAL"
  printf "%-26s  %-18s  %-7s  %-6s  %-8s  %s\n" "----" "------" "---" "-----" "--------" "----------------"
  local line
  while IFS='|' read -r rank slug status priority build updated progress milestone goal; do
    local slug_disp="$slug"
    (( ${#slug_disp} > 26 )) && slug_disp="${slug_disp:0:23}..."
    # Right column: current milestone if present, else the goal line, truncated.
    local right="${milestone:-$goal}"
    (( ${#right} > 42 )) && right="${right:0:39}..."
    printf "%-26s  %-18s  %-7s  %-6s  %-8s  %s\n" \
      "$slug_disp" "$status" "$priority" "$build" "$progress" "$right"
  done <<< "$sorted"

  _status_action_footer

  return 0
}

# `spectacular status <slug>` → single request card.
cmd_status_card() {
  local slug="$1"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "status: not inside a Spectacular workspace"
  local dir="$SPEC_REQUESTS_DIR/$slug"
  local plan="$dir/PLAN.md"
  [[ -f "$plan" ]] || die "status: no request '$slug' (looked for $plan)"

  local status priority build updated summary goal progress milestone hold
  status=$(fm_get "$plan" "status"); [[ -z "$status" ]] && status="?"
  hold=$(fm_get "$plan" "hold"); [[ "$hold" == "none" ]] && hold=""
  priority=$(fm_get "$plan" "priority"); [[ -z "$priority" ]] && priority="—"
  build=$(fm_get "$plan" "build")
  updated=$(fm_get "$plan" "updated")
  summary=$(fm_get "$plan" "summary")
  goal=$(_status_goal_line "$plan")
  progress=$(_status_progress_fmt "$dir/TASKS.md")
  milestone=$(_status_current_milestone "$dir/TASKS.md")

  # related: entries (list items in frontmatter)
  local related
  related=$(awk '
    /^---$/ { c++; next }
    c==1 && /^related:/ { inrel=1; next }
    c==1 && inrel && /^[[:space:]]*-[[:space:]]/ { sub(/^[[:space:]]*-[[:space:]]*/,""); print; next }
    c==1 && inrel && /^[^[:space:]]/ { inrel=0 }
  ' "$plan" 2>/dev/null | tr '\n' ' ')

  # Stale: active + updated >14d ago.
  local stale="" age
  age=$(_status_age_days "$updated")
  if [[ "$status" == "active" ]] && (( age > 14 && age < 999999 )); then
    stale="  ⚠ stale (${age}d since update)"
  fi

  printf "┌─ %s · %s%s%s\n" "$slug" "$status" "${hold:+ (hold: $hold)}" "$stale"
  if [[ -n "$goal" ]];    then printf "│ goal       %s\n" "$goal"; fi
  if [[ -n "$summary" ]]; then printf "│ summary    %s\n" "$summary"; fi
  printf "│ priority   %s" "$priority"
  if [[ -n "$build" ]];   then printf "   build %s" "$build"; fi
  if [[ -n "$updated" ]]; then printf "   updated %s" "$updated"; fi
  printf "\n"
  printf "│ progress   %s" "$progress"
  if [[ -n "$milestone" ]]; then printf "   · current: %s" "$milestone"; fi
  printf "\n"
  if [[ -n "${related// }" ]]; then printf "│ related    %s\n" "$(echo "$related" | xargs)"; fi
  printf "└─\n"
  return 0
}

# `spectacular status --json` → structured fleet for the skill / agents (contract).
cmd_status_json() {
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "status: not inside a Spectacular workspace"
  local f slug status priority build updated summary goal milestone
  printf '['
  local i=0
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    local dir; dir=$(dirname "$f")
    slug=$(basename "$dir")
    status=$(fm_get "$f" "status")
    local hold; hold=$(fm_get "$f" "hold"); [[ "$hold" == "none" ]] && hold=""
    priority=$(fm_get "$f" "priority")
    build=$(fm_get "$f" "build")
    updated=$(fm_get "$f" "updated")
    summary=$(fm_get "$f" "summary")
    goal=$(_status_goal_line "$f")
    milestone=$(_status_current_milestone "$dir/TASKS.md")
    _status_progress "$dir/TASKS.md"
    if (( i > 0 )); then printf ','; fi
    printf '{"slug":"%s","status":"%s","hold":"%s","priority":"%s","build":"%s","updated":"%s","summary":"%s","goal":"%s","progress":{"done":%d,"open":%d,"deferred":%d,"total":%d},"current_milestone":"%s"}' \
      "$(_json_escape "$slug")" "$(_json_escape "$status")" "$(_json_escape "$hold")" "$(_json_escape "$priority")" \
      "$(_json_escape "$build")" "$(_json_escape "$updated")" "$(_json_escape "$summary")" \
      "$(_json_escape "$goal")" "$_ST_DONE" "$_ST_OPEN" "$_ST_DEFERRED" "$_ST_TOTAL" \
      "$(_json_escape "$milestone")"
    i=$((i + 1))
  done < <(_request_iter_all)
  printf ']\n'
  return 0
}

# `spectacular status --brief [--json]` — bounded, action-oriented orientation.
# Plain --json remains the v1 fleet array for compatibility; this is a separate
# v2 envelope that adds blockers, health signals, and one next action.
cmd_status_brief() {
  local json="$1" blockers="" health="" action="" first=true
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "status: not inside a Spectacular workspace"
  if [[ "$json" != true ]]; then
    cmd_status_fleet
    return 0
  fi
  printf '{"schema":"spectacular.status.v2","blockers":['
  while IFS='|' read -r id label; do
    [[ -z "$id" ]] && continue
    $first || printf ','; first=false
    printf '{"id":"%s","summary":"%s"}' "$(_json_escape "$id")" "$(_json_escape "$label")"
  done < <(_status_open_blockers)
  printf '],"health":['; first=true
  while IFS='|' read -r kind slug detail; do
    [[ -z "$kind" ]] && continue
    $first || printf ','; first=false
    printf '{"kind":"%s","slug":"%s","detail":"%s"}' \
      "$(_json_escape "$kind")" "$(_json_escape "$slug")" "$(_json_escape "$detail")"
  done < <(_status_health_signals)
  printf '],"next_action":'
  IFS='|' read -r kind target command reason <<< "$(_status_next_action)"
  printf '{"kind":"%s","target":"%s","command":"%s","reason":"%s"},"requests":' \
    "$(_json_escape "$kind")" "$(_json_escape "$target")" "$(_json_escape "$command")" "$(_json_escape "$reason")"
  cmd_status_json | tr -d '\n'
  printf '}\n'
}

# `spectacular status --against-latest` — one-line workspace-schema verdict.
# Distinguishes an older workspace (which can migrate forward) from a newer one
# (which requires a CLI update). Always exits 0 when inside a workspace.
cmd_status_against_latest() {
  if [[ ! -d "$SPEC_WORKSPACE_DIR" ]]; then
    echo "Not inside a Spectacular workspace (no .spectacular/ here)." >&2
    return 1
  fi
  local declared relation
  declared="$(config_workspace_schema)"
  relation="$(workspace_schema_relation "$declared" "$CURRENT_SCHEMA")"
  case "$relation" in
    equal)
      echo "workspace_schema: ${declared}  ✓  up to date (CLI expects ${CURRENT_SCHEMA})"
      ;;
    older)
      echo "workspace_schema: ${declared}  ⚠  behind CLI (expects ${CURRENT_SCHEMA})"
      echo ""
      echo "  Run:  spectacular migrate            # apply pending migrations"
      echo "        spectacular migrate --dry-run  # preview without writing"
      ;;
    newer)
      echo "workspace_schema: ${declared}  ⚠  newer than this CLI (supports ${CURRENT_SCHEMA})"
      echo ""
      echo "  Update Spectacular before running a mutating command."
      ;;
  esac
  return 0
}

# `spectacular status --since <date>` — activity report since a cutoff.
# Lists requests + canonical docs whose frontmatter `updated:` is >= <date>.
#
# Accepts: YYYY-MM-DD, relative ("7d", "2w", "1m"), or "yesterday".
# Frontmatter-only scan — no git involved. Always exits 0 unless outside a
# workspace (exits 1) or date can't be parsed (exits 2).
cmd_status_since() {
  local since_input="${1:-}"
  if [[ -z "$since_input" ]]; then
    echo "status --since: <date> argument required (YYYY-MM-DD | 7d | 2w | 1m | yesterday)" >&2
    return 2
  fi
  if [[ ! -d "$SPEC_WORKSPACE_DIR" ]]; then
    echo "Not inside a Spectacular workspace (no .spectacular/ here)." >&2
    return 1
  fi

  local cutoff
  cutoff="$(status_since_resolve_date "$since_input")" || {
    echo "status --since: cannot parse '$since_input' (expected YYYY-MM-DD | <N>d | <N>w | <N>m | yesterday)" >&2
    return 2
  }

  echo "Activity since ${cutoff}:"
  echo ""

  # Requests, grouped by status. Scan both requests/ and archive/.
  local -a archived=() verified=() review=() active=() planned=()
  local dir slug updated status
  shopt -s nullglob
  for dir in "$SPEC_REQUESTS_DIR"/*/ "$SPEC_ARCHIVE_DIR"/*/; do
    [[ -f "$dir/PLAN.md" ]] || continue
    updated="$(fm_get "$dir/PLAN.md" "updated")"
    [[ -z "$updated" ]] && continue
    # Lexicographic compare works for YYYY-MM-DD; cutoff must be in same shape.
    [[ "$updated" < "$cutoff" ]] && continue
    slug="$(basename "$dir")"
    status="$(fm_get "$dir/PLAN.md" "status")"
    case "$status" in
      archived) archived+=("$slug") ;;
      verified) verified+=("$slug") ;;
      review)   review+=("$slug") ;;
      active)   active+=("$slug") ;;
      planned)  planned+=("$slug") ;;
    esac
  done
  shopt -u nullglob

  local req_total=$(( ${#archived[@]} + ${#verified[@]} + ${#review[@]} + ${#active[@]} + ${#planned[@]} ))
  echo "Requests (${req_total}):"
  status_since_print_group "archived" "${archived[@]+"${archived[@]}"}"
  status_since_print_group "verified" "${verified[@]+"${verified[@]}"}"
  status_since_print_group "review"   "${review[@]+"${review[@]}"}"
  status_since_print_group "active"   "${active[@]+"${active[@]}"}"
  status_since_print_group "planned"  "${planned[@]+"${planned[@]}"}"
  [[ $req_total -eq 0 ]] && echo "  (none)"

  # Canonical docs at .spectacular/ root.
  echo ""
  local -a docs=()
  local doc_file doc_base
  shopt -s nullglob
  for doc_file in "$SPEC_WORKSPACE_DIR"/*.md; do
    doc_base="$(basename "$doc_file")"
    # Skip snapshot files (@v in name)
    [[ "$doc_base" =~ @v ]] && continue
    updated="$(fm_get "$doc_file" "updated")"
    [[ -z "$updated" ]] && continue
    [[ "$updated" < "$cutoff" ]] && continue
    docs+=("$doc_base ($updated)")
  done
  shopt -u nullglob

  echo "Canonical docs (${#docs[@]}):"
  if (( ${#docs[@]} > 0 )); then
    local d
    for d in "${docs[@]}"; do
      echo "  $d"
    done
  else
    echo "  (none)"
  fi

  return 0
}

# Resolve a --since <date> input to an absolute YYYY-MM-DD cutoff.
# Accepts: YYYY-MM-DD, <N>d / <N>w / <N>m, "yesterday".
# Stdout: resolved date. Return 1 if unparseable.
status_since_resolve_date() {
  local input="$1"
  # Already YYYY-MM-DD
  if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    echo "$input"
    return 0
  fi
  # Relative: <N>d, <N>w, <N>m
  if [[ "$input" =~ ^([0-9]+)(d|w|m)$ ]]; then
    local n="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
    local days
    case "$unit" in
      d) days="$n" ;;
      w) days=$((n * 7)) ;;
      m) days=$((n * 30)) ;;  # approximate; good enough for activity reports
    esac
    # BSD date (macOS): -v-Nd. GNU date (Linux): -d "N days ago".
    if date -v-1d >/dev/null 2>&1; then
      date -v-"${days}"d +%Y-%m-%d
    else
      date -d "${days} days ago" +%Y-%m-%d
    fi
    return 0
  fi
  # Special keywords
  if [[ "$input" == "yesterday" ]]; then
    if date -v-1d >/dev/null 2>&1; then
      date -v-1d +%Y-%m-%d
    else
      date -d "1 day ago" +%Y-%m-%d
    fi
    return 0
  fi
  return 1
}

# Print one status group, indented under "Requests (N):".
# Args: <status-name> <item1> <item2> ... (pass array elements inline)
status_since_print_group() {
  local name="$1"
  shift
  (( $# == 0 )) && return 0
  echo "  ${name} ($#):"
  local item
  for item in "$@"; do
    echo "    $item"
  done
}

# Read convention_pack: stanza values from .spectacular/config.yaml
# Stdout: pack source name (empty if no convention_pack block or commented out)
config_pack_source() {
  local cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  [[ -f "$cfg" ]] || return 0
  awk '
    /^convention_pack:/ { in_block=1; next }
    in_block && /^[^[:space:]]/ { in_block=0 }
    in_block && /^  source:/ { gsub(/^  source:[[:space:]]*/, ""); gsub(/[[:space:]]*$/, ""); print; exit }
  ' "$cfg"
}

# Stdout: pack mode (suggest|scaffold|enforce); default "suggest" if convention_pack present without mode.
# Unknown values (e.g. "strict") silently fall back to "suggest" — call config_pack_mode_raw if you
# need to detect the discrepancy (used by check_conventions to emit an info note).
config_pack_mode() {
  local raw
  raw="$(config_pack_mode_raw)"
  case "$raw" in
    suggest|scaffold|enforce) echo "$raw" ;;
    *)                        echo "suggest" ;;  # unknown / empty → fallback
  esac
}

# Stdout: raw mode value as written in config.yaml (whatever string the user typed).
# Empty if convention_pack absent or mode: field omitted. Used by check_conventions
# to detect unknown-mode drift and emit an info note before silently falling back.
config_pack_mode_raw() {
  local cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  [[ -f "$cfg" ]] || return 0
  local src
  src="$(config_pack_source)"
  [[ -z "$src" ]] && return 0
  awk '
    /^convention_pack:/ { in_block=1; next }
    in_block && /^[^[:space:]]/ { in_block=0 }
    in_block && /^  mode:/ { gsub(/^  mode:[[:space:]]*/, ""); gsub(/[[:space:]]*$/, ""); print; exit }
  ' "$cfg"
}

# ══════════════════════════════════════════════════════════════════════════════
# POLICY — the practice layer (v1.12.0)
#
# POLICY.md defines policies under `## @<hook>` sections; config.yaml's
# `policies:` block is an override layer (enable/disable/severity + custom).
# `spectacular policy` reads POLICY.md, applies overrides, returns merged result.
# The skill calls `spectacular policy @<hook>` on entering a phase. Full spec:
# references/policies-contract.md + references/policy-injection.md.
# ══════════════════════════════════════════════════════════════════════════════

POLICY_VALID_HOOKS="@Init @Planning @Implementation @Debugging @Verification @Archive @Remember @Snapshot @SessionEnd"

# Emit the merged policy table to stdout, one record per line. Fields are
# separated by US (\x1f / octal 037) — NOT tab — because `read` with a
# whitespace IFS collapses consecutive separators, mangling empty fields
# (e.g. a policy with no `principle:` line). Field order:
#   hook⟨US⟩id⟨US⟩principle⟨US⟩severity⟨US⟩enabled⟨US⟩check
# Reads POLICY.md (definition) then applies config.yaml `policies:` overrides.
# Custom policies declared only in config (with a `hook:`) are appended.
_policy_records() {
  local pol="$SPEC_WORKSPACE_DIR/POLICY.md"
  local cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  [[ -f "$pol" ]] || return 0
  local US=$'\037'

  # 1) Parse POLICY.md blocks.
  awk '
    BEGIN { hook=""; id=""; principle=""; severity=""; check=""; directive=""; US=sprintf("%c",31) }
    function flush() {
      if (id != "") {
        printf "%s%s%s%s%s%s%s%s%s%s%s%s%s\n", hook, US, id, US, principle, US, severity, US, "true", US, check, US, directive
      }
      id=""; principle=""; severity=""; check=""; directive=""
    }
    /^##[[:space:]]+@/ {
      flush()
      h=$0; sub(/^##[[:space:]]+/, "", h); sub(/[[:space:]]+$/, "", h)
      hook=h; next
    }
    /^###[[:space:]]+/ {
      flush()
      i=$0; sub(/^###[[:space:]]+/, "", i); sub(/[[:space:]]+$/, "", i)
      id=i; next
    }
    /^-[[:space:]]+principle:/ { v=$0; sub(/^-[[:space:]]+principle:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); principle=v; next }
    /^-[[:space:]]+severity:/  { v=$0; sub(/^-[[:space:]]+severity:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); severity=v; next }
    /^-[[:space:]]+check:/     { v=$0; sub(/^-[[:space:]]+check:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); check=v; next }
    /^-[[:space:]]+directive:/ { v=$0; sub(/^-[[:space:]]+directive:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); directive=v; next }
    END { flush() }
  ' "$pol" | while IFS="$US" read -r hook id principle severity enabled check directive; do
    # Apply config overrides for this id.
    local ov_enabled ov_severity
    ov_enabled="$(_policy_cfg_get "$id" "enabled")"
    ov_severity="$(_policy_cfg_get "$id" "severity")"
    [[ -n "$ov_enabled" ]]  && enabled="$ov_enabled"
    [[ -n "$ov_severity" ]] && severity="$ov_severity"
    printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' "$hook" "$US" "$id" "$US" "$principle" "$US" "$severity" "$US" "$enabled" "$US" "$check" "$US" "$directive"
  done

  # 2) Append config-only custom policies (have a `hook:` field, not in POLICY.md).
  [[ -f "$cfg" ]] || return 0
  local defined_ids
  defined_ids="$(awk '/^###[[:space:]]+/ { i=$0; sub(/^###[[:space:]]+/, "", i); sub(/[[:space:]]+$/, "", i); print i }' "$pol" | tr '\n' ' ')"
  _policy_cfg_custom_ids | while IFS= read -r cid; do
    [[ -z "$cid" ]] && continue
    in_list "$cid" "$defined_ids" && continue   # already defined in POLICY.md
    local c_hook c_sev c_check c_pr c_en
    c_hook="$(_policy_cfg_get "$cid" "hook")"
    [[ -z "$c_hook" ]] && continue               # custom must declare a hook
    c_sev="$(_policy_cfg_get "$cid" "severity")"
    c_check="$(_policy_cfg_get "$cid" "check")"
    c_pr="$(_policy_cfg_get "$cid" "principle")"
    c_en="$(_policy_cfg_get "$cid" "enabled")"; [[ -z "$c_en" ]] && c_en="true"
    local c_dir; c_dir="$(_policy_cfg_get "$cid" "directive")"
    printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' "$c_hook" "$US" "$cid" "$US" "$c_pr" "$US" "$c_sev" "$US" "$c_en" "$US" "$c_check" "$US" "$c_dir"
  done
}

# Read a single field for a policy id from config.yaml's `policies:` block.
# Block shape (2-space indent under `policies:`, 4-space under the id):
#   policies:
#     understand-before-change:
#       enabled: false
#       severity: block
_policy_cfg_get() {
  local id="$1" field="$2" cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  [[ -f "$cfg" ]] || return 0
  awk -v id="$id" -v field="$field" '
    /^policies:/ { in_p=1; next }
    in_p && /^[^[:space:]]/ { in_p=0 }
    in_p && /^  [^[:space:]]/ {
      cur=$1; sub(/:.*/, "", cur); sub(/^[[:space:]]+/, "", cur)
      match_id = (cur == id)
      next
    }
    in_p && match_id && /^    [^[:space:]]/ {
      key=$1; sub(/:.*/, "", key); sub(/^[[:space:]]+/, "", key)
      if (key == field) {
        v=$0; sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v)
        gsub(/^"|"$/, "", v)
        print v; exit
      }
    }
  ' "$cfg"
}

# List all policy ids appearing in config.yaml's `policies:` block.
_policy_cfg_custom_ids() {
  local cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  [[ -f "$cfg" ]] || return 0
  awk '
    /^policies:/ { in_p=1; next }
    in_p && /^[^[:space:]]/ { in_p=0 }
    in_p && /^  [^[:space:]]/ { cur=$1; sub(/:.*/, "", cur); sub(/^[[:space:]]+/, "", cur); print cur }
  ' "$cfg"
}

# Pull a principle's heading + first content line from PRINCIPLES.md.
# Arg: principle number N. Stdout: "N. <heading> — <first line>" or empty.
_policy_principle_line() {
  local n="$1" pr="$SPEC_WORKSPACE_DIR/PRINCIPLES.md"
  [[ -n "$n" ]] || return 0
  [[ -f "$pr" ]] || return 0
  awk -v n="$n" '
    $0 ~ "^##[[:space:]]+" n "\\." {
      head=$0; sub(/^##[[:space:]]+/, "", head)
      body=""; got=0
      while ((getline line) > 0) {
        if (line ~ /^##[[:space:]]/) break          # next heading → no body
        if (line ~ /^[[:space:]]*$/) continue       # skip blank lines
        if (line ~ /^[[:space:]]*>/) continue       # skip leading blockquote (e.g. #10/#11 contrast box)
        body=line; got=1; break
      }
      sub(/^[[:space:]]+/, "", body)
      if (got) print head " — " body                # body found
      else     print head                           # heading only — no dangling em-dash
      exit
    }
  ' "$pr"
}

# Pull a principle's heading ONLY from PRINCIPLES.md (no body line).
# Arg: principle number N. Stdout: "<heading title>" (without the "N. " prefix) or empty.
_policy_principle_title() {
  local n="$1" pr="$SPEC_WORKSPACE_DIR/PRINCIPLES.md"
  [[ -n "$n" ]] || return 0
  [[ -f "$pr" ]] || return 0
  awk -v n="$n" '
    $0 ~ "^##[[:space:]]+" n "\\." {
      head=$0; sub(/^##[[:space:]]+/, "", head)
      sub("^" n "\\.[[:space:]]*", "", head)
      sub(/[[:space:]]+$/, "", head)
      print head; exit
    }
  ' "$pr"
}

# is this severity a blocker? (opt-in: only literal "block")
_policy_is_block() { [[ "$1" == "block" ]]; }

# Look up one policy's MERGED state (POLICY.md + config overrides) by id.
# Stdout: "enabled<US>severity" (e.g. "true<US>block"); empty if the id is unknown.
# Use this — not the raw POLICY.md text — before enforcing a gate, so config
# `enabled: false` / severity overrides are honored.
_policy_lookup() {
  local want="$1" US=$'\037' hook id principle severity enabled check directive
  while IFS="$US" read -r hook id principle severity enabled check directive; do
    [[ "$id" == "$want" ]] || continue
    printf '%s%s%s\n' "${enabled:-true}" "$US" "$severity"
    return 0
  done < <(_policy_records)
  return 0
}

# Is a policy enabled in the merged contract? (default: true if id unknown — a
# gate hard-coded in a ref doc shouldn't vanish just because POLICY.md was edited).
_policy_enabled() {
  local rec; rec="$(_policy_lookup "$1")"
  [[ -z "$rec" ]] && return 0                       # unknown id → treat as enabled
  local US=$'\037'
  local en="${rec%%"$US"*}"
  case "$en" in
    false|no|off|0|False|FALSE|No|NO) return 1 ;;   # disabled
    *) return 0 ;;
  esac
}

cmd_policy() {
  local form="list" arg="" principle_filter="" json=false full=false
  while (( $# > 0 )); do
    case "$1" in
      --principle) require_value "--principle" "${2:-}"; principle_filter="$2"; form="principle"; shift 2 ;;
      --principle=*) principle_filter="${1#--principle=}"; form="principle"; shift ;;
      --json) json=true; shift ;;
      --full) full=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular policy [@hook | <id> | --principle N | --json | --full]

Read the merged policy contract (POLICY.md + config.yaml overrides).

Forms:
  spectacular policy                 All policies, grouped by hook (skim)
  spectacular policy @Verification   One hook's policies + linked principle lines
  spectacular policy <id>            One policy, full text + its principle
  spectacular policy --principle N   Reverse: which policies enforce principle N
  spectacular policy --json          Machine form (skill-consumed)
  spectacular policy @hook --full    Full principle paragraphs on every row
                                     (default is tiered: block=full, warn=title)

The skill calls 'spectacular policy @<hook>' on entering a work phase.
Each row leads with the policy's own 'directive:' one-liner when authored.
Valid hooks: ${POLICY_VALID_HOOKS}
EOF
        exit 0 ;;
      @*) arg="$1"; form="hook"; shift ;;
      -*) die "Unknown flag for policy: $1" ;;
      *)  arg="$1"; form="id"; shift ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "policy: not inside a Spectacular workspace"
  [[ -f "$SPEC_WORKSPACE_DIR/POLICY.md" ]] || die_recover "policy: .spectacular/POLICY.md not found" \
    "spectacular doctor --fix   # re-scaffold the always-set POLICY.md"

  # Validate hook arg against the known set.
  if [[ "$form" == "hook" ]] && ! in_list "$arg" "$POLICY_VALID_HOOKS"; then
    die "policy: unknown hook '$arg'. Valid: ${POLICY_VALID_HOOKS}"
  fi

  local records US=$'\037'
  records="$(_policy_records)"
  [[ -z "$records" ]] && { info "(no policies defined)"; return 0; }

  # ── JSON form ──────────────────────────────────────────────────────────────
  if $json; then
    printf '['
    local i=0 hook id principle severity enabled check directive
    while IFS="$US" read -r hook id principle severity enabled check directive; do
      [[ -z "$id" ]] && continue
      # Apply filters
      if [[ "$form" == "hook" && "$hook" != "$arg" ]]; then continue; fi
      if [[ "$form" == "id"   && "$id"   != "$arg" ]]; then continue; fi
      if [[ "$form" == "principle" && "$principle" != "$principle_filter" ]]; then continue; fi
      local is_block="false"; _policy_is_block "$severity" && is_block="true"
      # Normalize enabled to a literal JSON boolean — config may carry yes/no/1/etc.
      local en_json="true"
      case "${enabled:-true}" in
        false|no|off|0|False|FALSE|No|NO) en_json="false" ;;
        *) en_json="true" ;;
      esac
      (( i > 0 )) && printf ','
      printf '{"hook":"%s","id":"%s","principle":"%s","severity":"%s","blocking":%s,"enabled":%s,"check":"%s","directive":"%s"}' \
        "$(_json_escape "$hook")" "$(_json_escape "$id")" "$(_json_escape "$principle")" \
        "$(_json_escape "$severity")" "$is_block" "$en_json" "$(_json_escape "$check")" "$(_json_escape "$directive")"
      i=$((i + 1))
    done <<< "$records"
    printf ']\n'
    return 0
  fi

  # ── id form: one policy, full text + principle ───────────────────────────────
  if [[ "$form" == "id" ]]; then
    local found=false hook id principle severity enabled check directive
    while IFS="$US" read -r hook id principle severity enabled check directive; do
      [[ "$id" == "$arg" ]] || continue
      found=true
      local sev_disp="${severity:-warn}"; _policy_is_block "$sev_disp" && sev_disp="block (refuse)" || sev_disp="${sev_disp} (surface + continue)"
      echo "$id"
      echo "  hook:      $hook"
      echo "  severity:  $sev_disp"
      [[ "${enabled:-true}" == "false" ]] && echo "  enabled:   false (disabled via config)"
      [[ -n "$principle" ]] && echo "  principle: $principle"
      [[ -n "$directive" ]] && echo "  directive: $directive"
      echo "  check:     $check"
      if [[ -n "$principle" ]]; then
        local pl; pl="$(_policy_principle_line "$principle")"
        [[ -n "$pl" ]] && echo "  → P$pl"
      fi
    done <<< "$records"
    $found || die "policy: no policy with id '$arg'"
    return 0
  fi

  # ── principle form: reverse lookup ───────────────────────────────────────────
  if [[ "$form" == "principle" ]]; then
    [[ "$principle_filter" =~ ^[0-9]+$ ]] || die "policy: --principle expects a number"
    local pl; pl="$(_policy_principle_line "$principle_filter")"
    echo "Principle $principle_filter${pl:+: ${pl#*. }}"
    echo ""
    local any=false hook id principle severity enabled check directive
    printf "%-28s  %-16s  %s\n" "POLICY" "HOOK" "SEVERITY"
    printf "%-28s  %-16s  %s\n" "------" "----" "--------"
    while IFS="$US" read -r hook id principle severity enabled check directive; do
      [[ "$principle" == "$principle_filter" ]] || continue
      any=true
      printf "%-28s  %-16s  %s\n" "$id" "$hook" "${severity:-warn}"
    done <<< "$records"
    $any || info "(no policies enforce principle $principle_filter)"
    return 0
  fi

  # ── hook form / bare list ────────────────────────────────────────────────────
  # Group by hook; in hook-form, show only the requested hook.
  # Tiered injection (default): every row leads with the policy's own directive
  # (the practice layer); the principle trailer is full for blocks, title-only
  # for warns. --full restores full principle paragraphs on every row.
  local current_hook="" hook id principle severity enabled check directive shown=0
  local order="$POLICY_VALID_HOOKS"
  local h
  for h in $order; do
    [[ "$form" == "hook" && "$h" != "$arg" ]] && continue
    local hook_has=false
    while IFS="$US" read -r hook id principle severity enabled check directive; do
      [[ "$hook" == "$h" ]] || continue
      [[ -z "$id" ]] && continue
      if ! $hook_has; then
        echo "$h"
        hook_has=true
      fi
      local marker="·"; _policy_is_block "$severity" && marker="⛔"
      local dis=""; [[ "${enabled:-true}" == "false" ]] && dis="  [disabled]"
      printf "  %s %-28s %-6s%s\n" "$marker" "$id" "${severity:-warn}" "$dis"
      shown=$((shown + 1))
      # In hook form, inject directive + principle trailer (the workhorse behavior).
      if [[ "$form" == "hook" ]]; then
        [[ -n "$directive" ]] && printf "      — %s\n" "$directive"
        if [[ -n "$principle" ]]; then
          if $full || _policy_is_block "$severity"; then
            local pl; pl="$(_policy_principle_line "$principle")"
            [[ -n "$pl" ]] && printf "      → P%s\n" "$pl"
          else
            local pt; pt="$(_policy_principle_title "$principle")"
            [[ -n "$pt" ]] && printf "      → P%s — %s\n" "$principle" "$pt"
          fi
        fi
      fi
    done <<< "$records"
  done
  (( shown == 0 )) && info "(no policies for ${arg:-this workspace})"
  if [[ "$form" == "list" ]]; then
    echo ""
    info "⛔ = blocks   · = warns.   spectacular policy @<hook> for one phase's rules + principles."
  fi
  return 0
}

