# Generic skim helper: print frontmatter (key: value pairs) + outline (H2 headings).
_skim_file() {
  local file="$1"
  [[ -f "$file" ]] || { echo "(file not found: $file)"; return 1; }

  echo "── $file ──"
  echo ""
  echo "Frontmatter:"
  awk '/^---$/{c++; if(c==2)exit; next} c==1{print "  "$0}' "$file"
  echo ""
  echo "Outline:"
  grep -nE "^## " "$file" | sed 's/^/  /' || echo "  (no H2 headings)"
}

_skim_file_json() {
  local file="$1"
  [[ -f "$file" ]] || { echo "{}"; return 1; }
  local fm outline
  fm=$(awk '/^---$/{c++; if(c==2)exit; next} c==1{print}' "$file" | _json_escape "$(cat)")
  # Simpler: just include path + frontmatter raw + outline
  printf '{"path":"%s","frontmatter":"%s","outline":[' "$(_json_escape "$file")" \
    "$(awk '/^---$/{c++; if(c==2)exit; next} c==1{printf "%s\\n", $0}' "$file" | sed 's/"/\\"/g')"
  local first=true line
  while IFS= read -r line; do
    $first && first=false || printf ','
    printf '"%s"' "$(_json_escape "$line")"
  done < <(grep -E "^## " "$file" 2>/dev/null || true)
  printf ']}\n'
}

_request_section() {
  local file="$1" heading="$2"
  [[ -f "$file" ]] || return 0
  awk -v wanted="$heading" '
    $0 == "## " wanted { inside=1; next }
    inside && /^##[[:space:]]/ { exit }
    inside { print }
  ' "$file" | awk 'BEGIN{blank=1} {if ($0=="" && blank) next; blank=($0==""); print}'
}

_request_replace_section() {
  local file="$1" heading="$2" body="$3" tmp
  tmp=$(mktemp)
  awk -v wanted="$heading" -v replacement="$body" '
    $0 == "## " wanted { print; print ""; print replacement; inside=1; next }
    inside && /^##[[:space:]]/ { inside=0; print; next }
    !inside { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

_request_milestone_key() {
  local raw="$1"
  raw=$(printf '%s' "$raw" | tr '[:lower:]' '[:upper:]')
  raw="${raw#M}"
  [[ "$raw" =~ ^[0-9]+$ ]] || return 1
  printf 'M%s\n' "$((10#$raw))"
}

_request_milestone_block() {
  local tasks="$1" milestone="$2"
  awk -v wanted="$milestone" '
    /^###[[:space:]]+M[0-9]+/ {
      line=$0; sub(/^###[[:space:]]+/, "", line); split(line, p, /[[:space:]]/)
      if (inside && p[1] != wanted) exit
      inside=(p[1] == wanted)
    }
    inside { print }
  ' "$tasks"
}

_request_current_milestone() {
  local tasks="$1" line key
  while IFS= read -r line; do
    key=$(printf '%s' "$line" | sed -E 's/^###[[:space:]]+(M[0-9]+).*/\1/')
    if _request_milestone_block "$tasks" "$key" | grep -qE '^- \[ \]'; then
      echo "$key"; return 0
    fi
  done < <(grep -E '^###[[:space:]]+M[0-9]+' "$tasks" 2>/dev/null || true)
  return 1
}

_request_full_bundle() {
  local dir="$1" f seen=""
  for f in PLAN.md TASKS.md SESSION.md UNDERSTANDING.md RISKS.md VERIFY.md VERIFY-LOG.md SPEC-DELTA.md; do
    [[ -f "$dir/$f" ]] || continue
    [[ -n "$seen" ]] && printf '\n\n'
    printf '<!-- %s -->\n' "$f"
    cat "$dir/$f"
    seen="$seen $f"
  done
  for f in "$dir"/*.md; do
    [[ -f "$f" ]] || continue
    case " $seen " in *" $(basename "$f") "*) continue ;; esac
    printf '\n\n<!-- %s -->\n' "$(basename "$f")"
    cat "$f"
  done
}

_request_brief() {
  local slug="$1" plan="$2" milestone="$3" tasks dir status source source_type source_ref
  dir="${plan%/PLAN.md}"; tasks="$dir/TASKS.md"; status=$(fm_get "$plan" status)
  [[ "$status" == active ]] || die "request --brief: '$slug' is $status; implementation briefs require an active request. Activate an approved plan with /spectacular act <SPC-ID>."
  [[ -f "$tasks" ]] || die "request --brief: TASKS.md is missing for '$slug'"
  if [[ -z "$milestone" ]]; then milestone=$(_request_current_milestone "$tasks" || true); fi
  [[ -n "$milestone" ]] || die "request --brief: '$slug' has no open milestone; advance it to review and run /spectacular verify $slug"
  _request_milestone_block "$tasks" "$milestone" | grep -q . || die "request --brief: milestone $milestone was not found in '$slug'"
  source=$(fm_get "$plan" contract); [[ -n "$source" ]] || source=$(fm_get "$plan" source_spec)
  source_type=$(fm_get "$plan" source_type); [[ -n "$source_type" ]] || { [[ -n "$source" ]] && source_type=spec || source_type=goal; }
  source_ref=$(fm_get "$plan" source_ref); [[ -n "$source_ref" ]] || source_ref="$source"
  cat <<EOF
# Implementation brief — $slug

Status: $status
Build: $(fm_get "$plan" build)
Source: $source_type ${source_ref:-none}
Contract: ${source:-none}
Activated by: $(fm_get "$plan" activated_by)
Activated at: $(fm_get "$plan" activated_at)
Git baseline: $(fm_get "$plan" activated_against)

## Goal
$(_request_section "$plan" Goal)

## Constraints
$(_request_section "$plan" Constraints)

## Active milestone
$(_request_milestone_block "$tasks" "$milestone")

## Validation
$(_request_section "$plan" Validation | grep -E "(^|[[:space:]])${milestone}[[:space:]]|^$" || true)

## Deliverables
$(_request_section "$plan" Deliverables)
EOF
  if [[ -f "$dir/SESSION.md" ]]; then
    cat <<EOF

## Session handoff
$(_request_section "$dir/SESSION.md" "Current state")
$(_request_section "$dir/SESSION.md" "Active task")
$(_request_section "$dir/SESSION.md" Blockers)
$(_request_section "$dir/SESSION.md" "Next actions")
EOF
  fi
  cat <<'EOF'

## Execution boundary

Implement only the approved request scope. Park unexpected discoveries as ideas or future work; do not silently expand this milestone. Stop at declared HITL, authorization, breaking-schema, merge, or irreversible gates.
EOF
}

cmd_request() {
  case "${1:-}" in
    new) shift; cmd_request_new "$@"; return $? ;;
    list) shift; cmd_requests "$@"; return $? ;;
    advance) shift; cmd_promote "$@"; return $? ;;
    archive) shift; cmd_archive "$@"; return $? ;;
  esac

  local slug="" full=false brief=false json=false milestone=""
  while (( $# > 0 )); do
    case "$1" in
      --full) full=true; shift ;;
      --brief) brief=true; shift ;;
      --milestone|-m) require_value "$1" "${2:-}"; milestone=$(_request_milestone_key "$2") || die "request: milestone must be M<N> or <N>"; shift 2 ;;
      -m[0-9]*) milestone=$(_request_milestone_key "${1#-m}") || die "request: invalid milestone '$1'"; shift ;;
      --json) json=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular request <new|list|advance|archive> ...
       spectacular request <slug> [--brief | --full] [--milestone M2|-m 2|-m2] [--json]

One namespace for request creation, lifecycle, and context retrieval.

Options:
  --brief          Compile the active implementation prompt (active requests only)
  --full           Return all request-owned Markdown in stable order
  --milestone M2   Select one milestone for --brief (-m 2 and -m2 are aliases)
  --json            Return the selected view in a stable JSON envelope

Compatibility aliases remain: spectacular new|requests|advance|archive.
EOF
        exit 0 ;;
      -*) die "Unknown flag for request: $1" ;;
      *)
        [[ -n "$slug" ]] && die "request: only one <slug> argument allowed"
        slug="$1"; shift ;;
    esac
  done

  $full && $brief && die "request: --brief and --full are mutually exclusive"
  [[ -n "$milestone" ]] && ! $brief && die "request: --milestone is valid only with --brief"

  [[ -z "$slug" ]] && die "request: <slug> argument required"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "request: not inside a Spectacular workspace"

  local plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md"
  local archive_plan="$SPEC_ARCHIVE_DIR/$slug/PLAN.md"
  if [[ ! -f "$plan" ]]; then
    if [[ -f "$archive_plan" ]]; then
      plan="$archive_plan"
      info "(showing archived request)"
    else
      die "request: '$slug' not found in requests/ or archive/"
    fi
  fi

  local request_dir="${plan%/PLAN.md}"
  if $full || $brief; then
    local rendered view="full"
    if $brief; then
      view="brief"; rendered=$(_request_brief "$slug" "$plan" "$milestone")
    else
      rendered=$(_request_full_bundle "$request_dir")
    fi
    if $json; then
      printf '{"schema":"spectacular.request.v1","slug":"%s","view":"%s","content":"%s"}\n' \
        "$(_json_escape "$slug")" "$view" "$(_json_escape "$rendered")"
    else
      printf '%s\n' "$rendered"
    fi
    return 0
  fi

  local tasks="${plan%/PLAN.md}/TASKS.md"

  if $json; then
    # JSON mode: include progress data
    printf '{"schema":"spectacular.request.v1","slug":"%s","view":"overview","path":"%s","frontmatter":{' \
      "$(_json_escape "$slug")" "$(_json_escape "$plan")"
    local first=true key val
    while IFS=':' read -r key val; do
      [[ -z "$key" ]] && continue
      key="${key// /}"
      val="${val# }"
      val="${val%\"}"
      val="${val#\"}"
      $first && first=false || printf ','
      printf '"%s":"%s"' "$(_json_escape "$key")" "$(_json_escape "$val")"
    done < <(awk '/^---$/{c++; if(c==2)exit; next} c==1 && /:/{print}' "$plan")
    printf '},"progress":'
    if [[ -f "$tasks" ]]; then
      _progress_json "$tasks"
    else
      printf 'null'
    fi
    printf '}\n'
    return 0
  fi

  _skim_file "$plan"
  local _source_type _source_ref _source_spec
  _source_spec=$(fm_get "$plan" contract); [[ -n "$_source_spec" ]] || _source_spec=$(fm_get "$plan" source_spec)
  _source_type=$(fm_get "$plan" source_type); [[ -n "$_source_type" ]] || { [[ -n "$_source_spec" ]] && _source_type=spec || _source_type=goal; }
  _source_ref=$(fm_get "$plan" source_ref); [[ -n "$_source_ref" ]] || _source_ref="$_source_spec"
  echo "Source:    $_source_type ${_source_ref:-none}"
  echo "Mode:      $(fm_get "$plan" status)"
  if [[ -f "$tasks" ]]; then
    local _current_m
    _current_m=$(_request_current_milestone "$tasks" || true)
    echo "Milestone: ${_current_m:-complete}"
    local _current_task
    _current_task=$(grep -m1 -E '^- \[ \]' "$tasks" | sed 's/^- \[ \] //' || true)
    echo "Task:      ${_current_task:-none open}"
  fi
  if [[ -f "$request_dir/SESSION.md" ]]; then
    local _blockers
    _blockers=$(_request_section "$request_dir/SESSION.md" Blockers | awk 'NF{print; exit}')
    echo "Blockers:  ${_blockers:-none recorded}"
  fi
  if [[ -f "$tasks" ]]; then
    echo ""
    echo "Progress:"
    _progress_text "$tasks" | sed 's/^/  /'
  fi

  # Show cross-request links if any declared or computed
  local _dep _blk _rel _req_by _blk_by
  _dep=$(awk '
    /^---$/ { fm++; if (fm > 1) exit; next }
    fm == 1 && found && /^[a-zA-Z]/ { exit }
    fm == 1 && found && /^[[:space:]]*-[[:space:]]+/ {
      val = $0; sub(/^[[:space:]]*-[[:space:]]+/, "", val)
      gsub(/^"|"$/, "", val); gsub(/[[:space:]]+$/, "", val)
      if (val != "") print val
    }
    fm == 1 && /^depends-on:/ { found=1 }
  ' "$plan")
  _blk=$(awk '
    /^---$/ { fm++; if (fm > 1) exit; next }
    fm == 1 && found && /^[a-zA-Z]/ { exit }
    fm == 1 && found && /^[[:space:]]*-[[:space:]]+/ {
      val = $0; sub(/^[[:space:]]*-[[:space:]]+/, "", val)
      gsub(/^"|"$/, "", val); gsub(/[[:space:]]+$/, "", val)
      if (val != "") print val
    }
    fm == 1 && /^blocks:/ { found=1 }
  ' "$plan")
  # Filter related: to slug-only entries (no '/' or '.md') — file refs are
  # for human navigation, not the link graph.
  local _rel_raw
  _rel_raw=$(awk '
    /^---$/ { fm++; if (fm > 1) exit; next }
    fm == 1 && found && /^[a-zA-Z]/ { exit }
    fm == 1 && found && /^[[:space:]]*-[[:space:]]+/ {
      val = $0; sub(/^[[:space:]]*-[[:space:]]+/, "", val)
      gsub(/^"|"$/, "", val); gsub(/[[:space:]]+$/, "", val)
      if (val != "") print val
    }
    fm == 1 && /^related:/ { found=1 }
  ' "$plan")
  _rel=""
  if [[ -n "$_rel_raw" ]]; then
    while IFS= read -r _rr; do
      [[ "$_rr" == */* ]] && continue
      [[ "$_rr" == *.md ]] && continue
      _rel="${_rel:+$_rel$'\n'}$_rr"
    done <<< "$_rel_raw"
  fi

  # Compute inverses by scanning all other active requests
  _req_by=""
  _blk_by=""
  if [[ -d "$SPEC_REQUESTS_DIR" ]]; then
    shopt -s nullglob
    for _other_plan in "$SPEC_REQUESTS_DIR"/*/PLAN.md; do
      local _other_slug
      _other_slug=$(basename "$(dirname "$_other_plan")")
      [[ "$_other_slug" == "$slug" ]] && continue
      # Check if other blocks us (→ we are blocked-by other)
      local _other_blocks
      _other_blocks=$(awk '
        /^---$/ { fm++; if (fm > 1) exit; next }
        fm == 1 && found && /^[a-zA-Z]/ { exit }
        fm == 1 && found && /^[[:space:]]*-[[:space:]]+/ {
          val = $0; sub(/^[[:space:]]*-[[:space:]]+/, "", val)
          gsub(/^"|"$/, "", val); gsub(/[[:space:]]+$/, "", val)
          if (val != "") print val
        }
        fm == 1 && /^blocks:/ { found=1 }
      ' "$_other_plan")
      if echo "$_other_blocks" | grep -qx "$slug" 2>/dev/null; then
        _blk_by="${_blk_by:+$_blk_by$'\n'}$_other_slug"
      fi
      # Check if other depends-on us (→ we are required-by other)
      local _other_deps
      _other_deps=$(awk '
        /^---$/ { fm++; if (fm > 1) exit; next }
        fm == 1 && found && /^[a-zA-Z]/ { exit }
        fm == 1 && found && /^[[:space:]]*-[[:space:]]+/ {
          val = $0; sub(/^[[:space:]]*-[[:space:]]+/, "", val)
          gsub(/^"|"$/, "", val); gsub(/[[:space:]]+$/, "", val)
          if (val != "") print val
        }
        fm == 1 && /^depends-on:/ { found=1 }
      ' "$_other_plan")
      if echo "$_other_deps" | grep -qx "$slug" 2>/dev/null; then
        _req_by="${_req_by:+$_req_by$'\n'}$_other_slug"
      fi
    done
    shopt -u nullglob
  fi

  local _has_links=false
  [[ -n "$_dep"    ]] && _has_links=true
  [[ -n "$_blk"    ]] && _has_links=true
  [[ -n "$_rel"    ]] && _has_links=true
  [[ -n "$_req_by" ]] && _has_links=true
  [[ -n "$_blk_by" ]] && _has_links=true

  if $_has_links; then
    echo ""
    echo "Links:"
    if [[ -n "$_dep" ]]; then
      while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        local _tst=""
        [[ -f "$SPEC_ARCHIVE_DIR/$t/PLAN.md" ]] && _tst=" ✓ (shipped)"
        [[ ! -f "$SPEC_REQUESTS_DIR/$t/PLAN.md" ]] && [[ ! -f "$SPEC_ARCHIVE_DIR/$t/PLAN.md" ]] && _tst=" ⚠ (not found)"
        printf "  depends-on:  %s%s\n" "$t" "$_tst"
      done <<< "$_dep"
    fi
    if [[ -n "$_blk" ]]; then
      while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        local _tst=""
        [[ -f "$SPEC_ARCHIVE_DIR/$t/PLAN.md" ]] && _tst=" ✓ (shipped)"
        [[ ! -f "$SPEC_REQUESTS_DIR/$t/PLAN.md" ]] && [[ ! -f "$SPEC_ARCHIVE_DIR/$t/PLAN.md" ]] && _tst=" ⚠ (not found)"
        printf "  blocks:      %s%s\n" "$t" "$_tst"
      done <<< "$_blk"
    fi
    if [[ -n "$_rel" ]]; then
      while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        local _tst=""
        [[ -f "$SPEC_ARCHIVE_DIR/$t/PLAN.md" ]] && _tst=" ✓ (shipped)"
        [[ ! -f "$SPEC_REQUESTS_DIR/$t/PLAN.md" ]] && [[ ! -f "$SPEC_ARCHIVE_DIR/$t/PLAN.md" ]] && _tst=" ⚠ (not found)"
        printf "  related:     %s%s\n" "$t" "$_tst"
      done <<< "$_rel"
    fi
    if [[ -n "$_req_by" ]]; then
      while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        printf "  required-by: %s  (computed)\n" "$t"
      done <<< "$_req_by"
    fi
    if [[ -n "$_blk_by" ]]; then
      while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        printf "  blocked-by:  %s  (computed)\n" "$t"
      done <<< "$_blk_by"
    fi
  fi
}

# ── cmd_traffic ───────────────────────────────────────────────────────────────
# Local, evidence-only request traffic assessment.  It does not inspect files,
# branches, PRs, or working-tree state, and it never writes request metadata.
# Durable declarations are the input; the date-stamped conclusion is deliberately
# recalculated on each call rather than persisted as stale coordination state.
cmd_traffic() {
  local action="${1:-}"
  [[ "$action" == "preflight" ]] || die "Usage: spectacular traffic preflight <request> [--against <request>] [--json]"
  shift

  local slug="" against="" json=false
  while (( $# > 0 )); do
    case "$1" in
      --against) require_value "$1" "${2:-}"; against="$2"; shift 2 ;;
      --json) json=true; shift ;;
      --help|-h)
        cat <<'EOF'
Usage: spectacular traffic preflight <request> [--against <request>] [--json]

Classify local request traffic using only durable PLAN.md frontmatter:
  serialized   declared depends-on:/blocks:/conflicts-with:, or a shared
               release-constraints: entry
  conditional  related: request link or a shared traffic-boundaries: entry
  parallel     both requests declare traffic-boundaries: and the named sets are
               disjoint
  unknown      insufficient durable evidence (the conservative default)

The output is assessed as of today from the local workspace. It is read-only:
record confirmed relationships in the relevant PLAN.md frontmatter, then rerun.
EOF
        exit 0 ;;
      -*) die "Unknown flag for traffic preflight: $1" ;;
      *) [[ -z "$slug" ]] || die "traffic preflight: only one <request> argument allowed"; slug="$1"; shift ;;
    esac
  done

  [[ -n "$slug" ]] || die "traffic preflight: <request> argument required"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "traffic: not inside a Spectacular workspace"
  local plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md"
  [[ -f "$plan" ]] || die "traffic preflight: '$slug' is not a live request"
  if [[ -n "$against" ]]; then
    [[ "$against" != "$slug" ]] || die "traffic preflight: --against must name another request"
    [[ -f "$SPEC_REQUESTS_DIR/$against/PLAN.md" ]] || die "traffic preflight: '$against' is not a live request"
  fi

  _traffic_has_field() {
    local file="$1" field="$2"
    awk -v fld="$field" '
      /^---$/ { fm++; if (fm > 1) exit; next }
      fm == 1 && $0 ~ "^" fld ":" { found=1; exit }
      END { exit !found }
    ' "$file"
  }
  _traffic_values() {
    local file="$1" field="$2"
    awk -v fld="$field" '
      /^---$/ { fm++; if (fm > 1) exit; next }
      fm != 1 { next }
      found && /^[a-zA-Z]/ { exit }
      found && /^[[:space:]]*-[[:space:]]+/ {
        value=$0; sub(/^[[:space:]]*-[[:space:]]+/, "", value)
        gsub(/^"|"$/, "", value); gsub(/[[:space:]]+$/, "", value)
        if (value != "") print value
      }
      $0 ~ "^" fld ":" { found=1 }
    ' "$file"
  }
  _traffic_contains() {
    local file="$1" field="$2" wanted="$3" value
    while IFS= read -r value; do [[ "$value" == "$wanted" ]] && return 0; done < <(_traffic_values "$file" "$field")
    return 1
  }
  _traffic_shared_value() {
    local left="$1" right="$2" field="$3" value
    while IFS= read -r value; do _traffic_contains "$right" "$field" "$value" && { echo "$value"; return 0; }; done < <(_traffic_values "$left" "$field")
    return 1
  }
  _traffic_state() {
    local other="$1" other_plan="" shared=""
    other_plan="$SPEC_REQUESTS_DIR/$other/PLAN.md"
    if _traffic_contains "$plan" "depends-on" "$other" || _traffic_contains "$plan" "blocks" "$other" || \
       _traffic_contains "$other_plan" "depends-on" "$slug" || _traffic_contains "$other_plan" "blocks" "$slug" || \
       _traffic_contains "$plan" "conflicts-with" "$other" || _traffic_contains "$other_plan" "conflicts-with" "$slug"; then
      echo "serialized|declared dependency or conflict"; return
    fi
    shared=$(_traffic_shared_value "$plan" "$other_plan" "release-constraints" || true)
    if [[ -n "$shared" ]]; then echo "serialized|shared release constraint: $shared"; return; fi
    if _traffic_contains "$plan" "related" "$other" || _traffic_contains "$other_plan" "related" "$slug"; then
      echo "conditional|declared cross-request link"; return
    fi
    shared=$(_traffic_shared_value "$plan" "$other_plan" "traffic-boundaries" || true)
    if [[ -n "$shared" ]]; then echo "conditional|shared boundary: $shared"; return; fi
    if _traffic_has_field "$plan" "traffic-boundaries" && _traffic_has_field "$other_plan" "traffic-boundaries"; then
      echo "parallel|complete, disjoint named boundaries"; return
    fi
    echo "unknown|insufficient durable traffic evidence"
  }

  local -a peers=()
  local dir peer result state reason assessed
  if [[ -n "$against" ]]; then
    peers=("$against")
  else
    shopt -s nullglob
    for dir in "$SPEC_REQUESTS_DIR"/*/; do
      peer="$(basename "$dir")"; [[ "$peer" == "$slug" ]] || peers+=("$peer")
    done
    shopt -u nullglob
  fi
  assessed=$(date +%F)

  if $json; then
    printf '{"request":"%s","assessed_at":"%s","evidence":"local durable PLAN.md frontmatter","assessments":[' "$(_json_escape "$slug")" "$assessed"
    local first=true
    for peer in "${peers[@]}"; do
      result=$(_traffic_state "$peer"); state=${result%%|*}; reason=${result#*|}
      $first && first=false || printf ','
      printf '{"against":"%s","state":"%s","reason":"%s"}' "$(_json_escape "$peer")" "$state" "$(_json_escape "$reason")"
    done
    printf ']}\n'
    return 0
  fi

  printf 'Traffic preflight: %s (assessed %s; local durable evidence only)\n' "$slug" "$assessed"
  if [[ ${#peers[@]} -eq 0 ]]; then
    echo "  unknown — no other live request supplied for comparison"
    return 0
  fi
  for peer in "${peers[@]}"; do
    result=$(_traffic_state "$peer"); state=${result%%|*}; reason=${result#*|}
    printf '  %-11s %-30s %s\n' "$state" "$peer" "$reason"
  done
}

# ── cmd_links ─────────────────────────────────────────────────────────────────
# Build and display the cross-request link graph (v1.16.0+).
# Forward edges come from depends-on:/blocks:/related:/conflicts-with: in each PLAN.md.
# Inverse edges (required-by:, blocked-by:) are computed at read time — never
# stored. Use --all to include unlinked requests; default shows only those with
# at least one edge. Use <slug> to show one request's edges only.
cmd_links() {
  local slug="" json=false all=false
  while (( $# > 0 )); do
    case "$1" in
      --json) json=true; shift ;;
      --all)  all=true;  shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular links [<slug>] [--json] [--all]

Show the cross-request link graph.

  <slug>   Show edges for one request only
  --json   Machine-readable JSON output
  --all    Include requests with no edges (default: only linked requests)

Forward declarations live in each PLAN.md frontmatter:
  related:     touches (symmetric)
  depends-on:  A cannot ship before B  → B gains required-by: A
  blocks:      A must ship before B    → B gains blocked-by:  A
  conflicts-with: incompatible launch scope (serialized)
EOF
        exit 0 ;;
      -*) die "Unknown flag for links: $1" ;;
      *)
        [[ -n "$slug" ]] && die "links: only one <slug> argument allowed"
        slug="$1"; shift ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "links: not inside a Spectacular workspace"

  # ── helper: parse a YAML list field from frontmatter ──────────────────────
  _links_parse_list() {
    local file="$1" field="$2"
    awk -v fld="$field" '
      /^---$/ { fm++; if (fm > 1) exit; next }
      fm != 1 { next }
      found && /^[a-zA-Z]/ { exit }
      found && /^[[:space:]]*-[[:space:]]+/ {
        val = $0; sub(/^[[:space:]]*-[[:space:]]+/, "", val)
        gsub(/^"|"$/, "", val)
        gsub(/[[:space:]]+$/, "", val)
        if (val != "") print val
      }
      $0 ~ "^"fld":" { found=1 }
    ' "$file"
  }

  # ── helper: slug → status label ───────────────────────────────────────────
  _links_status() {
    local t="$1"
    if [[ -f "$SPEC_REQUESTS_DIR/$t/PLAN.md" ]]; then
      fm_get "$SPEC_REQUESTS_DIR/$t/PLAN.md" "status"
    elif [[ -f "$SPEC_ARCHIVE_DIR/$t/PLAN.md" ]]; then
      echo "archived"
    else
      echo "unknown"
    fi
  }

  # ── helper: suffix label for a target slug ────────────────────────────────
  _links_suffix() {
    local t="$1"
    if [[ ! -f "$SPEC_REQUESTS_DIR/$t/PLAN.md" ]]; then
      if [[ -f "$SPEC_ARCHIVE_DIR/$t/PLAN.md" ]]; then
        echo " ✓ (shipped)"
      else
        echo " ⚠ (not found)"
      fi
    fi
  }

  # ── 1. Collect active slugs ────────────────────────────────────────────────
  local -a active_slugs=()
  shopt -s nullglob
  for _d in "$SPEC_REQUESTS_DIR"/*/; do
    active_slugs+=("$(basename "$_d")")
  done
  shopt -u nullglob

  # ── 2. Build graph via temp files (bash 3.2 compatible) ───────────────────
  # Temp dir: one file per edge type per slug: <dir>/slug.dep, slug.blk, slug.rel, slug.cfl
  # related: entries that contain '/' or '.md' are file refs, not slug refs —
  # skip them (legacy field; depends-on: and blocks: carry the slug edges)
  local _graph_dir
  _graph_dir=$(mktemp -d)

  for _s in ${active_slugs[@]+"${active_slugs[@]}"}; do
    local _plan="$SPEC_REQUESTS_DIR/$_s/PLAN.md"
    [[ -f "$_plan" ]] || continue
    local _deps _blks _rels_raw _conflicts
    _deps=$(_links_parse_list "$_plan" "depends-on")
    _blks=$(_links_parse_list "$_plan" "blocks")
    _rels_raw=$(_links_parse_list "$_plan" "related")
    _conflicts=$(_links_parse_list "$_plan" "conflicts-with")
    # Filter related: to slug-only entries (no '/' and not ending in .md)
    local _rels=""
    if [[ -n "$_rels_raw" ]]; then
      while IFS= read -r _r; do
        [[ "$_r" == */* ]] && continue
        [[ "$_r" == *.md ]] && continue
        _rels="${_rels:+$_rels$'\n'}$_r"
      done <<< "$_rels_raw"
    fi
    [[ -n "$_deps" ]] && printf '%s\n' "$_deps" > "$_graph_dir/$_s.dep"
    [[ -n "$_blks" ]] && printf '%s\n' "$_blks" > "$_graph_dir/$_s.blk"
    [[ -n "$_rels" ]] && printf '%s\n' "$_rels" > "$_graph_dir/$_s.rel"
    [[ -n "$_conflicts" ]] && printf '%s\n' "$_conflicts" > "$_graph_dir/$_s.cfl"
  done

  # ── 3. Compute inverses ────────────────────────────────────────────────────
  # For each A deps-on B → append A to B.req_by
  # For each A blocks B → append A to B.blk_by
  for _s in ${active_slugs[@]+"${active_slugs[@]}"}; do
    if [[ -f "$_graph_dir/$_s.dep" ]]; then
      while IFS= read -r _t; do
        [[ -z "$_t" ]] && continue
        echo "$_s" >> "$_graph_dir/$_t.req_by"
      done < "$_graph_dir/$_s.dep"
    fi
    if [[ -f "$_graph_dir/$_s.blk" ]]; then
      while IFS= read -r _t; do
        [[ -z "$_t" ]] && continue
        echo "$_s" >> "$_graph_dir/$_t.blk_by"
      done < "$_graph_dir/$_s.blk"
    fi
  done

  # ── 4. Helper: does slug have any edges? ──────────────────────────────────
  _links_has_edges() {
    local t="$1"
    [[ -f "$_graph_dir/$t.dep"    ]] && return 0
    [[ -f "$_graph_dir/$t.blk"    ]] && return 0
    [[ -f "$_graph_dir/$t.rel"    ]] && return 0
    [[ -f "$_graph_dir/$t.cfl"    ]] && return 0
    [[ -f "$_graph_dir/$t.req_by" ]] && return 0
    [[ -f "$_graph_dir/$t.blk_by" ]] && return 0
    return 1
  }

  # ── 5. Scoped to one slug if provided ─────────────────────────────────────
  local -a render_slugs=()
  if [[ -n "$slug" ]]; then
    if [[ ! -f "$SPEC_REQUESTS_DIR/$slug/PLAN.md" ]] && \
       [[ ! -f "$SPEC_ARCHIVE_DIR/$slug/PLAN.md" ]]; then
      rm -rf "$_graph_dir"
      die "links: '$slug' not found in requests/ or archive/"
    fi
    render_slugs=("$slug")
  else
    for _s in ${active_slugs[@]+"${active_slugs[@]}"}; do
      if $all || _links_has_edges "$_s"; then
        render_slugs+=("$_s")
      fi
    done
  fi

  # ── 6. JSON output ─────────────────────────────────────────────────────────
  if $json; then
    printf '{"graph":['
    local _first_node=true
    for _s in ${render_slugs[@]+"${render_slugs[@]}"}; do
      $_first_node && _first_node=false || printf ','
      printf '{"slug":"%s"' "$(_json_escape "$_s")"

      local _field _ftype
      for _ftype in dep blk rel cfl; do
        case "$_ftype" in
          dep) _field="depends_on" ;;
          blk) _field="blocks"     ;;
          rel) _field="related"    ;;
          cfl) _field="conflicts_with" ;;
        esac
        printf ',"%s":[' "$_field"
        local _fe=true
        if [[ -f "$_graph_dir/$_s.$_ftype" ]]; then
          while IFS= read -r _t; do
            [[ -z "$_t" ]] && continue
            local _st; _st=$(_links_status "$_t")
            $_fe && _fe=false || printf ','
            printf '{"slug":"%s","status":"%s"}' "$(_json_escape "$_t")" "$(_json_escape "$_st")"
          done < "$_graph_dir/$_s.$_ftype"
        fi
        printf ']'
      done

      for _ftype in req_by blk_by; do
        case "$_ftype" in
          req_by) _field="required_by" ;;
          blk_by) _field="blocked_by"  ;;
        esac
        printf ',"%s":[' "$_field"
        local _fe=true
        if [[ -f "$_graph_dir/$_s.$_ftype" ]]; then
          while IFS= read -r _t; do
            [[ -z "$_t" ]] && continue
            $_fe && _fe=false || printf ','
            printf '"%s"' "$(_json_escape "$_t")"
          done < "$_graph_dir/$_s.$_ftype"
        fi
        printf ']'
      done
      printf '}'
    done
    printf ']}\n'
    rm -rf "$_graph_dir"
    return 0
  fi

  # ── 7. Text output ─────────────────────────────────────────────────────────
  if [[ ${#render_slugs[@]} -eq 0 ]]; then
    info "No cross-request links declared yet. Add depends-on:/blocks:/related:/conflicts-with: to a PLAN.md."
    rm -rf "$_graph_dir"
    return 0
  fi

  for _s in ${render_slugs[@]+"${render_slugs[@]}"}; do
    local _st; _st=$(_links_status "$_s")
    printf "%-30s  [%s]\n" "$_s" "$_st"

    if [[ -f "$_graph_dir/$_s.dep" ]]; then
      while IFS= read -r _t; do
        [[ -z "$_t" ]] && continue
        printf "  depends-on:  %s%s\n" "$_t" "$(_links_suffix "$_t")"
      done < "$_graph_dir/$_s.dep"
    fi
    if [[ -f "$_graph_dir/$_s.blk" ]]; then
      while IFS= read -r _t; do
        [[ -z "$_t" ]] && continue
        printf "  blocks:      %s%s\n" "$_t" "$(_links_suffix "$_t")"
      done < "$_graph_dir/$_s.blk"
    fi
    if [[ -f "$_graph_dir/$_s.rel" ]]; then
      while IFS= read -r _t; do
        [[ -z "$_t" ]] && continue
        printf "  related:     %s%s\n" "$_t" "$(_links_suffix "$_t")"
      done < "$_graph_dir/$_s.rel"
    fi
    if [[ -f "$_graph_dir/$_s.cfl" ]]; then
      while IFS= read -r _t; do
        [[ -z "$_t" ]] && continue
        printf "  conflicts-with: %s%s\n" "$_t" "$(_links_suffix "$_t")"
      done < "$_graph_dir/$_s.cfl"
    fi
    if [[ -f "$_graph_dir/$_s.req_by" ]]; then
      while IFS= read -r _t; do
        [[ -z "$_t" ]] && continue
        printf "  required-by: %s  (computed)\n" "$_t"
      done < "$_graph_dir/$_s.req_by"
    fi
    if [[ -f "$_graph_dir/$_s.blk_by" ]]; then
      while IFS= read -r _t; do
        [[ -z "$_t" ]] && continue
        printf "  blocked-by:  %s  (computed)\n" "$_t"
      done < "$_graph_dir/$_s.blk_by"
    fi
  done
  rm -rf "$_graph_dir"
}

cmd_decision() {
  local slug="" full=false json=false
  while (( $# > 0 )); do
    case "$1" in
      --full) full=true; shift ;;
      --json) json=true; shift ;;
      --help|-h)
        echo "Usage: spectacular decision <slug> [--full] [--json]"
        exit 0 ;;
      -*) die "Unknown flag for decision: $1" ;;
      *)
        [[ -n "$slug" ]] && die "decision: only one <slug> argument allowed"
        slug="$1"; shift ;;
    esac
  done

  [[ -z "$slug" ]] && die "decision: <slug> argument required"
  local f="$SPEC_DECISIONS_DIR/$slug.md"
  if [[ ! -f "$f" ]]; then
    local compact canonical num candidate
    compact=$(printf '%s' "$slug" | tr -d ' _-' | tr '[:lower:]' '[:upper:]')
    if [[ "$compact" =~ ^(D|DEC)([0-9]+)$ ]] || [[ "$compact" =~ ^[0-9]+$ ]]; then
      canonical=$(_canonical_resolve "$slug" decision)
      for candidate in "$SPEC_DECISIONS_DIR"/"$canonical"-*.md "$SPEC_DECISIONS_DIR"/"$canonical".md; do
        [[ -f "$candidate" ]] && { f="$candidate"; break; }
      done
      if [[ ! -f "$f" ]]; then
        num=$((10#${canonical#DEC-}))
        for candidate in "$SPEC_DECISIONS_DIR"/D"$num"-*.md "$SPEC_DECISIONS_DIR"/D"$num".md; do
          [[ -f "$candidate" ]] && { f="$candidate"; break; }
        done
      fi
    fi
  fi
  [[ -f "$f" ]] || die "decision: '$slug' not found in .spectacular/decisions/"

  if $full; then cat "$f"; return 0; fi
  local id title context decision consequences status decided tags related
  id=$(fm_get "$f" id); [[ -n "$id" ]] || id=$(basename "$f" .md)
  title=$(_h1_title "$f")
  context=$(_decision_field "$f" Context)
  decision=$(_decision_field "$f" Decision)
  consequences=$(_decision_field "$f" Consequences)
  status=$(fm_get "$f" status); decided=$(fm_get "$f" updated)
  tags=$(fm_get "$f" tags); related=$(fm_get "$f" related)
  if $json; then
    printf '{"schema":"spectacular.decision.v1","id":"%s","title":"%s","status":"%s","decided":"%s","tags":"%s","related":"%s","context":"%s","decision":"%s","consequences":"%s"}\n' \
      "$(_json_escape "$id")" "$(_json_escape "$title")" "$(_json_escape "$status")" "$(_json_escape "$decided")" "$(_json_escape "$tags")" "$(_json_escape "$related")" "$(_json_escape "$context")" "$(_json_escape "$decision")" "$(_json_escape "$consequences")"
    return 0
  fi
  printf 'Decision: %s — %s\nStatus: %s · Decided: %s\nTags: %s\n\nDecision\n%s\n\nContext\n%s\n\nConsequences\n%s\n\nFull evidence: spectacular decision %s --full\n' \
    "$id" "${title:-not recorded}" "${status:-not recorded}" "${decided:-not recorded}" "${tags:-not recorded}" "${decision:-not recorded}" "${context:-not recorded}" "${consequences:-not recorded}" "$slug"
}

# Extract a known ADR field; this is intentionally limited to the decision
# entry contract and is not a reusable Markdown-heading parser.
_decision_field() {
  awk -v h="**$2:**" '
    $0 == h { grab=1; next }
    grab && /^\*\*[^*]+:\*\*/ { exit }
    grab { if (!started && $0 ~ /./) started=1; if (started) print }
  ' "$1"
}

