{
  "schema_version": "spectacular.command-catalog.v1",
  "release_version": "2.8.0",
  "release_inspection": {
    "command": "spectacular --version",
    "arguments": "[--json]",
    "schema": "spectacular.build-info.v1",
    "effect": "read-only"
  },
  "commands": [
    {
      "command": "spectacular mission start",
      "arguments": "<plan.md|-> [--allow-main] [--create-branch] [--json]",
      "schema": "spectacular.mission.start.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular mission list",
      "arguments": "[--status <status>] [--json]",
      "schema": "spectacular.mission.list.v2",
      "effect": "read-only"
    },
    {
      "command": "spectacular mission show",
      "arguments": "<ref> [--json]",
      "schema": "spectacular.mission.show.v2",
      "effect": "read-only"
    },
    {
      "command": "spectacular mission check",
      "arguments": "<ref> [--json]",
      "schema": "spectacular.mission.check.v2",
      "effect": "read-only"
    },
    {
      "command": "spectacular mission amend-scope",
      "arguments": "<ref> --add <paths> --by <owner> [--reason <text>] [--dry-run] [--json]",
      "schema": "spectacular.mission.amend_scope.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular mission close",
      "arguments": "<ref> --by <owner> [--json]",
      "schema": "spectacular.mission.close.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular objective show",
      "arguments": "<mission-ref>/<objective-ref> [--json]",
      "schema": "spectacular.objective.show.v2",
      "effect": "read-only"
    },
    {
      "command": "spectacular objective promote",
      "arguments": "<mission-ref>/<objective-ref> [--json]",
      "schema": "spectacular.objective.promote.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular objective finish",
      "arguments": "<mission-ref>/<objective-ref> [--json]",
      "schema": "spectacular.objective.finish.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular run show",
      "arguments": "<mission-ref>/<run-ref> [--json]",
      "schema": "spectacular.run.show.v2",
      "effect": "read-only"
    },
    {
      "command": "spectacular run start",
      "arguments": "<mission-ref>[/<objective-ref>] --title <title> [--json]",
      "schema": "spectacular.run.start.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular run transition",
      "arguments": "<target-ref> --to <state> --by <actor> --reason <text> [--next-action <action>] [--json]",
      "schema": "spectacular.run.transition.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular review record",
      "arguments": "<mission-ref> <review.md|-> [--json]",
      "schema": "spectacular.review.record.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular handoff record",
      "arguments": "<mission-ref> <handoff.md|-> --by <sender> [--json]",
      "schema": "spectacular.handoff.record.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular evidence record",
      "arguments": "<mission-ref> [draft.md|-] [--from <test-output>] [--json]",
      "schema": "spectacular.evidence.record.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular mission complete",
      "arguments": "<ref> --by <owner> [--json]",
      "schema": "spectacular.mission.complete.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular proposal check",
      "arguments": "<ref> [--json]",
      "schema": "spectacular.proposal.check.v2",
      "effect": "read-only"
    },
    {
      "command": "spectacular campaign check",
      "arguments": "<path> [--json]",
      "schema": "spectacular.campaign.check.v2",
      "effect": "read-only"
    },
    {
      "command": "spectacular contract amend",
      "arguments": "<contract-ref> --gap <gap-ref> --by <owner> [--resolution <text>] [--dry-run] [--json]",
      "schema": "spectacular.contract.amend.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular contract create",
      "arguments": "<ref> [--title <title>] [--json]",
      "schema": "spectacular.contract.create.v2",
      "effect": "mutating"
    },
    {
      "command": "spectacular charter",
      "arguments": "<mission-ref>/<objective-ref> [sources...] [--json]",
      "schema": "spectacular.charter.show.v2",
      "effect": "read-only"
    },
    {
      "command": "spectacular decide",
      "arguments": "<decision.md|-> [--json]",
      "schema": "spectacular.decision.record.v2",
      "effect": "mutating"
    }
  ]
}
