# ── frontmatter helpers (v0.7.0+) ─────────────────────────────────────────────
# Shared by all mutator verbs (promote, archive, snapshot, new, touch). Each
# helper assumes YAML frontmatter delimited by --- at lines 1 and N.

# Read a top-level scalar frontmatter field. Stdout: value (trimmed, unquoted);
# empty if file missing, no frontmatter, or field absent.
fm_get() {
  local file="$1" field="$2"
  [[ -f "$file" ]] || return 0
  awk -v fld="$field" '
    /^---$/ { fm++; if (fm > 1) exit; next }
    fm == 1 && $0 ~ "^"fld":" {
      val = $0
      sub("^"fld":[[:space:]]*", "", val)
      gsub(/^"|"$/, "", val)
      gsub(/[[:space:]]+$/, "", val)
      print val
      exit
    }
  ' "$file"
}

# Write or replace a top-level scalar frontmatter field. Adds the field if
# missing (inserts just before the closing --- delimiter). Preserves
# surrounding YAML formatting. Quotes value with double quotes if it contains
# special characters.
#
# Usage: fm_set <file> <field> <value>
fm_set() {
  local file="$1" field="$2" value="$3"
  [[ -f "$file" ]] || die "fm_set: file not found: $file"

  # Quote if value contains a colon, leading dash, or wraps in special chars
  local quoted_value="$value"
  if [[ "$value" =~ [\":#] ]] || [[ "$value" =~ ^[[:space:]]*- ]]; then
    quoted_value="\"${value//\"/\\\"}\""
  fi

  local tmp
  tmp=$(mktemp)
  awk -v fld="$field" -v val="$quoted_value" '
    BEGIN { fm=0; replaced=0 }
    /^---$/ {
      fm++
      if (fm == 2 && !replaced) {
        # Insert field just before closing delimiter
        print fld ": " val
      }
      print
      next
    }
    fm == 1 && $0 ~ "^"fld":" {
      print fld ": " val
      replaced=1
      next
    }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# Set updated: to today.
fm_touch() {
  fm_set "$1" "updated" "$TODAY"
}

# Remove a frontmatter field entirely (within the first --- block). No-op if absent.
# Usage: fm_unset <file> <field>
fm_unset() {
  local file="$1" field="$2"
  [[ -f "$file" ]] || die "fm_unset: file not found: $file"
  local tmp; tmp=$(mktemp)
  awk -v fld="$field" '
    /^---$/ { fm++; print; next }
    fm == 1 && $0 ~ "^"fld":" { next }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# Remove a frontmatter block-list field entirely: the `field:` line plus every
# indented `- item` line under it (fm_unset only drops the key line, orphaning
# the items under the previous list). No-op if absent.
# Usage: _fm_unset_block <file> <field>
_fm_unset_block() {
  local file="$1" field="$2"
  [[ -f "$file" ]] || die "_fm_unset_block: file not found: $file"
  local tmp; tmp=$(mktemp)
  awk -v fld="$field" '
    /^---$/ { fm++; in_blk=0; print; next }
    fm == 1 && $0 ~ "^"fld":" { in_blk=1; next }
    in_blk && /^[[:space:]]+-[[:space:]]/ { next }     # drop indented list items
    in_blk { in_blk=0 }                                 # first non-item ends the block
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# ── last-mutation breadcrumb (v1.22.0+, for `spectacular undo`) ───────────────
# Single-level only: each lifecycle mutator overwrites .spectacular/.last-mutation
# with key=value lines describing how to reverse the last op. Gitignored — session
# ephemera, not team state. undo reads it, reverses, then clears it. See [[lifecycle-undo]].
_BREADCRUMB="$SPEC_WORKSPACE_DIR/.last-mutation"

# _breadcrumb_write op slug [k=v ...]  — overwrites the breadcrumb. Always stamps ts (epoch).
_breadcrumb_write() {
  local op="$1" slug="$2"; shift 2
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || return 0
  {
    echo "op=$op"
    echo "slug=$slug"
    echo "ts=$(date +%s)"
    local kv
    for kv in "$@"; do echo "$kv"; done
  } > "$_BREADCRUMB"
}

# _breadcrumb_get key  — print a value from the breadcrumb, empty if absent.
_breadcrumb_get() {
  [[ -f "$_BREADCRUMB" ]] || return 0
  awk -F= -v k="$1" '$1==k { sub(/^[^=]*=/,""); print; exit }' "$_BREADCRUMB"
}

_breadcrumb_clear() { rm -f "$_BREADCRUMB"; }

# Append item to a YAML list field. Creates the list (as inline `field: [item]`)
# if absent. Skips silently if item already present in list.
#
# Usage: fm_add_to_list <file> <field> <item>
fm_add_to_list() {
  local file="$1" field="$2" item="$3"
  [[ -f "$file" ]] || die "fm_add_to_list: file not found: $file"

  # Check if item already in list (handles both block and inline styles)
  if awk -v fld="$field" -v itm="$item" '
    /^---$/ { fm++; if (fm > 1) exit; next }
    fm == 1 && $0 ~ "^"fld":" { in_list=1; line=$0 }
    in_list && /- / {
      val = $0
      sub(/^[[:space:]]*-[[:space:]]*/, "", val)
      gsub(/^"|"$/, "", val)
      if (val == itm) { found=1; exit }
    }
    in_list && !/^[[:space:]]/ && !/^---$/ { in_list=0 }
    END { exit (found ? 0 : 1) }
  ' "$file"; then
    return 0  # already present
  fi

  # Detect list style + append. Simple case: block list (one - per line).
  local tmp
  tmp=$(mktemp)
  awk -v fld="$field" -v itm="$item" '
    BEGIN { fm=0; inserted=0; in_list=0 }
    /^---$/ {
      fm++
      if (fm == 2 && !inserted) {
        # Field absent entirely; insert before closing delim
        print fld ":\n  - " itm
        inserted=1
      }
      print
      next
    }
    fm == 1 && $0 ~ "^"fld":" {
      print
      in_list=1
      next
    }
    in_list && /^[[:space:]]*-[[:space:]]+/ {
      print
      next
    }
    in_list && !/^[[:space:]]/ {
      # End of list — insert before this line
      print "  - " itm
      inserted=1
      in_list=0
      print
      next
    }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# ── soft-DB helpers (v1.5.0 — decide / remember / session) ──────────────────

# Derive a kebab-case slug from arbitrary text. Takes first ~6 words.
# Usage: _slug_from_text "use bash for the cli implementation"
#        → use-bash-for-the-cli-implementation
_slug_from_text() {
  local text="$1"
  local words
  words=$(echo "$text" | awk '{ for (i=1;i<=NF && i<=6;i++) printf "%s ", $i; print "" }')
  echo "$words" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9 ]+/ /g; s/[[:space:]]+/-/g; s/-+/-/g; s/^-//; s/-$//' \
    | cut -c1-64
}

# Resolve slug collisions by appending -2, -3, etc. Warns on collision.
# Usage: _resolve_slug_collision <dir> <base-slug> <ext>
#        echoes the final slug (no extension)
_resolve_slug_collision() {
  local dir="$1" base="$2" ext="$3"
  local candidate="$base" n=2
  while [[ -e "$dir/$candidate.$ext" ]]; do
    candidate="${base}-${n}"
    n=$((n + 1))
  done
  if [[ "$candidate" != "$base" ]]; then
    echo "  ⚠  slug collision: '$base' → '$candidate'" >&2
  fi
  echo "$candidate"
}

# Derive a 1-line summary from the first sentence of text.
# Usage: _summary_from_text "long text. with multiple sentences."
# Note: uses sed (multibyte-safe) instead of awk char-iteration which chokes
# on em-dashes and other 3-byte UTF-8 chars on macOS.
_summary_from_text() {
  local text="$1"
  # Replace newlines with spaces, take first sentence (split on period/!/? + space),
  # strip trailing punctuation, trim, cap at 120 chars.
  local summary
  summary=$(printf '%s' "$text" \
    | tr '\n' ' ' \
    | sed -E 's/([.!?])[[:space:]].*$/\1/' \
    | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+|[[:space:]]+$//g; s/[.!?]+$//' \
    | cut -c1-120)
  echo "$summary"
}

# Return the slug of the currently-open session, or empty if none.
# Scans .spectacular/sessions/*.md for status: open.
_active_session_slug() {
  local sessions_dir="$SPEC_SESSIONS_DIR"
  [[ -d "$sessions_dir" ]] || return 0
  local file status
  for file in "$sessions_dir"/*.md; do
    [[ -f "$file" ]] || continue
    status=$(fm_get "$file" "status")
    if [[ "$status" == "open" ]]; then
      basename "$file" .md
      return 0
    fi
  done
}

# Resolve a template path. Looks in project-local override first, then bundled.
# Usage: _resolve_template <relative-path-under-templates>
#        e.g. "memory/entry.md" → /path/to/templates/memory/entry.md
_resolve_template() {
  local rel="$1"
  local project_override="$SPEC_WORKSPACE_DIR/templates/$rel"
  if [[ -f "$project_override" ]]; then
    echo "$project_override"; return 0
  fi
  local bundled
  bundled="$(agents_skill_dir)/templates/$rel"
  if [[ -f "$bundled" ]]; then
    echo "$bundled"; return 0
  fi
  # Scope-independent global install fallback: a workspace may use a globally
  # installed skill regardless of OPT_SKILL_SCOPE (which is only "global" at
  # init time). Check the canonical global skill dir directly.
  bundled="$HOME/.agents/skills/spectacular/templates/$rel"
  if [[ -f "$bundled" ]]; then
    echo "$bundled"; return 0
  fi
  bundled="${SCRIPT_DIR}/../skills/spectacular/templates/$rel"
  if [[ -f "$bundled" ]]; then
    echo "$bundled"; return 0
  fi
  return 1
}

# Render a template by substituting <PLACEHOLDER> tokens.
# Usage: _render_template <template-path> <KEY1> <VAL1> <KEY2> <VAL2> ...
#        Emits rendered content to stdout.
_render_template() {
  local template="$1"; shift
  local content
  content=$(cat "$template")
  # Strip leading <!-- ... --> comment block (template hints not meant for output)
  content=$(echo "$content" | awk 'BEGIN{skip=0} /^<!--$/||/^<!--/{skip=1} skip && /-->$/{skip=0;next} !skip{print}')
  # Trim leading blank lines
  content=$(echo "$content" | awk 'BEGIN{started=0} /./{started=1} started{print}')
  while (( $# >= 2 )); do
    local key="$1" val="$2"; shift 2
    # Escape forward slashes + ampersands for sed replacement
    local esc_val
    esc_val=$(printf '%s' "$val" | sed 's/[\/&]/\\&/g')
    content=$(echo "$content" | sed "s/<${key}>/${esc_val}/g")
  done
  echo "$content"
}

# Regenerate MEMORY.md index from .spectacular/memory/*.md entries.
# Newest first by date in frontmatter.
_regen_memory_index() {
  local index="$SPEC_MEMORIES_DIR/index.md"
  local entries_dir="$SPEC_MEMORIES_DIR"
  [[ -d "$entries_dir" ]] || return 0

  {
    cat <<EOF
---
type: index
doc: memory
version: 1.0
updated: $TODAY
summary: "Operational memory index — auto-regenerated by spectacular remember"
---

# Memory

| Date | Slug | Tags | Summary |
|------|------|------|---------|
EOF
    # Collect rows: date<TAB>slug<TAB>tags<TAB>summary, sort by date desc
    local file slug date tags summary tags_inline
    for file in "$entries_dir"/*.md; do
      [[ -f "$file" ]] || continue
      slug=$(basename "$file" .md)
      [[ "$slug" == "index" ]] && continue
      date=$(fm_get "$file" "date")
      summary=$(fm_get "$file" "summary")
      # tags: read inline list; fall back to empty
      tags_inline=$(awk '/^---$/{fm++;if(fm>1)exit;next} fm==1 && /^tags:/{
        val=$0; sub(/^tags:[[:space:]]*/,"",val); print val; exit }' "$file")
      tags="${tags_inline:-[]}"
      printf '%s\t%s\t%s\t%s\n' "${date:-0000-00-00}" "$slug" "$tags" "$summary"
    done | sort -r | awk -F'\t' '{printf "| %s | [[memories/%s]] | %s | %s |\n", $1, $2, $3, $4}'
  } > "$index"
}

# Regenerate SESSIONS.md index from .spectacular/sessions/*.md entries.
# Newest first by start_date. Status column shows open|closed.
_regen_sessions_index() {
  local index="$SPEC_SESSIONS_DIR/index.md"
  local entries_dir="$SPEC_SESSIONS_DIR"
  [[ -d "$entries_dir" ]] || return 0

  {
    cat <<EOF
---
type: index
doc: sessions
version: 1.0
updated: $TODAY
summary: "Sessions index — auto-regenerated by spectacular session start|end"
---

# Sessions

| Start | Slug | Status | Decisions | Memories | Tags |
|-------|------|--------|-----------|----------|------|
EOF
    local file slug start status dcount mcount tags_inline
    for file in "$entries_dir"/*.md; do
      [[ -f "$file" ]] || continue
      slug=$(basename "$file" .md)
      [[ "$slug" == "index" ]] && continue
      start=$(fm_get "$file" "start_date")
      status=$(fm_get "$file" "status")
      dcount=$(fm_get "$file" "decisions_count")
      mcount=$(fm_get "$file" "memories_count")
      tags_inline=$(awk '/^---$/{fm++;if(fm>1)exit;next} fm==1 && /^tags:/{
        val=$0; sub(/^tags:[[:space:]]*/,"",val); print val; exit }' "$file")
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${start:-0000-00-00}" "$slug" "${status:-?}" "${dcount:-0}" "${mcount:-0}" "${tags_inline:-[]}"
    done | sort -r | awk -F'\t' '{printf "| %s | [[sessions/%s]] | %s | %s | %s | %s |\n", $1, $2, $3, $4, $5, $6}'
  } > "$index"
}

_regen_decisions_index() {
  local dir="$SPEC_DECISIONS_DIR" index rows file base id n title rationale tags tmp
  index="$dir/index.md"
  [[ -d "$dir" ]] || return 0
  rows=$(mktemp)
  for file in "$dir"/*.md; do
    [[ -f "$file" && "$(basename "$file")" != index.md ]] || continue
    id=$(fm_get "$file" id)
    if [[ -z "$id" ]]; then
      base=$(basename "$file" .md)
      case "$base" in
        DEC-[0-9]*) id=$(printf '%s' "$base" | sed -E 's/^(DEC-[0-9]+).*/\1/') ;;
        D[0-9]*) id=$(printf '%s' "$base" | sed -E 's/^(D[0-9]+).*/\1/') ;;
      esac
    fi
    [[ -n "$id" ]] || continue
    n="$id"
    title=$(grep -m1 '^# ' "$file" | sed -E 's/^# (DEC-|D)?[0-9]+[[:space:]]+[—-][[:space:]]+//' | tr '\t' ' ')
    [[ -n "$title" ]] || title=$(basename "$file" .md)
    rationale=$(awk '/^\*\*Consequences:\*\*/{found=1;next} found && NF{print;exit}' "$file" | tr '\t' ' ' | sed -E 's/( #[[:alnum:]_-]+)+[[:space:]]*$//')
    tags=$(fm_get "$file" tags | tr -d '[]' | sed 's/, */ #/g; s/^/#/' | sed 's/^#$//')
    printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$id" "$title" "$rationale" "$tags" >> "$rows"
  done
  tmp=$(mktemp)
  sort -k1,1 "$rows" | awk -F'\t' '
    { num[NR]=$1; id[NR]=$2; title[NR]=$3; why[NR]=$4; tags[NR]=$5 }
    END {
      for (i=1;i<=NR;i++) { printf "- **%s** — %s", id[i], title[i]; if (why[i] != "") printf " — %s", why[i]; if (tags[i] != "") printf " %s", tags[i]; print "" }
    }
  ' > "$tmp"
  cat > "$index" <<EOF
---
type: decisions
doc: decisions
mode: index
version: 1.0
updated: $TODAY
summary: "Architectural and product decisions log"
---

# Decisions

EOF
  cat "$tmp" >> "$index"
  rm -f "$rows" "$tmp"
}

# ── cmd_remember: spectacular remember "<text>" [--tag a,b] ─────────────────
cmd_remember() {
  local text="" tags_csv="" supersedes="" dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --tag|--tags) require_value "--tag" "${2:-}"; tags_csv="$2"; shift 2 ;;
      --supersedes) require_value "--supersedes" "${2:-}"; supersedes="$2"; shift 2 ;;
      --dry-run)    dry_run=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular remember "<text>" [--tag a,b] [--supersedes <memory>] [--dry-run]

Write one memory entry to .spectacular/memories/M<N>-<slug>.md and regenerate
memories/index.md index. Auto-derives slug + summary. If a session is open,
the entry links to it via frontmatter session: field.
EOF
        exit 0 ;;
      -*) die "Unknown flag for remember: $1" ;;
      *)
        [[ -n "$text" ]] && die "remember: only one <text> argument allowed"
        text="$1"; shift ;;
    esac
  done

  [[ -z "$text" ]] && die "remember: <text> argument required. See: spectacular remember --help"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "remember: not inside a Spectacular workspace"

  local base_slug slug entry_dir entry_path summary tags_yaml session old_memory=""
  entry_dir="$SPEC_MEMORIES_DIR"
  mkdir -p "$entry_dir"
  if [[ -n "$supersedes" ]]; then
    old_memory=$(_memory_find "$supersedes") || die "remember: superseded memory '$supersedes' not found"
    [[ "$(fm_get "$old_memory" status)" == active || -z "$(fm_get "$old_memory" status)" ]] || die "remember: superseded memory must be active"
  fi

  # Auto-number: find highest M<N> in memories/ dir
  local next_n
  next_n=$(_next_entry_num "$entry_dir" M)
  local mnum="M${next_n}"

  local raw_slug
  raw_slug=$(_slug_from_text "$text")
  [[ -z "$raw_slug" ]] && die "remember: could not derive slug from text"
  base_slug="${mnum}-${raw_slug}"

  slug=$(_resolve_slug_collision "$entry_dir" "$base_slug" "md")
  entry_path="$entry_dir/$slug.md"
  summary=$(_summary_from_text "$text")

  # Build tags YAML inline list
  if [[ -n "$tags_csv" ]]; then
    tags_yaml="[$(echo "$tags_csv" | sed 's/,/, /g')]"
  else
    tags_yaml="[]"
  fi

  session=$(_active_session_slug)
  local session_yaml="null"
  [[ -n "$session" ]] && session_yaml="$session"

  local template rendered
  template=$(_resolve_template "memory/entry.md") || die_recover \
    "remember: memory entry template not found" \
    "Create .spectacular/memories/${base_slug}.md with frontmatter:" \
    "  type: memory / date: $TODAY / tags: [...] / summary: \"...\" / session: null" \
    "then add the body text below the frontmatter." \
    "It will appear in memories/index.md on the next successful 'spectacular remember'."
  rendered=$(_render_template "$template" \
    DATE "$TODAY" \
    TAGS "$tags_yaml" \
    SUMMARY "$summary" \
    SESSION "$session_yaml" \
    TEXT "$text")

  if $dry_run; then
    echo "── would write $entry_path ──"
    echo "$rendered"
    echo "── would regenerate memories/index.md ──"
    return 0
  fi

  echo "$rendered" > "$entry_path"
  [[ -n "$supersedes" ]] && fm_set "$entry_path" supersedes "$(basename "$old_memory" .md)"
  created "$entry_path"
  if [[ -n "$old_memory" ]]; then
    fm_set "$old_memory" status superseded
    fm_set "$old_memory" superseded_by "$slug"
    fm_touch "$old_memory"
    info "  ↔ superseded: $(basename "$old_memory" .md)"
  fi
  _regen_memory_index
  info "  ✓  memories/index.md regenerated"
  if [[ -n "$session" ]]; then
    info "  ↳ linked to session: $session"
  fi
}

# ── cmd_decide: spectacular decide "<text>" ─────────────────────────────────
# v1.5.0: appends to flat DECISIONS.md.
# v1.17.0: detects index mode (decisions/ folder) and writes per-entry file instead.
cmd_decide() {
  local text="" context="" consequences="" evidence="" tags_csv="" autonomous=false technical=false in_scope=false reversible=false no_product_tradeoff=false alternatives="" derived_from="" supersedes="" dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --context)      require_value "--context" "${2:-}";      context="$2";      shift 2 ;;
      --consequences) require_value "--consequences" "${2:-}"; consequences="$2"; shift 2 ;;
      --evidence)     require_value "--evidence"     "${2:-}"; evidence="$2";     shift 2 ;;
      --tag|--tags)   require_value "$1" "${2:-}"; tags_csv="$2"; shift 2 ;;
      --autonomous)   autonomous=true; shift ;;
      --technical) technical=true; shift ;;
      --in-scope) in_scope=true; shift ;;
      --reversible) reversible=true; shift ;;
      --no-product-tradeoff) no_product_tradeoff=true; shift ;;
      --alternatives) require_value "--alternatives" "${2:-}"; alternatives="$2"; shift 2 ;;
      --derived-from) require_value "--derived-from" "${2:-}"; derived_from="$2"; shift 2 ;;
      --supersedes) require_value "--supersedes" "${2:-}"; supersedes=$(_canonical_resolve "$2" decision); shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: spectacular decide "<decision>" [--context "..."] [--consequences "..."] [--tags cli,docs] [--derived-from <source>] [--supersedes <DEC>] [--dry-run]

Append one ADR-style entry to .spectacular/decisions/index.md (Context / Decision /
Consequences). The positional argument fills **Decision:**. Auto-derives a
title from the first ~6 words of the decision. If a session is open, the entry
includes a Session: link to the active session.

Writes full ADR prose to decisions/DEC-NNN-<slug>.md and appends one index line to decisions/index.md.
Legacy D<N> files remain readable and contribute to the next allocated number.

  --context "..."        fill the **Context:** section (situation forcing the decision)
  --consequences "..."   fill the **Consequences:** section (what it enables/forecloses)
  --tags cli,docs         reusable topic labels (stored as frontmatter tags)
  --derived-from "..."   cite unambiguous user intent already recorded elsewhere
  --supersedes <DEC>     create a replacement decision; preserve the old history
  --autonomous           narrow AFK exception; also requires conclusive RES/SPK evidence,
                         --technical --in-scope --reversible --no-product-tradeoff,
                         and --alternatives

Sections left without a flag are emitted as empty headers to fill in later.
EOF
        exit 0 ;;
      -*) die "Unknown flag for decide: $1" ;;
      *)
        [[ -n "$text" ]] && die "decide: only one <decision> argument allowed"
        text="$1"; shift ;;
    esac
  done

  [[ -z "$text" ]] && die "decide: <decision> argument required. See: spectacular decide --help"
  if $autonomous; then
    [[ -n "$evidence" ]] || die "decide: --autonomous requires completed research/spike --evidence"
    $technical && $in_scope && $reversible && $no_product_tradeoff && [[ -n "$alternatives" ]] || die "decide: autonomous decisions require --technical --in-scope --reversible --no-product-tradeoff --alternatives"
    local run allowed token ep result
    run=$(_afk_active_run) || die "decide: --autonomous is allowed only inside an active AFK run"
    [[ "$(fm_get "$run" status)" == active ]] || die "decide: AFK run is gated"
    allowed=$(fm_get "$run" allowed_actions)
    [[ ",$allowed," == *,decisions,* ]] || die "decide: active AFK run does not authorize decisions"
    local old_ifs="$IFS"; IFS=','
    for token in $evidence; do
      token=$(printf '%s' "$token" | tr -d ' ')
      case "$token" in RES-*|SPK-*) ;; *) die "decide: autonomous evidence '$token' must be a RES/SPK canonical ID" ;; esac
      ep=$(_wayfind_find_id "$token") || die "decide: evidence '$token' not found"
      [[ "$(fm_get "$ep" status)" == completed ]] || die "decide: evidence '$token' is not completed"
      result=$(fm_get "$ep" result); [[ "$result" == supported || "$result" == refuted ]] || die "decide: evidence '$token' is inconclusive"
    done
    IFS="$old_ifs"
  fi
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "decide: not inside a Spectacular workspace"

  local title session decision_slug old_decision=""
  title=$(_summary_from_text "$text")
  decision_slug=$(_slug_from_text "$text")
  session=$(_active_session_slug)

  local decisions="$SPEC_DECISIONS_DIR/index.md"
  local decisions_dir="$SPEC_DECISIONS_DIR"

  # Enforce index mode under OKF: bootstrap decisions/ directory if absent
  mkdir -p "$decisions_dir"
  _require_unique_collection_slug decisions "$decision_slug" "decide"
  if [[ -n "$supersedes" ]]; then
    old_decision=$(_wayfind_find_id "$supersedes") || die "decide: superseded decision '$supersedes' not found"
    [[ "$(fm_get "$old_decision" status)" == verified ]] || die "decide: $supersedes is not a verified current decision"
  fi

  # ── Index mode ──────────────────────────────────────────────────────────────
  # UUIDv7 IDs avoid branch-local counter allocation; the slug remains the path.
  local dnum
  dnum=$(_uuidv7)
  local entry_slug="${decision_slug}"
  local entry_path="${decisions_dir}/${entry_slug}.md"

  # Build the index line with the canonical ID.
  # Title comes from the decision text; rationale from consequences if provided.
  local rationale="${consequences:-${context:-}}"
  local index_line
  if [[ -n "$rationale" ]]; then
    index_line="- **${dnum}** — ${title} — ${rationale}"
  else
    index_line="- **${dnum}** — ${title}"
  fi

  local origin="user"
  $autonomous && origin="autonomous-evidence"
  [[ -n "$derived_from" ]] && origin="user-derived"

  # Build full ADR prose for the per-entry file
  local prose
  prose=$(printf '%s\n' \
    '---' \
    "id: $dnum" \
    "slug: $decision_slug" \
    'kind: decision' \
    'scope: project' \
    'status: verified' \
    "origin: $origin" \
    "derived_from: \"$derived_from\"" \
    "supersedes: \"$supersedes\"" \
    "evidence: \"${evidence:-user direction}\"" \
    "tags: [$(printf '%s' "$tags_csv" | sed 's/,/, /g')]" \
    "updated: $TODAY" \
    'references: []' \
    '---' \
    '' \
    "# $title" \
    '' \
    '**Context:**' \
    "$context" \
    '' \
    '**Evidence:**' \
    "${evidence:-User direction recorded by explicit command.}" \
    '' \
    '**Alternatives considered:**' \
    "${alternatives:-Recorded in the cited user context or decision discussion.}" \
    '' \
    '**Decision:**' \
    "$text" \
    '' \
    '**Consequences:**' \
    "$consequences")
  if [[ -n "$session" ]]; then
    prose+="$(printf '\n**Session:** [[sessions/%s]]\n' "$session")"
  fi

  if $dry_run; then
    echo "── would write ${entry_path} ──"
    echo "$prose"
    echo ""
    echo "── would append to ${decisions} (index line) ──"
    echo "$index_line"
    return 0
  fi

  # Ensure decisions/index.md exists
  if [[ ! -f "$decisions" ]]; then
    cat > "$decisions" <<EOF
---
type: decisions
doc: decisions
updated: $TODAY
---

# Decisions

EOF
    created "$decisions"
  fi

  printf '%s\n' "$prose" > "$entry_path"
  if [[ -n "$old_decision" ]]; then
    fm_set "$old_decision" status superseded
    fm_set "$old_decision" superseded_by "$dnum"
    fm_touch "$old_decision"
  fi
  created "$entry_path"
  _regen_decisions_index
  info "  ✓  decision $dnum: $title"
  [[ -n "$session" ]] && info "  ↳ linked to session: $session"
  return 0
}

# ── canonical IDs + questions (wayfinding contract) ─────────────────────────
# Canonical cross-store IDs are stable machine references. Input accepts short
# aliases; persisted references always use the canonical prefix and padding.
_canonical_prefix() {
  local raw
  raw=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  case "$raw" in
    D|DEC|DECISION|DECISIONS) echo "DEC" ;;
    Q|QUE|QUESTION|QUESTIONS) echo "QUE" ;;
    I|IDE|IDEA|IDEAS) echo "IDEA" ;;
    R|RES|RESEARCH) echo "RES" ;;
    SPK|SPIKE|SPIKES) echo "SPK" ;;
    PRT|PROTOTYPE|PROTOTYPES) echo "PRT" ;;
    S|SPC|SPEC|SPECS|SPECIFICATION|SPECIFICATIONS) echo "SPC" ;;
    T|TSK|TASK|TASKS) echo "TSK" ;;
    FND|FINDING|FINDINGS) echo "FND" ;;
    FIX|REMEDIATION|REMEDIATIONS) echo "FIX" ;;
    BUG|BUGS|DEFECT|DEFECTS) echo "BUG" ;;
    SEC|SECURITY) echo "SEC" ;;
    BM|BMK|BENCHMARK|BENCHMARKS) echo "BMK" ;;
    *) return 1 ;;
  esac
}

_canonical_pad() {
  local digits="$1" n width=3
  [[ "$digits" =~ ^[0-9]+$ ]] || return 1
  n=$((10#$digits))
  (( n > 999 )) && width=4
  printf "%0${width}d" "$n"
}

_is_uuidv7() {
  printf '%s\n' "$1" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
}

_uuidv7() {
  # Bash 3.2 has neither nanosecond date formatting nor a portable UUID helper.
  # The Unix-second portion still gives UUIDv7 chronological ordering; RANDOM
  # supplies the remaining entropy so independent branches never share a counter.
  local millis time_high time_low rand_a variant rand_b1 rand_b2 rand_b3 rand_b4
  millis=$(( $(date +%s) * 1000 ))
  time_high=$(( millis / 65536 ))
  time_low=$(( millis % 65536 ))
  rand_a=$(( RANDOM & 4095 ))
  variant=$(( 8 + (RANDOM & 3) ))
  rand_b1=$(( RANDOM & 4095 ))
  rand_b2=$(( (RANDOM << 1) | (RANDOM & 1) ))
  rand_b3=$(( (RANDOM << 1) | (RANDOM & 1) ))
  rand_b4=$(( (RANDOM << 1) | (RANDOM & 1) ))
  printf '%08x-%04x-7%03x-%x%03x-%04x%04x%04x\n' \
    "$time_high" "$time_low" "$rand_a" "$variant" "$rand_b1" "$rand_b2" "$rand_b3" "$rand_b4"
}

_collection_for_context() {
  case "$1" in
    decision|decisions) echo decisions ;;
    question|questions) echo questions ;;
    idea|ideas) echo ideas ;;
    research) echo research ;;
    spike|spikes) echo spikes ;;
    spec|specs|specification|specifications) echo specs ;;
    *) return 1 ;;
  esac
}

_record_slug() {
  local file="$1" base slug
  slug=$(fm_get "$file" slug)
  [[ -n "$slug" ]] && { printf '%s\n' "$slug"; return 0; }
  base=$(basename "$file" .md)
  printf '%s\n' "$base" | sed -E 's/^(DEC|QUE|IDEA|RES|SPK|SPC)-[0-9]+-//; s/^D[0-9]+-//'
}

_resolve_uuid_or_slug() {
  local ref="$1" context="$2" collection f id aliases found=""
  ref=$(printf '%s' "$ref" | tr '[:upper:]' '[:lower:]')
  _is_uuidv7 "$ref" && { printf '%s\n' "$ref"; return 0; }
  collection=$(_collection_for_context "$context") || return 1
  for f in "$SPEC_WORKSPACE_DIR/$collection"/*.md "$SPEC_ARCHIVE_DIR/$collection"/*.md; do
    [[ -f "$f" ]] || continue
    [[ "$(basename "$f")" == index.md ]] && continue
    aliases=$(fm_get "$f" aliases | tr '[:upper:]' '[:lower:]')
    [[ "$(_record_slug "$f")" == "$ref" || "$aliases" == "$ref" ]] || continue
    id=$(fm_get "$f" id)
    [[ -n "$id" ]] || continue
    [[ -z "$found" ]] || die "id resolve: slug '$ref' is ambiguous in $collection"
    found="$id"
  done
  [[ -n "$found" ]] || return 1
  printf '%s\n' "$found"
}

_collection_slug_exists() {
  local collection="$1" slug="$2" f base dir
  for dir in "$SPEC_WORKSPACE_DIR/$collection" "$SPEC_ARCHIVE_DIR/$collection"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      [[ "$(basename "$f")" == index.md ]] && continue
      base=$(basename "$f" .md)
      base=$(printf '%s' "$base" | sed -E 's/^(DEC|QUE|IDEA|RES|SPK|SPC)-[0-9]+-//; s/^D[0-9]+-//')
      [[ "$base" == "$slug" ]] && return 0
    done
  done
  return 1
}

_require_unique_collection_slug() {
  local collection="$1" slug="$2" command="$3"
  _collection_slug_exists "$collection" "$slug" && \
    die "$command: slug '$slug' already exists in .spectacular/$collection/"
  return 0
}

_canonical_resolve() {
  local ref="$1" context="${2:-}" compact prefix digits
  ref=$(printf '%s' "$ref" | tr '[:upper:]' '[:lower:]')
  _is_uuidv7 "$ref" && { printf '%s\n' "$ref"; return 0; }
  if [[ -n "$context" ]]; then
    _resolve_uuid_or_slug "$ref" "$context" 2>/dev/null && return 0
  fi
  compact=$(printf '%s' "$ref" | tr -d ' _-' | tr '[:lower:]' '[:upper:]')

  if [[ "$compact" =~ ^([A-Z]+)([0-9]+)$ ]]; then
    prefix=$(_canonical_prefix "${BASH_REMATCH[1]}") ||
      die "id resolve: unknown prefix '${BASH_REMATCH[1]}' in '$ref'"
    digits="${BASH_REMATCH[2]}"
  elif [[ "$compact" =~ ^[0-9]+$ ]]; then
    [[ -n "$context" ]] || die "id resolve: naked number '$ref' is ambiguous; pass --context decision|question|idea|research|spike|prototype|spec|task"
    prefix=$(_canonical_prefix "$context") || die "id resolve: unknown context '$context'"
    digits="$compact"
  else
    die "id resolve: invalid reference '$ref'"
  fi

  printf '%s-%s\n' "$prefix" "$(_canonical_pad "$digits")"
}

_next_canonical_id() {
  local collection="$1" prefix="$2" next=1 f base digits n dir
  for dir in "$SPEC_WORKSPACE_DIR/$collection" "$SPEC_ARCHIVE_DIR/$collection"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      [[ "$(basename "$f")" == "index.md" ]] && continue
      base=$(basename "$f" .md)
      digits=""
      case "$base" in
        "$prefix"-[0-9]*) digits="${base#${prefix}-}"; digits="${digits%%-*}" ;;
        D[0-9]*) [[ "$prefix" == "DEC" ]] && { digits="${base#D}"; digits="${digits%%-*}"; } ;;
      esac
      [[ "$digits" =~ ^[0-9]+$ ]] || continue
      n=$((10#$digits))
      (( n >= next )) && next=$((n + 1))
    done
  done
  printf '%s-%s\n' "$prefix" "$(_canonical_pad "$next")"
}

cmd_id() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    generate)
      (( $# == 0 )) || die "id generate: no arguments expected"
      _uuidv7
      ;;
    resolve)
      local ref="" context=""
      while (( $# > 0 )); do
        case "$1" in
          --context) require_value "--context" "${2:-}"; context="$2"; shift 2 ;;
          -*) die "id resolve: unknown flag '$1'" ;;
          *) [[ -z "$ref" ]] || die "id resolve: only one reference allowed"; ref="$1"; shift ;;
        esac
      done
      [[ -n "$ref" ]] || die "Usage: spectacular id resolve <ref> [--context <entity>]"
      local compact_ref
      compact_ref=$(printf '%s' "$ref" | tr -d ' _-' | tr '[:upper:]' '[:lower:]')
      if [[ -z "$context" && "$compact_ref" =~ ^fix([0-9]+)$ ]]; then
        printf 'F%s\n' "$((10#${BASH_REMATCH[1]}))"; return 0
      fi
      if [[ -z "$context" && "$compact_ref" =~ ^f([0-9]+)$ ]]; then
        die "id resolve: '$ref' is intentionally ambiguous; use fix${BASH_REMATCH[1]} for a fix or fnd${BASH_REMATCH[1]} for a finding"
      fi
      if [[ -z "$context" && "$compact_ref" =~ ^b([0-9]+)$ ]]; then
        printf 'b%s\n' "$((10#${BASH_REMATCH[1]}))"; return 0
      fi
      _canonical_resolve "$ref" "$context"
      ;;
    migrate)
      cmd_id_migrate "$@"
      ;;
    ""|--help|-h)
      cat <<EOF
Usage:
  spectacular id generate
  spectacular id resolve <ref> [--context <entity>]
  spectacular id migrate [--uuidv7] [--dry-run | --apply --yes]

Examples:
  spectacular id resolve d1                 # DEC-001
  spectacular id resolve res2               # RES-002
  spectacular id resolve 3 --context question  # QUE-003

Naked numbers require context. Persisted cross-references always use the
canonical ID, even when input used an alias. `--uuidv7` is preview-first and
preserves previous IDs as read-only aliases.
EOF
      ;;
    *) die "id: unknown subcommand '$sub'. Use: resolve | migrate" ;;
  esac
}

_id_migration_add_frontmatter() {
  local file="$1" id="$2" type="$3" status="$4"
  if ! head -1 "$file" | grep -q '^---$'; then
    local tmp="${file}.tmp.$$"
    {
      echo '---'
      echo "id: $id"
      echo "type: $type"
      echo "status: $status"
      echo "updated: $TODAY"
      echo '---'
      echo ''
      cat "$file"
    } > "$tmp"
    mv "$tmp" "$file"
  else
    fm_set "$file" id "$id"
    fm_set "$file" type "$type"
    [[ -n "$status" ]] && fm_set "$file" status "$status"
    fm_touch "$file"
  fi
}

cmd_id_migrate() {
  local apply=false yes=false uuidv7=false
  while (( $# > 0 )); do
    case "$1" in
      --dry-run) apply=false; shift ;;
      --apply) apply=true; shift ;;
      --yes) yes=true; shift ;;
      --uuidv7) uuidv7=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular id migrate [--dry-run | --apply --yes]

Preview or apply canonical filenames for legacy decisions, ideas, and specs.
Apply is archive-first: original files and a mapping are copied under
.spectacular/archive/id-migrations/<timestamp>/ before any rename. References
to the old paths are then rewritten. Default is dry-run; --apply requires --yes.
EOF
        return 0 ;;
      *) die "id migrate: unknown option '$1'" ;;
    esac
  done
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "id migrate: not inside a Spectacular workspace"
  $apply && ! $yes && die "id migrate: --apply requires --yes after reviewing the dry-run"
  $uuidv7 && { _id_migrate_uuidv7 "$apply"; return $?; }

  local tmp map f base suffix num id old new next_idea=1 next_spec=1
  tmp=$(mktemp -d); map="$tmp/mapping.tsv"; : > "$map"

  # Seed sequential allocators from already-canonical files.
  for f in "$SPEC_IDEAS_DIR"/IDEA-[0-9]*.md; do
    [[ -f "$f" ]] || continue; base=$(basename "$f"); num="${base#IDEA-}"; num="${num%%-*}"
    [[ "$num" =~ ^[0-9]+$ ]] && (( 10#$num >= next_idea )) && next_idea=$((10#$num + 1))
  done
  for f in "$SPEC_SPECS_DIR"/SPC-[0-9]*.md; do
    [[ -f "$f" ]] || continue; base=$(basename "$f"); num="${base#SPC-}"; num="${num%%-*}"
    [[ "$num" =~ ^[0-9]+$ ]] && (( 10#$num >= next_spec )) && next_spec=$((10#$num + 1))
  done

  # Decisions retain their historical number.
  for f in "$SPEC_DECISIONS_DIR"/D[0-9]*.md; do
    [[ -f "$f" ]] || continue
    base=$(basename "$f" .md)
    [[ "$base" =~ ^D([0-9]+)(-(.*))?$ ]] || continue
    num=$((10#${BASH_REMATCH[1]})); suffix="${BASH_REMATCH[3]:-decision-$num}"
    id="DEC-$(_canonical_pad "$num")"; old="${f#"$SPEC_WORKSPACE_DIR"/}"; new="decisions/$id-$suffix.md"
    [[ ! -e "$SPEC_WORKSPACE_DIR/$new" ]] || die "id migrate: target exists: .spectacular/$new"
    printf '%s|%s|%s|decision|verified\n' "$old" "$new" "$id" >> "$map"
  done

  # Legacy ideas get deterministic IDs in filename sort order.
  for f in "$SPEC_IDEAS_DIR"/*.md; do
    [[ -f "$f" ]] || continue; base=$(basename "$f" .md)
    [[ "$base" == index || "$base" == IDEA-[0-9]* ]] && continue
    id="IDEA-$(_canonical_pad "$next_idea")"; next_idea=$((next_idea + 1))
    old="${f#"$SPEC_WORKSPACE_DIR"/}"; new="ideas/$id-$base.md"
    printf '%s|%s|%s|idea|%s\n' "$old" "$new" "$id" "$(fm_get "$f" status)" >> "$map"
  done

  # Legacy capability specs become canonical SPC files; old statuses map forward.
  for f in "$SPEC_SPECS_DIR"/*.md; do
    [[ -f "$f" ]] || continue; base=$(basename "$f" .md)
    [[ "$base" == index || "$base" == SPC-[0-9]* ]] && continue
    id="SPC-$(_canonical_pad "$next_spec")"; next_spec=$((next_spec + 1))
    local legacy_status new_status
    legacy_status=$(fm_get "$f" status)
    case "$legacy_status" in
      draft|"") new_status=draft ;;
      unconfirmed) new_status=unconfirmed ;;
      stable|published|current) new_status=approved ;;
      deprecated) new_status=deprecated ;;
      *) new_status="$legacy_status" ;;
    esac
    old="${f#"$SPEC_WORKSPACE_DIR"/}"; new="specs/$id-$base.md"
    printf '%s|%s|%s|specification|%s\n' "$old" "$new" "$id" "$new_status" >> "$map"
  done

  local count
  count=$(wc -l < "$map" | tr -d ' ')
  if (( count == 0 )); then info "  ✓  IDs already canonical — nothing to migrate"; rm -rf "$tmp"; return 0; fi

  info "── canonical ID migration ($count file(s)) ──"
  while IFS='|' read -r old new id _type _status; do info "  $old → $new  ($id)"; done < "$map"
  if ! $apply; then
    info ""
    info "Dry-run only. Apply with: spectacular id migrate --apply --yes"
    rm -rf "$tmp"
    return 0
  fi

  local stamp archive_root archived type status mf old_base new_base
  stamp=$(date +%Y%m%d-%H%M%S)
  archive_root="$SPEC_ARCHIVE_DIR/id-migrations/$stamp"
  mkdir -p "$archive_root"
  cp "$map" "$archive_root/mapping.tsv"

  while IFS='|' read -r old new id type status; do
    archived="$archive_root/$old"
    mkdir -p "$(dirname "$archived")" "$(dirname "$SPEC_WORKSPACE_DIR/$new")"
    cp "$SPEC_WORKSPACE_DIR/$old" "$archived"
    mv "$SPEC_WORKSPACE_DIR/$old" "$SPEC_WORKSPACE_DIR/$new"
    _id_migration_add_frontmatter "$SPEC_WORKSPACE_DIR/$new" "$id" "$type" "$status"
  done < "$map"

  # Rewrite path references outside snapshots and the migration archive.
  while IFS='|' read -r old new id type status; do
    old_base=$(basename "$old" .md); new_base=$(basename "$new" .md)
    while IFS= read -r mf; do
      sed -i.bak "s|$old|$new|g; s|\*\*$old_base\*\*|**$id**|g" "$mf"
      if [[ "$type" == decision ]]; then
        num=$((10#${id#DEC-}))
        sed -i.bak "s|\*\*D${num}\*\*|**$id**|g" "$mf"
      fi
      rm -f "$mf.bak"
    done < <(find "$SPEC_WORKSPACE_DIR" -type f -name '*.md' ! -path "$SPEC_WORKSPACE_DIR/_snapshots/*" ! -path "$SPEC_ARCHIVE_DIR/id-migrations/*")
  done < "$map"

  info "  ✓  migrated $count file(s)"
  info "  ↳ originals archived at $archive_root"
  info "  ↳ mapping: $archive_root/mapping.tsv"
  rm -rf "$tmp"
}

_id_migrate_uuidv7() {
  local apply="$1" collection f oldid slug new_id old new kind status tmp map count=0 stamp archive_root mf
  tmp=$(mktemp -d); map="$tmp/mapping.tsv"; : > "$map"
  for collection in specs decisions questions research spikes ideas memories feedbacks audits fixes sessions; do
    [[ -d "$SPEC_WORKSPACE_DIR/$collection" ]] || continue
    for f in "$SPEC_WORKSPACE_DIR/$collection"/*.md; do
      [[ -f "$f" && "$(basename "$f")" != index.md ]] || continue
      oldid=$(fm_get "$f" id); [[ -n "$oldid" ]] || oldid=$(basename "$f" .md)
      _is_uuidv7 "$oldid" && continue
      slug=$(_record_slug "$f")
      new_id=$(_uuidv7); old=${f#"$SPEC_WORKSPACE_DIR"/}; new="$collection/$slug.md"
      [[ "$old" == "$new" || ! -e "$SPEC_WORKSPACE_DIR/$new" ]] || die "id migrate --uuidv7: target collision: $new"
      kind=$(fm_get "$f" kind); [[ -n "$kind" ]] || kind=$(fm_get "$f" type); [[ -n "$kind" ]] || kind="${collection%s}"
      status=$(fm_get "$f" status)
      printf '%s|%s|%s|%s|%s|%s\n' "$old" "$new" "$oldid" "$new_id" "$kind" "$status" >> "$map"
      count=$((count + 1))
    done
  done
  (( count > 0 )) || { info "  ✓ UUIDv7 migration already complete"; rm -rf "$tmp"; return 0; }
  info "── UUIDv7 identity migration ($count record(s)) ──"
  while IFS='|' read -r old new oldid new_id _kind _status; do info "  $oldid → $new_id  ($old → $new)"; done < "$map"
  if [[ "$apply" != true ]]; then info "Dry-run only. Apply with: spectacular id migrate --uuidv7 --apply --yes"; rm -rf "$tmp"; return 0; fi
  stamp=$(date +%Y%m%d-%H%M%S); archive_root="$SPEC_ARCHIVE_DIR/id-migrations/$stamp"; mkdir -p "$archive_root"; cp "$map" "$archive_root/uuidv7-mapping.tsv"
  while IFS='|' read -r old new oldid new_id kind status; do
    mkdir -p "$archive_root/$(dirname "$old")" "$(dirname "$SPEC_WORKSPACE_DIR/$new")"
    cp "$SPEC_WORKSPACE_DIR/$old" "$archive_root/$old"
    [[ "$old" == "$new" ]] || mv "$SPEC_WORKSPACE_DIR/$old" "$SPEC_WORKSPACE_DIR/$new"
  done < "$map"
  # Rewrite references before restoring the old value as a compatibility alias.
  # Otherwise a global old-ID substitution would turn the alias into the new ID.
  while IFS='|' read -r old new oldid new_id _kind _status; do
    while IFS= read -r mf; do
      sed -i.bak "s|$old|$new|g; s|$oldid|$new_id|g" "$mf"
      rm -f "$mf.bak"
    done < <(find "$SPEC_WORKSPACE_DIR" -type f -name '*.md' ! -path "$SPEC_ARCHIVE_DIR/id-migrations/*")
  done < "$map"
  while IFS='|' read -r _old new oldid new_id kind _status; do
    fm_set "$SPEC_WORKSPACE_DIR/$new" id "$new_id"
    fm_set "$SPEC_WORKSPACE_DIR/$new" slug "$(_record_slug "$SPEC_WORKSPACE_DIR/$new")"
    fm_set "$SPEC_WORKSPACE_DIR/$new" kind "$kind"
    [[ -n "$(fm_get "$SPEC_WORKSPACE_DIR/$new" scope)" ]] || fm_set "$SPEC_WORKSPACE_DIR/$new" scope project
    fm_set "$SPEC_WORKSPACE_DIR/$new" aliases "$oldid"
    fm_touch "$SPEC_WORKSPACE_DIR/$new"
  done < "$map"
  info "  ✓ migrated $count record(s); originals and uuidv7-mapping.tsv archived at $archive_root"
  rm -rf "$tmp"
}

cmd_collections() {
  local sub="${1:-}"; shift || true
  [[ "$sub" == migrate ]] || die "Usage: spectacular collections migrate [--dry-run | --apply --yes]"
  local apply=false yes=false
  while (( $# > 0 )); do case "$1" in --dry-run) apply=false; shift ;; --apply) apply=true; shift ;; --yes) yes=true; shift ;; *) die "collections migrate: unknown option '$1'" ;; esac; done
  $apply && ! $yes && die "collections migrate: --apply requires --yes"
  local mappings="idea:ideas question:questions spike:spikes decision:decisions spec:specs memory:memories session:sessions feedback:feedbacks audit:audits fix:fixes debug:debugs"
  local pair old new src dest item changes=0 conflicts=""
  for pair in $mappings; do
    old=${pair%%:*}; new=${pair#*:}; src="$SPEC_WORKSPACE_DIR/$old"; dest="$SPEC_WORKSPACE_DIR/$new"
    [[ -d "$src" ]] || continue
    for item in "$src"/*; do
      [[ -e "$item" ]] || continue
      changes=$((changes + 1))
      [[ -e "$dest/$(basename "$item")" ]] && conflicts="${conflicts:+$conflicts, }$old/$(basename "$item")"
      info "  $item → $dest/$(basename "$item")"
    done
  done
  (( changes > 0 )) || { info "  ✓ collection folders already canonical"; return 0; }
  [[ -z "$conflicts" ]] || die "collections migrate: destination collision(s): $conflicts; resolve explicitly before migration"
  if ! $apply; then info "Dry-run only. Apply with: spectacular collections migrate --apply --yes"; return 0; fi
  local stamp archive_root
  stamp=$(date +%Y%m%d-%H%M%S); archive_root="$SPEC_ARCHIVE_DIR/collection-migrations/$stamp"
  mkdir -p "$archive_root"
  for pair in $mappings; do
    old=${pair%%:*}; new=${pair#*:}; src="$SPEC_WORKSPACE_DIR/$old"; dest="$SPEC_WORKSPACE_DIR/$new"
    [[ -d "$src" ]] || continue
    cp -R "$src" "$archive_root/$old"
    mkdir -p "$dest"
    for item in "$src"/*; do [[ -e "$item" ]] && mv "$item" "$dest/"; done
  done
  info "  ✓ migrated $changes item(s); originals archived at $archive_root"
  info "  ↳ empty singular directories are intentionally left in place for safe manual cleanup"
}

cmd_lifecycle_migrate() {
  local sub="${1:-}"; shift || true
  [[ "$sub" == migrate ]] || die "Usage: spectacular lifecycle migrate [--dry-run | --apply --yes]"
  local apply=false yes=false
  while (( $# > 0 )); do case "$1" in --dry-run) apply=false; shift ;; --apply) apply=true; shift ;; --yes) yes=true; shift ;; *) die "lifecycle migrate: unknown option '$1'" ;; esac; done
  $apply && ! $yes && die "lifecycle migrate: --apply requires --yes"
  local tmp map f status new count manual=0
  tmp=$(mktemp -d); map="$tmp/mapping.tsv"; : > "$map"
  while IFS= read -r f; do
    status=$(fm_get "$f" status); new=""
    case "$status" in stable|published|current) new=approved ;; esac
    [[ -n "$new" ]] && printf '%s\tstatus\t%s\t%s\n' "$f" "$status" "$new" >> "$map"
  done < <(_iter_md specs)
  while IFS= read -r f; do
    status=$(fm_get "$f" status)
    [[ -z "$status" ]] && printf '%s\tstatus\tmissing\tactive\n' "$f" >> "$map"
  done < <(_iter_md memories)
  for f in "$SPEC_RESEARCH_DIR"/*.md "$SPEC_SPIKES_DIR"/*.md; do
    [[ -f "$f" ]] || continue
    if [[ "$(fm_get "$f" status)" == verified ]]; then
      info "  manual: $f verified → completed requires supported|refuted|inconclusive + evidence review"
      manual=$((manual + 1))
    fi
  done
  count=$(wc -l < "$map" | tr -d ' ')
  if (( count == 0 )); then
    (( manual > 0 )) && info "No safe automatic mappings; $manual discovery record(s) require judgment" || info "  ✓ lifecycle labels already canonical"
    rm -rf "$tmp"; return 0
  fi
  info "── lifecycle migration ($count safe mapping(s)) ──"
  while IFS=$'\t' read -r f _field status new; do info "  $f: $status → $new"; done < "$map"
  if ! $apply; then info "Dry-run only. Apply with: spectacular lifecycle migrate --apply --yes"; rm -rf "$tmp"; return 0; fi
  local stamp archive_root rel
  stamp=$(date +%Y%m%d-%H%M%S); archive_root="$SPEC_ARCHIVE_DIR/lifecycle-migrations/$stamp"; mkdir -p "$archive_root"
  cp "$map" "$archive_root/mapping.tsv"
  while IFS=$'\t' read -r f _field status new; do
    rel=${f#"$SPEC_WORKSPACE_DIR"/}; mkdir -p "$archive_root/$(dirname "$rel")"; cp "$f" "$archive_root/$rel"
    fm_set "$f" status "$new"; fm_touch "$f"
  done < "$map"
  info "  ✓ migrated $count record(s); originals + mapping archived at $archive_root"
  (( manual > 0 )) && info "  ⚠ $manual discovery record(s) still require explicit result/evidence review"
  rm -rf "$tmp"
}

_question_find() {
  local ref="$1" canonical f dir
  if _resolve_uuid_or_slug "$ref" question >/dev/null 2>&1; then
    canonical=$(_resolve_uuid_or_slug "$ref" question)
  else
    canonical=$(_canonical_resolve "$ref" question)
  fi
  for dir in "$SPEC_QUESTIONS_DIR" "$SPEC_WORKSPACE_DIR/question"; do
    for f in "$dir"/*.md; do
      [[ -f "$f" && "$(fm_get "$f" id)" == "$canonical" ]] && { echo "$f"; return 0; }
    done
    for f in "$dir"/"$canonical"-*.md "$dir"/"$canonical".md "$dir"/"$ref".md; do
      [[ -f "$f" ]] && { echo "$f"; return 0; }
    done
  done
  return 1
}

cmd_question() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    new) cmd_question_new "$@" ;;
    list) cmd_question_list "$@" ;;
