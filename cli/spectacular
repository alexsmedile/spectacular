    if ! git push -u origin "$branch"; then
      # The scoped commit is already durable locally. Return the user to the
      # original branch and make the recoverable state explicit; never stash or
      # roll back a failed publication.
      git switch "$original"
      die "workspace preserve: push failed; local preservation remains at $branch ($commit_sha)"
    fi
    info "  pushed: $remote"
  else
    info "  remote: unknown (no origin; preserved locally)"
  fi
  git switch "$original"
  info "  ✓ preserved: $branch at $commit_sha"
}
_workspace_cleanup_inventory() {
  local base branch current state provider
  _workspace_require_repo; base=$(_workspace_base); current=$(_workspace_current_branch)
  info "── Workspace cleanup inventory (read-only) ──"
  for branch in $(git for-each-ref --format='%(refname:short)' refs/heads); do
    [[ "$branch" == "$base" || "$branch" == "$current" ]] && continue
    if git merge-base --is-ancestor "$branch" "$base" 2>/dev/null; then state=merged-local; else state=unmerged-or-unknown; fi
    provider=$(_workspace_provider_state "$branch")
    info "  - $branch: $state · provider PR/MR: $provider"
  done
  info "  deletion requires: explicit branch, --apply --yes, fresh shared base, reachable merged tip, and preserved archive ref"
}
_workspace_cleanup_apply() {
  local branch="$1" apply="$2" yes="$3" refresh="$4" base current tip archive_ref provider receipt stamp safe
  _workspace_require_repo; base=$(_workspace_base); current=$(_workspace_current_branch)
  [[ "$branch" != "$current" && "$branch" != "$base" ]] || die "workspace cleanup: refusing current or base branch"
  git show-ref --verify --quiet "refs/heads/$branch" || die "workspace cleanup: local branch not found: $branch"
  tip=$(git rev-parse "$branch")
  git merge-base --is-ancestor "$tip" "$base" 2>/dev/null || die "workspace cleanup: $branch is not reachable from $base; preserve or resolve it first"
  provider=$(_workspace_provider_state "$branch")
