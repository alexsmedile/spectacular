}
_workspace_preserve() {
  local slug="$1" paths="$2" apply="$3" yes="$4" original branch path commit_sha remote
  _workspace_require_repo
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "workspace preserve: slug must be kebab-case"
  [[ -n "$paths" ]] || die "workspace preserve: --paths is required"
  original=$(_workspace_current_branch); [[ -n "$original" ]] || die "workspace preserve: detached HEAD is not supported"
  branch="preserve/${slug}-$(date +%Y%m%d-%H%M%S)"
  info "── Workspace preservation proposal ──"
  info "  source branch: $original"
  info "  preservation branch: $branch"
  info "  paths: $paths"
  info "  commit: preserve: $slug"
  info "  exact mutations: git switch -c $branch; git add -- <paths>; git commit --only -- <paths>; git push -u origin $branch (if origin exists); git switch $original"
  $apply || { info "Dry-run only. Apply with --apply --yes"; return 0; }
  $yes || die "workspace preserve: --apply requires --yes"
  for path in ${paths//,/ }; do [[ -e "$path" || -n "$(git ls-files -- "$path")" ]] || die "workspace preserve: path not found: $path"; done
