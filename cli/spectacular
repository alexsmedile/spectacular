}
_workspace_mutation_gate() {
  # Shared first-write guard for Spectacular-owned Git mutators. The report is
  # intentionally emitted before refusal so ambiguous paths are actionable.
  local request="${1:-}" group path owner confidence disposition blocked=false
  _workspace_report "$request"
  while IFS=$'\t' read -r group path; do
    IFS='|' read -r owner confidence disposition <<EOF
$(_workspace_path_owner "$path" "$request")
EOF
    [[ "$disposition" == belongs-to-current-request ]] || blocked=true
  done < <(_workspace_changed_paths)
  $blocked && die "workspace: mutation refused while changed paths are unowned or belong to another request; preserve or make scope explicit first"
