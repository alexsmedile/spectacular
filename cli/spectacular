cmd_question_new() {
  local slug="" question="" context="" priority="medium" target_version="tbd" blocked_csv="" dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --question) require_value "--question" "${2:-}"; question="$2"; shift 2 ;;
      --context) require_value "--context" "${2:-}"; context="$2"; shift 2 ;;
      --priority) require_value "--priority" "${2:-}"; priority="$2"; shift 2 ;;
      --target-version) require_value "--target-version" "${2:-}"; target_version="$2"; shift 2 ;;
      --blocked-by) require_value "--blocked-by" "${2:-}"; blocked_csv="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      -*) die "question new: unknown flag '$1'" ;;
      *) [[ -z "$slug" ]] || die "question new: only one slug allowed"; slug="$1"; shift ;;
    esac
  done
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "question new: slug must be kebab-case"
  case "$priority" in low|medium|high) ;; *) die "question new: priority must be low|medium|high" ;; esac
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "question new: not inside a Spectacular workspace"
  _require_unique_collection_slug questions "$slug" "question new"

  local dir="$SPEC_QUESTIONS_DIR" id path blocked_yaml="blocked_by: []" item canonical
  mkdir -p "$dir"
  id=$(_uuidv7)
  path="$dir/$slug.md"
  if [[ -n "$blocked_csv" ]]; then
    blocked_yaml="blocked_by:"$'\n'
    local IFS=','
    for item in $blocked_csv; do
      canonical=$(_canonical_resolve "$item")
      blocked_yaml+="  - $canonical"$'\n'
    done
    blocked_yaml="${blocked_yaml%$'\n'}"
  fi
  local rendered
  rendered=$(cat <<EOF
---
id: $id
slug: $slug
kind: question
scope: project
status: open
summary: "${question:-$slug}"
priority: $priority
requires_user_input: true
target_version: "$target_version"
${blocked_yaml}
related: []
references: []
updated: $TODAY
---

# ${question:-$slug}

## Question

${question:-_(fill in)_}

## Context

${context:-_(fill in)_}

## Options

- _(fill in)_

## Resolution

—
EOF
)
  if $dry_run; then echo "── would write $path ──"; echo "$rendered"; return 0; fi
  [[ ! -e "$path" ]] || die "question new: target exists: $path"
  printf '%s\n' "$rendered" > "$path"
  created "$path"
  info "  → $id requires user input"
}

cmd_question_list() {
  local filter="active" f id status priority updated summary count=0 dir stored_status
  while (( $# > 0 )); do
    case "$1" in --status) require_value "--status" "${2:-}"; filter="$2"; shift 2 ;; *) die "question list: unknown option '$1'" ;; esac
  done
  printf '%-10s  %-10s  %-8s  %-10s  %s\n' "ID" "STATUS" "PRIORITY" "UPDATED" "SUMMARY"
  printf '%-10s  %-10s  %-8s  %-10s  %s\n' "--" "------" "--------" "-------" "--------"
  case "$filter" in active|open|deferred|archived|resolved|all) ;; *) die "question list: --status must be active|open|deferred|archived|resolved|all" ;; esac
  for dir in "$SPEC_QUESTIONS_DIR" "$SPEC_ARCHIVE_DIR/questions"; do
    [[ -d "$dir" ]] || continue
    [[ "$dir" == "$SPEC_ARCHIVE_DIR/questions" && "$filter" != archived && "$filter" != resolved && "$filter" != all ]] && continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      id=$(fm_get "$f" id); stored_status=$(fm_get "$f" status); priority=$(fm_get "$f" priority); updated=$(fm_get "$f" updated)
      status="$stored_status"
      [[ "$dir" == "$SPEC_ARCHIVE_DIR/questions" ]] && status=archived
      if [[ "$dir" == "$SPEC_QUESTIONS_DIR" ]]; then
        [[ "$filter" == active || "$filter" == all || "$filter" == "$stored_status" ]] || continue
      else
        [[ "$filter" == archived || "$filter" == resolved || "$filter" == all ]] || continue
      fi
      summary=$(fm_get "$f" summary); [[ -n "$summary" ]] || summary="(legacy record — inspect $id)"
      printf '%-10s  %-10s  %-8s  %-10s  %s\n' "$id" "$status" "$priority" "$updated" "$summary"
      count=$((count + 1))
    done
  done
  (( count > 0 )) || info "(no questions${filter:+ matching $filter})"
}

cmd_question_show() {
  local ref="$1"; shift
  local full=false json=false f id
  while (( $# > 0 )); do case "$1" in --full) full=true; shift ;; --json) json=true; shift ;; *) die "question: unknown option '$1'" ;; esac; done
  f=$(_question_find "$ref") || die "question: '$ref' not found"
  $full && { cat "$f"; return 0; }
  id=$(fm_get "$f" id)
  if $json; then
    printf '{"schema":"spectacular.question.v1","id":"%s","status":"%s","priority":"%s","requires_user_input":"%s","blocked_by":"%s","summary":"%s","question":"%s","context":"%s","options":"%s"}\n' \
      "$(_json_escape "$id")" "$(_json_escape "$(fm_get "$f" status)")" "$(_json_escape "$(fm_get "$f" priority)")" "$(_json_escape "$(fm_get "$f" requires_user_input)")" "$(_json_escape "$(fm_get "$f" blocked_by)")" "$(_json_escape "$(fm_get "$f" summary)")" "$(_json_escape "$(_section_body "$f" Question)")" "$(_json_escape "$(_section_body "$f" Context)")" "$(_json_escape "$(_section_body "$f" Options)")"
    return 0
  fi
  printf 'Question: %s\nStatus: %s · Priority: %s · Requires user input: %s\nBlocked by: %s\n\nQuestion\n%s\n\nContext\n%s\n\nOptions\n%s\n\nFull evidence: spectacular question %s --full\n' \
    "$id" "$(fm_get "$f" status)" "$(fm_get "$f" priority)" "$(fm_get "$f" requires_user_input)" "$(fm_get "$f" blocked_by)" "$(_section_body "$f" Question)" "$(_section_body "$f" Context)" "$(_section_body "$f" Options)" "$ref"
}

cmd_question_resolve() {
  local ref="" answer="" resolved_by="user" source="" decision=""
  while (( $# > 0 )); do
    case "$1" in
      --answer) require_value "--answer" "${2:-}"; answer="$2"; shift 2 ;;
      --resolved-by) require_value "--resolved-by" "${2:-}"; resolved_by="$2"; shift 2 ;;
      --source) require_value "--source" "${2:-}"; source="$2"; shift 2 ;;
      --decision) require_value "--decision" "${2:-}"; decision=$(_canonical_resolve "$2" decision); shift 2 ;;
      -*) die "question resolve: unknown flag '$1'" ;;
      *) [[ -z "$ref" ]] || die "question resolve: only one reference allowed"; ref="$1"; shift ;;
    esac
  done
  [[ -n "$ref" && -n "$answer" ]] || die "Usage: spectacular question resolve <id|alias> --answer <text>"
  local path id destination
  path=$(_question_find "$ref") || die "question resolve: '$ref' not found"
  id=$(fm_get "$path" id)
  fm_set "$path" status resolved
  fm_set "$path" resolved_at "$TODAY"
  fm_set "$path" resolved_by "$resolved_by"
  [[ -n "$source" ]] && fm_set "$path" resolution_source "$source"
  [[ -n "$decision" ]] && fm_set "$path" resulting_decision "$decision"
  fm_set "$path" updated "$TODAY"
  printf '\n**Resolved %s:** %s\n' "$TODAY" "$answer" >> "$path"
  fm_set "$path" archived_from resolved
  fm_set "$path" status archived
  fm_set "$path" archived_at "$TODAY"
  destination="$SPEC_ARCHIVE_DIR/questions/$(basename "$path")"
  [[ ! -e "$destination" ]] || die "question resolve: archive target exists: $destination"
  mkdir -p "$SPEC_ARCHIVE_DIR/questions"
  mv "$path" "$destination"
  info "  ✓  ${id} resolved and archived"
  info "  ↳ $destination"
}

