}

# A memory body is its lesson. Read it only after the caller has named a record.
_memory_lesson() {
  awk '
    /^---$/ { delimiters++; next }
    delimiters >= 2 {
      if (!started && $0 !~ /./) next
      started=1
      print
    }
  ' "$1"
}

_memory_find() {
  local ref="$1" f compact dir
  for dir in "$SPEC_MEMORIES_DIR" "$SPEC_WORKSPACE_DIR/memory"; do
    [[ -f "$dir/$ref.md" ]] && { echo "$dir/$ref.md"; return 0; }
  done
  compact=$(printf '%s' "$ref" | tr '[:lower:]' '[:upper:]')
  for dir in "$SPEC_MEMORIES_DIR" "$SPEC_WORKSPACE_DIR/memory"; do
    for f in "$dir"/"$compact"-*.md "$dir"/"$compact".md; do
      [[ -f "$f" ]] && { echo "$f"; return 0; }
    done
  done
  return 1
}

cmd_memory_retract() {
  local ref="" reason=""
  while (( $# > 0 )); do case "$1" in --reason) require_value "$1" "${2:-}"; reason="$2"; shift 2 ;; -*) die "memory retract: unknown flag '$1'" ;; *) [[ -z "$ref" ]] || die "memory retract: only one reference allowed"; ref="$1"; shift ;; esac; done
  [[ -n "$ref" && -n "$reason" ]] || die "Usage: spectacular memory retract <memory> --reason <why>"
  local f; f=$(_memory_find "$ref") || die "memory retract: '$ref' not found"
  [[ "$(fm_get "$f" status)" == active || -z "$(fm_get "$f" status)" ]] || die "memory retract: only an active memory can be retracted"
  fm_set "$f" status retracted; fm_set "$f" retracted_at "$TODAY"; fm_set "$f" retraction_reason "$reason"; fm_touch "$f"
  info "  ✓ retracted $(basename "$f" .md); history preserved"
}

