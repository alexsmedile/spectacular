    ""|--help|-h) echo "Usage: spectacular afk run <start|status|event|gate|resume|complete|cancel>" ;;
    *) die "afk run: unknown subcommand '$sub'" ;;
  esac
}

cmd_afk_configure() {
  local enabled="" prefix="" primaries="" allow_pr="" apply=false yes=false
  while (( $# > 0 )); do
    case "$1" in
      --enable) enabled=true; shift ;;
      --disable) enabled=false; shift ;;
      --branch-prefix) require_value "$1" "${2:-}"; prefix="$2"; shift 2 ;;
      --primary-branches) require_value "$1" "${2:-}"; primaries="$2"; shift 2 ;;
      --allow-pr-create) allow_pr=true; shift ;;
      --deny-pr-create) allow_pr=false; shift ;;
      --apply) apply=true; shift ;;
      --yes) yes=true; shift ;;
      *) die "afk configure: unknown option '$1'" ;;
    esac
  done
  [[ -n "$enabled$prefix$primaries$allow_pr" ]] || die "afk configure: provide a policy change"
  [[ -n "$enabled" ]] || enabled="${_afk_current_enabled:-$(_afk_config_get enabled)}"; [[ -n "$enabled" ]] || enabled=false
  [[ -n "$prefix" ]] || prefix=$(_afk_prefix)
  [[ -n "$primaries" ]] || primaries=$(_afk_primary_list)
  [[ -n "$allow_pr" ]] || allow_pr=$(_afk_config_get allow_pr_create); [[ -n "$allow_pr" ]] || allow_pr=false
  info "── AFK Git policy proposal ──"
  info "  enabled: $enabled"
  info "  branch_prefix: $prefix"
  info "  primary_branches: $primaries"
  info "  allow_pr_create: $allow_pr"
  if ! $apply; then info "  dry-run only — apply with --apply --yes"; return 0; fi
  $yes || die "afk configure: --apply requires --yes"
  [[ -f "$SPEC_CONFIG_FILE" ]] || die "afk configure: .spectacular/config.yaml missing"
  cmd_snapshot "$SPEC_CONFIG_FILE" >/dev/null
  local tmp; tmp=$(mktemp)
  awk '
    /^afk_git:/ { skip=1; next }
    skip && /^[^[:space:]#]/ { skip=0 }
    !skip { print }
  ' "$SPEC_CONFIG_FILE" > "$tmp"
  mv "$tmp" "$SPEC_CONFIG_FILE"
  printf '\nafk_git:\n  enabled: %s\n  branch_prefix: "%s"\n  primary_branches: "%s"\n  allow_pr_create: %s\n' \
    "$enabled" "$prefix" "$primaries" "$allow_pr" >> "$SPEC_CONFIG_FILE"
  info "  ✓ AFK Git policy updated"
}

cmd_afk_propose() {
  local kind="${1:-}" target="${2:-}" version="" host_prefix=""
  [[ -n "$kind" && -n "$target" ]] || die "Usage: spectacular afk propose <draft-spec|spike|fork|feature> <name|id> [--version vX.Y.Z] [--host-prefix p/]"
  shift 2
  while (( $# > 0 )); do
    case "$1" in --version) require_value "$1" "${2:-}"; version="$2"; shift 2 ;; --host-prefix) require_value "$1" "${2:-}"; host_prefix="$2"; shift 2 ;; *) die "afk propose: unknown option '$1'" ;; esac
  done
  _afk_branch_name "$kind" "$target" "$version" "$host_prefix"
}

cmd_afk_preflight() {
  local kind="${1:-}"; [[ -n "$kind" ]] || die "Usage: spectacular afk preflight <draft-spec|spike|fork|feature>"
  _afk_require_repo; _afk_require_clean
  local branch; branch=$(git branch --show-current)
  _afk_is_primary "$branch" && die "afk preflight: refusing $kind writes on primary branch '$branch'"
  case "$kind:$branch" in
    spike:*spike/prototype-*) ;;
    draft-spec:*spec/draft-*) ;;
    fork:*fork/idea-*) ;;
    feature:*feat/v*) ;;
    *) die "afk preflight: branch '$branch' does not match $kind branch class" ;;
  esac
  info "  ✓ AFK preflight: clean isolated $kind branch ($branch)"
}

_afk_record_branch() {
  local branch="$1" kind="$2" target="$3"
  mkdir -p "$SPEC_AFK_DIR"
  local ledger="$SPEC_AFK_DIR/branches.md"
  [[ -f "$ledger" ]] || printf '%s\n' '---' "updated: $TODAY" '---' '' '# AFK branches' > "$ledger"
  printf '\n- `%s` — kind: %s · source: %s · created: %s\n' "$branch" "$kind" "$target" "$TODAY" >> "$ledger"
  fm_touch "$ledger"
}

cmd_afk_start() {
  local kind="${1:-}" target="${2:-}" version="" host_prefix="" apply=false yes=false
  [[ -n "$kind" && -n "$target" ]] || die "Usage: spectacular afk start <kind> <name|id> [--version vX.Y.Z] [--apply --yes]"
  shift 2
  while (( $# > 0 )); do
    case "$1" in --version) require_value "$1" "${2:-}"; version="$2"; shift 2 ;; --host-prefix) require_value "$1" "${2:-}"; host_prefix="$2"; shift 2 ;; --apply) apply=true; shift ;; --yes) yes=true; shift ;; *) die "afk start: unknown option '$1'" ;; esac
  done
  local branch; branch=$(_afk_branch_name "$kind" "$target" "$version" "$host_prefix")
  info "Proposed branch: $branch"
  if ! $apply; then info "Dry-run only. Create with: --apply --yes"; return 0; fi
  _afk_enabled || die "afk start: AFK Git policy is not enabled"
  local active_run; active_run=$(_afk_active_run) || die "afk start: no active AFK run; authorize one with 'spectacular afk run start'"
  [[ "$(fm_get "$active_run" status)" == active ]] || die "afk start: AFK run is gated"
  $yes || die "afk start: --apply requires --yes"
  _workspace_mutation_gate
  _afk_require_repo; _afk_require_clean
  git show-ref --verify --quiet "refs/heads/$branch" && die "afk start: branch already exists: $branch"
  git switch -c "$branch" >/dev/null
  _afk_record_branch "$branch" "$kind" "$target"
  info "  ✓ created isolated branch: $branch"
  info "  ↳ provenance: .spectacular/afk/branches.md"
}

cmd_afk_cleanup() {
  local branch="${1:-}" disposition="" node="" outcome="" evidence="" apply=false yes=false remote=false
  [[ -n "$branch" ]] || die "Usage: spectacular afk cleanup <branch> --disposition merged|abandoned --outcome <text> --evidence <ref> [--apply --yes]"
  shift || true
  while (( $# > 0 )); do
    case "$1" in
      --disposition) require_value "$1" "${2:-}"; disposition="$2"; shift 2 ;;
      --node) require_value "$1" "${2:-}"; node="$2"; shift 2 ;;
      --outcome) require_value "$1" "${2:-}"; outcome="$2"; shift 2 ;;
      --evidence) require_value "$1" "${2:-}"; evidence="$2"; shift 2 ;;
      --remote) remote=true; shift ;;
      --apply) apply=true; shift ;;
      --yes) yes=true; shift ;;
      *) die "afk cleanup: unknown option '$1'" ;;
    esac
  done
  case "$disposition" in merged|abandoned) ;; *) die "afk cleanup: --disposition must be merged|abandoned" ;; esac
  [[ -n "$outcome" && -n "$evidence" ]] || die "afk cleanup: --outcome and --evidence are required before cleanup"
  $remote && die "afk cleanup: remote deletion remains a human-only gate; delete it explicitly with your Git provider"
  _workspace_mutation_gate
  _afk_require_repo
  local current; current=$(git branch --show-current)
  [[ "$current" != "$branch" ]] || die "afk cleanup: cannot delete the current branch"
  _afk_is_primary "$branch" && die "afk cleanup: refusing primary branch '$branch'"
  git show-ref --verify --quiet "refs/heads/$branch" || die "afk cleanup: local branch not found: $branch"
  info "Cleanup plan: archive evidence, then delete local branch '$branch' ($disposition)"
  if ! $apply; then info "Dry-run only. Apply with: --apply --yes"; return 0; fi
  _afk_enabled || die "afk cleanup: AFK Git policy is not enabled"
  $yes || die "afk cleanup: --apply requires --yes"
  local stamp safe archive tip_sha archive_ref restore_command
  stamp=$(date +%Y%m%d-%H%M%S); safe=$(_afk_slug "$branch")
  archive="$SPEC_ARCHIVE_DIR/afk-branches/${stamp}-${safe}.md"
  tip_sha=$(git rev-parse "refs/heads/$branch")
  archive_ref="refs/spectacular/archive/${safe}-${stamp}-${tip_sha:0:12}"
  restore_command="git branch $branch $archive_ref"
  git update-ref "$archive_ref" "$tip_sha"
  [[ "$(git rev-parse "$archive_ref")" == "$tip_sha" ]] || die "afk cleanup: failed to verify durable archive ref; branch was not deleted"
  mkdir -p "$(dirname "$archive")"
  printf '%s\n' '---' "branch: \"$branch\"" "disposition: $disposition" "node: \"$node\"" "archived: $TODAY" "tip_sha: $tip_sha" "archive_ref: $archive_ref" "restore_command: \"$restore_command\"" '---' '' "# AFK branch archive — $branch" '' "**Outcome:** $outcome" '' "**Evidence:** $evidence" '' "**Restore:** \`$restore_command\`" > "$archive"
  if [[ "$disposition" == merged ]]; then git branch -d "$branch" >/dev/null; else git branch -D "$branch" >/dev/null; fi
  info "  ✓ archived: $archive"
  info "  ✓ deleted local branch: $branch"
  info "  ↳ durable ref: $archive_ref ($tip_sha)"
  info "  ↳ restore with: $restore_command; remote branch untouched"
}

cmd_afk_pr() {
  local slug="${1:-}" version="" name="" base="" apply=false yes=false tests_passed=false breaking=false breaking_ok=false
  local summaries="" validations="" summary validation
  [[ -n "$slug" ]] || die "Usage: spectacular afk pr <request> --version vX.Y.Z --name <name> [--summary <change>] [--validation <result>] [--tests-passed] [--apply --yes]"
  shift || true
  while (( $# > 0 )); do
    case "$1" in
      --version) require_value "$1" "${2:-}"; version="$2"; shift 2 ;;
      --name) require_value "$1" "${2:-}"; name="$2"; shift 2 ;;
      --base) require_value "$1" "${2:-}"; base="$2"; shift 2 ;;
      --summary) require_value "$1" "${2:-}"; summaries="$summaries${summaries:+$'\n'}$2"; shift 2 ;;
      --validation) require_value "$1" "${2:-}"; validations="$validations${validations:+$'\n'}$2"; shift 2 ;;
      --tests-passed) tests_passed=true; shift ;;
      --breaking) breaking=true; shift ;;
      --breaking-change-approved) breaking_ok=true; shift ;;
      --apply) apply=true; shift ;;
      --yes) yes=true; shift ;;
      *) die "afk pr: unknown option '$1'" ;;
    esac
  done
  [[ -n "$version" && -n "$name" ]] || die "afk pr: --version and --name are required"
  local plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md" log="$SPEC_REQUESTS_DIR/$slug/VERIFY-LOG.md" source spec_path
  [[ -f "$plan" ]] || die "afk pr: request not found: $slug"
  [[ "$(fm_get "$plan" status)" == verified ]] || die "afk pr: request '$slug' must be verified"
  [[ -f "$log" ]] && grep -q '\*\*Outcome:\*\* verified' "$log" || die "afk pr: verified request has no passing VERIFY-LOG outcome"
  source=$(fm_get "$plan" contract); [[ -n "$source" ]] || source=$(fm_get "$plan" source_spec)
  [[ -n "$source" ]] || die "afk pr: request has no contract provenance"
  spec_path=$(_spec_find "$source") || die "afk pr: contract not found: $source"
  case "$(fm_get "$spec_path" status)" in
    approved|implemented) ;;
    *) _contract_is_merged "$spec_path" || die "afk pr: contract $source is not merged into $(_contract_shared_base)" ;;
  esac
  $tests_passed || die "afk pr: fresh passing tests must be confirmed with --tests-passed"
  $breaking && ! $breaking_ok && die "afk pr: breaking API/schema change requires --breaking-change-approved"
  if [[ -z "$summaries" ]]; then
    summary=$(_request_section "$plan" Goal | awk 'NF { sub(/^- /, ""); print; exit }')
    summaries="${summary:-Implements the verified request scope.}"
  fi
  local title="[Spectacular] Executed: $version - $name" body
  body=$(_github_pr_manifest "$slug" "$plan" "$name" "" on_merge "$summaries" "$validations")
  info "PR title: $title"
  info "PR body:"
  printf '%s\n' "$body"
  if ! $apply; then info "Dry-run only. The command will open this PR and stop before merge."; return 0; fi
  _afk_enabled || die "afk pr: AFK Git policy is not enabled"
  _afk_allow_pr || die "afk pr: allow_pr_create is false"
  $yes || die "afk pr: --apply requires --yes"
  _workspace_mutation_gate "$slug"
  _afk_require_repo; _afk_require_clean
  local current_branch; current_branch=$(git branch --show-current)
  _afk_is_primary "$current_branch" && die "afk pr: refusing PR handoff from primary branch '$current_branch'"
  command -v gh >/dev/null 2>&1 || die "afk pr: gh CLI not found"
  local args=(pr create --title "$title" --body "$body" --draft)
  [[ -n "$base" ]] && args+=(--base "$base")
  local pr_url head
  pr_url=$(gh "${args[@]}") || die "afk pr: GitHub did not create the pull request"
  head=$(git rev-parse HEAD)
  fm_set "$plan" github_pr "$pr_url"; fm_set "$plan" github_pr_opened_at "$TODAY"; fm_set "$plan" github_pr_head "$head"; fm_set "$plan" issue_resolution on_merge
  info "  ✓ draft pull request opened: $pr_url; merge was not attempted"
}

cmd_afk() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    status) cmd_afk_status "$@" ;;
    run) cmd_afk_run "$@" ;;
    configure) cmd_afk_configure "$@" ;;
    propose) cmd_afk_propose "$@" ;;
    preflight) cmd_afk_preflight "$@" ;;
    start) cmd_afk_start "$@" ;;
    cleanup) cmd_afk_cleanup "$@" ;;
    pr) cmd_afk_pr "$@" ;;
    ""|--help|-h)
      cat <<EOF
Usage: spectacular afk <run|status|configure|propose|preflight|start|cleanup|pr>

Read-only by default. Branch creation, cleanup, and PR creation require enabled
project policy plus explicit --apply --yes. Merge and remote deletion are never performed.
Authority records (`afk run start --authority-record`, `afk run event`) mutate
only .spectacular Markdown; they do not mutate Git history, branches, or remotes.
EOF
      ;;
    *) die "afk: unknown subcommand '$sub'" ;;
  esac
}

# ── GitHub work bridge ──────────────────────────────────────────────────────

_github_request_source() {
  local plan="$1" source_type source_ref source_spec
  source_spec=$(fm_get "$plan" contract); [[ -n "$source_spec" ]] || source_spec=$(fm_get "$plan" source_spec)
  source_type=$(fm_get "$plan" source_type); [[ -n "$source_type" ]] || { [[ -n "$source_spec" ]] && source_type=spec || source_type=goal; }
  source_ref=$(fm_get "$plan" source_ref); [[ -n "$source_ref" ]] || source_ref="$source_spec"
  printf '%s|%s\n' "$source_type" "$source_ref"
}

_github_verification_covers_head() {
  local slug="$1" log="$2" head="$3" stamp changed file
  [[ -f "$log" ]] || return 1
  grep -qE "$head|${head:0:12}" "$log" && return 0
  while IFS= read -r stamp; do
    [[ -n "$stamp" ]] || continue
    git cat-file -e "$stamp^{commit}" 2>/dev/null || continue
    git merge-base --is-ancestor "$stamp" "$head" 2>/dev/null || continue
    changed=$(git diff --name-only "$stamp..$head" 2>/dev/null || true)
    [[ -n "$changed" ]] || return 0
    local only_request_metadata=true
    while IFS= read -r file; do
      case "$file" in
        ".spectacular/requests/$slug/PLAN.md"|".spectacular/requests/$slug/TASKS.md"|".spectacular/requests/$slug/SESSION.md"|".spectacular/requests/$slug/VERIFY-LOG.md"|".spectacular/requests/$slug/SPEC-DELTA.md") ;;
        *) only_request_metadata=false; break ;;
      esac
    done <<< "$changed"
    $only_request_metadata && return 0
  done < <(grep -oE 'against:[[:space:]]*`?[0-9a-f]{7,40}' "$log" | sed -E 's/^against:[[:space:]]*`?//')
  return 1
}

_github_pr_manifest() {
  local slug="$1" plan="$2" name="$3" issue="$4" resolution="$5" summaries="$6" validations="$7"
  local source_pair source_type source_ref source_spec docs_impact status summary validation relationship="" goal unchanged
  source_pair=$(_github_request_source "$plan"); source_type=${source_pair%%|*}; source_ref=${source_pair#*|}
  source_spec=$(fm_get "$plan" contract); [[ -n "$source_spec" ]] || source_spec=$(fm_get "$plan" source_spec)
  docs_impact=$(fm_get "$plan" docs_impact); status=$(fm_get "$plan" status)
  goal=$(_request_section "$plan" Goal | awk 'NF { sub(/^- /, ""); print; exit }')
  [[ -n "$summaries" ]] || summaries="$goal"
  [[ -n "$summaries" ]] || summaries="Implements the accepted request outcome."
  unchanged=$(_request_section "$plan" Understanding | awk '
    /^### What stays the same$/ { inside=1; next }
    inside && /^### / { exit }
    inside && /^- / { sub(/^- /, ""); print; exit }
    inside && NF && $0 !~ /^<!--/ { print; exit }
  ')
  [[ -n "$unchanged" ]] || unchanged="No other behavior is intended to change."
  if [[ -n "$issue" ]]; then
    if [[ "$resolution" == on_merge ]]; then relationship="Fixes $issue"; else relationship="Refs $issue"; fi
  fi
  printf '%s\n' "## In plain language"
  printf '%s\n' "This PR makes a focused change that can be reviewed without reading the technical files first."
  printf '\n## Why this matters\n'
  printf '%s\n' "- It moves this request toward its agreed outcome: ${goal:-$summaries}"
  printf '\n## Decision requested\n'
  printf '%s\n' "- Confirm that this change is clear, appropriately scoped, and ready to merge."
  printf '\n## What this PR changes\n'
  while IFS= read -r summary; do [[ -n "$summary" ]] && printf '%s\n' "- $summary"; done <<< "$summaries"
  printf '\n## What this PR does not change\n'
  printf '%s\n' "- $unchanged"
  printf '\n## Review focus\n'
  printf '%s\n' "- Does the proposed change solve the stated need without expanding the scope?"
  printf '\n## Follow-up\n'
  printf '%s\n' "- Merge remains human-gated; follow-on work stays in the linked request."
  printf '\n<details>\n<summary>Technical details</summary>\n'
  printf '\n## Integration manifest\n'
  [[ -n "$issue" ]] && printf '%s\n' "- Issue: $relationship"
  [[ -n "$source_ref" ]] && printf '%s\n' "- Source: \`$source_type $source_ref\`"
  [[ -n "$source_spec" ]] && printf '%s\n' "- Specification: \`$source_spec\`"
  printf '%s\n' "- Spectacular request: \`$slug\`" "- Request state at handoff: \`$status\`"
  printf '\n## Validation\n'
  if [[ -n "$validations" ]]; then
    while IFS= read -r validation; do [[ -n "$validation" ]] && printf '%s\n' "- $validation"; done <<< "$validations"
  else
    printf '%s\n' "- Verification evidence is owned by \`.spectacular/requests/$slug/VERIFY-LOG.md\`."
  fi
  printf '\n## Documentation impact\n- %s\n' "${docs_impact:-pending}"
  printf '\n## Review notes\n- Merge remains human-gated.\n'
  [[ "$resolution" == on_release ]] && printf '%s\n' "- Issue resolution is release-gated; this PR must not close it on merge."
  printf '\n</details>\n\n---\n_Filed with [Spectacular](https://github.com/alexsmedile/spectacular)._\n'
}

cmd_github_pr_open() {
  local slug="${1:-}" name="" version="" base="" issue="" resolution=on_merge apply=false yes=false
  local summaries="" validations="" summary validation
  [[ -n "$slug" ]] || die "Usage: spectacular github pr open <request> [--name <name>] [--version vX.Y.Z] [--issue owner/repo#N] [--resolution on_merge|on_release] [--summary <change>] [--validation <check>] [--apply --yes]"
  shift || true
  while (( $# > 0 )); do
    case "$1" in
      --name) require_value "$1" "${2:-}"; name="$2"; shift 2 ;;
      --version) require_value "$1" "${2:-}"; version="$2"; shift 2 ;;
      --base) require_value "$1" "${2:-}"; base="$2"; shift 2 ;;
      --issue) require_value "$1" "${2:-}"; issue="$2"; shift 2 ;;
      --resolution) require_value "$1" "${2:-}"; resolution="$2"; shift 2 ;;
      --summary) require_value "$1" "${2:-}"; summaries="$summaries${summaries:+$'\n'}$2"; shift 2 ;;
      --validation) require_value "$1" "${2:-}"; validations="$validations${validations:+$'\n'}$2"; shift 2 ;;
      --apply) apply=true; shift ;;
      --yes) yes=true; shift ;;
      *) die "github pr open: unknown option '$1'" ;;
    esac
  done
  case "$resolution" in on_merge|on_release) ;; *) die "github pr open: --resolution must be on_merge|on_release" ;; esac
  local plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md" status source_pair source_type source_ref declared_source_type sensitivity title body
  [[ -f "$plan" ]] || die "github pr open: request not found: $slug"
  status=$(fm_get "$plan" status); case "$status" in active|review|verified) ;; *) die "github pr open: request '$slug' must be active, review, or verified" ;; esac
  sensitivity=$(fm_get "$plan" sensitivity)
  case "$sensitivity" in protected|confidential|security-sensitive) die "github pr open: protected content requires the provider-native security workflow" ;; esac
  source_pair=$(_github_request_source "$plan"); source_type=${source_pair%%|*}; source_ref=${source_pair#*|}
  declared_source_type=$(fm_get "$plan" source_type)
  if [[ "$declared_source_type" == issue || "$declared_source_type" == goal ]]; then
    [[ -n "$sensitivity" ]] || die "github pr open: Issue/goal request lacks an explicit sensitivity assessment"
  fi
  [[ -n "$issue" ]] || { [[ "$source_type" == issue ]] && issue="$source_ref" || true; }
  [[ -n "$name" ]] || name=$(printf '%s' "$slug" | tr '-' ' ')
  if [[ -n "$version" ]]; then title="[Spectacular] Executed: $version - $name"; else title="[Spectacular] $name"; fi
  body=$(_github_pr_manifest "$slug" "$plan" "$name" "$issue" "$resolution" "$summaries" "$validations")
  info "PR title: $title"
  info "PR body:"
  printf '%s\n' "$body"
  if ! $apply; then info "Dry-run only. Apply with --apply --yes to open a draft PR; merge is never attempted."; return 0; fi
  $yes || die "github pr open: --apply requires --yes"
  _workspace_mutation_gate "$slug"
  _afk_require_repo; _afk_require_clean
  local current_branch baseline commit_count upstream pr_url head
  current_branch=$(git branch --show-current); _afk_is_primary "$current_branch" && die "github pr open: refusing PR handoff from primary branch '$current_branch'"
  baseline=$(fm_get "$plan" activated_against)
  if [[ -n "$baseline" && "$baseline" != uncommitted ]] && git cat-file -e "$baseline^{commit}" 2>/dev/null; then
    commit_count=$(git rev-list --count "$baseline..HEAD")
    [[ "$commit_count" -gt 0 ]] || die "github pr open: no meaningful implementation commit exists after activation"
  fi
  upstream=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null || true)
  [[ -n "$upstream" ]] || die "github pr open: current branch has no pushed upstream; push it before opening the PR"
  command -v gh >/dev/null 2>&1 || die "github pr open: gh CLI not found"
  local args=(pr create --title "$title" --body "$body" --draft)
  [[ -n "$base" ]] && args+=(--base "$base")
  pr_url=$(gh "${args[@]}") || die "github pr open: GitHub did not create the pull request"
  head=$(git rev-parse HEAD)
  fm_set "$plan" github_pr "$pr_url"; fm_set "$plan" github_pr_opened_at "$TODAY"; fm_set "$plan" github_pr_head "$head"; fm_set "$plan" issue_resolution "$resolution"
  info "  ✓ draft pull request opened: $pr_url"
  info "  ↳ merge was not attempted"
}

cmd_github_pr_ready() {
  local slug="${1:-}" pr="" apply=false yes=false
  [[ -n "$slug" ]] || die "Usage: spectacular github pr ready <request> [--pr <number|url>] [--apply --yes]"
  shift || true
  while (( $# > 0 )); do
    case "$1" in --pr) require_value "$1" "${2:-}"; pr="$2"; shift 2 ;; --apply) apply=true; shift ;; --yes) yes=true; shift ;; *) die "github pr ready: unknown option '$1'" ;; esac
  done
  local plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md" log="$SPEC_REQUESTS_DIR/$slug/VERIFY-LOG.md" head short_head remote_head checks_output checks_code=0
  [[ -f "$plan" ]] || die "github pr ready: request not found: $slug"
  [[ "$(fm_get "$plan" status)" == verified ]] || die "github pr ready: request '$slug' must be verified"
  [[ -f "$log" ]] && grep -Eq '✅|^result:[[:space:]]*pass([[:space:]]|$)|\*\*Outcome:\*\*[[:space:]]*verified' "$log" || die "github pr ready: verified request has no passing VERIFY-LOG evidence"
  pr=${pr:-$(fm_get "$plan" github_pr)}; [[ -n "$pr" ]] || die "github pr ready: no linked pull request; pass --pr or open one first"
  _afk_require_repo; head=$(git rev-parse HEAD); short_head=$(git rev-parse --short=12 HEAD)
  command -v gh >/dev/null 2>&1 || die "github pr ready: gh CLI not found"
  remote_head=$(gh pr view "$pr" --json headRefOid --jq .headRefOid) || die "github pr ready: cannot read pull request head"
  [[ "$remote_head" == "$head" ]] || die "github pr ready: remote head $remote_head differs from verified local head $head"
  checks_output=$(gh pr checks "$pr" --required 2>&1) || checks_code=$?
  if [[ "$checks_code" -ne 0 ]]; then
    if printf '%s' "$checks_output" | grep -qiE 'no (required )?checks (reported|found)'; then
      _github_verification_covers_head "$slug" "$log" "$head" || die "github pr ready: no required checks exist and local verification does not cover current HEAD $short_head"
    else
      die "github pr ready: required checks are not acceptable"
    fi
  fi
  info "Ready plan: mark $pr ready for review at verified head $short_head"
  if ! $apply; then info "Dry-run only. Apply with --apply --yes; merge is never attempted."; return 0; fi
  $yes || die "github pr ready: --apply requires --yes"
  _workspace_mutation_gate "$slug"
  gh pr ready "$pr" >/dev/null || die "github pr ready: GitHub did not mark the pull request ready"
  fm_set "$plan" github_pr_ready_at "$TODAY"; fm_set "$plan" github_pr_head "$head"
  info "  ✓ pull request is ready for review; merge was not attempted"
}

cmd_github_reconcile() {
  local slug="" json=false
  while (( $# > 0 )); do case "$1" in --json) json=true; shift ;; -*) die "github reconcile: unknown option '$1'" ;; *) [[ -z "$slug" ]] || die "github reconcile: only one request slug is allowed"; slug="$1"; shift ;; esac; done
  command -v gh >/dev/null 2>&1 || { $json && printf '{"schema":"spectacular.github.reconcile.v1","status":"pending","reason":"gh CLI not found","findings":[]}\n' || info "GitHub reconciliation pending: gh CLI not found"; return 0; }
  local findings="" count=0 plan req status pr source_pair source_type source_ref pr_state pr_head issue_state log local_head finding
  shopt -s nullglob
  for plan in "$SPEC_REQUESTS_DIR"/*/PLAN.md; do
    req=$(basename "$(dirname "$plan")"); [[ -z "$slug" || "$req" == "$slug" ]] || continue
    status=$(fm_get "$plan" status); pr=$(fm_get "$plan" github_pr)
    pr_state=""; pr_head=""; issue_state=""
    source_pair=$(_github_request_source "$plan"); source_type=${source_pair%%|*}; source_ref=${source_pair#*|}
    if [[ -n "$pr" ]]; then
      pr_state=$(gh pr view "$pr" --json state --jq .state 2>/dev/null || true)
      pr_head=$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>/dev/null || true)
      if [[ -z "$pr_state" ]]; then
        finding="$req: pull request state unavailable ($pr)"
      elif [[ "$pr_state" == MERGED ]]; then
        finding="$req: pull request merged while request remains $status"
      else
        finding=""
      fi
      if [[ -n "$pr_head" && "$status" =~ ^(review|verified)$ ]]; then
        log="$SPEC_REQUESTS_DIR/$req/VERIFY-LOG.md"
        _github_verification_covers_head "$req" "$log" "$pr_head" || finding="${finding:+$finding; }$req: verification does not cover PR head ${pr_head:0:12}"
      fi
      if [[ -n "$finding" ]]; then findings="$findings${findings:+$'\n'}$finding"; count=$((count + 1)); fi
    fi
    if [[ "$source_type" == issue && -n "$source_ref" ]]; then
      local issue_repo issue_number
      issue_repo=${source_ref%#*}; issue_number=${source_ref##*#}
      issue_state=$(gh issue view "$issue_number" --repo "$issue_repo" --json state --jq .state 2>/dev/null || true)
      if [[ -z "$issue_state" ]]; then
        finding="$req: source Issue state unavailable ($source_ref)"
        findings="$findings${findings:+$'\n'}$finding"; count=$((count + 1))
      elif [[ "$issue_state" == CLOSED && "$(fm_get "$plan" issue_resolution)" == on_release ]]; then
        finding="$req: release-gated source Issue closed before authorized release reconciliation"
        findings="$findings${findings:+$'\n'}$finding"; count=$((count + 1))
      elif [[ "$issue_state" == CLOSED && "$status" =~ ^(active|review)$ ]]; then
        finding="$req: source Issue is closed while request remains $status"
        findings="$findings${findings:+$'\n'}$finding"; count=$((count + 1))
      elif [[ "$issue_state" == OPEN && "$pr_state" == MERGED && "$(fm_get "$plan" issue_resolution)" == on_merge ]]; then
        finding="$req: fully integrated on-merge Issue remains open"
        findings="$findings${findings:+$'\n'}$finding"; count=$((count + 1))
      fi
    fi
  done
  shopt -u nullglob
  if [[ -n "$slug" && ! -f "$SPEC_REQUESTS_DIR/$slug/PLAN.md" ]]; then die "github reconcile: request not found: $slug"; fi
  if $json; then
    printf '{"schema":"spectacular.github.reconcile.v1","status":"%s","finding_count":%s,"findings":[' "$([[ "$count" -eq 0 ]] && echo clean || echo discrepancies)" "$count"
    local first=true
    while IFS= read -r finding; do [[ -n "$finding" ]] || continue; $first && first=false || printf ','; printf '"%s"' "$(_json_escape "$finding")"; done <<< "$findings"
    printf ']}\n'
  elif [[ "$count" -eq 0 ]]; then
    info "GitHub reconciliation: no actionable discrepancies"
  else
    info "GitHub reconciliation: $count actionable discrepancy(s)"
    while IFS= read -r finding; do [[ -n "$finding" ]] && printf '  - %s\n' "$finding"; done <<< "$findings"
  fi
}

cmd_github() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    triage)
      skill_verb_message "github triage ${1:-<issue>}" \
        "Interpret Issue readiness and route it to direct work, a durable request, or spec-first discovery. This requires agent judgment; labels and assignment are evidence, not authority." "${@:2}"
      ;;
    pr)
      local action="${1:-}"; shift || true
      case "$action" in open) cmd_github_pr_open "$@" ;; ready) cmd_github_pr_ready "$@" ;; *) die "Usage: spectacular github pr <open|ready> ..." ;; esac
      ;;
    reconcile) cmd_github_reconcile "$@" ;;
    ""|--help|-h)
      cat <<'EOF'
Usage: spectacular github triage <issue>
       spectacular github pr open <request> [options]
       spectacular github pr ready <request> [options]
       spectacular github reconcile [request] [--json]

Spectacular wraps GitHub only where it adds lifecycle interpretation, safety
gates, provenance, or reconciliation. Use gh directly for GitHub-only work.
EOF
      ;;
    *) die "github: unknown subcommand '$sub'" ;;
  esac
}

# ── cmd_decisions (list + migrate subcommand) ────────────────────────────────
cmd_decisions() {
  # Route sub-verb first
  case "${1:-}" in
    migrate) shift; cmd_decisions_migrate "$@"; return $? ;;
  esac

  local tag_filter="" since="" limit=20 show_all=false json=false
  while (( $# > 0 )); do
    case "$1" in
      --tag)   require_value "--tag" "${2:-}"; tag_filter="$2"; shift 2 ;;
      --since) require_value "--since" "${2:-}"; since="$2"; shift 2 ;;
      --limit) require_value "--limit" "${2:-}"; limit="$2"; shift 2 ;;
      --all)   show_all=true; shift ;;
      --json)  json=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular decisions [<subcommand>] [options]

Subcommands:
  migrate [--dry-run]   Split flat DECISIONS.md into index mode

List decisions from .spectacular/decisions/ (index mode) or flat DECISIONS.md.

Options:
  --tag <t>       Filter to entries tagged with <t>
  --since <dur>   Filter to entries decided within duration (e.g. 7d, 24h, 2w)
  --limit <n>     Cap output at n rows (default: 20)
  --all           No limit
  --json          JSON output (array of objects)
EOF
        exit 0 ;;
      *) die "Unknown flag for decisions: $1" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "decisions: not inside a Spectacular workspace"
  [[ "$limit" =~ ^[0-9]+$ ]] || die "decisions: --limit must be a positive integer"
  local since_epoch
  since_epoch=$(_parse_since "$since")

  local rows=() count=0
  local f slug decided summary tags
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    slug=$(basename "$f" .md)
    decided=$(fm_get "$f" "decided")
    [[ -z "$decided" ]] && decided=$(fm_get "$f" "updated")
    if (( since_epoch > 0 )); then
      local d_epoch
      d_epoch=$(_date_to_epoch "$decided")
      (( d_epoch < since_epoch )) && continue
    fi
    tags=$(fm_get "$f" "tags")
    if [[ -n "$tag_filter" ]]; then
      [[ "$tags" == *"$tag_filter"* ]] || continue
    fi
    summary=$(fm_get "$f" "summary")
    [[ -z "$summary" ]] && summary=$(fm_get "$f" "decision")
    rows+=("$slug|${decided:-?}|${tags:-}|${summary:-}")
    count=$((count + 1))
  done < <(_iter_md decisions)

  # Sort by decided date desc (we'll trust filesystem; if needed, can pipe through sort)
  local effective_limit=$count
  if ! $show_all && (( count > limit )); then
    effective_limit=$limit
  fi

  if $json; then
    printf '['
    local i=0
    for row in "${rows[@]:0:$effective_limit}"; do
      IFS='|' read -r slug decided tags summary <<< "$row"
      (( i > 0 )) && printf ','
      printf '{"slug":"%s","decided":"%s","tags":"%s","summary":"%s"}' \
        "$(_json_escape "$slug")" "$(_json_escape "$decided")" \
        "$(_json_escape "$tags")" "$(_json_escape "$summary")"
      i=$((i + 1))
    done
    printf ']\n'
    return 0
  fi

  if (( count == 0 )); then
    info "(no decisions match)"
    return 0
  fi

  printf "%-36s  %-10s  %-20s  %s\n" "SLUG" "DECIDED" "TAGS" "SUMMARY"
  printf "%-36s  %-10s  %-20s  %s\n" "----" "-------" "----" "-------"
  local row
  for row in "${rows[@]:0:$effective_limit}"; do
    IFS='|' read -r slug decided tags summary <<< "$row"
    local slug_disp="$slug" summary_disp="$summary" tags_disp="$tags"
    (( ${#slug_disp} > 36 )) && slug_disp="${slug_disp:0:33}..."
    (( ${#tags_disp} > 20 )) && tags_disp="${tags_disp:0:17}..."
    (( ${#summary_disp} > 50 )) && summary_disp="${summary_disp:0:47}..."
    printf "%-36s  %-10s  %-20s  %s\n" "$slug_disp" "$decided" "$tags_disp" "$summary_disp"
  done

  if (( count > effective_limit )); then
    info "(showing $effective_limit of $count — use --all for full list)"
  fi
}

