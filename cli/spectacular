cmd_workspace() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    preflight|plan)
      local request="" json=false
      while (( $# > 0 )); do case "$1" in --request) require_value "$1" "${2:-}"; request="$2"; shift 2 ;; --json) json=true; shift ;; *) die "Usage: spectacular workspace $sub [--request <slug>] [--json]" ;; esac; done
      [[ -z "$request" || -f "$SPEC_REQUESTS_DIR/$request/PLAN.md" ]] || die "workspace: request not found: $request"
      $json && _workspace_report_json "$request" || _workspace_report "$request" ;;
    preserve)
      local slug="" paths="" apply=false yes=false
      while (( $# > 0 )); do
        case "$1" in
          --paths) require_value "$1" "${2:-}"; paths="$2"; shift 2 ;;
          --apply) apply=true; shift ;;
          --yes) yes=true; shift ;;
          -*) die "Usage: spectacular workspace preserve <slug> --paths <path[,path...]> [--apply --yes]" ;;
          *) [[ -z "$slug" ]] || die "workspace preserve: only one slug allowed"; slug="$1"; shift ;;
        esac
      done
      _workspace_preserve "$slug" "$paths" "$apply" "$yes" ;;
    ""|--help|-h)
      cat <<EOF
Usage: spectacular workspace <preflight|plan|preserve|cleanup>

  preflight [--request <slug>]  Read-only coordination report and safe next action.
  plan [--request <slug>]       Read-only path-to-disposition plan.
  preserve <slug> --paths <p,...> [--apply --yes]
                              Create and push a scoped preservation commit.
  cleanup                       Read-only branch inventory.
  cleanup <branch> [--refresh --apply --yes]
                              Delete only a locally merged, archive-backed branch.
EOF
      ;;
    cleanup)
      [[ $# -eq 0 ]] && { _workspace_cleanup_inventory; return 0; }
      local branch="" apply=false yes=false refresh=false
      while (( $# > 0 )); do case "$1" in --refresh) refresh=true; shift ;; --apply) apply=true; shift ;; --yes) yes=true; shift ;; -*) die "Usage: spectacular workspace cleanup <branch> [--refresh --apply --yes]" ;; *) [[ -z "$branch" ]] || die "workspace cleanup: only one branch allowed"; branch="$1"; shift ;; esac; done
      _workspace_cleanup_apply "$branch" "$apply" "$yes" "$refresh" ;;
    *) die "Usage: spectacular workspace <preflight|plan|preserve|cleanup>" ;;
  esac
}

_afk_slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

_afk_branch_name() {
  local kind="$1" target="$2" version="${3:-}" host_prefix="${4:-}" canonical slug base prefix
  slug=$(_afk_slug "$target")
  case "$kind" in
    draft|draft-spec|spec) base="spec/draft-$slug" ;;
    spike)
      canonical=$(_canonical_resolve "$target" spike 2>/dev/null) || canonical="$target"
      base="spike/prototype-$(_afk_slug "$canonical")" ;;
    fork|idea)
      canonical=$(_canonical_resolve "$target" idea 2>/dev/null) || canonical="$target"
      base="fork/idea-$(_afk_slug "$canonical")" ;;
    feature|feat)
      [[ -n "$version" ]] || die "afk propose: feature requires --version vX.Y.Z"
      [[ "$version" == v* ]] || version="v$version"
      base="feat/${version}-$slug" ;;
    *) die "afk propose: kind must be draft-spec|spike|fork|feature" ;;
  esac
  prefix="${host_prefix:-$(_afk_prefix)}"; prefix="${prefix%/}"
  [[ -n "$prefix" ]] && echo "$prefix/$base" || echo "$base"
}

cmd_afk_status() {
  (( $# == 0 )) || die "afk status takes no arguments"
  _afk_require_repo
  local branch dirty="clean" enabled=false
  branch=$(git branch --show-current 2>/dev/null); [[ -n "$(git status --porcelain 2>/dev/null)" ]] && dirty=dirty
  _afk_enabled && enabled=true
  info "── AFK Git policy (read-only) ──"
  info "  enabled:          $enabled"
  info "  branch_prefix:    $(_afk_prefix)"
  info "  primary_branches: $(_afk_primary_list)"
  info "  allow_pr_create:  $(_afk_config_get allow_pr_create)"
  info "  current:          ${branch:-(detached)} ($dirty)"
  $enabled || info "  gate:             configure, review, then apply with: spectacular afk configure --enable --apply --yes"
}

_afk_active_run() {
  local f status
  for f in "$SPEC_AFK_DIR"/runs/*.md; do
    [[ -f "$f" ]] || continue
    status=$(fm_get "$f" status)
    [[ "$status" == active || "$status" == gated ]] && { echo "$f"; return 0; }
  done
  return 1
}

_afk_event_type_valid() {
  case "$1" in
    authorization|node-added|technical-choice|delegated|returned|verification|acceptance|integration|git-action|gate|resume|handoff|completion|cancellation|cleanup) return 0 ;;
    *) return 1 ;;
  esac
}

_afk_event_next_id() {
  awk '/^### E-[0-9][0-9][0-9] — / { n=substr($2,3)+0 } END { printf "%03d", n + 1 }' "$1"
}

_afk_event_append() {
  local path="$1" type="$2" scope="$3" rationale="$4" evidence="$5" result="${6:-recorded}" id stamp
  id=$(_afk_event_next_id "$path")
  stamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  printf '\n### E-%s — %s\n- at: %s\n- actor: orchestrator\n- scope: %s\n- rationale: %s\n- evidence: %s\n- result: %s\n' \
    "$id" "$type" "$stamp" "$scope" "$rationale" "$evidence" "$result" >> "$path"
}

cmd_afk_run() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    start)
      local slug="" goal="" request="" allowed="research,spikes,draft-specs" gates="merge,breaking-api-schema,product-business,undeclared-auth-browser-sensitive-data" authorized_by="" session="" base="" nodes="" authority=false apply=false yes=false
