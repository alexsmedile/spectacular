      "tags": ["mode-selection", "multi-file", "complexity-c2"],
      "expect": {"status": "done", "required_commands": ["sh tests/check.sh"], "post_checks": [{"command": ["sh", "tests/check.sh"], "expected_exit": 0}], "allowed_changed_paths": ["src/**"], "forbidden_changed_paths": ["tests/**", ".spectacular/**"], "maximum_owner_questions": 0, "require_single_return": true},
