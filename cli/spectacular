# ── cmd_summary (aggregate workspace overview) ───────────────────────────────
cmd_summary() {
  local json=false
  while (( $# > 0 )); do
    case "$1" in
      --json) json=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular summary [--json]

One-page workspace overview: counts of requests by status, recent decisions,
recent memories, open sessions. Aggregates by calling other read verbs.
EOF
        exit 0 ;;
      *) die "Unknown flag for summary: $1" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "summary: not inside a Spectacular workspace"

  # Count requests by status
  local total_requests=0 planned=0 active=0 review=0 verified=0
  local f s
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    total_requests=$((total_requests + 1))
    s=$(fm_get "$f" "status")
    case "$s" in
      planned)  planned=$((planned + 1)) ;;
      active)   active=$((active + 1)) ;;
      review)   review=$((review + 1)) ;;
      verified) verified=$((verified + 1)) ;;
    esac
  done < <(_request_iter_all)

  # Count decisions, memories
  local total_decisions=0 total_memories=0
  if [[ -d "$SPEC_DECISIONS_DIR" ]]; then
    while IFS= read -r f; do [[ -n "$f" ]] && total_decisions=$((total_decisions + 1)); done < <(_iter_md decisions)
  elif [[ -f "$SPEC_WORKSPACE_DIR/DECISIONS.md" ]]; then
    # flat mode: each ADR is a "## <date> — <title>" prose block
    total_decisions=$(grep -c '^## ' "$SPEC_WORKSPACE_DIR/DECISIONS.md" 2>/dev/null || true)
  fi
  while IFS= read -r f; do [[ -n "$f" ]] && total_memories=$((total_memories + 1)); done < <(_iter_md memory)

  # Sessions: total + open
  local total_sessions=0 open_sessions=0
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    total_sessions=$((total_sessions + 1))
    s=$(fm_get "$f" "status")
    [[ "$s" == "open" ]] && open_sessions=$((open_sessions + 1))
  done < <(_iter_md sessions)

  # Ideas + feedback (light counts)
  local total_ideas=0
  if [[ -d "$SPEC_IDEAS_DIR" ]]; then
    for f in "$SPEC_IDEAS_DIR"/*.md; do [[ -f "$f" ]] && total_ideas=$((total_ideas + 1)); done
  fi
  local total_feedback=0
  if [[ -d "$SPEC_WORKSPACE_DIR/feedback" ]]; then
    for f in "$SPEC_WORKSPACE_DIR/feedback"/*.md; do [[ -f "$f" ]] && total_feedback=$((total_feedback + 1)); done
  fi

  # Project name
  local project="?"
  if [[ -f "$SPEC_WORKSPACE_DIR/config.yaml" ]]; then
    project=$(awk '/^  name:/ { sub(/^  name:[[:space:]]*/, ""); print; exit }' "$SPEC_CONFIG_FILE")
    [[ -z "$project" ]] && project="?"
  fi

  if $json; then
    printf '{"project":"%s","requests":{"total":%d,"planned":%d,"active":%d,"review":%d,"verified":%d},' \
      "$(_json_escape "$project")" "$total_requests" "$planned" "$active" "$review" "$verified"
    printf '"decisions":%d,"memories":%d,"sessions":{"total":%d,"open":%d},"ideas":%d,"feedback":%d}\n' \
      "$total_decisions" "$total_memories" "$total_sessions" "$open_sessions" "$total_ideas" "$total_feedback"
    return 0
  fi

  echo "── Spectacular Workspace Summary ──"
  echo ""
  printf "Project:    %s\n" "$project"
  echo ""

  if (( total_requests > 0 )); then
    printf "Requests:   %d total\n" "$total_requests"
    # Status breakdown with mini bars (width=10, proportional to total)
    local statuses=("planned" "active" "review" "verified")
    local counts=("$planned" "$active" "$review" "$verified")
    local s c bar
    for (( i=0; i<4; i++ )); do
      s="${statuses[$i]}"
      c="${counts[$i]}"
      (( c == 0 )) && continue
      bar=$(_ascii_bar "$c" "$total_requests" 10)
      printf "            %-10s %s  %d\n" "$s" "$bar" "$c"
    done
  else
    echo "Requests:   0"
  fi
  echo ""
  printf "Decisions:  %d\n" "$total_decisions"
  printf "Memories:   %d\n" "$total_memories"
  printf "Sessions:   %d (%d open)\n" "$total_sessions" "$open_sessions"
  printf "Ideas:      %d\n" "$total_ideas"
  printf "Feedback:   %d\n" "$total_feedback"
  echo ""
  if (( active > 0 )); then
    echo "Active requests:"
    spectacular_self_active_requests=true cmd_requests --active --limit 5 2>/dev/null | tail -n +3 | sed 's/^/  /'
  fi

  # Cross-request link advisory (v1.16.0+): show active requests that have
  # declared edges so an agent sees ordering dependencies at a glance.
  local _link_lines=""
  if [[ -d "$SPEC_REQUESTS_DIR" ]]; then
    local _link_gdir
    _link_gdir=$(mktemp -d)
    local _active_plan_slugs=()
    shopt -s nullglob
    for _d in "$SPEC_REQUESTS_DIR"/*/; do
      local _sl; _sl=$(basename "$_d")
      local _st; _st=$(fm_get "$SPEC_REQUESTS_DIR/$_sl/PLAN.md" "status" 2>/dev/null || true)
      [[ "$_st" == "active" ]] || continue
      _active_plan_slugs+=("$_sl")
      local _dp
      _dp=$(awk '/^---$/{c++;if(c>1)exit;next}c==1&&f&&/^[a-zA-Z]/{exit}c==1&&f&&/^[[:space:]]*-/{v=$0;sub(/^[[:space:]]*-[[:space:]]*/,"",v);gsub(/^"|"$/,"",v);gsub(/[[:space:]]+$/,"",v);if(v!="")print v}c==1&&/^depends-on:/{f=1}' \
        "$SPEC_REQUESTS_DIR/$_sl/PLAN.md")
      local _bk
      _bk=$(awk '/^---$/{c++;if(c>1)exit;next}c==1&&f&&/^[a-zA-Z]/{exit}c==1&&f&&/^[[:space:]]*-/{v=$0;sub(/^[[:space:]]*-[[:space:]]*/,"",v);gsub(/^"|"$/,"",v);gsub(/[[:space:]]+$/,"",v);if(v!="")print v}c==1&&/^blocks:/{f=1}' \
        "$SPEC_REQUESTS_DIR/$_sl/PLAN.md")
      [[ -n "$_dp" ]] && printf '%s\n' "$_dp" > "$_link_gdir/$_sl.dep"
      [[ -n "$_bk" ]] && printf '%s\n' "$_bk" > "$_link_gdir/$_sl.blk"
    done
    shopt -u nullglob
    # Compute inverses for active requests only.
    # ponytail: ${arr[@]+...} guards the empty-array-under-set-u bash quirk.
    for _sl in ${_active_plan_slugs[@]+"${_active_plan_slugs[@]}"}; do
      if [[ -f "$_link_gdir/$_sl.dep" ]]; then
        while IFS= read -r _t; do
          [[ -z "$_t" ]] && continue
          echo "$_sl" >> "$_link_gdir/$_t.req_by"
        done < "$_link_gdir/$_sl.dep"
      fi
      if [[ -f "$_link_gdir/$_sl.blk" ]]; then
        while IFS= read -r _t; do
          [[ -z "$_t" ]] && continue
          echo "$_sl" >> "$_link_gdir/$_t.blk_by"
        done < "$_link_gdir/$_sl.blk"
      fi
    done
    # Build advisory lines
    for _sl in ${_active_plan_slugs[@]+"${_active_plan_slugs[@]}"}; do
      local _has=false
      [[ -f "$_link_gdir/$_sl.dep"    ]] && _has=true
      [[ -f "$_link_gdir/$_sl.blk"    ]] && _has=true
      [[ -f "$_link_gdir/$_sl.req_by" ]] && _has=true
      [[ -f "$_link_gdir/$_sl.blk_by" ]] && _has=true
      $_has || continue
      local _parts=""
      if [[ -f "$_link_gdir/$_sl.dep" ]]; then
        local _ts; _ts=$(paste -sd, "$_link_gdir/$_sl.dep")
        _parts="${_parts:+$_parts; }depends-on: $_ts"
      fi
      if [[ -f "$_link_gdir/$_sl.blk" ]]; then
        local _ts; _ts=$(paste -sd, "$_link_gdir/$_sl.blk")
        _parts="${_parts:+$_parts; }blocks: $_ts"
      fi
      if [[ -f "$_link_gdir/$_sl.req_by" ]]; then
        local _ts; _ts=$(paste -sd, "$_link_gdir/$_sl.req_by")
        _parts="${_parts:+$_parts; }required-by: $_ts"
      fi
      if [[ -f "$_link_gdir/$_sl.blk_by" ]]; then
        local _ts; _ts=$(paste -sd, "$_link_gdir/$_sl.blk_by")
        _parts="${_parts:+$_parts; }blocked-by: $_ts"
      fi
      _link_lines="${_link_lines:+$_link_lines$'\n'}  ${_sl}: $_parts"
    done
    rm -rf "$_link_gdir"
  fi
  if [[ -n "$_link_lines" ]]; then
    echo "Active links:"
    echo "$_link_lines"
    echo ""
  fi
}

# ── cmd_roadmap_migrate: spectacular roadmap migrate ─────────────────────────
# v1.23.0 (b18): move shipped per-version prose blocks into per-version files
# (.spectacular/roadmap/v<X.Y.Z>.md) behind a cheap "shipped index", keeping the
# most-recent N shipped blocks inline. Mirrors cmd_decisions_migrate.
#
# Mode: roadmap/ folder present → index mode. Only SHIPPED versions (per the
# ledger status column) beyond the keep-window move. Planned/active/vision blocks
# never move. Safe: per-version files written before ROADMAP.md is rewritten.
ROADMAP_KEEP_DEFAULT=3

cmd_roadmap_migrate() {
  local dry_run=false keep="$ROADMAP_KEEP_DEFAULT"
  while (( $# > 0 )); do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --keep) require_value "--keep" "${2:-}"; keep="$2"; shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: spectacular roadmap migrate [--dry-run] [--keep N]

Move shipped per-version prose blocks into per-version files
(.spectacular/roadmap/v<X.Y.Z>.md) behind a "## Shipped" index, keeping the most
recent N shipped blocks inline (default $ROADMAP_KEEP_DEFAULT). Only blocks whose
ledger status is 'shipped' move; planned/active/vision blocks stay inline.

Safe: per-version files are written before ROADMAP.md is rewritten.
Idempotent: re-running moves only newly-ageable blocks.

  --dry-run   Preview would-write paths + the index; write nothing.
  --keep N    Keep the N most-recent shipped blocks inline (default $ROADMAP_KEEP_DEFAULT).
EOF
        exit 0 ;;
      *) die "Unknown flag for roadmap migrate: $1" ;;
    esac
  done

  [[ "$keep" =~ ^[0-9]+$ ]] || die "roadmap migrate: --keep must be a non-negative integer"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "roadmap migrate: not inside a Spectacular workspace"

  local roadmap="$SPEC_ROADMAPS_DIR/index.md"
  local roadmap_dir="$SPEC_ROADMAPS_DIR"
  [[ -f "$roadmap" ]] || die "roadmap migrate: $roadmap not found"

  # 1. Parse ## v<X.Y.Z> blocks in document order. Capture heading, body span, and
  #    whether the block's own `**Status:**` line says shipped. The block's own
  #    status is the authority for "is this prose past-tense" — more reliable than
  #    the ledger, which has no rows for pre-ledger (v1.17.0) shipped versions.
  #    A block runs from its "## v..." line up to (not including) the next "## "
  #    heading or EOF. (Bash 3.2: plain indexed arrays only, no associative.)
  local -a blk_ver blk_head blk_start blk_end blk_shipped
  local n=0 lineno=0 cur_ver="" line
  while IFS= read -r line; do
    lineno=$((lineno+1))
    if [[ "$line" =~ ^##[[:space:]]+(v[0-9]+\.[0-9]+\.[0-9]+) ]]; then
      if [[ -n "$cur_ver" ]]; then blk_end[$n]=$((lineno-1)); n=$((n+1)); fi
      cur_ver="${BASH_REMATCH[1]}"
      blk_ver[$n]="$cur_ver"; blk_head[$n]="$line"; blk_start[$n]=$lineno; blk_shipped[$n]=0
    elif [[ "$line" =~ ^##[[:space:]] ]] && [[ -n "$cur_ver" ]]; then
      blk_end[$n]=$((lineno-1)); n=$((n+1)); cur_ver=""
    elif [[ -n "$cur_ver" && "$line" =~ ^\*\*Status:\*\*[[:space:]]*shipped ]]; then
      blk_shipped[$n]=1
    fi
  done < "$roadmap"
  if [[ -n "$cur_ver" ]]; then blk_end[$n]=$lineno; n=$((n+1)); fi

  # 2. Determine which shipped blocks move: all shipped EXCEPT the newest `keep`.
  #    "Newest" by document order — shipped blocks run oldest→newest top→bottom;
  #    later document position = newer.
  local -a shipped_idx
  local i
  for ((i=0; i<n; i++)); do
    [[ "${blk_shipped[$i]}" == 1 ]] && shipped_idx+=("$i")
  done
  local total_shipped=${#shipped_idx[@]}
  local move_count=$(( total_shipped > keep ? total_shipped - keep : 0 ))

  if (( move_count == 0 )); then
    info "  ✓  roadmap: $total_shipped shipped block(s), keep=$keep — nothing to migrate"
    return 0
  fi

  # The blocks to move = the first (oldest) move_count shipped blocks.
  local -a move_idx
  for ((i=0; i<move_count; i++)); do move_idx+=("${shipped_idx[$i]}"); done

  if $dry_run; then
    echo "── dry-run: would move $move_count of $total_shipped shipped blocks (keep newest $keep) ──"
    for i in "${move_idx[@]}"; do
      echo "  would write: ${roadmap_dir}/${blk_ver[$i]}.md   (${blk_head[$i]#\#\# })"
    done
    echo ""
    echo "── dry-run: would add to '## Shipped' index in $roadmap ──"
    for i in "${move_idx[@]}"; do
      echo "- ${blk_ver[$i]} → roadmaps/${blk_ver[$i]}.md"
    done
    return 0
  fi

  # 4. Write per-version files (all before rewriting roadmaps/index.md — no data loss).
  mkdir -p "$roadmap_dir"
  for i in "${move_idx[@]}"; do
    local v="${blk_ver[$i]}"
    local s="${blk_start[$i]}" e="${blk_end[$i]}"
    # Slice the block, then drop trailing blank lines (awk: buffer blanks, flush
    # only when a non-blank follows — portable, no BSD/GNU sed divergence).
    sed -n "${s},${e}p" "$roadmap" \
      | awk 'NF{for(;b>0;b--)print ""; print; next} {b++}' > "${roadmap_dir}/${v}.md"
    created "${roadmap_dir}/${v}.md"
  done

  # 5. Build the "## Shipped" index from every v*.md in roadmaps/ (sorted), into a
  #    temp file (awk reads it — avoids the newline-in-`-v` limitation).
  local idx_file="${roadmap}.idx.$$"
  {
    echo "## Shipped"
    echo ""
    echo "> Older shipped versions — full prose moved to per-version files (\`roadmaps/v*.md\`); the most recent stay inline above. Facts also live in \`CHANGELOG.md\`."
    echo ""
    local f vv
    while IFS= read -r f; do
      vv=$(basename "$f" .md)
      echo "- ${vv} → roadmaps/${vv}.md"
    done < <(ls "$roadmap_dir"/v*.md 2>/dev/null | sort -V)
  } > "$idx_file"

  # 6. Rewrite ROADMAP.md in one awk pass: skip the moved blocks' line ranges, and
  #    inject the Shipped index just before "## Icebox" (or at EOF if no Icebox).
  #    `ranges` = space-separated "start:end" pairs for moved blocks.
  local ranges=""
  for i in "${move_idx[@]}"; do ranges+="${blk_start[$i]}:${blk_end[$i]} "; done

  local tmp="${roadmap}.tmp.$$"
  awk -v ranges="$ranges" -v idxfile="$idx_file" '
    BEGIN {
      ni = split(ranges, a, " ");
      for (k = 1; k <= ni; k++) {
        if (a[k] == "") continue;
        split(a[k], se, ":"); lo[k] = se[1]; hi[k] = se[2];
      }
      nr = ni;
    }
    function skip(n,   k) { for (k=1;k<=nr;k++) if (a[k]!="" && n>=lo[k] && n<=hi[k]) return 1; return 0 }
    /^## Icebox/ && !done {
      while ((getline il < idxfile) > 0) print il;
      print "";
      close(idxfile); done=1;
    }
    { if (!skip(NR)) print }
    END {
      if (!done) { print ""; while ((getline il < idxfile) > 0) print il; close(idxfile); }
    }
  ' "$roadmap" > "$tmp"

  rm -f "$idx_file"
  mv "$tmp" "$roadmap"
  fm_touch "$roadmap"
  info "  ✓  migrated $move_count shipped block(s) to $roadmap_dir/"
  info "  ↳  kept newest $keep shipped inline; index in $roadmap (## Shipped)"
}

# ── cmd_roadmap (v1.15.0+, ledger-driven v1.13.0+) ────────────────────────────
# Renders ROADMAP.md using the ledger table as the single source of truth.
# Ledger columns: build | slug | title | tier | target-version | status
# Tier legend: full = current/near-term detail, themed = mid-term, vision = future.
# Non-TTY / NO_COLOR: degrades to plain text (no box chars, no color logic).
cmd_roadmap() {
  # Route sub-verb first
  case "${1:-}" in
    migrate) shift; cmd_roadmap_migrate "$@"; return $? ;;
  esac

  local json=false all=false
  while (( $# > 0 )); do
    case "$1" in
      --json)    json=true;  shift ;;
      --all)     all=true;   shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular roadmap [--all] [--json]
       spectacular roadmap migrate [--dry-run] [--keep N]

Render the ROADMAP.md as a version arc — runway (near-term), major (breaking),
and vision (future-direction) tiers shown with aligned status indicators.
Data source: the roadmap ledger table (build → target-version mapping).

  --all   include shipped entries (default: only planned/active)
  --json  machine-readable: array of {build,slug,version,title,tier,status} objects

Subcommands:
  migrate [--dry-run] [--keep N]   Move old shipped prose blocks into per-version
                                   files (roadmap/v*.md) behind a Shipped index.
EOF
        exit 0 ;;
      -*) die "Unknown flag for roadmap: $1" ;;
      *) die "roadmap: unexpected argument '$1'" ;;
    esac
  done

  local roadmap="$SPEC_ROADMAPS_DIR/index.md"
  [[ -f "$roadmap" ]] || roadmap="$SPEC_WORKSPACE_DIR/ROADMAP.md"
  [[ -f "$roadmap" ]] || die "roadmap: roadmap index not found at $roadmap"

  # Parse ledger table → emit pipe-delimited: build|slug|title|tier|version|status
  # Ledger format: | build | slug | title | tier | target-version | status |
  # Skips header row (contains "build") and separator row (contains "---").
  local -a builds slugs titles tiers versions statuses
  while IFS='|' read -r _pre build slug title tier ver status _post; do
    # strip whitespace from each field
    build="${build## }"; build="${build%% }"
    slug="${slug## }";   slug="${slug%% }"
    title="${title## }"; title="${title%% }"
    tier="${tier## }";   tier="${tier%% }"
    ver="${ver## }";     ver="${ver%% }"
    status="${status## }"; status="${status%% }"
    # skip header, separator, and empty rows
    [[ "$build" == "build" || "$build" == "---"* || -z "$build" ]] && continue
    builds+=("$build")
    slugs+=("$slug")
    titles+=("$title")
    tiers+=("$tier")
    versions+=("$ver")
    statuses+=("$status")
  done < <(awk '/^\| *build/,/^[^|]/' "$roadmap" | grep '^|')

  if (( ${#builds[@]} == 0 )); then
    info "roadmap: no ledger table found in $roadmap"
    return 0
  fi

  if $json; then
    printf "["
    local first=true i
    for (( i=0; i<${#builds[@]}; i++ )); do
      $all || [[ "${statuses[$i]}" != "shipped" ]] || continue
      $first && first=false || printf ","
      printf '{"build":"%s","slug":"%s","version":"%s","title":"%s","tier":"%s","status":"%s"}' \
        "${builds[$i]}" "${slugs[$i]}" "${versions[$i]}" \
        "${titles[$i]}" "${tiers[$i]}" "${statuses[$i]}"
    done
    printf "]\n"
    return 0
  fi

  # Text render
  if _ascii_color_enabled; then
    echo "── Roadmap ──────────────────────────────────────────────────────"
  else
    echo "── Roadmap ──"
  fi
  echo ""

  local cur_tier="" i
  for (( i=0; i<${#builds[@]}; i++ )); do
    local status="${statuses[$i]}"
    $all || [[ "$status" != "shipped" ]] || continue

    local tier="${tiers[$i]}"
    if [[ "$tier" != "$cur_tier" ]]; then
      [[ -n "$cur_tier" ]] && echo ""
      case "$tier" in
        full)    echo "  ── Runway (near-term) ──" ;;
        themed)  echo "  ── Major (mid-term) ──" ;;
        vision)  echo "  ── Vision (future) ──" ;;
        *)       echo "  ── $tier ──" ;;
      esac
      cur_tier="$tier"
    fi

    local indicator
    case "$status" in
      shipped)  indicator="✓" ;;
      active)   indicator="▶" ;;
      planned)  indicator="·" ;;
      *)        indicator="?" ;;
    esac

    local ver="${versions[$i]}"
    local title="${titles[$i]}"
    if (( ${#title} > 44 )); then title="${title:0:43}…"; fi
    printf "  %s  %-12s  %s\n" "$indicator" "$ver" "$title"
  done
  echo ""
}

# ── Closure gate (v1.28.0+) ───────────────────────────────────────────────────
# Three mechanical checks run before archive. Each blocks unless satisfied or
# explicitly overridden. See references/archive.md § The closure gate and the
# archive-closure-gate PLAN § Formats for the on-disk contracts.

# _closure_check_tasks <dir> — echo a failure message if any milestone TASKS box
# is open ([ ]) or deferred without a reason ([~] lacking ' — <reason>'). Only
# scans task lines under '### M<N>' headings; ignores '## v2 (deferred)' sections.
# Silent (exit 0, no output) when clean or TASKS.md absent.
_closure_check_tasks() {
  local tasks="$1/TASKS.md"
  [[ -f "$tasks" ]] || return 0
  awk '
    /^## / { in_v2 = ($0 ~ /deferred/) ? 1 : 0 }
    in_v2 { next }
    /^### M/ { in_ms = 1; next }
    /^#/ { if ($0 !~ /^### M/) in_ms = 0 }
    in_ms && /^- \[ \]/ {
      t=$0; sub(/^- \[ \][[:space:]]*/,"",t); print "open: " t; bad=1
    }
    in_ms && /^- \[~\]/ {
      # deferred is OK only with a " — " reason (em-dash or " - " hyphen)
      if ($0 !~ / — / && $0 !~ / - /) {
        t=$0; sub(/^- \[~\][[:space:]]*/,"",t); print "deferred without reason: " t; bad=1
      }
    }
    END { exit (bad?1:0) }
  ' "$tasks"
}

# _closure_check_verify <dir> — fail if VERIFY.md exists but VERIFY-LOG.md has no
# passed (✅) walk row (never actually walked). No VERIFY.md → not applicable.
_closure_check_verify() {
  local dir="$1"
  [[ -f "$dir/VERIFY.md" ]] || return 0
  if [[ ! -f "$dir/VERIFY-LOG.md" ]]; then
    echo "VERIFY.md exists but no VERIFY-LOG.md — never run through the verify walk"; return 0
  fi
  if ! grep -q "✅" "$dir/VERIFY-LOG.md"; then
    echo "VERIFY-LOG.md has no passed (✅) walk row — verify walk left no green result"
  fi
}

# _closure_check_spec <dir> — fail if no SPEC-DELTA.md declaring spec impact.
_closure_check_spec() {
  local delta="$1/SPEC-DELTA.md"
  if [[ ! -f "$delta" ]]; then
    echo "no SPEC-DELTA.md — declare spec impact (ADDED/MODIFIED/REMOVED, or 'NONE — <why>')"
  fi
}

_closure_check_docs() {
  local plan="$1/PLAN.md"
  [[ -f "$plan" ]] || return 0
  local impact; impact=$(fm_get "$plan" docs_impact)
  [[ -z "$impact" ]] && return 0
  [[ "$impact" == pending ]] && ! _request_docs_impact_is_heavy "$plan" && return 0
  _request_docs_impact_closed "$plan" || echo "docs impact is pending or lacks its required reason/evidence"
}

# `spectacular archive <slug> [--force]`
# Moves request to .spectacular/archive/, rewrites inbound related: links,
# sets status: archived + archived: <today>. Refuses if not in verified/review
# without --force.
cmd_archive() {
  local slug="" opt_force=false opt_skip_doctor=false opt_no_docs_prompt=false
  # Closure-gate overrides: --override <check> --reason "<text>" (repeatable).
  # Parallel arrays; ov_check[i] is bypassed with reason ov_reason[i].
  local -a ov_check=() ov_reason=()
  while (( $# > 0 )); do
    case "$1" in
      --force)           opt_force=true; shift ;;
      --skip-doctor)     opt_skip_doctor=true; shift ;;
      --no-docs-prompt)  opt_no_docs_prompt=true; shift ;;
      --override)
        [[ -n "${2:-}" ]] || die "archive: --override requires a check name (tasks|verify|spec|docs)"
        case "$2" in tasks|verify|spec|docs) ;; *) die "archive: --override check must be tasks|verify|spec|docs, got: $2" ;; esac
        [[ "${3:-}" == "--reason" && -n "${4:-}" ]] || die "archive: --override $2 requires --reason \"<text>\""
        ov_check+=("$2"); ov_reason+=("$4"); shift 4 ;;
      --help|-h)
        cat <<EOF
Usage: spectacular archive <slug> [--force] [--skip-doctor] [--no-docs-prompt]
                                  [--override <check> --reason "<text>"]...

Move a request from .spectacular/requests/<slug>/ to .spectacular/archive/<slug>/
and rewrite inbound related: links in other request files to point at the new
location.

Refuses unless status is 'verified' or 'review'. Use --force to override.
Refuses if doctor finds workspace/specs/links errors. Use --skip-doctor to bypass.

Closure gate — blocks archive unless the request closed itself out:
  tasks   every TASKS.md box is [x], or [~] with a ' — <reason>'
  verify  if VERIFY.md exists, VERIFY-LOG.md has a passed (✅) walk row
  spec    a SPEC-DELTA.md exists (ADDED/MODIFIED/REMOVED, or 'NONE — <why>')
  docs    docs_impact is none + reason, or required + update/handoff evidence
Bypass one check with --override <check> --reason "<text>" (repeatable). The
reason is stamped into archive_overrides: in the archived PLAN — auditable, not
silent. --force does NOT bypass these; it only bypasses the status gate.

If the archived request touched SPEC.md / specs/ / ARCHITECTURE.md / PRD.md AND
docs/ exists, prints a hint suggesting 'pageworks audit'. Suppress per-call with
--no-docs-prompt, or per-project with 'docs.prompt_on_archive: false' in
.spectacular/config.yaml. See: skills/spectacular/references/pageworks-handoff.md

Options:
  --force            Skip status-gate check (allow archiving planned/active requests)
  --skip-doctor      Bypass the doctor precondition (use with caution)
  --no-docs-prompt   Suppress the post-archive pageworks suggestion this run
  --override <check> --reason "<text>"
                     Bypass one closure check (tasks|verify|spec), recording why
  -h, --help         Show this help
EOF
        exit 0 ;;
      -*) die "Unknown flag for archive: $1" ;;
      *)
        [[ -n "$slug" ]] && die "archive takes one <slug> argument; got: $slug and $1"
        slug="$1"
        shift
        ;;
    esac
  done

  [[ -z "$slug" ]] && die "archive: <slug> argument required."
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "archive: not inside a Spectacular workspace."

  require_doctor_clean "archive" "skip-doctor" "$opt_skip_doctor"

  local src="$SPEC_REQUESTS_DIR/$slug"
  if [[ ! -d "$src" ]]; then
    if [[ -d "$SPEC_ARCHIVE_DIR/$slug" ]]; then
      die "archive: '$slug' is already archived (.spectacular/archive/$slug)"
    fi
    die "archive: request '$slug' not found at $src"
  fi

  local plan="$src/PLAN.md"
  if [[ ! -f "$plan" ]]; then
    die "archive: $plan not found — refuse to archive a request without PLAN.md"
  fi

  # Lifecycle gate
  local status
  status="$(fm_get "$plan" "status")"
  case "$status" in
    verified|review) ;;
    *)
      if ! $opt_force; then
        die "archive: refusing to archive '$slug' (status: ${status:-missing}). Promote to verified or use --force."
      fi
      ;;
  esac

  # ── Closure gate (v1.28.0+) ────────────────────────────────────────────────
  # Three checks; each blocks unless satisfied or overridden. Collect ALL
  # failures so the user sees the whole punch list, not one-at-a-time.
  local -a gate_fail_check=() gate_fail_msg=()
  local _msg
  _msg="$(_closure_check_tasks "$src")"  || true
  [[ -n "$_msg" ]] && { gate_fail_check+=("tasks");  gate_fail_msg+=("$_msg"); }
  _msg="$(_closure_check_verify "$src")" || true
  [[ -n "$_msg" ]] && { gate_fail_check+=("verify"); gate_fail_msg+=("$_msg"); }
  _msg="$(_closure_check_spec "$src")"   || true
  [[ -n "$_msg" ]] && { gate_fail_check+=("spec");   gate_fail_msg+=("$_msg"); }
  _msg="$(_closure_check_docs "$src")"   || true
  [[ -n "$_msg" ]] && { gate_fail_check+=("docs");   gate_fail_msg+=("$_msg"); }

  # Resolve each failure against the overrides. An override for check C clears
  # every failure of check C and records an archive_overrides: entry.
  local -a blocked_check=() blocked_msg=() override_entry=()
  local i j overridden reason
  for i in "${!gate_fail_check[@]}"; do
    overridden=false; reason=""
    for j in "${!ov_check[@]}"; do
      if [[ "${ov_check[$j]}" == "${gate_fail_check[$i]}" ]]; then
        overridden=true; reason="${ov_reason[$j]}"; break
      fi
    done
    if $overridden; then
      echo "  ⚠ closure check '${gate_fail_check[$i]}' overridden: ${reason}" >&2
      override_entry+=("${gate_fail_check[$i]} — ${reason} (${TODAY})")
    else
      blocked_check+=("${gate_fail_check[$i]}"); blocked_msg+=("${gate_fail_msg[$i]}")
    fi
  done

  # Warn on overrides passed for checks that would have passed anyway (no-op, not an error).
  for j in "${!ov_check[@]}"; do
    local matched=false
    for i in "${!gate_fail_check[@]}"; do
      [[ "${ov_check[$j]}" == "${gate_fail_check[$i]}" ]] && { matched=true; break; }
    done
    $matched || echo "  ⚠ --override ${ov_check[$j]}: that check already passes — ignoring." >&2
  done

  if (( ${#blocked_check[@]} > 0 )); then
    echo "archive: '$slug' isn't closed out — the closure gate blocks:" >&2
    for i in "${!blocked_check[@]}"; do
      echo "  ✗ ${blocked_check[$i]}: ${blocked_msg[$i]}" >&2
    done
    echo "" >&2
    echo "Fix the above, or bypass a check with:  --override <check> --reason \"<why>\"" >&2
    exit 1
  fi

  # Stamp all recorded overrides as one block list (fm_add_to_list can't build a
  # multi-item list — see its block-list bug; we own this field, so write it whole).
  # Build the block on stdin (awk -v can't hold newlines on macOS) and insert it
  # before the closing frontmatter delimiter.
  if (( ${#override_entry[@]} > 0 )); then
    local tmp; tmp=$(mktemp)
    { printf 'archive_overrides:\n'; printf '  - %s\n' "${override_entry[@]}"; } \
      | awk '
        NR==FNR { block = block $0 "\n"; next }
        /^---$/ { fm++; if (fm==2) { printf "%s", block } print; next }
        { print }
      ' - "$plan" > "$tmp" && mv "$tmp" "$plan"
  fi

  # Capture the pre-archive status for the undo breadcrumb (before we overwrite it).
  local pre_archive_status="$status"

  # Bump PLAN frontmatter BEFORE the move (avoids losing the change)
  fm_set "$plan" "status" "archived"
  fm_set "$plan" "archived" "$TODAY"
  fm_touch "$plan"

  # Move dir
  mkdir -p "$SPEC_ARCHIVE_DIR"
  local dest="$SPEC_ARCHIVE_DIR/$slug"
  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git mv "$src" "$dest" 2>/dev/null || mv "$src" "$dest"
  else
    mv "$src" "$dest"
  fi
  echo "  ✓ moved: $src → $dest"

  # Rewrite inbound related: links across all remaining request files.
  # Pattern: '../<slug>/' → '../../archive/<slug>/'
  # Also catches: '../<slug>/PLAN.md', '../<slug>/TASKS.md', etc.
  local rewrite_count=0
  shopt -s nullglob
  for target_file in "$SPEC_REQUESTS_DIR"/*/PLAN.md "$SPEC_REQUESTS_DIR"/*/TASKS.md "$SPEC_REQUESTS_DIR"/*/VERIFY.md; do
    if grep -q "\.\./${slug}/" "$target_file" 2>/dev/null; then
      sed -i.bak "s|\\.\\./${slug}/|../../archive/${slug}/|g" "$target_file"
      rm -f "$target_file.bak"
      rewrite_count=$((rewrite_count + 1))
      echo "  ✓ rewrote inbound link in: $target_file"
    fi
  done
  shopt -u nullglob

  if [[ "$rewrite_count" -eq 0 ]]; then
    echo "  • no inbound related: links found to rewrite"
  fi

  # Breadcrumb for `spectacular undo` (single-level). Records the pre-archive
  # status so undo restores it; the dir move + link rewrites are reversed
  # deterministically from op+slug.
  _breadcrumb_write "archive" "$slug" "prev_status=$pre_archive_status"

  # ── pageworks handoff prompt (v1.2.0+) ─────────────────────────────────────
  # If the archived request touched SPEC.md, specs/, ARCHITECTURE.md, or PRD.md
  # AND docs/ exists in the project, surface a hint about pageworks. The user
  # decides whether to act. See: skills/spectacular/references/pageworks-handoff.md
  if ! $opt_no_docs_prompt && [[ -d "docs" ]]; then
    # Per-project suppression via config.yaml
    local prompt_setting
    prompt_setting="$(awk '
      /^docs:/ { in_docs=1; next }
      in_docs && /^[a-zA-Z]/ && !/^  / { in_docs=0 }
      in_docs && /^[[:space:]]+prompt_on_archive:/ {
        sub(/^[[:space:]]+prompt_on_archive:[[:space:]]*/, "")
        sub(/[[:space:]]*#.*$/, "")
        sub(/[[:space:]]*$/, "")
        print; exit
      }
    ' "$SPEC_CONFIG_FILE" 2>/dev/null)"

    if [[ "$prompt_setting" != "false" ]]; then
      # Detect spec-touching changes in the archived request's tracked content
      local touched_spec=false
      for sentinel in PLAN.md TASKS.md VERIFY.md; do
        if [[ -f "$dest/$sentinel" ]]; then
          if grep -qE '(SPEC\.md|specs/|ARCHITECTURE\.md|PRD\.md)' "$dest/$sentinel" 2>/dev/null; then
            touched_spec=true
            break
          fi
        fi
      done

      if $touched_spec; then
        echo ""
        echo "ℹ This request referenced internal specs. Public docs/ may need updates."
        echo ""
        if command -v pageworks >/dev/null 2>&1; then
          echo "  Suggested next steps:"
          echo "    pageworks audit           # find pages whose synced_from: matches the changed spec"
          echo "    pageworks review <page>   # work through each flagged page"
        else
          echo "  Public docs work has moved to a dedicated skill: pageworks."
          echo "  Install: https://github.com/alexsmedile/pageworks"
        fi
        echo ""
        echo "  Skip future prompts:"
        echo "    spectacular archive <slug> --no-docs-prompt"
        echo "    or set 'docs.prompt_on_archive: false' in .spectacular/config.yaml"
      fi
    fi
  fi
}

# ── snapshot retention (b16) ──────────────────────────────────────────────────
# Tiered, generational retention — keep the union of three tiers, prune the rest:
#   origin    — always keep the lowest version (@v1 / @v1.0)
#   recent    — keep the newest `keep` by version ordinal
#   periodic  — keep the newest snapshot in each calendar bucket (month|week),
#               bucketed by each snapshot's `updated:` frontmatter date (stable
#               across clone, unlike mtime). `off` skips this tier.
# A snapshot kept by ANY tier survives. Used by both `cmd_snapshot_prune` and the
# doctor retention check, so the kept-set logic lives in one place.

# Sortable key for a snapshot basename: "@v1.3.md" -> "1 3", "@v2.md" -> "2 0".
# Feeds `sort -k1n -k2n` for correct ordinal ordering (1.10 > 1.9).
snapshot_sort_key() {
  local b="$1"
  b="${b#@v}"; b="${b%.*}"   # strip @v prefix and .md/.ext suffix
  local maj="${b%%.*}" min="0"
  [[ "$b" == *.* ]] && min="${b#*.}"
  [[ "$maj" =~ ^[0-9]+$ ]] || maj=0
  [[ "$min" =~ ^[0-9]+$ ]] || min=0
  echo "$maj $min"
}

# Emit the basenames of snapshots to KEEP for one doc dir, one per line.
# Args: <doc_dir> <keep> <period>  (period: month|week|off)
snapshot_retained_set() {
  local doc_dir="$1" keep="$2" period="$3"
  shopt -s nullglob
  local files=("$doc_dir"/@v*)
  shopt -u nullglob
  [[ ${#files[@]} -eq 0 ]] && return 0

  # Sort basenames by version ordinal (ascending).
  local sorted=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && sorted+=("$line")
  done < <(
    for f in "${files[@]}"; do
      local b; b="$(basename "$f")"
      echo "$(snapshot_sort_key "$b") $b"
    done | sort -k1n -k2n | awk '{print $3}'
  )
  local n=${#sorted[@]}
  (( n == 0 )) && return 0

  local kept=""   # space-padded set of kept basenames

  # origin: lowest version (first after ascending sort)
  kept+=" ${sorted[0]} "

  # recent: newest `keep` (tail of ascending list)
  local start=$(( n - keep )); (( start < 0 )) && start=0
  local i
  for (( i = start; i < n; i++ )); do
    [[ "$kept" == *" ${sorted[$i]} "* ]] || kept+="${sorted[$i]} "
  done

  # periodic: newest snapshot per calendar bucket, keyed off `updated:` date.
  if [[ "$period" != "off" ]]; then
    # Walk ascending so the LAST write per bucket is the newest → wins.
    local -a bucket_keys=() bucket_files=()
    for (( i = 0; i < n; i++ )); do
      local b="${sorted[$i]}"
      local up; up="$(fm_get "$doc_dir/$b" updated 2>/dev/null)"
      [[ "$up" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue   # no usable date → skip tier for this file
      local bkey
      if [[ "$period" == "week" ]]; then
        bkey="$(snapshot_week_bucket "$up")"
      else
        bkey="${up%-*}"   # YYYY-MM-DD -> YYYY-MM (substring, no date math)
      fi
      [[ -z "$bkey" ]] && continue
      # upsert: replace this bucket's current winner with the newer file
      local found=0 j
      for (( j = 0; j < ${#bucket_keys[@]}; j++ )); do
        if [[ "${bucket_keys[$j]}" == "$bkey" ]]; then bucket_files[$j]="$b"; found=1; break; fi
      done
      (( found )) || { bucket_keys+=("$bkey"); bucket_files+=("$b"); }
    done
    for (( j = 0; j < ${#bucket_files[@]}; j++ )); do
      local bf="${bucket_files[$j]}"
      [[ "$kept" == *" $bf "* ]] || kept+="$bf "
    done
  fi

  # Emit kept basenames, one per line.
  for b in $kept; do echo "$b"; done
}

# ISO week bucket "YYYY-Www" from a YYYY-MM-DD date. Guards BSD vs GNU date.
snapshot_week_bucket() {
  local d="$1" out
  out="$(date -j -f "%Y-%m-%d" "$d" "+%G-W%V" 2>/dev/null)" && { echo "$out"; return; }
  out="$(date -d "$d" "+%G-W%V" 2>/dev/null)" && { echo "$out"; return; }
  echo ""   # no usable date binary → empty (caller skips)
}

# ── snapshot ─────────────────────────────────────────────────────────────────
# `spectacular snapshot <file> [--major]`
# Copies a canonical doc to <FILE>@v<N>.md (next N inferred), bumps version
# field in the unversioned file. Idempotent: no-op if content unchanged since
# last snapshot.
cmd_snapshot() {
  local file="" opt_major=false
  while (( $# > 0 )); do
    case "$1" in
      --major) opt_major=true; shift ;;
      --help|-h)
        cat <<EOF
Usage: spectacular snapshot <file> [--major]
       spectacular snapshot prune [--apply]

Snapshot a canonical doc into <store>/<DOC>/@v<ver>.md, bump its version field,
set updated. The snapshot is named for the version the copied content IS (a doc
at 1.3 → @v1.3.md, then the live doc bumps to 1.4). Docs without a version:
field (e.g. DESIGN.md) use a plain @v<N> counter. Idempotent: re-running with no
content changes since the last snapshot is a no-op.

Canonical docs are: PRD, SPEC, ARCHITECTURE, PRINCIPLES, ROADMAP, STACK,
DECISIONS, AGENTS, DESIGN, and specs/<capability>/SPEC.md files. Non-canonical
files are refused — manual snapshots for those use plain cp.

The store dir, retention, and gitignoring are configured in config.yaml:
  snapshots:
    folder: _snapshots   # store dir name      (default _snapshots)
    keep: 3              # recent-tier count   (default 3)
    period: month        # periodic bucket     (month|week|off, default month)
    gitignore: false     # gitignore the store (default false)

Options:
  --major    Bump major version (X.Y → (X+1).0). Default is minor bump (X.Y → X.(Y+1)).
  -h, --help Show this help

Subcommand:
  prune [--apply]   Apply tiered retention (origin + periodic + recent),
                    removing snapshots outside the kept tiers. Dry-run unless
                    --apply. See: spectacular snapshot prune --help
EOF
        exit 0 ;;
      -*) die "Unknown flag for snapshot: $1" ;;
      *)
        [[ -n "$file" ]] && die "snapshot takes one file argument; got: $file and $1"
        file="$1"
        shift
        ;;
    esac
  done

  [[ -z "$file" ]] && die "snapshot: <file> argument required. See: spectacular snapshot --help"
  if [[ ! -f "$file" ]]; then
    local diag_output
    if diag_output=$(diagnose_path_error "snapshot" "$file"); then
      local diagnosis suggested_path
      diagnosis=$(echo "$diag_output" | head -n 1)
      suggested_path=$(echo "$diag_output" | tail -n 1)
      case "$diagnosis" in
        prefix-missing)
          die "snapshot: file not found: $file (did you mean $suggested_path?)"
          ;;
        not-eligible-request)
          die "snapshot: file not found: $file. Note: request plans are not eligible for snapshotting. If you only meant to update the updated: date, use: spectacular touch $suggested_path"
          ;;
        not-eligible-other)
          die "snapshot: file not found: $file. Note: $suggested_path is not a registered canonical doc."
          ;;
      esac
    fi
    die "snapshot: file not found: $file"
  fi

  if ! is_canonical_doc "$file"; then
    if [[ "$file" == "$SPEC_REQUESTS_DIR"/*/PLAN.md ]] || [[ "$file" == requests/*/PLAN.md ]]; then
      die "snapshot: $file is a request plan and not eligible for snapshotting. If you only meant to update the updated: date, use: spectacular touch $file"
    else
      die "snapshot: $file is not a registered canonical doc. Use plain cp for other files."
    fi
  fi

  local has_frontmatter=true
  if ! head -1 "$file" | grep -q '^---$'; then
    case "$file" in
      "$SPEC_CONFIG_FILE"|config.yaml|"$SPEC_WORKSPACE_DIR/DESIGN.md"|DESIGN.md) has_frontmatter=false ;;
      *) die "snapshot: $file has no frontmatter delimiter" ;;
    esac
  fi

  # Determine next snapshot number
  local dir base ext base_no_ext
  dir=$(dirname "$file")
  base=$(basename "$file")
  ext="${base##*.}"
  base_no_ext="${base%.*}"

  # Snapshot layout: <store>/<DOC>/@v<N>.<ext>, mirroring sub-paths. Store dir is
  # config-driven (b16, default _snapshots; pre-b16 workspaces used snapshots/).
  # .spectacular/PRD.md → <store>/PRD/@v<N>.md
  # .spectacular/specs/cli/SPEC.md → <store>/specs/cli/SPEC/@v<N>.md
  local snap_root snap_dir rel_dir
  snap_root="$(snapshot_store_root)"
  rel_dir="${dir#"$SPEC_WORKSPACE_DIR"/}"
  if [[ "$rel_dir" == "$SPEC_WORKSPACE_DIR" || "$rel_dir" == "$dir" ]]; then
    # File is at .spectacular root (rel_dir collapses), or not under .spectacular at all
    snap_dir="${snap_root}/${base_no_ext}"
  else
    snap_dir="${snap_root}/${rel_dir}/${base_no_ext}"
  fi

  local max_n=0 latest_path=""
  shopt -s nullglob
  # Scan NEW location: snapshots/<DOC>/@v<N>.<ext>
  for existing in "$snap_dir/@v"*.${ext}; do
    local n
    n=$(echo "$existing" | sed -E "s|.*@v([0-9]+(\.[0-9]+)?)\.${ext}\$|\1|")
    # Reduce X.Y to X for max comparison; keep full string for latest_path
    local nint="${n%.*}"
    if [[ "$nint" =~ ^[0-9]+$ ]] && (( nint > max_n )); then
      max_n=$nint
      latest_path="$existing"
    fi
  done
  # Also scan LEGACY location: <dir>/<base>@v<N>.<ext> for back-compat
  for existing in "$dir/${base_no_ext}@v"*.${ext}; do
    local n
    n=$(echo "$existing" | sed -E "s|.*@v([0-9]+(\.[0-9]+)?)\.${ext}\$|\1|")
    local nint="${n%.*}"
    if [[ "$nint" =~ ^[0-9]+$ ]] && (( nint > max_n )); then
      max_n=$nint
      latest_path="$existing"
    fi
  done
  shopt -u nullglob

  local next_n=$((max_n + 1))

  # Idempotence: compare BODY (everything after the frontmatter block) only.
  # Frontmatter fields like `version:` and `updated:` change every snapshot,
  # so they'd cause false-positive "changes" if compared.
  if (( max_n > 0 )) && [[ -n "$latest_path" ]]; then
    local latest="$latest_path"
    local cur_body snap_body
    if $has_frontmatter; then
      cur_body=$(awk '/^---$/{c++; if(c<=2) next} c>=2' "$file" | md5 2>/dev/null || awk '/^---$/{c++; if(c<=2) next} c>=2' "$file" | md5sum | cut -d' ' -f1)
      snap_body=$(awk '/^---$/{c++; if(c<=2) next} c>=2' "$latest" | md5 2>/dev/null || awk '/^---$/{c++; if(c<=2) next} c>=2' "$latest" | md5sum | cut -d' ' -f1)
    else
      cur_body=$(md5 "$file" 2>/dev/null | awk '{print $NF}' || md5sum "$file" | cut -d' ' -f1)
      snap_body=$(md5 "$latest" 2>/dev/null | awk '{print $NF}' || md5sum "$latest" | cut -d' ' -f1)
    fi
    if [[ -n "$cur_body" && "$cur_body" == "$snap_body" ]]; then
      echo "  • $file: no body changes since $latest (no snapshot taken)"
      return 0
    fi
  fi

  # Compute the new version field. Version coupling is best-effort (b16): a
  # parseable MAJOR.MINOR bumps; absent/malformed falls back to the counter and
  # never dies — DESIGN.md without a version: is the canonical case.
  local current_ver new_ver
  current_ver=""
  $has_frontmatter && current_ver="$(fm_get "$file" "version")"
  if [[ "$current_ver" =~ ^([0-9]+)\.([0-9]+)$ ]]; then
    local major="${BASH_REMATCH[1]}" minor="${BASH_REMATCH[2]}"
    if $opt_major; then
      new_ver="$((major + 1)).0"
    else
      new_ver="${major}.$((minor + 1))"
    fi
  else
    # No version: field (DESIGN.md), or unparseable: don't impose one — stay on
    # the @v<N> counter and leave the live doc's frontmatter untouched.
    new_ver=""
  fi

  # Snapshot filename = the version the COPIED content actually IS (decision 1):
  # snapshot first (pre-bump), so the file is named for the current version,
  # then the live doc bumps. Fall back to the @v<N> counter when there is no
  # parseable version to couple to (DESIGN.md without frontmatter, malformed ver).
  local snapshot_path
  if [[ "$current_ver" =~ ^[0-9]+\.[0-9]+$ ]]; then
    snapshot_path="$snap_dir/@v${current_ver}.${ext}"
  else
    snapshot_path="$snap_dir/@v${next_n}.${ext}"
  fi

  # Write snapshot (creating dir if needed), then bump (if we have a new version)
  mkdir -p "$snap_dir"
  cp "$file" "$snapshot_path"
  if [[ -n "$new_ver" ]]; then
    fm_set "$file" "version" "$new_ver"
  fi
  $has_frontmatter && fm_touch "$file"

  echo "  ✓ snapshot: $snapshot_path"
  if [[ -n "$new_ver" ]]; then
    echo "  ✓ version: ${current_ver:-(none)} → $new_ver"
  else
    echo "  ✓ version: ${current_ver:-(none)} (unchanged — counter snapshot)"
  fi
}

# Resolve the active snapshot store dir. Prefers the configured folder
# (default _snapshots); falls back to a legacy snapshots/ dir if that's what's
# on disk and the configured one doesn't exist yet (pre-M4-migration workspace).
snapshot_store_root() {
  local folder; folder="$(config_snapshots_folder)"
  if [[ -d "$SPEC_WORKSPACE_DIR/$folder" ]]; then
    echo "$SPEC_WORKSPACE_DIR/$folder"
  elif [[ "$folder" != "snapshots" && -d "$SPEC_WORKSPACE_DIR/snapshots" ]]; then
    echo "$SPEC_WORKSPACE_DIR/snapshots"
  else
    echo "$SPEC_WORKSPACE_DIR/$folder"
  fi
}

# ── snapshot prune (b16) ──────────────────────────────────────────────────────
# `spectacular snapshot prune [--apply]`
# Apply tiered retention (origin + periodic + recent) across every doc in the
# snapshot store; move snapshots no tier claims out of the way. Dry-run by
# default — prints what WOULD go; --apply performs the move. Tracked files are
# `git rm`'d (history holds the content); untracked / non-git fall back to
# .spectacular/.trash/<store>/<doc>/. The live canonical file is never touched.
cmd_snapshot_prune() {
  local apply=false
  while (( $# > 0 )); do
    case "$1" in
      --apply|--confirm) apply=true; shift ;;
      --help|-h)
        cat <<'EOF'
Usage: spectacular snapshot prune [--apply]

Apply tiered retention to the snapshot store and remove snapshots outside the
kept tiers (origin @v1 + newest-per-period + newest `keep`). Dry-run by default.

Retention is configured in .spectacular/config.yaml:
  snapshots:
    keep: 3          # recent tier count   (default 3)
    period: month    # periodic bucket     (month|week|off, default month)

Options:
  --apply    Perform the prune (git rm if tracked, else move to .trash/).
             Without it, prints what would be pruned and changes nothing.
  -h, --help Show this help
EOF
        exit 0 ;;
      *) die "snapshot prune: unknown argument '$1'. See: spectacular snapshot prune --help" ;;
    esac
  done

  local root; root="$(snapshot_store_root)"
  if [[ ! -d "$root" ]]; then
    echo "  • no snapshot store at $root — nothing to prune"
    return 0
  fi

  local keep period; keep="$(config_snapshots_keep)"; period="$(config_snapshots_period)"

  # Doc dirs = every dir directly containing @v* files. bash 3.2 has no globstar,
  # so enumerate the known nesting depths explicitly (root docs at <store>/<DOC>/,
  # capability specs at <store>/specs/<cap>/SPEC/).
  local doc_dirs=""
  local f
  shopt -s nullglob
  for f in "$root"/*/@v* "$root"/*/*/@v* "$root"/*/*/*/@v*; do
    local d; d="$(dirname "$f")"
    [[ "$doc_dirs" == *" $d "* ]] || doc_dirs+=" $d "
  done
  shopt -u nullglob

  local total_pruned=0 doc_dir
  for doc_dir in $doc_dirs; do
    # kept set (basenames)
    local kept=" "
    local b
    while IFS= read -r b; do [[ -n "$b" ]] && kept+="$b "; done < <(snapshot_retained_set "$doc_dir" "$keep" "$period")

    # prunable = all @v* basenames not in kept
    shopt -s nullglob
    local all=("$doc_dir"/@v*)
    shopt -u nullglob
    local prunable=()
    for f in "${all[@]}"; do
      b="$(basename "$f")"
      [[ "$kept" == *" $b "* ]] || prunable+=("$f")
    done
    (( ${#prunable[@]} == 0 )) && continue

    local doc_label; doc_label="$(basename "$doc_dir")"
    echo "  $doc_label: keep $(( ${#all[@]} - ${#prunable[@]} )) / prune ${#prunable[@]}"
    for f in "${prunable[@]}"; do
      total_pruned=$(( total_pruned + 1 ))
      if $apply; then
        snapshot_prune_remove "$f"
      else
        echo "      would prune: $f"
      fi
    done
  done

  if (( total_pruned == 0 )); then
    echo "  ✓ nothing to prune — all snapshots within retention tiers"
  elif $apply; then
    echo "  ✓ pruned $total_pruned snapshot(s)"
  else
    echo "  • dry-run: $total_pruned snapshot(s) would be pruned. Re-run with --apply."
  fi
}

# Remove one snapshot file: git rm if tracked (history keeps it), else move to
# .spectacular/.trash/ preserving the relative path. Never rm -f.
snapshot_prune_remove() {
  local f="$1"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && \
     git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
    git rm -q "$f" >/dev/null 2>&1 && { echo "      pruned (git rm): $f"; return; }
  fi
  # Fallback: move to .trash/ mirroring the path under .spectacular/
  local rel="${f#.spectacular/}"
  local dest="$SPEC_WORKSPACE_DIR/.trash/$rel"
  mkdir -p "$(dirname "$dest")"
  mv "$f" "$dest" && echo "      pruned (→ .trash): $f"
}

# ── promote ──────────────────────────────────────────────────────────────────
# `spectacular promote <slug> [--to <state>] [--force]`
# State machine: planned → active → review → verified (linear).
# Is PLAN.md's `## Understanding` section filled? (the understand-before-change
# mechanical check). "Filled" = at least one line of real content under the
# section, ignoring HTML comment blocks (<!-- ... -->, possibly multi-line),
# blank lines, and the ### subheads themselves. Satisfied by a sibling
# UNDERSTANDING.md too. Exit 0 = filled, 1 = empty/absent.
_plan_understanding_filled() {
  local plan="$1"
  [[ -f "$plan" ]] || return 1
  local und_dir
  und_dir="$(dirname "$plan")/UNDERSTANDING.md"
  [[ -f "$und_dir" ]] && return 0
  awk '
    /^##[[:space:]]+Understanding/ { in_u=1; next }
    in_u && /^##[[:space:]]/ && !/^###/ { in_u=0 }
    !in_u { next }
    {
      line=$0
      # strip comment spans; track open multi-line comments. Strip the FIRST
      # complete comment each pass (awk sub is greedy + has no non-greedy op, so
      # we cut to the first "-->" via a placeholder) to avoid eating real content
      # sandwiched between two inline comments on one line.
      if (in_c) { ci=index(line, "-->"); if (ci) { line=substr(line, ci+3); in_c=0 } else next }
      while (match(line, /<!--/)) {
        if (line ~ /-->/) {
          # replace the first <!-- ... --> only: split at the first close marker
          pre=substr(line, 1, RSTART-1)
          rest=substr(line, RSTART)
          ci=index(rest, "-->")
          line=pre substr(rest, ci+3)
        } else { sub(/<!--.*/, "", line); in_c=1; break }
      }
      sub(/^###.*/, "", line)          # subheads are not content
      gsub(/[[:space:]]/, "", line)
      if (line != "") found=1
    }
    END { exit found ? 0 : 1 }
  ' "$plan"
}

# Advisory policy consult on a lifecycle transition. Prints the hook's active
# policies; for @Implementation it runs the mechanical understand-before-change
# presence-check and surfaces a warning if unmet. The CLI does NOT block — the
# skill's injection loop (policy-injection.md) is authoritative. Honors the
# locked design: CLI mechanical surface, skill judgment + enforcement.
_policy_consult_transition() {
  local slug="$1" plan="$2" hook="$3"
  [[ -f "$SPEC_WORKSPACE_DIR/POLICY.md" ]] || return 0

  local pol_out
  pol_out="$(cmd_policy "$hook" 2>/dev/null)"
  [[ -z "$pol_out" ]] && return 0

  echo "  policy gate $hook:"
  echo "$pol_out" | sed 's/^/    /'

  # Mechanical gate: understand-before-change on planned → active.
  # Honor config: skip entirely if the policy is disabled; label by merged severity.
  if [[ "$hook" == "@Implementation" ]] && _policy_enabled "understand-before-change" \
       && ! _plan_understanding_filled "$plan"; then
    local sev rec; rec="$(_policy_lookup "understand-before-change")"
    sev="${rec##*$'\037'}"; [[ -z "$sev" ]] && sev="block"
    info "  ⚠ understand-before-change ($sev): no filled '## Understanding' in PLAN.md (or UNDERSTANDING.md)."
    info "    Fill it before implementing — How it works now / What changes / What stays the same."
    info "    (CLI advisory only; run /spectacular to enforce the gate.)"
  fi
  echo ""
}

# Default --to: advances one step. Refuses backward without --force.
cmd_promote() {
  local slug="" opt_to="" opt_force=false opt_archive=false opt_skip_doctor=false opt_override="" opt_reason=""
  while (( $# > 0 )); do
    case "$1" in
      --to)           require_value "--to" "${2:-}"; opt_to="$2"; shift 2 ;;
      --force)        opt_force=true; shift ;;
      --archive)      opt_archive=true; shift ;;
      --skip-doctor)  opt_skip_doctor=true; shift ;;
      --override)     require_value "--override" "${2:-}"; opt_override="$2"; shift 2 ;;
      --reason)       require_value "--reason" "${2:-}"; opt_reason="$2"; shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: spectacular advance <slug> [--to <state>] [--force] [--archive] [--skip-doctor]
       (alias: spectacular promote — deprecated)

Advance a request through the lifecycle. State machine:
  planned → active → review → verified

Default behavior advances one step (e.g. planned → active). Use --to to
jump (e.g. --to verified). Backward transitions refused without --force.

Advance alone is non-destructive (frontmatter edit only). When --archive is
passed, the chain into archive runs the doctor precondition; --skip-doctor
bypasses it.

Options:
  --to <state>    Target state explicitly (planned | active | review | verified)
  --force         Allow backward or non-adjacent transitions
  --archive       After promoting to verified, also archive the request
  --skip-doctor   Bypass doctor precondition on the --archive chain (caution)
  --override verify --reason <why>
                  Exceptional evidence-gate bypass; records actor/date/reason
  -h, --help      Show this help
EOF
        exit 0 ;;
      -*) die "Unknown flag for promote: $1" ;;
      *)
        [[ -n "$slug" ]] && die "promote takes one <slug> argument; got: $slug and $1"
        slug="$1"
        shift
        ;;
    esac
  done

  [[ -z "$slug" ]] && die "promote: <slug> argument required. See: spectacular promote --help"
  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "promote: not inside a Spectacular workspace."

  local plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md"
  if [[ ! -f "$plan" ]]; then
    if [[ -f "$SPEC_ARCHIVE_DIR/$slug/PLAN.md" ]]; then
      die "promote: '$slug' is archived. Restore from .spectacular/archive/ first."
    fi
    die "promote: request '$slug' not found at .spectacular/requests/$slug/"
  fi

  local current
  current="$(fm_get "$plan" "status")"
  [[ -z "$current" ]] && die "promote: PLAN.md has no status: field"

  # Refuse to advance a held request. `hold:` (e.g. `deferred`, `blocked`) is an
  # orthogonal modifier on any lifecycle stage — the five-state lifecycle stays
  # pure, but a held request can't move until the hold is cleared. Mirrors how
  # the substrate keeps non-lifecycle states out of the linear chain.
  local hold
  hold="$(fm_get "$plan" "hold")"
  if [[ -n "$hold" && "$hold" != "none" ]]; then
    die "promote: '$slug' is held (hold: $hold) — clear the hold in PLAN.md before advancing (remove the \`hold:\` field or set it to 'none')."
  fi

  # Compute target if --to omitted
  local target
  if [[ -n "$opt_to" ]]; then
    target="$opt_to"
  else
    case "$current" in
      planned)  target="active" ;;
      active)   target="review" ;;
      review)   target="verified" ;;
      verified) die "promote: '$slug' is already verified. Use 'spectacular archive $slug' to archive it." ;;
      archived) die "promote: '$slug' is archived (status: archived). Cannot promote further." ;;
      *) die "promote: unknown current status '$current' in PLAN.md" ;;
    esac
  fi

  # Validate target
  case "$target" in
    planned|active|review|verified) ;;
    *) die "promote: invalid --to '$target'. Must be: planned | active | review | verified" ;;
  esac

  if [[ "$target" == verified ]]; then
    local verify_log="$SPEC_REQUESTS_DIR/$slug/VERIFY-LOG.md" verified_evidence=false
    if [[ -f "$verify_log" ]] && grep -Eq '✅|^result:[[:space:]]*pass([[:space:]]|$)|\*\*Outcome:\*\*[[:space:]]*verified' "$verify_log"; then
      verified_evidence=true
    fi
    if ! $verified_evidence; then
      if [[ "$opt_override" != verify || -z "$opt_reason" ]]; then
        die "advance: review → verified requires passing VERIFY-LOG evidence from /spectacular verify; exceptional bypass requires --override verify --reason <why>"
      fi
      fm_set "$plan" verification_override "${USER:-unknown} | $TODAY | $opt_reason"
      warn "advance: verification evidence overridden and recorded"
    fi
    local docs_impact; docs_impact=$(fm_get "$plan" docs_impact)
    if [[ -n "$docs_impact" ]]; then
      if [[ "$docs_impact" != pending ]] || _request_docs_impact_is_heavy "$plan"; then
        _request_docs_impact_closed "$plan" || die "advance: docs impact is not closed; run 'spectacular docs-impact $slug --none --reason <why>' or '--required --evidence <update|handoff>'"
      fi
    else
      warn "advance: legacy request has no docs_impact field; add an assessment for major/heavy work"
    fi
  fi

  # Refuse backward unless --force
  if [[ "$current" == "$target" ]]; then
    echo "  • $slug: already $current (no change)"
    return 0
  fi

  local order="planned active review verified"
  local cur_idx tgt_idx i=0
  for s in $order; do
    [[ "$s" == "$current" ]] && cur_idx=$i
    [[ "$s" == "$target" ]] && tgt_idx=$i
    i=$((i + 1))
  done
  if (( tgt_idx < cur_idx )) && ! $opt_force; then
    die "promote: backward transition $current → $target refused. Use --force to override."
  fi

  # Policy consult on spine transitions (advisory at the CLI; the skill's
  # injection loop is authoritative for block enforcement — see policy-injection.md).
  # The CLI surfaces the relevant hook's policies + a mechanical check so a
  # terminal user isn't blind to a gate they're about to cross.
  case "$target" in
    active)   _policy_consult_transition "$slug" "$plan" "@Implementation" ;;
    verified) _policy_consult_transition "$slug" "$plan" "@Verification" ;;
  esac

  if [[ "$current" == planned && "$target" == active ]]; then
    local activation_spec activation_path activation_baseline activation_type activation_ref
    activation_spec=$(fm_get "$plan" contract); [[ -n "$activation_spec" ]] || activation_spec=$(fm_get "$plan" source_spec)
    activation_type=$(fm_get "$plan" source_type)
    activation_ref=$(fm_get "$plan" source_ref)
    if [[ -n "$activation_spec" ]]; then
      activation_path=$(_spec_find "$activation_spec") || die "advance: source specification '$activation_spec' not found"
      _contract_is_merged "$activation_path" || die "advance: contract '$activation_spec' is not merged into $(_contract_shared_base)"
      _execution_contains_contract "$activation_path" || die "advance: current branch does not contain contract '$activation_spec'; merge or rebase $(_contract_shared_base) first"
    elif [[ -n "$activation_type" || -n "$activation_ref" ]]; then
      case "$activation_type" in issue|goal) ;; *) die "advance: source_type must be issue or goal when source_spec is absent" ;; esac
      [[ -n "$activation_ref" ]] || die "advance: $activation_type-derived request has no source_ref"
    fi
    if [[ -n "$activation_spec" || -n "$activation_type" || -n "$activation_ref" ]]; then
      activation_baseline=uncommitted
      git rev-parse --verify HEAD >/dev/null 2>&1 && activation_baseline=$(git rev-parse HEAD)
      fm_set "$plan" activated_at "$TODAY"
      fm_set "$plan" activated_by "${USER:-user}"
      fm_set "$plan" activated_against "$activation_baseline"
    fi
  fi

  fm_set "$plan" "status" "$target"
  fm_touch "$plan"
  # Also bump TASKS.md status: to stay in sync
  local tasks="$SPEC_REQUESTS_DIR/$slug/TASKS.md"
  if [[ -f "$tasks" ]]; then
    fm_set "$tasks" "status" "$target"
    fm_touch "$tasks"
  fi
  # planned → active: scaffold SESSION.md so the request never starts life as a
  # doctor lifecycle warning. Never overwrites — an existing SESSION.md is kept.
  # (Mirrors the template in references/active-request.md — keep the two in sync.)
  if [[ "$current" == "planned" && "$target" == "active" ]]; then
    local session="$SPEC_REQUESTS_DIR/$slug/SESSION.md"
    if [[ ! -f "$session" ]]; then
      cat > "$session" <<EOF
---
updated: ${TODAY}
---

# Session — ${slug}

## Current state
<What's been done so far>

## Active task
<What's being worked on right now>

## Blockers
<Anything blocking progress>

## Next actions
-
-
EOF
      echo "  ✓ scaffolded: SESSION.md"
    fi
  fi
  # Breadcrumb for `spectacular undo` (single-level). Records prior status so undo
  # can restore it. Skipped when chaining into archive (--archive overwrites it next).
  $opt_archive || _breadcrumb_write "advance" "$slug" "prev_status=$current"
  echo "  ✓ $slug: $current → $target"

  # --archive: chain into cmd_archive (pass --skip-doctor through if set)
  if $opt_archive && [[ "$target" == "verified" ]]; then
    echo ""
    if $opt_skip_doctor; then
      cmd_archive "$slug" --skip-doctor
    else
      cmd_archive "$slug"
    fi
  fi
}

# ── undo (v1.22.0+) ──────────────────────────────────────────────────────────
# Reverses the most recent lifecycle mutation recorded in .last-mutation:
#   advance       → status back to prev_status (PLAN + TASKS)
#   archive       → dir back to requests/, status restored, archived: dropped, links reversed
#   idea-promote  → idea source restored to ideas/, status reset; scaffolded request left
#                   in place unless the user confirms removal (decision D9)
# Single-level only. Refuses if the breadcrumb is stale (an affected file changed
# after the mutation timestamp) — timestamp-vs-mtime guard. --dry-run previews.

# Largest mtime (epoch) among existing paths; 0 if none exist. Portable (BSD+GNU stat).
_max_mtime() {
  local p m max=0
  for p in "$@"; do
    [[ -e "$p" ]] || continue
    m="$(stat -f %m "$p" 2>/dev/null || stat -c %Y "$p" 2>/dev/null || echo 0)"
    (( m > max )) && max=$m
  done
  echo "$max"
}

cmd_undo() {
  local dry_run=false
  while (( $# > 0 )); do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --help|-h)
        cat <<'EOF'
Usage: spectacular undo [--dry-run]

Reverse the most recent lifecycle mutation (single-level):
  advance       → status back one step (PLAN + TASKS)
  archive       → move back to requests/, restore status, drop archived:, reverse links
  idea-promote  → restore the idea to ideas/, reset its status (scaffolded request left in place)

Refuses if nothing to undo, or if the breadcrumb is stale (an affected file was
modified after the recorded mutation). --dry-run prints what would change and
mutates nothing.
EOF
        exit 0 ;;
      *) die "undo: unexpected argument '$1' (only --dry-run is accepted)" ;;
    esac
  done

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "undo: not inside a Spectacular workspace"

  if [[ ! -f "$_BREADCRUMB" ]]; then
    info "Nothing to undo — no recent lifecycle mutation recorded."
    return 0
  fi

  local op slug ts
  op="$(_breadcrumb_get op)"
  slug="$(_breadcrumb_get slug)"
  ts="$(_breadcrumb_get ts)"
  [[ -z "$op" || -z "$slug" ]] && die "undo: .last-mutation is malformed (missing op/slug). Remove it manually if stuck."

  case "$op" in
    advance)
      local prev; prev="$(_breadcrumb_get prev_status)"
      local plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md"
      local tasks="$SPEC_REQUESTS_DIR/$slug/TASKS.md"
      [[ -f "$plan" ]] || die "undo: $plan not found — cannot reverse advance for '$slug'."
      # Staleness: refuse if PLAN/TASKS changed after the mutation.
      local mt; mt="$(_max_mtime "$plan" "$tasks")"
      if [[ -n "$ts" ]] && (( mt > ts + 1 )); then
        die "undo: '$slug' changed since the advance — refusing (stale breadcrumb). Reverse manually if intended."
      fi
      local now; now="$(fm_get "$plan" "status")"
      if $dry_run; then
        info "[dry-run] advance undo: $slug status $now → $prev (PLAN + TASKS)"
        return 0
      fi
      fm_set "$plan" "status" "$prev"; fm_touch "$plan"
      [[ -f "$tasks" ]] && { fm_set "$tasks" "status" "$prev"; fm_touch "$tasks"; }
      _breadcrumb_clear
      info "  ↩ undo advance: $slug $now → $prev"
      ;;

    archive)
      local prev; prev="$(_breadcrumb_get prev_status)"
      local arc="$SPEC_ARCHIVE_DIR/$slug"
      local dest="$SPEC_REQUESTS_DIR/$slug"
      [[ -d "$arc" ]] || die "undo: archived dir $arc not found — cannot reverse archive for '$slug'."
      [[ -d "$dest" ]] && die "undo: $dest already exists — refusing to overwrite. Resolve manually."
      # Staleness: refuse if the archived PLAN changed after the mutation.
      local mt; mt="$(_max_mtime "$arc/PLAN.md" "$arc/TASKS.md")"
      if [[ -n "$ts" ]] && (( mt > ts + 1 )); then
        die "undo: '$slug' changed since archiving — refusing (stale breadcrumb). Reverse manually if intended."
      fi
      if $dry_run; then
        info "[dry-run] archive undo for $slug:"
        info "  move   $arc → $dest"
        info "  status archived → ${prev:-review}; drop archived: field"
        info "  links  ../../archive/$slug/ → ../$slug/ in sibling requests"
        return 0
      fi
      # Reverse the move (git-aware, mirroring cmd_archive)
      if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git mv "$arc" "$dest" 2>/dev/null || mv "$arc" "$dest"
      else
        mv "$arc" "$dest"
      fi
      info "  ↩ moved: $arc → $dest"
      # Restore status, drop archived:
      local plan="$dest/PLAN.md"
      fm_set "$plan" "status" "${prev:-review}"; fm_unset "$plan" "archived"
      _fm_unset_block "$plan" "archive_overrides"   # stale once the archive is reversed
      fm_touch "$plan"
      local tasks="$dest/TASKS.md"
      [[ -f "$tasks" ]] && { fm_set "$tasks" "status" "${prev:-review}"; fm_touch "$tasks"; }
      # Reverse inbound link rewrites: ../../archive/<slug>/ → ../<slug>/
      local rev=0 tf
      shopt -s nullglob
      for tf in "$SPEC_REQUESTS_DIR"/*/PLAN.md "$SPEC_REQUESTS_DIR"/*/TASKS.md "$SPEC_REQUESTS_DIR"/*/VERIFY.md; do
        if grep -q "\.\./\.\./archive/${slug}/" "$tf" 2>/dev/null; then
          sed -i.bak "s|\\.\\./\\.\\./archive/${slug}/|../${slug}/|g" "$tf"
          rm -f "$tf.bak"; rev=$((rev+1))
          info "  ↩ reversed inbound link in: $tf"
        fi
      done
      shopt -u nullglob
      (( rev == 0 )) && info "  • no inbound links to reverse"
      _breadcrumb_clear
      info "  ↩ undo archive: $slug restored to requests/ (status ${prev:-review})"
      ;;

    idea-promote)
      local req_slug idea_prev idea_file
      req_slug="$(_breadcrumb_get request_slug)"
      idea_prev="$(_breadcrumb_get idea_prev_status)"; [[ -z "$idea_prev" ]] && idea_prev="exploring"
      idea_file="$(_breadcrumb_get idea_file)"; [[ -z "$idea_file" ]] && idea_file="$slug.md"
      local arc="$SPEC_ARCHIVE_DIR/ideas/$idea_file"
      local dest="$SPEC_IDEAS_DIR/$idea_file"
      [[ -f "$arc" ]] || die "undo: archived idea $arc not found — cannot reverse idea-promote for '$slug'."
      [[ -f "$dest" ]] && die "undo: $dest already exists — refusing to overwrite. Resolve manually."
      local mt; mt="$(_max_mtime "$arc")"
      if [[ -n "$ts" ]] && (( mt > ts + 1 )); then
        die "undo: idea '$slug' changed since promotion — refusing (stale breadcrumb)."
      fi
      if $dry_run; then
        info "[dry-run] idea-promote undo for $slug:"
        info "  move   $arc → $dest"
        info "  status promoted → $idea_prev; drop promoted_to:"
        info "  request dir .spectacular/requests/$req_slug/ left in place (use removal prompt to delete)"
        return 0
      fi
      mkdir -p "$SPEC_IDEAS_DIR"
      if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git mv "$arc" "$dest" 2>/dev/null || mv "$arc" "$dest"
      else
        mv "$arc" "$dest"
      fi
      fm_set "$dest" "status" "$idea_prev"; fm_unset "$dest" "promoted_to"; fm_touch "$dest"
      info "  ↩ restored idea: $arc → $dest (status $idea_prev)"
      # Scaffolded request: leave by default; prompt to remove (decision D9).
      local req_dir="$SPEC_REQUESTS_DIR/$req_slug"
      if [[ -d "$req_dir" ]]; then
        info ""
        info "  The scaffolded request still exists: $req_dir"
        printf "  Remove it too? [y/N] "
        local ans
        if [[ -t 0 && -t 1 ]]; then
          read -r ans </dev/tty 2>/dev/null || ans="n"
        else
          read -r ans 2>/dev/null || ans="n"
        fi
        if [[ "$ans" == "y" || "$ans" == "Y" ]]; then
          rm -rf "$req_dir"; info "  ↩ removed scaffolded request: $req_dir"
        else
          info "  • left scaffolded request in place: $req_dir"
        fi
      fi
      _breadcrumb_clear
      info "  ↩ undo idea-promote: $slug"
      ;;

    *)
      die "undo: unknown op '$op' in .last-mutation. Remove it manually if stuck."
      ;;
  esac
}

# ── new ──────────────────────────────────────────────────────────────────────
# `spectacular new <slug> [--summary "..."] [--status planned|active|review] [--priority low|medium|high]`
# Scaffolds .spectacular/requests/<slug>/PLAN.md + TASKS.md from templates with
# frontmatter prefilled. Refuses if <slug> exists in requests/ OR archive/.
cmd_new() {
  local slug="" opt_summary="" opt_status="planned" opt_priority="medium"
  while (( $# > 0 )); do
    case "$1" in
      --summary)        require_value "--summary" "${2:-}"; opt_summary="$2"; shift 2 ;;
      --status)         require_value "--status" "${2:-}"; opt_status="$2"; shift 2 ;;
      --priority)       require_value "--priority" "${2:-}"; opt_priority="$2"; shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: spectacular new <slug> [--summary "..."] [--status <state>] [--priority <level>]

Scaffold a new request at .spectacular/requests/<slug>/ with PLAN.md and
TASKS.md prefilled from templates. Assigns the next build id (build: bN) and
increments last_build: in config.yaml.

Arguments:
  <slug>              Kebab-case identifier (e.g. user-auth, fix-race-cond)

Options:
  --summary "..."     One-sentence description (default: empty placeholder)
  --status <state>    planned | active | review  (default: planned)
  --priority <level>  low | medium | high        (default: medium)
  -h, --help          Show this help

The target version is NOT set here — add a row to the roadmap ledger in
ROADMAP.md when you slot this request into a version.

Refuses if <slug> already exists in .spectacular/requests/ or
.spectacular/archive/.
EOF
        exit 0 ;;
      -*) die "Unknown flag for new: $1" ;;
      *)
        [[ -n "$slug" ]] && die "new takes one <slug> argument; got: $slug and $1"
        slug="$1"
        shift
        ;;
    esac
  done

  [[ -z "$slug" ]] && die "new: <slug> argument required. See: spectacular new --help"

  # Slug validation: kebab-case, max 64 chars, no dots/slashes
  if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]; then
    die "new: invalid slug '$slug'. Must be kebab-case, lowercase alnum + hyphens, max 64 chars, starting with letter or digit."
  fi
  # Status + priority validation
  case "$opt_status" in
    planned|active|review) ;;
    *) die "new: invalid --status '$opt_status'. Must be: planned | active | review" ;;
  esac
  case "$opt_priority" in
    low|medium|high) ;;
    *) die "new: invalid --priority '$opt_priority'. Must be: low | medium | high" ;;
  esac

  [[ -d "$SPEC_WORKSPACE_DIR" ]] || die "new: not inside a Spectacular workspace. Run 'spectacular init' first."

  local target="$SPEC_REQUESTS_DIR/$slug"
  if [[ -d "$target" ]]; then
    die "new: slug '$slug' already exists at $target"
  fi
  if [[ -d "$SPEC_ARCHIVE_DIR/$slug" ]]; then
    die "new: slug '$slug' exists in archive (.spectacular/archive/$slug). Pick a different slug or restore the archived request."
  fi

  # Read owner from config.yaml if present
  local owner=""
  if [[ -f "$SPEC_WORKSPACE_DIR/config.yaml" ]]; then
    owner=$(awk '/^  owner:/ { sub(/^  owner:[[:space:]]*/, ""); print; exit }' "$SPEC_CONFIG_FILE")
  fi
  [[ -z "$owner" ]] && owner="$(whoami 2>/dev/null || echo unknown)"

  # Assign build id (v1.17.0+): read last_build: from config.yaml (missing = 0),
  # compute next id, stamp build: bN on PLAN.md, write last_build: N+1 back.
  # The counter self-heals against ledger drift (v1.30.2+): if the roadmap
  # ledger's max bN runs ahead of config's last_build (a request slotted into
  # the ledger without last_build catching up), reconcile to the ledger max so
  # `new` never re-issues an id the ledger already uses.
  local _last_build=0 _build_id=""
  if [[ -f "$SPEC_WORKSPACE_DIR/config.yaml" ]]; then
    local _lb
    _lb=$(awk '/^last_build:/ { sub(/^last_build:[[:space:]]*/, ""); print; exit }' "$SPEC_CONFIG_FILE")
    [[ "$_lb" =~ ^[0-9]+$ ]] && _last_build="$_lb"
  fi
  # Reconcile against the roadmap ledger's highest bN (index.md, or legacy ROADMAP.md).
  local _ledger="" _ledger_max=0
  if [[ -f "$SPEC_ROADMAPS_DIR/index.md" ]]; then _ledger="$SPEC_ROADMAPS_DIR/index.md"
  elif [[ -f "$SPEC_WORKSPACE_DIR/ROADMAP.md" ]]; then _ledger="$SPEC_WORKSPACE_DIR/ROADMAP.md"; fi
  if [[ -n "$_ledger" ]]; then
    _ledger_max=$(grep -oE '\| *b[0-9]+' "$_ledger" | grep -oE '[0-9]+' | sort -n | tail -1)
    [[ "$_ledger_max" =~ ^[0-9]+$ ]] || _ledger_max=0
  fi
  (( _ledger_max > _last_build )) && _last_build="$_ledger_max"
  local _next_build=$(( _last_build + 1 ))
  _build_id="b${_next_build}"

  local request_id
  request_id=$(_uuidv7)
  mkdir -p "$target"

  # PLAN.md from template
  local plan_template
  plan_template="$(agents_skill_dir)/templates/plan/base.md"
  if [[ ! -f "$plan_template" ]]; then
    plan_template="${SCRIPT_DIR}/../skills/spectacular/templates/plan/base.md"
  fi
  if [[ -f "$plan_template" ]]; then
    sed -e "s|<OWNER>|${owner}|g" \
        -e "s|<ID>|${request_id}|g" \
        -e "s|<SLUG>|${slug}|g" \
        -e "s|<DATE>|${TODAY}|g" \
        -e "s|<BUILD>|${_build_id}|g" \
        -e "s|<one-sentence description of what this request changes>|${opt_summary:-<one-sentence description of what this request changes>}|" \
        -e "s|<Request Title>|${slug}|g" \
        "$plan_template" > "$target/PLAN.md"
    # Override frontmatter status + priority via fm_set (build already in template)
    fm_set "$target/PLAN.md" "status" "$opt_status"
    fm_set "$target/PLAN.md" "priority" "$opt_priority"
  else
    # Fallback minimal scaffold
    cat > "$target/PLAN.md" <<EOF
---
id: $request_id
slug: $slug
kind: request
scope: project
status: $opt_status
priority: $opt_priority
owner: $owner
updated: $TODAY
build: $_build_id
docs_impact: pending
summary: "${opt_summary}"
related: []
references: []
---

# Plan — $slug

## 1. Goal

<GOAL — one sentence; name the PRD goal it serves>

## 2. Constraints

- <CONSTRAINT>

## Understanding

### How it works now

<CURRENT BEHAVIOR>

### What changes

<CHANGES>

### What stays the same

<UNCHANGED>

## Decisions

- <DECISION — chose X over Y because Z>

## 3. Milestones

1. **<MILESTONE>** — <demoable outcome>

## 4. Tasks

See TASKS.md.

## 5. Dependencies

- <DEPENDENCY or "none">

## 6. Validation

- M1 — <VERIFICATION>

## 7. Deliverables

- <DELIVERABLE>
EOF
  fi

  # TASKS.md from template
  local tasks_template
  tasks_template="$(agents_skill_dir)/templates/tasks/base.md"
  if [[ ! -f "$tasks_template" ]]; then
    tasks_template="${SCRIPT_DIR}/../skills/spectacular/templates/tasks/base.md"
  fi
  if [[ -f "$tasks_template" ]]; then
    sed -e "s|<DATE>|${TODAY}|g" \
        -e "s|<Request Title>|${slug}|g" \
        "$tasks_template" > "$target/TASKS.md"
    fm_set "$target/TASKS.md" "status" "$opt_status"
  else
    cat > "$target/TASKS.md" <<EOF
---
status: $opt_status
updated: $TODAY
related:
  - PLAN.md
---

# Tasks — $slug

## v1

### M1 — <Milestone name>
- [ ] <Task>
EOF
  fi

  # Write last_build: back to config.yaml (create field if missing)
  if [[ -f "$SPEC_WORKSPACE_DIR/config.yaml" ]]; then
    if grep -q "^last_build:" "$SPEC_CONFIG_FILE"; then
      local _tmp; _tmp=$(mktemp)
      awk -v nb="$_next_build" '/^last_build:/ { print "last_build: " nb; next } { print }' \
        "$SPEC_CONFIG_FILE" > "$_tmp" && mv "$_tmp" "$SPEC_CONFIG_FILE"
    else
      printf '\nlast_build: %s\n' "$_next_build" >> "$SPEC_CONFIG_FILE"
    fi
  fi

  echo "  ✓ scaffolded: $target/PLAN.md"
  echo "  ✓ scaffolded: $target/TASKS.md"
  echo "  ✓ build id:   $_build_id"
  echo ""
  echo "Next: edit $target/PLAN.md to flesh out the 7 slots."
  echo "      When slotting into the roadmap, add a row to the ledger in ROADMAP.md."

  # Relationship prompt (v1.16.0+): if any active request's slug shares a
  # keyword with the new slug, hint to declare depends-on:/blocks:/related:.
  local _new_keywords _match_slugs=""
  _new_keywords=$(echo "$slug" | tr '-' '\n')
  shopt -s nullglob
  for _d in "$SPEC_REQUESTS_DIR"/*/; do
    local _cs; _cs=$(basename "$_d")
    [[ "$_cs" == "$slug" ]] && continue
    local _cst; _cst=$(fm_get "$SPEC_REQUESTS_DIR/$_cs/PLAN.md" "status" 2>/dev/null || true)
    [[ "$_cst" == "active" ]] || [[ "$_cst" == "planned" ]] || continue
    local _matched=false
    while IFS= read -r _kw; do
      [[ ${#_kw} -lt 4 ]] && continue  # skip short words
      if echo "$_cs" | grep -qi "$_kw"; then
        _matched=true; break
      fi
    done <<< "$_new_keywords"
    $_matched && _match_slugs="${_match_slugs:+$_match_slugs, }$_cs"
  done
  shopt -u nullglob
  if [[ -n "$_match_slugs" ]]; then
    echo "  ⚠  Related requests detected: $_match_slugs"
    echo "     Consider adding depends-on:, blocks:, or related: in PLAN.md."
  fi
}

# Canonical spec-derived request scaffold. This is deliberately mechanical:
# it creates a reviewed draft bundle from an approved baseline but does not
# activate implementation or pretend to perform agentic planning.
cmd_request_new() {
  local slug="" from="" from_issue="" from_goal="" priority=medium source_summary="" sensitivity=""
  while (( $# > 0 )); do
    case "$1" in
      --from) require_value "$1" "${2:-}"; from="$2"; shift 2 ;;
      --from-issue) require_value "$1" "${2:-}"; from_issue="$2"; shift 2 ;;
      --from-goal) require_value "$1" "${2:-}"; from_goal="$2"; shift 2 ;;
      --summary) require_value "$1" "${2:-}"; source_summary="$2"; shift 2 ;;
      --sensitivity) require_value "$1" "${2:-}"; sensitivity="$2"; shift 2 ;;
      --priority) require_value "$1" "${2:-}"; priority="$2"; shift 2 ;;
      --help|-h)
        cat <<'EOF'
Usage: spectacular request new [<slug>] --from <SPC-ID> [--priority low|medium|high]
       spectacular request new <slug> --from-issue <owner/repo#N|URL> --summary <accepted-outcome> --sensitivity normal|protected
       spectacular request new <slug> --from-goal <goal-ref> [--summary <accepted-outcome>] --sensitivity normal|protected

Create a planned PLAN/TASKS bundle from exactly one source. Specifications must
be approved. Issue and goal sources are for already-defined destinations that
need durable coordination; they never manufacture a specification.
EOF
        return 0 ;;
      -*) die "request new: unknown flag '$1'" ;;
      *) [[ -z "$slug" ]] || die "request new: only one slug allowed"; slug="$1"; shift ;;
    esac
  done
  local source_count=0
  [[ -n "$from" ]] && source_count=$((source_count + 1))
  [[ -n "$from_issue" ]] && source_count=$((source_count + 1))
  [[ -n "$from_goal" ]] && source_count=$((source_count + 1))
  [[ "$source_count" -eq 1 ]] || die "request new: choose exactly one source: --from <SPC-ID>, --from-issue <owner/repo#N|URL>, or --from-goal <goal-ref>"
  if [[ -n "$from_issue" || -n "$from_goal" ]]; then
    [[ -n "$slug" ]] || die "request new: <slug> is required for Issue/goal-derived work"
    [[ -z "$from_issue" || -n "$source_summary" ]] || die "request new: --from-issue requires --summary <accepted-outcome>; do not copy the Issue body"
    case "$sensitivity" in normal|protected) ;; *) die "request new: Issue/goal sources require --sensitivity normal|protected from the readiness assessment" ;; esac
    local source_type source_ref source_label plan tasks existing_source
    if [[ -n "$from_issue" ]]; then
      source_type=issue
      if [[ "$from_issue" =~ ^https://github\.com/([^/]+)/([^/]+)/issues/([0-9]+)(/)?$ ]]; then
        source_ref="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}#${BASH_REMATCH[3]}"
      elif [[ "$from_issue" =~ ^[^/[:space:]]+/[^#[:space:]]+#[0-9]+$ ]]; then
        source_ref="$from_issue"
      else
        die "request new: Issue source must be canonical owner/repo#N or a GitHub Issue URL"
      fi
      source_label="Issue $source_ref"
    else
      source_type=goal; source_ref="$from_goal"; source_label="goal $source_ref"
      [[ -n "$source_summary" ]] || source_summary="$from_goal"
    fi
    existing_source=$(grep -lE "^source_ref:[[:space:]]*[\"']?${source_ref//\//\\/}[\"']?[[:space:]]*$" "$SPEC_REQUESTS_DIR"/*/PLAN.md 2>/dev/null | head -1 || true)
    [[ -z "$existing_source" ]] || die "request new: $source_label already owns request '$(basename "$(dirname "$existing_source")")'"
    cmd_new "$slug" --summary "$source_summary" --priority "$priority"
    plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md"; tasks="$SPEC_REQUESTS_DIR/$slug/TASKS.md"
    fm_set "$plan" source_type "$source_type"
    fm_set "$plan" source_ref "$source_ref"
    fm_set "$plan" sensitivity "$sensitivity"
    _request_replace_section "$plan" Goal "$source_summary"
    _request_replace_section "$plan" Constraints "- Preserve the accepted outcome and named boundaries of $source_label.\n- Stop for unresolved product choices, material scope expansion, security sensitivity, or undeclared access.\n- Link remote evidence; do not copy Issue bodies or comments into the request."
    _request_replace_section "$plan" Milestones "- M1 — Implement and verify the accepted $source_type-derived work."
    _request_replace_section "$plan" Dependencies "- Source: $source_label.\n- Existing code, tests, documentation, and decisions define the destination; escalate to spec-first if that proves false."
    _request_replace_section "$plan" Validation "- M1 — prove the accepted outcome against the real code path and record current-head evidence."
    _request_replace_section "$plan" Deliverables "- Verified implementation for $source_label.\n- Pull-request handoff with source, request, verification, and docs-impact references."
    fm_set "$tasks" source_type "$source_type"
    fm_set "$tasks" source_ref "$source_ref"
    local source_task="Implement and verify the accepted outcome for $source_label."
    local task_tmp; task_tmp=$(mktemp)
    awk -v task="$source_task" '
      /^###[[:space:]]+M1/ { print "### M1 — Implement accepted work"; print "- [ ] " task; skip=1; next }
      skip && /^##[[:space:]]/ { skip=0 }
      !skip { print }
    ' "$tasks" > "$task_tmp" && mv "$task_tmp" "$tasks"
    fm_touch "$plan"; fm_touch "$tasks"
    info "  ↳ source: $source_type $source_ref"
    info "  • request remains planned; review its closed outcome/boundaries before activation"
    return 0
  fi
  local spec id status summary spec_slug existing plan tasks tmp req_file baseline reqs intent
  spec=$(_spec_find "$from") || die "request new: specification '$from' not found"
  id=$(fm_get "$spec" id); status=$(fm_get "$spec" status); summary=$(fm_get "$spec" summary)
  _contract_is_merged "$spec" || die "request new: contract '$id' is not merged into $(_contract_shared_base); merge its spec PR before creating execution work"
  _execution_contains_contract "$spec" || die "request new: current execution branch does not contain contract '$id'; merge or rebase $(_contract_shared_base) first"
  spec_slug=$(_record_slug "$spec")
  [[ -z "$slug" ]] && slug="$spec_slug"
  existing=$(grep -lE "^contract:[[:space:]]*[\"']?${id}[\"']?[[:space:]]*$" "$SPEC_REQUESTS_DIR"/*/PLAN.md 2>/dev/null | head -1 || true)
  [[ -z "$existing" ]] || die "request new: $id already seeds request '$(basename "$(dirname "$existing")")'"

  cmd_new "$slug" --summary "Implement $id: $summary" --priority "$priority"
  plan="$SPEC_REQUESTS_DIR/$slug/PLAN.md"; tasks="$SPEC_REQUESTS_DIR/$slug/TASKS.md"
  baseline="uncommitted"
  git rev-parse --verify HEAD >/dev/null 2>&1 && baseline=$(git rev-parse HEAD)
  fm_set "$plan" contract "$id"
  fm_set "$plan" scaffolded_against "$baseline"
  intent=$(_request_section "$spec" Intent | awk 'NF && $0 !~ /^<!--/ && $0 !~ /^_/ {print}' | head -1)
  [[ -n "$intent" ]] || intent="Implement the approved $id specification: $summary."
  _request_replace_section "$plan" Goal "$intent"
  _request_replace_section "$plan" Constraints "- Stay within the approved $id requirements; unresolved scope changes return to discovery.\n- Preserve existing behavior outside this specification.\n- Production code and invariant tests become implementation truth after verification."
  _request_replace_section "$plan" Milestones "- M1 — Implement and verify the approved $id requirements."
  _request_replace_section "$plan" Dependencies "- Approved source specification: $id.\n- Linked decisions and questions remain in the source specification."
  _request_replace_section "$plan" Validation "- M1 — run/assert: every approved requirement has implementation evidence and relevant tests pass."
  _request_replace_section "$plan" Deliverables "- Production implementation and tests for $id.\n- Verification evidence and documentation-impact assessment."
  fm_touch "$plan"

  # Seed TASKS from top-level requirement bullets. The generated order mirrors
  # the approved spec; later agent review may clarify wording but cannot silently
  # add, remove, or reorder scope after activation.
  reqs=$(_request_section "$spec" Requirements | grep -E '^- ' | grep -v '_(fill in)_' | sed 's/^- /- [ ] /' || true)
  [[ -n "$reqs" ]] || reqs="- [ ] Implement the approved requirements in $id."
  req_file=$(mktemp); printf '%s\n' "$reqs" > "$req_file"
  tmp=$(mktemp)
  awk -v req_file="$req_file" -v spec_id="$id" '
    /^###[[:space:]]+M1/ {
      print "### M1 — Implement " spec_id
      while ((getline task < req_file) > 0) print task
      close(req_file); skip=1; next
    }
    skip && /^##[[:space:]]/ { skip=0 }
    !skip { print }
  ' "$tasks" > "$tmp" && mv "$tmp" "$tasks"
  rm -f "$req_file"
  fm_set "$tasks" contract "$id"
  fm_touch "$tasks"
  info "  ↳ approved contract: $id on $(_contract_shared_base)"
  info "  • request remains planned; next: /spectacular act $id"
}

# ── touch ────────────────────────────────────────────────────────────────────
# `spectacular touch <file>` — update frontmatter `updated:` to today.
# Idempotent: no-op if already today. Refuses files without frontmatter.
cmd_touch() {
  local file=""
  while (( $# > 0 )); do
    case "$1" in
      --help|-h)
        cat <<EOF
Usage: spectacular touch <file>

Update the frontmatter \`updated:\` field of <file> to today (${TODAY}).
Idempotent — re-running on a file already current is a clean no-op.
Refuses files without a YAML frontmatter block.
EOF
        exit 0 ;;
      -*) die "Unknown flag for touch: $1" ;;
      *)
        [[ -n "$file" ]] && die "touch takes one file argument; got: $file and $1"
        file="$1"
        shift
        ;;
    esac
  done

  [[ -z "$file" ]] && die "touch: <file> argument required. See: spectacular touch --help"
  if [[ ! -f "$file" ]]; then
    local diag_output
    if diag_output=$(diagnose_path_error "touch" "$file"); then
      local diagnosis suggested_path
      diagnosis=$(echo "$diag_output" | head -n 1)
      suggested_path=$(echo "$diag_output" | tail -n 1)
      case "$diagnosis" in
        prefix-missing)
          die "touch: file not found: $file (did you mean $suggested_path?)"
          ;;
        slug-to-plan)
          die "touch: file not found: $file ($file is a request directory; did you mean $suggested_path?)"
          ;;
      esac
    fi
    die "touch: file not found: $file"
  fi
  if ! head -1 "$file" | grep -q '^---$'; then
    die "touch: $file has no frontmatter delimiter"
  fi

  local current
  current="$(fm_get "$file" "updated")"
  if [[ "$current" == "$TODAY" ]]; then
    echo "  • $file: updated already $TODAY (no change)"
    return 0
  fi

  fm_touch "$file"
  echo "  ✓ $file: updated ${current:-(missing)} → $TODAY"
}

# ── doctor precondition (v0.7.4+) ────────────────────────────────────────────
# Run a scoped doctor check before destructive verbs (migrate, archive,
# promote --archive). Errors block (exit 1); warnings and info pass through.
# Bypass via --skip-doctor on the calling verb.
#
# Areas scoped: workspace, specs, links — the three most likely to surface
# structural problems that would make a destructive op unsafe. We don't run
# the full doctor (~10 areas) to keep precondition latency low and avoid
# blocking on unrelated drift (e.g. ROADMAP pre-v0.7.2 naming).
#
# Usage:  require_doctor_clean "<verb-name>" "<skip-doctor-flag-name>" $opt_skip_doctor
#         <verb-name>: human-readable verb (for error message)
#         <flag>: the bypass flag name (for error message)
#         $opt_skip_doctor: true|false — caller's parsed flag value
#
# Returns: 0 if clean (or skipped), exits 1 if errors found.
# Used by: archive (and promote --archive chain). For migrate, see
# require_doctor_clean_links — migrate would self-trigger on schema drift it's
# designed to fix.
require_doctor_clean() {
  _doctor_precondition "$1" "$2" "$3" "workspace specs links"
}

# Narrower precondition: only the links area. Used by migrate, which would
# self-trigger if it ran the workspace/specs checks (v0.4-shape workspaces
# have current/ which check_specs intentionally flags).
require_doctor_clean_links() {
  _doctor_precondition "$1" "$2" "$3" "links"
}

# Internal: run doctor on the named areas, count errors, refuse if any.
_doctor_precondition() {
  local verb="$1" flag="$2" skip="$3" areas="$4"
  if [[ "$skip" == "true" ]]; then
    return 0
  fi
  if [[ ! -d "$SPEC_WORKSPACE_DIR" ]]; then
    return 0  # outside-workspace check is the caller's job; don't double-error
  fi

  # JSON renders with `"severity": "error"` (space after colon) — match either spacing.
  local out err_count=0
  for area in $areas; do
    out=$("$0" doctor "$area" --format json 2>/dev/null) || true
    local n
    n=$(echo "$out" | grep -c '"severity":[[:space:]]*"error"' || true)
    err_count=$((err_count + n))
  done

  if (( err_count > 0 )); then
    local areas_display
    areas_display=$(echo "$areas" | tr ' ' '/')
    cat >&2 <<EOF

Refusing '$verb' — doctor found $err_count error(s) in $areas_display.

Run 'spectacular doctor' for details, fix the errors, then re-run.
To bypass (use with caution): pass --$flag

EOF
    exit 1
  fi
}

# ── migrate ──────────────────────────────────────────────────────────────────
# `spectacular migrate` — apply pending workspace-schema migrations.
#
# v0.6.2+: migrations live as .md files under skills/spectacular/references/
# migrations/. Each file declares (id, from, to, mechanical, reversible,
# apply-fn, affects) in frontmatter. The loader scans + sorts by `from` semver,
# resolves the chain from current_schema → target_schema, and dispatches each:
#   - mechanical: true  → calls the bash function named in apply-fn
#   - mechanical: false → prints "run /spectacular migrate in your AI agent",
#                         exits non-zero; the skill walks judgment migrations
#                         (see references/migrate.md)
#
# Schema contract: skills/spectacular/references/migrations-contract.md
#
# Idempotence: every migration self-detects whether it needs to run. Running
# `migrate` on an up-to-date workspace is a clean no-op.

# Resolve the directory where migration .md files live. Tries in order:
#   1. .agents/skills/spectacular/references/migrations/  (project-installed)
#   2. ~/.agents/skills/spectacular/references/migrations/ (global install)
#   3. ${SCRIPT_DIR}/../skills/spectacular/references/migrations/ (dev / source-tree run)
# Stdout: resolved absolute path, or empty string if none found.
migrations_dir() {
  local project_path="$(pwd)/.agents/skills/spectacular/references/migrations"
  local global_path="$HOME/.agents/skills/spectacular/references/migrations"
  local dev_path="${SCRIPT_DIR}/../skills/spectacular/references/migrations"
  for candidate in "$project_path" "$global_path" "$dev_path"; do
    if [[ -d "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

# Extract a single frontmatter field value from a migration .md file.
# Usage: migration_field <path> <field-name>
# Stdout: field value (trimmed, quotes stripped); empty if not found.
migration_field() {
  local path="$1" field="$2"
  awk -v fld="$field" '
    /^---$/ { fm = !fm; next }
    fm && $0 ~ "^"fld":" {
      val = $0
      sub("^"fld":[[:space:]]*", "", val)
      gsub(/^"|"$/, "", val)
      gsub(/[[:space:]]+$/, "", val)
      print val
      exit
    }
  ' "$path"
}

# Bump workspace_schema in config.yaml to the given version.
# Used internally by migration apply functions.
bump_workspace_schema() {
  local new_schema="$1"
  local cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  if [[ ! -f "$cfg" ]]; then
    echo "  ✗ cannot bump workspace_schema — config.yaml not found" >&2
    return 1
  fi
  if grep -q "^workspace_schema:" "$cfg"; then
    # In-place update (portable sed: use a tmp file)
    sed "s/^workspace_schema:.*/workspace_schema: \"${new_schema}\"/" "$cfg" > "$cfg.tmp"
    mv "$cfg.tmp" "$cfg"
  else
    # Insert after the `project:` block (between line ending with ^summary: and the next blank line)
    # Simpler: append at end of file with a header comment
    cat >> "$cfg" <<EOF

# Structural version of .spectacular/ layout. Migrations bump this.
workspace_schema: "${new_schema}"
EOF
  fi
}

# Stamp last_touched_with: to the current CLI version. Called by any verb that
# structurally mutates the workspace (migrate, doctor --fix). Idempotent — a
# no-op if the field already matches. Legacy workspaces predating provenance
# (no field) get one inserted after workspace_schema:. Never touches
# created_with: (write-once at init). Silent no-op if config.yaml is absent.
stamp_last_touched() {
  local cfg="$SPEC_WORKSPACE_DIR/config.yaml"
  [[ -f "$cfg" ]] || return 0
  if grep -q "^last_touched_with:" "$cfg"; then
    grep -q "^last_touched_with: \"${SPECTACULAR_VERSION}\"$" "$cfg" && return 0
    sed "s/^last_touched_with:.*/last_touched_with: \"${SPECTACULAR_VERSION}\"/" "$cfg" > "$cfg.tmp"
    mv "$cfg.tmp" "$cfg"
  else
    # Legacy workspace: backfill provenance after workspace_schema:. Set
    # created_with too, best-effort — the true creation version is unknown, so
    # mark it "unknown" rather than lying with the current version.
    awk -v v="$SPECTACULAR_VERSION" '
      { print }
      /^workspace_schema:/ && !done {
        print ""
        print "# Provenance (backfilled — created_with unknown for pre-provenance workspaces)."
        print "created_with: \"unknown\""
        print "last_touched_with: \"" v "\""
        done=1
      }
    ' "$cfg" > "$cfg.tmp"
    mv "$cfg.tmp" "$cfg"
  fi
}

# v0.4 → v0.5: rename .spectacular/current/ → .spectacular/specs/ if present.
# Preserves contents verbatim (flat .md files OR per-capability subfolders).
# Idempotent: no-op when current/ absent.
migration_apply_v04_to_v05() {
  local dry="$1"
  local current_dir="$SPEC_WORKSPACE_DIR/current"
  local specs_dir="$SPEC_SPECS_DIR"

  if [[ ! -d "$current_dir" ]]; then
    echo "  • v0.4→v0.5: no .spectacular/current/ found — nothing to rename"
    [[ "$dry" == "true" ]] || bump_workspace_schema "0.5"
    return 0
  fi

  if [[ -d "$specs_dir" ]]; then
    echo "  ✗ v0.4→v0.5: both .spectacular/current/ AND .spectacular/specs/ exist" >&2
    echo "    Manual merge required. Run 'spectacular doctor specs' for guidance." >&2
    return 1
  fi

  if [[ "$dry" == "true" ]]; then
    echo "  • v0.4→v0.5: would rename .spectacular/current/ → .spectacular/specs/ (preserve contents)"
    return 0
  fi

  mv "$current_dir" "$specs_dir"
  echo "  ✓ v0.4→v0.5: renamed .spectacular/current/ → .spectacular/specs/"
  bump_workspace_schema "0.5"
}

# v0.5 → v0.6: ensure .spectacular/specs/ exists (mkdir + .gitkeep if empty).
# Idempotent: no-op when specs/ already present.
migration_apply_v05_to_v06() {
  local dry="$1"
  local specs_dir="$SPEC_SPECS_DIR"

  if [[ -d "$specs_dir" ]]; then
    # specs/ exists — just ensure schema is bumped
    if [[ "$dry" == "true" ]]; then
      echo "  • v0.5→v0.6: .spectacular/specs/ already present — would bump schema only"
    else
      echo "  • v0.5→v0.6: .spectacular/specs/ already present — bumping schema only"
